<Project>
    <PropertyGroup>
        <HexalithBuildPackageVersions1>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions1>
        <HexalithBuildPackageVersions2>$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions2>
        <HexalithBuildPackageVersions3>$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/Directory.Packages.props</HexalithBuildPackageVersions3>
    </PropertyGroup>
    <Import Project="$(HexalithBuildPackageVersions1)" Condition="Exists('$(HexalithBuildPackageVersions1)') And '$(HexalithVersionsLoaded)' != 'true'" />
    <Import Project="$(HexalithBuildPackageVersions2)" Condition="Exists('$(HexalithBuildPackageVersions2)') And '$(HexalithVersionsLoaded)' != 'true'" />
    <Import Project="$(HexalithBuildPackageVersions3)" Condition="Exists('$(HexalithBuildPackageVersions3)') And '$(HexalithVersionsLoaded)' != 'true'" />

    <PropertyGroup>
        <!-- Auto-detect Hexalith.EventStore location:
             1. Tenants is a submodule inside Hexalith.EventStore
             2. EventStore is a references/ submodule inside Tenants (standalone) — prioritized over sibling
             3. Tenants and EventStore are sibling submodules in a references/ folder or app repo
             4. Tenants is under an EventStore references/ folder
             5. Fallback: assume submodule inside Tenants references/ -->
        <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)..</HexalithEventStoreRoot>
        <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)..\..</HexalithEventStoreRoot>
        <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.EventStore</HexalithEventStoreRoot>
        <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.EventStore</HexalithEventStoreRoot>
        <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\references\Hexalith.EventStore\src\Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)..\references\Hexalith.EventStore</HexalithEventStoreRoot>
        <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.EventStore</HexalithEventStoreRoot>
        <!-- Auto-detect Hexalith.Commons location for shared module infrastructure that is source-only in
             this workspace, such as Hexalith.Commons.ServiceDefaults. -->
        <HexalithCommonsRoot Condition="'$(HexalithCommonsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Commons\src\libraries\Hexalith.Commons.ServiceDefaults')">$(MSBuildThisFileDirectory)references\Hexalith.Commons</HexalithCommonsRoot>
        <HexalithCommonsRoot Condition="'$(HexalithCommonsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Commons\src\libraries\Hexalith.Commons.ServiceDefaults')">$(MSBuildThisFileDirectory)..\Hexalith.Commons</HexalithCommonsRoot>
        <HexalithCommonsRoot Condition="'$(HexalithCommonsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\references\Hexalith.Commons\src\libraries\Hexalith.Commons.ServiceDefaults')">$(MSBuildThisFileDirectory)..\references\Hexalith.Commons</HexalithCommonsRoot>
        <!-- Auto-detect Hexalith.FrontComposer location:
             1. FrontComposer is a references/ submodule inside Tenants (standalone)
             2. FrontComposer and Tenants are sibling submodules in a references/ folder or app repo
             3. Tenants is a submodule of the FrontComposer root repo (FrontComposer src at the repo root)
             4. Fallback: assume submodule inside Tenants references/ -->
        <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Shell')">$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer</HexalithFrontComposerRoot>
        <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Shell')">$(MSBuildThisFileDirectory)..\Hexalith.FrontComposer</HexalithFrontComposerRoot>
        <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\references\Hexalith.FrontComposer\src\Hexalith.FrontComposer.Shell')">$(MSBuildThisFileDirectory)..\references\Hexalith.FrontComposer</HexalithFrontComposerRoot>
        <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\.gitmodules') and Exists('$(MSBuildThisFileDirectory)..\src\Hexalith.FrontComposer.Shell')">$(MSBuildThisFileDirectory)..</HexalithFrontComposerRoot>
        <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\src\Hexalith.FrontComposer.Shell')">$(MSBuildThisFileDirectory)..\..</HexalithFrontComposerRoot>
        <HexalithFrontComposerRoot Condition="'$(HexalithFrontComposerRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.FrontComposer</HexalithFrontComposerRoot>
        <!-- Auto-detect Hexalith.Memories location for tenant search index integration:
             1. Memories is a references/ submodule inside Tenants (standalone)
             2. Memories and Tenants are sibling submodules in a references/ folder or app repo
             3. Fallback: assume submodule inside Tenants references/ -->
        <HexalithMemoriesRoot Condition="'$(HexalithMemoriesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)references\Hexalith.Memories\src\Hexalith.Memories.Contracts')">$(MSBuildThisFileDirectory)references\Hexalith.Memories</HexalithMemoriesRoot>
        <HexalithMemoriesRoot Condition="'$(HexalithMemoriesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\Hexalith.Memories\src\Hexalith.Memories.Contracts')">$(MSBuildThisFileDirectory)..\Hexalith.Memories</HexalithMemoriesRoot>
        <HexalithMemoriesRoot Condition="'$(HexalithMemoriesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\references\Hexalith.Memories\src\Hexalith.Memories.Contracts')">$(MSBuildThisFileDirectory)..\references\Hexalith.Memories</HexalithMemoriesRoot>
        <HexalithMemoriesRoot Condition="'$(HexalithMemoriesRoot)' == ''">$(MSBuildThisFileDirectory)references\Hexalith.Memories</HexalithMemoriesRoot>
        <!-- Cross-repo Hexalith dependencies use centrally pinned NuGet packages by default so
             restore/build graphs stay consistent even when CI restores without an explicit
             configuration and then builds Release without restoring again. Override
             UseHexalithProjectReferences=true or UseNuGetDeps=false only for intentional
             source-debug sessions. The non-packable Tenants UI and its tests are the narrow
             exception: they prefer a complete, available FrontComposer source graph because
             their current components can lead the published package baseline. Set
             HexalithFrontComposerFromSource=false explicitly to validate package mode. -->
        <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'true'">false</UseHexalithProjectReferences>
        <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(UseNuGetDeps)' == 'false'">true</UseHexalithProjectReferences>
        <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(Configuration)' == ''">false</UseHexalithProjectReferences>
        <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == ''">false</UseHexalithProjectReferences>
        <UseNuGetDeps Condition="'$(UseNuGetDeps)' == '' and '$(UseHexalithProjectReferences)' == 'true'">false</UseNuGetDeps>
        <UseNuGetDeps Condition="'$(UseNuGetDeps)' == ''">true</UseNuGetDeps>
        <HexalithCommonsFromSource Condition="'$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithCommonsRoot)\src\libraries\Hexalith.Commons.ServiceDefaults\Hexalith.Commons.ServiceDefaults.csproj')">true</HexalithCommonsFromSource>
        <HexalithEventStoreFromSource Condition="'$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj')">true</HexalithEventStoreFromSource>
        <HexalithFrontComposerSourceConsumer Condition="'$(MSBuildProjectName)' == 'Hexalith.Tenants.UI' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.UI.Tests'">true</HexalithFrontComposerSourceConsumer>
        <HexalithFrontComposerSourceAvailable Condition="'$(HexalithFrontComposerSourceAvailable)' == '' and Exists('$(HexalithFrontComposerRoot)\src\Hexalith.FrontComposer.Contracts\Hexalith.FrontComposer.Contracts.csproj') and Exists('$(HexalithFrontComposerRoot)\src\Hexalith.FrontComposer.Shell\Hexalith.FrontComposer.Shell.csproj') and Exists('$(HexalithFrontComposerRoot)\src\Hexalith.FrontComposer.Testing\Hexalith.FrontComposer.Testing.csproj')">true</HexalithFrontComposerSourceAvailable>
        <HexalithFrontComposerSourceAvailable Condition="'$(HexalithFrontComposerSourceAvailable)' == ''">false</HexalithFrontComposerSourceAvailable>
        <HexalithFrontComposerFromSource Condition="'$(HexalithFrontComposerFromSource)' == '' and '$(HexalithFrontComposerSourceConsumer)' == 'true' and '$(HexalithFrontComposerSourceAvailable)' == 'true'">true</HexalithFrontComposerFromSource>
        <HexalithFrontComposerFromSource Condition="'$(HexalithFrontComposerFromSource)' == ''">false</HexalithFrontComposerFromSource>
        <HexalithMemoriesFromSource Condition="'$(UseHexalithProjectReferences)' == 'true' and Exists('$(HexalithMemoriesRoot)\src\Hexalith.Memories.Contracts\Hexalith.Memories.Contracts.csproj')">true</HexalithMemoriesFromSource>
    </PropertyGroup>

    <!-- Deliberate exception to the "centralized build config" convention: this module
         imports only Directory.Packages.props from Hexalith.Builds. Hexalith.Build.props is
         NOT imported because it adds analyzer packages (SonarAnalyzer, StyleCop, Roslynator)
         that this repository's analyzer policy intentionally excludes. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version Condition="'$(Version)' == '' and '$(HexalithTenantsVersion)' != ''">$(HexalithTenantsVersion)</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Keep the NuGet vulnerability audit enabled, but keep advisory codes out of
             warnings-as-errors so a transitive advisory that cannot be upgraded immediately
             surfaces in build logs without blocking CI (Hexalith ci-cd-standards.md,
             "Dependency Auditing"). -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
        <LangVersion>latest</LangVersion>

        <!-- NuGet Package Defaults (overridden by host/test projects) -->
        <IsPackable>true</IsPackable>
        <IsPublishable>false</IsPublishable>

        <!-- NuGet Metadata -->
        <Authors>Hexalith Contributors</Authors>
        <Company>Hexalith</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Hexalith/Hexalith.Tenants</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Hexalith/Hexalith.Tenants</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>Multi-tenant management service for .NET built on Hexalith.EventStore</Description>
        <PackageTags>multi-tenancy;tenants;dapr;eventsourcing;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' == 'true'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
