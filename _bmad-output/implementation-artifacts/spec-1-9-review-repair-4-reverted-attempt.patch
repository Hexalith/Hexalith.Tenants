+                ? offset.ToString(CultureInfo.InvariantCulture)
+                : throw encodeFailure();
+
+        public bool TryDecode(string? cursor, string scope, out int offset)
+        {
+            if (decodeFailure is not null)
+            {
+                throw decodeFailure();
+            }
+
+            if (failedDecodeOffset is int unsafeOffset)
+            {
+                offset = unsafeOffset;
+                return false;
+            }
+
+            offset = 0;
+            return true;
+        }
+    }
