        },
        {
          "name": "global-admin-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "global_admin",
            "claim.name": "global_admin",
            "jsonType.label": "boolean",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "current-tenant-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "current-tenant",
            "claim.name": "eventstore:current-tenant",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "eventstore",
      "name": "Hexalith EventStore workload",
      "description": "Service-account workload client: short-lived assertions proving EventStore to domain services (Story 5.5). Grants no audience or operation by default; each token is requested for one audience scope and one operation scope.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HEXALITH_EVENTSTORE_WORKLOAD_CLIENT_SECRET}",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "attributes": {
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": [
        "eventstore-audience.sample",
        "eventstore-audience.tenants",
        "eventstore-operation.domain-service.process",
        "eventstore-operation.domain-service.replay-state",
        "eventstore-operation.domain-service.query",
        "eventstore-operation.domain-service.project",
        "eventstore-operation.domain-service.metadata"
