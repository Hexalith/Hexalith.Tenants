@using Microsoft.AspNetCore.Components.Authorization
@inject IStringLocalizer<TenantsResources> Localizer

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <FcPageLayout Mode="FcPageLayoutMode.FullWidth">
                        <FluentMessageBar Intent="MessageBarIntent.Warning"
                                          Title="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                                          data-testid="tenants-route-unavailable">
                            @Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Message"]
                        </FluentMessageBar>
                    </FcPageLayout>
                </NotAuthorized>
                <Authorizing>
                    <FcPageLayout Mode="FcPageLayoutMode.FullWidth">
                        <FluentMessageBar Intent="MessageBarIntent.Info"
                                          Title="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                                          data-testid="tenants-route-authorizing" />
                    </FcPageLayout>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
