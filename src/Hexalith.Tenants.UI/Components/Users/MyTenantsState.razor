@using Hexalith.Tenants.UI.State.UserTenants
@inject IStringLocalizer<TenantsResources> Localizer

<section class="my-tenants-state my-tenants-state--@CssClass"
         role="@Role"
         aria-live="@AriaLive"
         data-testid="@TestId">
    <h2>@Localizer[$"{ResourcePrefix}.State.{ResourceName}.Title"]</h2>
    <p>@Localizer[$"{ResourcePrefix}.State.{ResourceName}.Message"]</p>
    @if (Kind is UserTenantMembershipSurfaceKind.Stale or UserTenantMembershipSurfaceKind.Degraded)
    {
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="@($"{SelectorPrefix}-state-refresh")" OnClick="OnRefresh">
            @Localizer[$"{ResourcePrefix}.Refresh"]
        </FluentButton>
    }
</section>

@code {
    [Parameter]
    public UserTenantMembershipSurfaceKind Kind { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public string ResourcePrefix { get; set; } = "Tenants.MyTenants";

    [Parameter]
    public string SelectorPrefix { get; set; } = "tenants-my";

    private string ResourceName => Kind switch
    {
        UserTenantMembershipSurfaceKind.Loading => "Loading",
        UserTenantMembershipSurfaceKind.Empty => "Empty",
        UserTenantMembershipSurfaceKind.Invalid => "Invalid",
        UserTenantMembershipSurfaceKind.Stale => "Stale",
        UserTenantMembershipSurfaceKind.Degraded => "Degraded",
        UserTenantMembershipSurfaceKind.Unauthorized => "Unauthorized",
        UserTenantMembershipSurfaceKind.Unavailable => "Unavailable",
        _ => "Unavailable",
    };

    private string TestId => Kind switch
    {
        UserTenantMembershipSurfaceKind.Loading => $"{SelectorPrefix}-loading",
        UserTenantMembershipSurfaceKind.Empty => $"{SelectorPrefix}-empty",
        UserTenantMembershipSurfaceKind.Stale => $"{SelectorPrefix}-stale",
        UserTenantMembershipSurfaceKind.Degraded => $"{SelectorPrefix}-degraded",
        UserTenantMembershipSurfaceKind.Invalid => $"{SelectorPrefix}-invalid",
        UserTenantMembershipSurfaceKind.Unauthorized => $"{SelectorPrefix}-error",
        UserTenantMembershipSurfaceKind.Unavailable => $"{SelectorPrefix}-error",
        _ => $"{SelectorPrefix}-error",
    };

    private string CssClass => ResourceName.ToLowerInvariant();

    private string Role => Kind is UserTenantMembershipSurfaceKind.Invalid
        or UserTenantMembershipSurfaceKind.Unauthorized
        or UserTenantMembershipSurfaceKind.Unavailable
        or UserTenantMembershipSurfaceKind.Degraded
            ? "alert"
            : "status";

    private string AriaLive => Role == "alert" ? "assertive" : "polite";
}
