@using Hexalith.Tenants.UI.State.UserTenants
@inject IStringLocalizer<TenantsResources> Localizer

<section class="my-tenants-state my-tenants-state--@CssClass"
         role="@Role"
         aria-live="@AriaLive"
         data-testid="@TestId">
    <h2>@Localizer[$"Tenants.MyTenants.State.{ResourceName}.Title"]</h2>
    <p>@Localizer[$"Tenants.MyTenants.State.{ResourceName}.Message"]</p>
    @if (Kind is UserTenantMembershipSurfaceKind.Stale or UserTenantMembershipSurfaceKind.Degraded)
    {
        <button type="button" data-testid="tenants-my-state-refresh" @onclick="OnRefresh">
            @Localizer["Tenants.MyTenants.Refresh"]
        </button>
    }
</section>

@code {
    [Parameter]
    public UserTenantMembershipSurfaceKind Kind { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private string ResourceName => Kind switch
    {
        UserTenantMembershipSurfaceKind.Loading => "Loading",
        UserTenantMembershipSurfaceKind.Empty => "Empty",
        UserTenantMembershipSurfaceKind.Stale => "Stale",
        UserTenantMembershipSurfaceKind.Degraded => "Degraded",
        UserTenantMembershipSurfaceKind.Unauthorized => "Unauthorized",
        UserTenantMembershipSurfaceKind.Unavailable => "Unavailable",
        _ => "Unavailable",
    };

    private string TestId => Kind switch
    {
        UserTenantMembershipSurfaceKind.Loading => "tenants-my-loading",
        UserTenantMembershipSurfaceKind.Empty => "tenants-my-empty",
        UserTenantMembershipSurfaceKind.Stale => "tenants-my-stale",
        UserTenantMembershipSurfaceKind.Degraded => "tenants-my-degraded",
        UserTenantMembershipSurfaceKind.Unauthorized => "tenants-my-error",
        UserTenantMembershipSurfaceKind.Unavailable => "tenants-my-error",
        _ => "tenants-my-error",
    };

    private string CssClass => ResourceName.ToLowerInvariant();

    private string Role => Kind is UserTenantMembershipSurfaceKind.Unauthorized or UserTenantMembershipSurfaceKind.Unavailable ? "alert" : "status";

    private string AriaLive => Role == "alert" ? "assertive" : "polite";
}
