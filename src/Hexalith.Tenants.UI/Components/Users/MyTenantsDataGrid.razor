@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.UI.State.UserTenants
@inject IStringLocalizer<TenantsResources> Localizer

<div class="my-tenants-grid" data-testid="@($"{SelectorPrefix}-list")">
    <FluentDataGrid Items="@Rows.AsQueryable()"
                    ResizableColumns="true"
                    ReorderableColumns="false"
                    GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                    ItemKey="@(row => row.TenantId)">
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Tenant"]"
                        ColumnId="tenant-id"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--identity")"
                        Width="240px"
                        Pin="DataGridColumnPin.Start">
            <div class="my-tenants-grid__identity"
                 data-testid="@($"{SelectorPrefix}-row")">
                <div class="my-tenants-grid__identity-line">
                    <strong data-testid="@($"{SelectorPrefix}-tenant-id")">@context.TenantId</strong>
                    <SupportSafeCopyButton Value="@context.TenantId"
                                           ValueKind="SupportSafeCopyValueKind.TenantId"
                                           AccessibleName="@Localizer["Tenants.Copy.Label.TenantId", context.TenantId]"
                                           TestId="@($"{SelectorPrefix}-copy-reference")" />
                </div>
                <span>@context.Name</span>
            </div>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Role"]"
                        ColumnId="tenant-role"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--role")"
                        Width="165px"
                        Pin="DataGridColumnPin.Start">
            <FluentBadge Appearance="BadgeAppearance.Tint"
                         Color="@RoleBadgeColor(context.Role)"
                         IconStart="@RoleIcon(context.Role)"
                         Class="@($"my-tenants-grid__badge my-tenants-grid__badge--role-{RoleCss(context.Role)}")"
                         aria-label="@Localizer[$"{ResourcePrefix}.RoleAccessible", RoleLabel(context.Role)]"
                         data-testid="@($"{SelectorPrefix}-role")">
                @RoleLabel(context.Role)
            </FluentBadge>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Status"]"
                        ColumnId="tenant-status"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--status")"
                        Width="150px">
            <FluentBadge Appearance="BadgeAppearance.Tint"
                         Color="@StatusBadgeColor(context.Status)"
                         IconStart="@StatusIcon(context.Status)"
                         Class="@($"my-tenants-grid__badge my-tenants-grid__badge--status-{StatusCss(context.Status)}")"
                         aria-label="@Localizer[$"{ResourcePrefix}.StatusAccessible", StatusLabel(context.Status)]"
                         data-testid="@($"{SelectorPrefix}-status")">
                @StatusLabel(context.Status)
            </FluentBadge>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Lifecycle"]"
                        ColumnId="tenant-lifecycle"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--lifecycle")"
                        Width="160px">
            @Localizer[$"{ResourcePrefix}.Lifecycle.FromStatus", StatusLabel(context.Status)]
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Freshness"]"
                        ColumnId="tenant-freshness"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--freshness")"
                        Width="170px">
            <TruthStateBadge Freshness="@context.Freshness"
                             TestId="@($"{SelectorPrefix}-truth-state")"
                             ResourcePrefix="@ResourcePrefix" />
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.List.Column.Audit"]" ColumnId="tenant-audit" Width="175px">
            <AuditEvidenceEntryPoint TenantId="@context.TenantId"
                                     TargetUserId="@TargetUserId"
                                     SourceKind="@SourceKind"
                                     SourceTestId="@AuditTestId"
                                     Label="@Localizer["Tenants.Audit.EntryPoint.Label"]"
                                     AccessibleName="@AuditAccessibleName(context)"
                                     ReturnUrl="@ReturnUrl"
                                     ReturnFocus="@($"{SelectorPrefix}-row-{context.TenantId}")" />
        </TemplateColumn>
    </FluentDataGrid>
</div>

@code {
    [Parameter]
    public IReadOnlyList<UserTenantMembershipRow> Rows { get; set; } = [];

    [Parameter]
    public string ResourcePrefix { get; set; } = "Tenants.MyTenants";

    [Parameter]
    public string SelectorPrefix { get; set; } = "tenants-my";

    [Parameter]
    public string? TargetUserId { get; set; }

    [Parameter]
    public string? ReturnUrl { get; set; }

    [Parameter]
    public string SourceKind { get; set; } = "my-tenants";

    private string AuditTestId
        => SelectorPrefix == "tenants-user" ? "tenants-user-audit-entrypoint" : "tenants-my-audit-entrypoint";

    private string AuditAccessibleName(UserTenantMembershipRow row)
        => !string.IsNullOrWhiteSpace(TargetUserId)
            ? Localizer["Tenants.UserLookup.AuditAccessibleLabel", TargetUserId, row.TenantId]
            : Localizer["Tenants.MyTenants.AuditAccessibleLabel", row.TenantId];

    private string RoleLabel(TenantRole role)
        => Localizer[$"{ResourcePrefix}.Role.{role}"];

    private string StatusLabel(TenantStatus status)
        => Localizer[$"{ResourcePrefix}.Status.{status}"];

    private static string RoleCss(TenantRole role)
        => role.ToString().ToLowerInvariant();

    private static string StatusCss(TenantStatus status)
        => status.ToString().ToLowerInvariant();

    private static BadgeColor RoleBadgeColor(TenantRole role)
        => role switch
        {
            TenantRole.TenantOwner => BadgeColor.Brand,
            TenantRole.TenantContributor => BadgeColor.Informative,
            TenantRole.TenantReader => BadgeColor.Subtle,
            _ => BadgeColor.Subtle,
        };

    private static Icon RoleIcon(TenantRole role)
        => role switch
        {
            TenantRole.TenantOwner => FcFluentIcons.Star16(),
            TenantRole.TenantContributor => FcFluentIcons.Edit16(),
            TenantRole.TenantReader => FcFluentIcons.Eye16(),
            _ => FcFluentIcons.QuestionCircle16(),
        };

    private static BadgeColor StatusBadgeColor(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => BadgeColor.Success,
            TenantStatus.Disabled => BadgeColor.Danger,
            _ => BadgeColor.Subtle,
        };

    private static Icon StatusIcon(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => FcFluentIcons.Checkmark16(),
            TenantStatus.Disabled => FcFluentIcons.SubtractCircle16(),
            _ => FcFluentIcons.QuestionCircle16(),
        };
}
