@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.UI.State.UserTenants
@inject IStringLocalizer<TenantsResources> Localizer

<div class="my-tenants-grid" data-testid="@($"{SelectorPrefix}-list")">
    <FluentDataGrid Items="@Rows.AsQueryable()"
                    ResizableColumns="true"
                    ReorderableColumns="false"
                    GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                    ItemKey="@(row => row.TenantId)">
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Tenant"]"
                        ColumnId="tenant-id"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--identity")"
                        Width="240px"
                        Pin="DataGridColumnPin.Start">
            <div class="my-tenants-grid__identity"
                 data-testid="@($"{SelectorPrefix}-row")">
                <strong data-testid="@($"{SelectorPrefix}-tenant-id")">@context.TenantId</strong>
                <span>@context.Name</span>
            </div>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Role"]"
                        ColumnId="tenant-role"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--role")"
                        Width="165px"
                        Pin="DataGridColumnPin.Start">
            <span class="my-tenants-grid__badge my-tenants-grid__badge--role-@RoleCss(context.Role)"
                  aria-label="@Localizer[$"{ResourcePrefix}.RoleAccessible", RoleLabel(context.Role)]"
                  data-testid="@($"{SelectorPrefix}-role")">
                <span aria-hidden="true">@RoleIcon(context.Role)</span>
                <span>@RoleLabel(context.Role)</span>
            </span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Status"]"
                        ColumnId="tenant-status"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--status")"
                        Width="150px">
            <span class="my-tenants-grid__badge my-tenants-grid__badge--status-@StatusCss(context.Status)"
                  aria-label="@Localizer[$"{ResourcePrefix}.StatusAccessible", StatusLabel(context.Status)]"
                  data-testid="@($"{SelectorPrefix}-status")">
                <span aria-hidden="true">@StatusIcon(context.Status)</span>
                <span>@StatusLabel(context.Status)</span>
            </span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Lifecycle"]"
                        ColumnId="tenant-lifecycle"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--lifecycle")"
                        Width="160px">
            @Localizer[$"{ResourcePrefix}.Lifecycle.FromStatus", StatusLabel(context.Status)]
        </TemplateColumn>
        <TemplateColumn Title="@Localizer[$"{ResourcePrefix}.Column.Freshness"]"
                        ColumnId="tenant-freshness"
                        Class="@($"{SelectorPrefix}-critical {SelectorPrefix}-critical--freshness")"
                        Width="170px">
            <TruthStateBadge Freshness="@context.Freshness"
                             TestId="@($"{SelectorPrefix}-truth-state")"
                             ResourcePrefix="@ResourcePrefix" />
        </TemplateColumn>
    </FluentDataGrid>
</div>

@code {
    [Parameter]
    public IReadOnlyList<UserTenantMembershipRow> Rows { get; set; } = [];

    [Parameter]
    public string ResourcePrefix { get; set; } = "Tenants.MyTenants";

    [Parameter]
    public string SelectorPrefix { get; set; } = "tenants-my";

    private string RoleLabel(TenantRole role)
        => Localizer[$"{ResourcePrefix}.Role.{role}"];

    private string StatusLabel(TenantStatus status)
        => Localizer[$"{ResourcePrefix}.Status.{status}"];

    private static string RoleCss(TenantRole role)
        => role.ToString().ToLowerInvariant();

    private static string StatusCss(TenantStatus status)
        => status.ToString().ToLowerInvariant();

    private static string RoleIcon(TenantRole role)
        => role switch
        {
            TenantRole.TenantOwner => "O",
            TenantRole.TenantContributor => "C",
            TenantRole.TenantReader => "R",
            _ => "?",
        };

    private static string StatusIcon(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => "OK",
            TenantStatus.Disabled => "!",
            _ => "?",
        };
}
