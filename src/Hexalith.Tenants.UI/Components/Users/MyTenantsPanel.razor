@using Hexalith.Tenants.UI.Components.Users
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject NavigationManager Navigation

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20px" Class="my-tenants-page" data-testid="tenants-my-page">
    @if (ShowBackLink)
    {
        <FluentStack Orientation="Orientation.Horizontal" Class="my-tenants-page__breadcrumb">
            <FluentAnchorButton Href="@BackHref"
                                Appearance="ButtonAppearance.Subtle"
                                data-testid="tenants-my-back">
                @Localizer["Tenants.MyTenants.Back"]
            </FluentAnchorButton>
        </FluentStack>
    }

    <FluentStack Orientation="Orientation.Horizontal"
                 HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="16px"
                 VerticalGap="12px"
                 Wrap="true"
                 Class="my-tenants-page__toolbar"
                 aria-label="@Localizer["Tenants.MyTenants.ControlsLabel"]">
        <FluentText As="TextTag.Paragraph"
                    Size="TextSize.Size200"
                    Color="Color.Lightweight"
                    Class="my-tenants-page__summary"
                    aria-live="polite"
                    data-testid="tenants-my-summary">
            @SummaryText
        </FluentText>
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-my-refresh" OnClick="RefreshAsync">
            @Localizer["Tenants.MyTenants.Refresh"]
        </FluentButton>
    </FluentStack>

    @if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Loading)
    {
        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Loading" />
    }
    else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Empty)
    {
        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Empty" />
    }
    else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Invalid)
    {
        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Invalid" />
    }
    else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Unauthorized)
    {
        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Unauthorized" />
    }
    else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Unavailable)
    {
        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Unavailable" />
    }
    else
    {
        @if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Stale)
        {
            <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Stale" OnRefresh="RefreshAsync" />
        }
        else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Degraded)
        {
            <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Degraded" OnRefresh="RefreshAsync" />
        }

        <MyTenantsDataGrid Rows="@_snapshot.Rows" DetailHref="DetailHrefFor" ReturnUrl="@EffectiveReturnUrl" />

        <nav class="my-tenants-page__pager" aria-label="@Localizer["Tenants.MyTenants.PaginationLabel"]" data-testid="tenants-my-pager">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="12px" Wrap="true">
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-my-previous" Disabled="@(_cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                    @Localizer["Tenants.MyTenants.Previous"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-my-next" Disabled="@(!_snapshot.HasMore)" OnClick="NextPageAsync">
                    @Localizer["Tenants.MyTenants.Next"]
                </FluentButton>
            </FluentStack>
        </nav>
    }
</FluentStack>

@code {
    private UserTenantMembershipSnapshot _snapshot = UserTenantMembershipSnapshot.Loading();
    private readonly Stack<string?> _cursorHistory = new();
    private bool _parametersInitialized;
    private long _loadVersion;
    private string? _currentCursor;

    [Parameter]
    public bool ShowBackLink { get; set; }

    [Parameter]
    public string BackHref { get; set; } = "/tenants";

    [Parameter]
    public string? InitialCursor { get; set; }

    [Parameter]
    public string? ReturnUrl { get; set; }

    private string EffectiveReturnUrl
        => string.IsNullOrWhiteSpace(ReturnUrl) ? BuildReturnUrl() : ReturnUrl;

    private string? SummaryText => _snapshot.Kind is UserTenantMembershipSurfaceKind.Ready
        or UserTenantMembershipSurfaceKind.Stale
        or UserTenantMembershipSurfaceKind.Degraded
            ? Localizer["Tenants.MyTenants.Summary", _snapshot.Rows.Count].Value
            : null;

    protected override async Task OnParametersSetAsync()
    {
        string? incomingCursor = TenantWorkspaceState.NormalizeCursor(InitialCursor);
        if (_parametersInitialized && string.Equals(incomingCursor, _currentCursor, StringComparison.Ordinal))
        {
            return;
        }

        _parametersInitialized = true;
        System.Threading.Interlocked.Increment(ref _loadVersion);
        _currentCursor = incomingCursor;
        _cursorHistory.Clear();
        if (!string.IsNullOrWhiteSpace(_currentCursor))
        {
            // Deep-link / audit-return at a non-first cursor: seed history with null so "Previous" returns
            // to page 1 instead of being permanently disabled.
            _cursorHistory.Push(null);
        }

        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task LoadAsync(bool reuseETag, bool retainConfirmed = false)
    {
        // Invalidate any in-flight load so a slower earlier response cannot overwrite a newer snapshot
        // (Refresh/paging call the gateway with no cancellation token).
        long loadVersion = System.Threading.Interlocked.Increment(ref _loadVersion);
        UserTenantMembershipSnapshot previous = _snapshot;
        if (!retainConfirmed)
        {
            _snapshot = UserTenantMembershipSnapshot.Loading();
        }

        UserTenantMembershipRequest request = new(
            Cursor: _currentCursor,
            PageSize: 20,
            ETag: reuseETag ? previous.ETag : null);

        UserTenantMembershipSnapshot snapshot = await QueryGateway
            .GetMyTenantsAsync(request, previous, CancellationToken.None)
            .ConfigureAwait(false);

        await InvokeAsync(() =>
        {
            if (loadVersion == _loadVersion)
            {
                _snapshot = snapshot;
            }
        }).ConfigureAwait(false);
    }

    private async Task RefreshAsync()
        => await LoadAsync(reuseETag: true).ConfigureAwait(false);

    private async Task NextPageAsync()
    {
        _cursorHistory.Push(_currentCursor);
        _currentCursor = _snapshot.NextCursor;
        await InvokeAsync(() => Navigation.NavigateTo(BuildReturnUrl(), replace: true)).ConfigureAwait(false);
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task PreviousPageAsync()
    {
        if (_cursorHistory.Count > 0)
        {
            _currentCursor = _cursorHistory.Pop();
            await InvokeAsync(() => Navigation.NavigateTo(BuildReturnUrl(), replace: true)).ConfigureAwait(false);
            await LoadAsync(reuseETag: false).ConfigureAwait(false);
        }
    }

    private string BuildReturnUrl()
        => MyTenantsWorkspaceState().ToCanonicalUrl();

    // Builds the shared /tenants/{tenantId} detail drill-in for a self-audit row, reusing the scope=all
    // navigation mechanism. The return URL carries scope=mine plus the selection and a return-focus anchor
    // that matches this row's element id; the cursor is reset so return lands on the authorized first page
    // (mirroring the scope=all list detail behavior), where the workspace shows the return-context banner
    // and restores focus to the heading.
    private string DetailHrefFor(UserTenantMembershipRow row)
        => new TenantListNavigationContext(MyTenantsWorkspaceState())
            .ToDetailUrl(row.TenantId, $"tenants-my-row-{row.TenantId}");

    private TenantWorkspaceState MyTenantsWorkspaceState()
        => TenantWorkspaceState.FromQuery(
            TenantWorkspaceState.TenantsTab,
            TenantWorkspaceState.MyScope,
            userId: null,
            search: null,
            status: null,
            sort: null,
            sortDescending: null,
            _currentCursor,
            selectedTenantId: null,
            anchor: null);
}
