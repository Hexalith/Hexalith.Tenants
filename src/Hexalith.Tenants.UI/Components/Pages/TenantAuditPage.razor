@page "/tenants/{TenantId}/audit"
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.EventStore.Client.Gateway
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject ITenantsBffComposition BffComposition
@inject IJSRuntime JS
@inject IServiceProvider Services

<FcPageLayout Mode="FcPageLayoutMode.FullWidth">
    <FluentStack Orientation="Orientation.Vertical"
                 VerticalGap="16px"
                 Class="tenant-audit"
                 data-testid="tenants-audit-surface"
                 aria-labelledby="tenant-audit-heading">
    <FcPageHeader PageTitle="@Localizer["Tenants.Audit.Title", TenantDisplayName]"
                  Heading="@Localizer["Tenants.Audit.Title", TenantDisplayName]"
                  HeadingId="tenant-audit-heading"
                  Eyebrow="@Localizer["Tenants.Audit.Eyebrow"]"
                  Description="@Localizer["Tenants.Audit.Description"]"
                  TestId="tenants-audit-page-header">
        <Metadata>
        @if (HasContext)
        {
            <p class="tenant-audit__context"
               data-testid="tenants-audit-context"
               aria-live="@ContextLiveRegion">
                @ContextText
            </p>
        }
        @if (!string.IsNullOrWhiteSpace(ReturnFocus))
        {
            <p class="tenant-audit__return-context" data-testid="tenants-audit-return-context">
                @Localizer["Tenants.Audit.ReturnContext", ReturnFocus]
            </p>
        }
        </Metadata>
        <Actions>
            <a class="tenant-audit__back" href="@BackHref" data-testid="tenants-audit-back">@Localizer["Tenants.Audit.Back"]</a>
        </Actions>
    </FcPageHeader>

    <FluentAccordion Class="tenant-audit__support"
                     ExpandMode="AccordionExpandMode.Multi"
                     Block="true">
        <FluentAccordionItem Header="@Localizer["Tenants.Audit.ControlsLabel"]"
                             Expanded="true">
            <section class="tenant-audit__controls" aria-label="@Localizer["Tenants.Audit.ControlsLabel"]">
                <FluentGrid Spacing="3" Class="tenant-audit__controls-layout">
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        @* Fluent v5's TextInputType enum has no datetime-local member, so the native datetime-local
                           picker is requested with a splatted type attribute on the FluentTextInput. The bound value
                           stays a string and is interpreted as UTC by ParseDate, preserving the existing range logic. *@
                        <FluentTextInput Value="@_fromText"
                                         ValueChanged="OnFromChanged"
                                         Label="@Localizer["Tenants.Audit.Filter.From"]"
                                         type="datetime-local"
                                         data-testid="tenants-audit-filter-from"
                                         aria-label="@Localizer["Tenants.Audit.Filter.From"]" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        <FluentTextInput Value="@_toText"
                                         ValueChanged="OnToChanged"
                                         Label="@Localizer["Tenants.Audit.Filter.To"]"
                                         type="datetime-local"
                                         data-testid="tenants-audit-filter-to"
                                         aria-label="@Localizer["Tenants.Audit.Filter.To"]" />
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        <FluentSelect TOption="string" TValue="string"
                                      Value="@_categoryText"
                                      ValueChanged="OnCategoryChanged"
                                      Label="@Localizer["Tenants.Audit.Filter.Category"]"
                                      data-testid="tenants-audit-filter-category"
                                      aria-label="@Localizer["Tenants.Audit.Filter.Category"]">
                            <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.Audit.Filter.Category.All"]</FluentOption>
                            <FluentOption TValue="string" Value="@AuditEventCategory.Access.ToString()">@Localizer["Tenants.Audit.Category.Access"]</FluentOption>
                            <FluentOption TValue="string" Value="@AuditEventCategory.Administrative.ToString()">@Localizer["Tenants.Audit.Category.Administrative"]</FluentOption>
                        </FluentSelect>
                    </FluentGridItem>
                    <FluentGridItem Xs="12" Md="6" Lg="3">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalGap="12px" Wrap="true">
                            <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-audit-refresh" OnClick="RefreshAsync">
                                @Localizer["Tenants.Audit.Refresh"]
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-audit-reset" OnClick="ResetFiltersAsync">
                                @Localizer["Tenants.Audit.Reset"]
                            </FluentButton>
                        </FluentStack>
                    </FluentGridItem>
                </FluentGrid>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@Localizer[$"Tenants.Audit.State.{ResourceState}.Title"]"
                             Expanded="true">
            <section class="tenant-audit__state tenant-audit__state--@ResourceState.ToLowerInvariant()"
                     role="@StatusRole"
                     aria-live="@StatusLive"
                     tabindex="0"
                     data-testid="@StateTestId">
                <span class="tenant-audit__state-icon" aria-hidden="true">@StateIcon</span>
                <div class="tenant-audit__state-copy">
                    <h2>@Localizer[$"Tenants.Audit.State.{ResourceState}.Title"]</h2>
                    <p data-testid="tenants-audit-live-region">@Localizer[$"Tenants.Audit.State.{ResourceState}.Message"]</p>
                </div>
            </section>
            @* Lifecycle evidence is a sibling of the state section, not a child. StatusRole/StatusLive
               resolve to alert/assertive for non-Ready states; nesting the badge re-announced the whole
               state block. The wrapper owns polite/alert escalation for Unavailable. *@
            <ProjectionLifecycleStatus Lifecycle="@_snapshot.Lifecycle"
                                       TestId="tenants-audit-projection-lifecycle-status"
                                       BadgeTestId="tenants-audit-projection-lifecycle-status-badge" />
            @* Rendered as a sibling of the state section, not a child. StatusRole/StatusLive resolve to
               alert/assertive for the non-Ready states, and inserting or removing a child mutates that
               region's own subtree -- so every projection nudge re-announced the whole state block
               assertively and interrupted the screen-reader user. The nudge is a polite, non-authoritative
               signal and must own its live region. *@
            @if (_isNotificationRefreshing)
            {
                <p class="tenant-audit__nudge" role="status" aria-live="polite" data-testid="tenants-audit-notification-refreshing">
                    @Localizer["Tenants.Audit.Freshness.Refreshing"]
                </p>
            }
        </FluentAccordionItem>
    </FluentAccordion>

    @if (ShouldRenderRows)
    {
        <section class="tenant-audit__grid-shell" aria-labelledby="tenant-audit-grid-heading">
            <h2 id="tenant-audit-grid-heading">@Localizer["Tenants.Audit.GridTitle"]</h2>
            <AuditDataGrid Rows="@_snapshot.Rows"
                           OnOpenReceipt="OpenReceiptAsync"
                           CorrectionIntentProvider="CreateCorrectionIntent"
                           OnRoleSelected="SelectCorrectionRoleAsync"
                           OnStartCorrection="OpenCorrectionAsync" />
            @if (_selectedReceipt is not null)
            {
                <AuditEvidenceReceipt Receipt="@_selectedReceipt"
                                      CorrectionIntent="@_selectedReceiptCorrectionIntent"
                                      OnStartCorrection="OpenCorrectionAsync"
                                      OnRetry="RefreshAsync"
                                      OnClose="CloseReceiptAsync" />
            }
            @if (_activeCorrectionIntent is not null)
            {
                @if (_activeCorrectionIntent.IntendedCommandDomain is TenantCorrectionCommandDomain.GlobalAdministrators)
                {
                    <GlobalAdministratorCorrectionPanel Intent="@_activeCorrectionIntent"
                                                        CurrentProjection="@_globalAdministratorsSnapshot"
                                                        ProjectionRefreshProvider="RefreshGlobalAdministratorsProjectionAsync"
                                                        OnClose="CloseCorrectionAsync" />
                }
                else
                {
                    <CorrectionStartPanel Intent="@_activeCorrectionIntent"
                                          CurrentProjection="@_tenantDetailSnapshot?.Detail"
                                          ProjectionRefreshProvider="RefreshTenantProjectionAsync"
                                          OnClose="CloseCorrectionAsync" />
                }
            }
            @if (_pagingJumpedToFirstPage)
            {
                <p role="status" aria-live="polite" data-testid="tenants-audit-history-truncated">
                    @Localizer["Tenants.Audit.Recovery.HistoryTruncated"]
                </p>
            }
            <nav class="tenant-audit__pager" aria-label="@Localizer["Tenants.Audit.PaginationLabel"]">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-audit-previous" Disabled="@(_pageLoadInFlight || _cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                        @Localizer["Tenants.Audit.Previous"]
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-audit-next" Disabled="@(_pageLoadInFlight || !_snapshot.HasMore)" OnClick="NextPageAsync">
                        @Localizer["Tenants.Audit.Next"]
                    </FluentButton>
                </FluentStack>
            </nav>
        </section>
    }
    </FluentStack>
</FcPageLayout>

@code {
    private const string FocusModulePath = "./js/tenantsFocus.js";
    private const int PageSize = 50;
    /// <summary>Upper bound on retained paging history.</summary>
    private const int MaximumCursorHistory = CursorHistory.DefaultMaximum;

    private readonly Stack<string?> _cursorHistory = new();

    // Set when CursorHistory.Trim drops entries, cleared when the resulting jump has been announced. The
    // trim re-appends the first-page sentinel beneath the newest entries, so one later Previous click moves
    // the operator from the middle of the sequence to page one -- which the pager would otherwise render as
    // an ordinary one-page step back.
    private bool _pagingHistoryTruncated;
    private bool _pagingJumpedToFirstPage;
    private TenantAuditSnapshot _snapshot = TenantAuditSnapshot.Loading();
    private string? _currentCursor;
    private string? _fromText;
    private string? _toText;
    private string? _categoryText;
    private TenantAuditReceipt? _selectedReceipt;
    private TenantCorrectionStartIntent? _selectedReceiptCorrectionIntent;
    private TenantCorrectionStartIntent? _activeCorrectionIntent;
    private int _correctionOpenGeneration;
    private TenantDetailSnapshot? _tenantDetailSnapshot;
    private GlobalAdministratorsSnapshot? _globalAdministratorsSnapshot;
    private IAsyncDisposable? _readRefreshLease;
    private string? _loadedTenantId;
    private string? _subscriptionTenantId;
    private bool _readRefreshSubscriptionInFlight;
    private string? _pendingSubscriptionTenantId;
    private readonly Lock _readRefreshSubscriptionLock = new();
    private bool _isNotificationRefreshing;
    private bool _pageLoadInFlight;
    private bool _disposed;
    private long _loadGeneration;
    private CancellationTokenSource? _loadCancellation;
    // Serialises the active-cancellation swap. A superseded source is cancelled immediately -- which is what
    // callers observe -- but NOT disposed there: disposing one at the moment it is replaced races the
    // request still inside SendAsync, where a CancellationToken.Register after Dispose throws
    // ObjectDisposedException, which is not an OperationCanceledException and so slips past every caller's
    // cancellation-only handler. Disposal is owned solely by CompleteCancellation, which the owning
    // PendingOperation calls when its operation finishes. A prior version also tracked superseded sources in
    // a List; nothing ever read it, so it is removed rather than left to read as a retention mechanism.
    private readonly Lock _cancellationLock = new();
    private readonly Dictionary<string, TenantRole> _selectedCorrectionRoles = new(StringComparer.Ordinal);
    private IJSObjectReference? _focusModule;
    private string? _activeCorrectionFocusReference;
    private string? _pendingCorrectionFocusReference;

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "targetUserId")]
    public string? TargetUserId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "supportSafeCommandReference")]
    public string? SupportSafeCommandReference { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnFocus")]
    public string? ReturnFocus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "source")]
    public string? SourceKind { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "receiptReference")]
    public string? ReceiptReference { get; set; }

    private string BackHref
        => IsSafeReturnUrl(ReturnUrl) ? ReturnUrl! : $"/tenants/{Uri.EscapeDataString(TenantId)}";

    // A blank/whitespace TenantId would render a dangling "Audit trail for " heading. Substitute a
    // localized fallback so the page header always reads as a complete phrase (cosmetic, not a crash fix).
    private string TenantDisplayName
        => string.IsNullOrWhiteSpace(TenantId) ? Localizer["Tenants.Audit.UnknownTenant"].Value : TenantId;

    private bool HasContext
        => !string.IsNullOrWhiteSpace(TargetUserId)
            || !string.IsNullOrWhiteSpace(SupportSafeCommandReference)
            || !string.IsNullOrWhiteSpace(SourceKind);

    // Context restoration is informational, never a blocking state, so it is always polite.
    private string ContextLiveRegion
        => "polite";

    private string ContextText
        => !string.IsNullOrWhiteSpace(TargetUserId)
            ? Localizer["Tenants.Audit.Context.User", TargetUserId]
            : !string.IsNullOrWhiteSpace(SupportSafeCommandReference)
                ? Localizer["Tenants.Audit.Context.Command", SupportSafeCommandReference]
                : Localizer["Tenants.Audit.Context.Source", SourceLabel];

    // Resolve the machine source kind to a localized whole phrase so raw tokens never reach visible copy.
    private string SourceLabel
        => SourceKind switch
        {
            "tenant-list" => Localizer["Tenants.Audit.Context.SourceKind.TenantList"],
            "tenant-detail" => Localizer["Tenants.Audit.Context.SourceKind.TenantDetail"],
            "member-row" => Localizer["Tenants.Audit.Context.SourceKind.MemberRow"],
            "user-lookup" => Localizer["Tenants.Audit.Context.SourceKind.UserLookup"],
            "my-tenants" => Localizer["Tenants.Audit.Context.SourceKind.MyTenants"],
            "command-result" => Localizer["Tenants.Audit.Context.SourceKind.CommandResult"],
            _ => Localizer["Tenants.Audit.Context.SourceKind.Default"],
        };

    private bool ShouldRenderRows
        => (_snapshot.Kind is TenantAuditSurfaceKind.Ready
            or TenantAuditSurfaceKind.Stale
            or TenantAuditSurfaceKind.Degraded
            or TenantAuditSurfaceKind.ListRefreshed)
            && _snapshot.Rows.Count > 0;

    private string ResourceState => _snapshot.Kind switch
    {
        TenantAuditSurfaceKind.Loading => "Loading",
        TenantAuditSurfaceKind.Ready => "Ready",
        TenantAuditSurfaceKind.Empty => "Empty",
        TenantAuditSurfaceKind.FilteredEmpty => "FilteredEmpty",
        TenantAuditSurfaceKind.Stale => "Stale",
        TenantAuditSurfaceKind.Degraded => "Degraded",
        TenantAuditSurfaceKind.Unauthorized => "Unauthorized",
        TenantAuditSurfaceKind.InvalidCursor => "InvalidCursor",
        TenantAuditSurfaceKind.ListRefreshed => "ListRefreshed",
        TenantAuditSurfaceKind.Unavailable => "Unavailable",
        TenantAuditSurfaceKind.Error => "Error",
        _ => "Error",
    };

    private string StateTestId
        => $"tenants-audit-{TestIdState(ResourceState)}";

    private string StatusRole
        => _snapshot.Kind is TenantAuditSurfaceKind.Unauthorized
            or TenantAuditSurfaceKind.InvalidCursor
            or TenantAuditSurfaceKind.Degraded
            or TenantAuditSurfaceKind.Unavailable
            or TenantAuditSurfaceKind.Error
                ? "alert"
                : "status";

    private string StatusLive => StatusRole == "alert" ? "assertive" : "polite";

    private string StateIcon => _snapshot.Kind switch
    {
        TenantAuditSurfaceKind.Ready => "OK",
        TenantAuditSurfaceKind.Empty => "0",
        TenantAuditSurfaceKind.FilteredEmpty => "0",
        TenantAuditSurfaceKind.Loading => "...",
        TenantAuditSurfaceKind.ListRefreshed => "R",
        TenantAuditSurfaceKind.Stale => "!",
        TenantAuditSurfaceKind.Degraded => "!",
        TenantAuditSurfaceKind.InvalidCursor => "!",
        _ => "?",
    };

    protected override async Task OnParametersSetAsync()
    {
        string tenantId = TenantId;
        bool tenantChanged = !string.Equals(_loadedTenantId, tenantId, StringComparison.Ordinal);
        if (tenantChanged)
        {
            IAsyncDisposable? previousLease = _readRefreshLease;
            _readRefreshLease = null;
            _subscriptionTenantId = null;
            if (previousLease is not null)
            {
                await previousLease.DisposeAsync().ConfigureAwait(false);
            }

            // Marshalled: the lease dispose above is a remote unsubscribe that can genuinely suspend, so
            // this block may run on a thread-pool thread while the render ComponentBase queued for the
            // incomplete task is still in flight. ClearPaging clears _cursorHistory and, critically,
            // _selectedCorrectionRoles -- a plain Dictionary the renderer reads via TryGetValue, which can
            // throw InvalidOperationException on a concurrent mutation and tear down the circuit.
            await InvokeAsync(() =>
            {
                ClearPaging();
                _tenantDetailSnapshot = null;
                _globalAdministratorsSnapshot = null;
                _snapshot = TenantAuditSnapshot.Loading(tenantId);
            }).ConfigureAwait(false);

            // Recorded only once the clear has actually run. Assigning it before the awaited lease dispose
            // let a re-entrant OnParametersSetAsync for the same tenant, arriving while that dispose was
            // suspended, compute tenantChanged == false -- so the conditional read below reused the previous
            // tenant's ETag as its If-None-Match validator and its cursor as the paging position. Before the
            // reuseETag/retainConfirmed change those arguments were unconditionally false, so no cross-tenant
            // validator could leak; now the assignment order is what holds that line.
            _loadedTenantId = tenantId;
        }

        // Only a tenant change may discard the retained validator and blank the grid. The route carries six
        // [SupplyParameterFromQuery] parameters, none of which feed CreateRequest -- it is built from the
        // filter fields (_fromText/_toText/_categoryText) -- so the member "open audit for this user" entry
        // point re-enters here with an unchanged TenantId and an identical request. Re-reading
        // unconditionally discarded the conditional-read validator, reset the grid to Loading and cancelled
        // any in-flight notification or paging load on every such navigation.
        await LoadAsync(
            reuseETag: !tenantChanged,
            retainConfirmed: !tenantChanged,
            requestedTenantId: tenantId).ConfigureAwait(false);
        await EnsureReadRefreshSubscriptionAsync(tenantId).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrWhiteSpace(_pendingCorrectionFocusReference))
        {
            return;
        }

        string focusReference = _pendingCorrectionFocusReference;
        _pendingCorrectionFocusReference = null;

        try
        {
            IJSObjectReference module = _focusModule
                ??= await JS.InvokeAsync<IJSObjectReference>("import", FocusModulePath).ConfigureAwait(false);

            _ = await module
                .InvokeAsync<bool>("focusCorrectionLauncher", focusReference)
                .ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; focus return is no longer observable.
        }
    }

    private async Task<TenantAuditSnapshot?> LoadAsync(
        bool reuseETag,
        bool retainConfirmed = false,
        string? requestedTenantId = null,
        string? requestedCursor = null,
        bool useRequestedCursor = false)
    {
        string tenantId = requestedTenantId ?? TenantId;
        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        TenantAuditSnapshot previous = _snapshot;
        if (!retainConfirmed)
        {
            // Marshalled and generation-guarded like every other _snapshot write in this file. Callers reach
            // here from ConfigureAwait(false) continuations, so a manual Refresh or filter change running on
            // the dispatcher could interleave between this call's BeginLoad and this write and have its
            // applied page overwritten with Loading. The sibling global-administrators page guards its
            // equivalent write for the same reason.
            await InvokeAsync(() =>
            {
                if (CanApply(tenantId, generation))
                {
                    _snapshot = TenantAuditSnapshot.Loading(tenantId);
                }
            }).ConfigureAwait(false);
        }

        TenantAuditRequest request = CreateRequest(
            tenantId,
            useRequestedCursor ? requestedCursor : _currentCursor,
            reuseETag ? previous.ETag : null);
        TenantAuditSnapshot result;
        try
        {
            result = await QueryGateway
                .GetTenantAuditAsync(request, previous, cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return null;
        }

        if (!CanApply(tenantId, generation))
        {
            return null;
        }

        // Re-checked inside the dispatcher callback: the CanApply above ran on a thread-pool continuation,
        // so a newer load can win between that check and this write.
        await InvokeAsync(() =>
        {
            if (CanApply(tenantId, generation))
            {
                _snapshot = result;
            }
        }).ConfigureAwait(false);

        // Page-load enrichment only, same contract as the global-administrator refresh below. The gateway
        // rethrows OperationCanceledException unfiltered, so without this handler a Refresh or paging click
        // during the in-flight detail read let the cancellation escape LoadAsync and OnParametersSetAsync
        // and tear down the circuit. The audit list itself has already been applied above.
        try
        {
            await RefreshTenantProjectionForLoadAsync(tenantId, generation, cancellationToken).ConfigureAwait(false);
        }
        catch (Exception ex) when (ex is EventStoreGatewayException or HttpRequestException or JsonException or OperationCanceledException)
        {
            // Supplementary tenant-detail evidence unavailable; the audit page stays usable.
        }

        if (result.Rows.Any(IsGlobalAdministratorRow))
        {
            // Page-load enrichment only: the audit list already rendered. A transport/parse fault that
            // escapes the gateway's EventStoreGatewayException mapping must degrade this supplementary
            // global-administrator evidence, not tear down the audit page. The confirm-time path
            // (OpenCorrectionAsync / the panel ProjectionRefreshProvider) keeps propagating so a correction
            // never silently confirms on a failed read.
            try
            {
                await RefreshGlobalAdministratorsProjectionForLoadAsync(tenantId, generation, cancellationToken).ConfigureAwait(false);
            }
            catch (Exception ex) when (ex is EventStoreGatewayException or HttpRequestException or JsonException or OperationCanceledException)
            {
                // Supplementary evidence unavailable; the audit page stays usable.
            }
        }

        if (!CanApply(tenantId, generation))
        {
            return null;
        }

        // Marshalled for the same reason the _snapshot write above is: these fields are read by
        // NextPageAsync/PreviousPageAsync and ResolveReceiptSelection on the renderer dispatcher, but this
        // continuation runs on a thread-pool thread after ConfigureAwait(false).
        await InvokeAsync(() =>
        {
            if (result.Kind is TenantAuditSurfaceKind.ListRefreshed)
            {
                _cursorHistory.Clear();
                _currentCursor = null;
            }

            ResolveReceiptSelection();
        }).ConfigureAwait(false);
        return result;
    }

    private async Task EnsureReadRefreshSubscriptionAsync(string tenantId)
    {
        // _subscriptionTenantId is only written after the await below, so without an in-flight guard a second
        // OnParametersSetAsync for the same tenant passes the entry check mid-setup, subscribes again and
        // overwrites _readRefreshLease -- orphaning the first lease, whose callback stays registered until
        // the circuit ends.
        if (_disposed
            || string.IsNullOrWhiteSpace(tenantId)
            || !BffComposition.IsReadSurfaceConnected
            || string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal)
            || Services.GetService(typeof(TenantReadRefreshSubscription)) is not TenantReadRefreshSubscription refreshSubscription)
        {
            return;
        }

        // Claim setup and hand a later tenant to the current owner atomically. Clearing a pending target in a
        // finally block used to race a navigation arriving between the owner's last read and that clear,
        // silently losing the newer tenant's subscription request.
        lock (_readRefreshSubscriptionLock)
        {
            if (_disposed || string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal))
            {
                return;
            }

            if (_readRefreshSubscriptionInFlight)
            {
                _pendingSubscriptionTenantId = tenantId;
                return;
            }

            _readRefreshSubscriptionInFlight = true;
        }

        bool released = false;
        try
        {
            string? target = tenantId;
            while (target is not null)
            {
                await SubscribeReadRefreshAsync(refreshSubscription, target).ConfigureAwait(false);
                lock (_readRefreshSubscriptionLock)
                {
                    target = _disposed ? null : _pendingSubscriptionTenantId;
                    _pendingSubscriptionTenantId = null;
                    if (target is not null && string.Equals(_subscriptionTenantId, target, StringComparison.Ordinal))
                    {
                        target = null;
                    }

                    if (target is null)
                    {
                        _readRefreshSubscriptionInFlight = false;
                        released = true;
                    }
                }
            }
        }
        finally
        {
            if (!released)
            {
                lock (_readRefreshSubscriptionLock)
                {
                    _readRefreshSubscriptionInFlight = false;
                }
            }
        }
    }

    private async Task SubscribeReadRefreshAsync(TenantReadRefreshSubscription refreshSubscription, string tenantId)
    {
        {
            // Deliberately NOT _loadCancellation.Token. Subscription setup is independent of any one load:
            // binding it to the load token meant a Refresh during setup cancelled SubscribeAsync, the catch
            // below returned without recording _subscriptionTenantId, and nothing retried for the same
            // tenant -- silently disabling projection auto-refresh for the rest of the circuit. Reading
            // _loadCancellation?.Token here could also throw ObjectDisposedException on a concurrent
            // supersession. The sibling global-administrators page already passes None.
            TenantReadRefreshLease lease;
            try
            {
                lease = await refreshSubscription.SubscribeAsync(
                    GetTenantAuditQuery.ProjectionType,
                    tenantId,
                    () => InvokeAsync(() => RefreshFromNotificationAsync(tenantId)),
                    CancellationToken.None).ConfigureAwait(false);
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch
            {
                // Optional refresh only. A transport fault here must not escape OnParametersSetAsync and
                // tear down the circuit; the surface stays usable through manual and command refresh.
                return;
            }

            if (_disposed || !string.Equals(TenantId, tenantId, StringComparison.Ordinal))
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
                return;
            }

            if (!lease.IsSubscribed)
            {
                // Setup failed and registered no callback. Recording it would satisfy the "already
                // subscribed" guard forever and permanently disable auto-refresh for this circuit.
                return;
            }

            IAsyncDisposable? previousLease = _readRefreshLease;
            _readRefreshLease = lease;
            _subscriptionTenantId = tenantId;
            if (previousLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(previousLease).ConfigureAwait(false);
            }
        }
    }

    /// <summary>Disposes an optional refresh lease without surfacing transport detail.</summary>
    private static async Task DisposeLeaseSupportSafelyAsync(IAsyncDisposable lease)
    {
        try
        {
            await lease.DisposeAsync().ConfigureAwait(false);
        }
        catch
        {
            // Lease cleanup must never disclose transport details or block fail-closed rendering.
        }
    }

    private async Task RefreshAsync()
        => await LoadAsync(reuseETag: true).ConfigureAwait(false);

    private async Task RefreshFromNotificationAsync(string tenantId)
    {
        if (_disposed || !string.Equals(TenantId, tenantId, StringComparison.Ordinal))
        {
            return;
        }

        _isNotificationRefreshing = true;
        StateHasChanged();
        try
        {
            await LoadAsync(reuseETag: true, retainConfirmed: true, requestedTenantId: tenantId).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // Superseded or torn down; the newer load owns the surface.
        }
        catch
        {
            // This runs on a notification callback, not on a render path. An unhandled fault here would
            // escape into the SignalR dispatch loop rather than being rendered, and the nudge is optional
            // anyway -- the last-confirmed rows stay visible and manual refresh still works.
        }
        finally
        {
            // Guard disposal: a notification arriving as the circuit tears down would otherwise call
            // InvokeAsync on a disposed component and throw ObjectDisposedException.
            if (!_disposed)
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        _isNotificationRefreshing = false;
                        StateHasChanged();
                    });
                }
                catch (ObjectDisposedException)
                {
                    // Disposed between the check above and the dispatch; nothing left to update.
                }
            }
        }
    }

    private async Task ResetFiltersAsync()
    {
        _fromText = null;
        _toText = null;
        _categoryText = null;
        ClearPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task NextPageAsync()
    {
        if (_pageLoadInFlight || string.IsNullOrWhiteSpace(_snapshot.NextCursor))
        {
            return;
        }

        string tenantId = TenantId;
        string? priorCursor = _currentCursor;
        string nextCursor = _snapshot.NextCursor;
        _pageLoadInFlight = true;
        try
        {
            TenantAuditSnapshot? result = await LoadAsync(
                reuseETag: false,
                requestedTenantId: tenantId,
                requestedCursor: nextCursor,
                useRequestedCursor: true).ConfigureAwait(false);
            // Marshalled: this continuation resumes on a thread-pool thread while the render LoadAsync
            // queued through InvokeAsync is in flight, and that render reads _cursorHistory.Count for the
            // Previous button's Disabled binding. Pushing onto a non-thread-safe Stack concurrently with
            // that read is a data race, and could render page-2 rows with Previous still disabled.
            await InvokeAsync(() =>
            {
                // The tenant-identity clause is defence in depth, not the load-bearing guard: after a route
                // change LoadAsync's own CanApply already refuses to publish the late result, so
                // ReferenceEquals(_snapshot, result) is false and rejects it first. Removing the clause
                // therefore changes no observable behaviour and no test can isolate it -- kept so the rule
                // survives any future loosening of the reference check.
                // A_next_page_completing_after_the_route_moved_does_not_commit_its_cursor_onto_the_new_tenant
                // pins the behaviour these three clauses jointly provide.
                if (IsAppliedRequestedPage(result, nextCursor)
                    && ReferenceEquals(_snapshot, result)
                    && string.Equals(TenantId, tenantId, StringComparison.Ordinal))
                {
                    _cursorHistory.Push(priorCursor);
                    _currentCursor = nextCursor;
                    _pagingHistoryTruncated |= CursorHistory.Trim(_cursorHistory, MaximumCursorHistory);
                    _pagingJumpedToFirstPage = false;
                }
            }).ConfigureAwait(false);
        }
        finally
        {
            _pageLoadInFlight = false;
        }
    }


    private async Task PreviousPageAsync()
    {
        if (_pageLoadInFlight || _cursorHistory.Count == 0)
        {
            return;
        }

        string tenantId = TenantId;
        string? previousCursor = _cursorHistory.Peek();
        _pageLoadInFlight = true;
        try
        {
            TenantAuditSnapshot? result = await LoadAsync(
                reuseETag: false,
                requestedTenantId: tenantId,
                requestedCursor: previousCursor,
                useRequestedCursor: true).ConfigureAwait(false);
            // Marshalled for the same reason as NextPageAsync: this continuation resumes on a thread-pool
            // thread while the render LoadAsync queued through InvokeAsync is still in flight, and that
            // render reads _cursorHistory.Count for the Previous button's Disabled binding. Popping a
            // non-thread-safe Stack concurrently with that read is a data race. Only NextPageAsync and both
            // global-administrator pagers were marshalled when this rule was first applied.
            await InvokeAsync(() =>
            {
                if (IsAppliedRequestedPage(result, previousCursor)
                    && ReferenceEquals(_snapshot, result)
                    && string.Equals(TenantId, tenantId, StringComparison.Ordinal)
                    // The entry guard checked Count above, but that was before this dispatcher hop. The
                    // filter controls carry no Disabled binding and OnFromChanged/OnToChanged/
                    // OnCategoryChanged/ResetFiltersAsync all call ClearPaging() with no in-flight check, so
                    // a filter change landing after _snapshot was assigned and before this body runs leaves
                    // every other clause passing against an emptied stack -- and Stack.Pop() then throws
                    // InvalidOperationException on the Blazor dispatcher, tearing down the circuit. The
                    // global-administrator sibling has carried this clause since the hop was introduced.
                    && _cursorHistory.Count > 0)
                {
                    _currentCursor = _cursorHistory.Pop();

                    // A trimmed history re-appends the first-page sentinel under the newest entries, so one
                    // Previous click walks the operator from the middle of the sequence straight to page one.
                    // Rendered as an ordinary step back it silently misstates where they are.
                    _pagingJumpedToFirstPage = _pagingHistoryTruncated
                        && _currentCursor is null
                        && _cursorHistory.Count == 0;
                    if (_pagingJumpedToFirstPage)
                    {
                        _pagingHistoryTruncated = false;
                    }
                }
            }).ConfigureAwait(false);
        }
        finally
        {
            _pageLoadInFlight = false;
        }
    }

    private async Task OnFromChanged(string? value)
    {
        _fromText = value;
        ClearPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task OnToChanged(string? value)
    {
        _toText = value;
        ClearPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task OnCategoryChanged(string? value)
    {
        _categoryText = value;
        ClearPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private TenantAuditRequest CreateRequest(string tenantId, string? cursor, string? eTag)
        => new(
            tenantId,
            From: ParseDate(_fromText),
            To: ParseDate(_toText),
            Category: Enum.TryParse(_categoryText, out AuditEventCategory category) ? category : null,
            Cursor: cursor,
            PageSize: PageSize,
            ETag: eTag);

    private void ClearPaging()
    {
        _cursorHistory.Clear();
        _pagingHistoryTruncated = false;
        _pagingJumpedToFirstPage = false;
        _currentCursor = null;
        _selectedReceipt = null;
        _selectedReceiptCorrectionIntent = null;
        _activeCorrectionIntent = null;
        _activeCorrectionFocusReference = null;
        _selectedCorrectionRoles.Clear();
    }

    private Task OpenReceiptAsync(TenantAuditRow row)
    {
        _selectedReceipt = TenantAuditReceipt.FromRow(row, SupportSafeCommandReference, _snapshot.Kind);
        _selectedReceiptCorrectionIntent = CreateCorrectionIntent(row);
        return Task.CompletedTask;
    }

    private Task CloseReceiptAsync()
    {
        _selectedReceipt = null;
        _selectedReceiptCorrectionIntent = null;
        return Task.CompletedTask;
    }

    private async Task OpenCorrectionAsync(TenantCorrectionStartIntent intent)
    {
        // Guard against out-of-order completion: two rapid opens each await a projection refresh, and the
        // earlier one can resolve last. Capturing a generation synchronously (before the first await, on the
        // renderer dispatcher) lets only the newest open apply its intent.
        int generation = ++_correctionOpenGeneration;

        // Refresh the projection that actually governs this correction so the panel's preview,
        // last-administrator hard stop, and present/absent evaluation run against current evidence:
        // the fixed global-administrator projection for platform-authority corrections, tenant detail
        // otherwise. The panel re-derives its preview from this refreshed CurrentProjection (AC6/AC8).
        GlobalAdministratorsSnapshot? globalSnapshot = null;
        if (intent.IntendedCommandDomain is TenantCorrectionCommandDomain.GlobalAdministrators)
        {
            globalSnapshot = await RefreshGlobalAdministratorsProjectionAsync().ConfigureAwait(false);
        }
        else
        {
            await RefreshTenantProjectionAsync().ConfigureAwait(false);
        }

        // Marshal the parent field writes back onto the renderer's dispatcher: this method awaited a
        // projection refresh with ConfigureAwait(false), so the continuation runs off the Blazor sync
        // context (dispatcher hygiene — this UI has documented off-dispatcher circuit-crash history).
        await InvokeAsync(() =>
        {
            if (generation != _correctionOpenGeneration)
            {
                return; // A newer correction open superseded this one while its projection refreshed.
            }

            if (globalSnapshot is not null)
            {
                _globalAdministratorsSnapshot = globalSnapshot;
            }

            TenantCorrectionStartIntent refreshedIntent = intent;
            if (intent.IntendedCommandDomain is TenantCorrectionCommandDomain.GlobalAdministrators)
            {
                TenantAuditRow? sourceRow = _snapshot.Rows.FirstOrDefault(row =>
                    string.Equals(row.EventReference, intent.OriginalAuditReference, StringComparison.Ordinal));
                if (sourceRow is not null)
                {
                    refreshedIntent = CreateGlobalAdministratorCorrectionIntent(sourceRow);
                }
            }

            _activeCorrectionIntent = refreshedIntent;
            _activeCorrectionFocusReference = refreshedIntent.OriginalAuditReference;
            StateHasChanged();
        }).ConfigureAwait(false);
    }

    private Task CloseCorrectionAsync()
    {
        _pendingCorrectionFocusReference = _activeCorrectionFocusReference;
        _activeCorrectionFocusReference = null;
        _activeCorrectionIntent = null;
        return Task.CompletedTask;
    }

    private void ResolveReceiptSelection()
    {
        if (!ShouldRenderRows && string.IsNullOrWhiteSpace(ReceiptReference))
        {
            _selectedReceipt = null;
            _selectedReceiptCorrectionIntent = null;
            _activeCorrectionIntent = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(ReceiptReference))
        {
            TenantAuditRow? requestedRow = _snapshot.Rows.FirstOrDefault(row =>
                string.Equals(row.EventReference, ReceiptReference, StringComparison.Ordinal));
            _selectedReceipt = requestedRow is null
                ? TenantAuditReceipt.Unavailable(ReceiptReference, TenantId, SupportSafeCommandReference)
                : TenantAuditReceipt.FromRow(requestedRow, SupportSafeCommandReference, _snapshot.Kind);
            _selectedReceiptCorrectionIntent = requestedRow is null ? null : CreateCorrectionIntent(requestedRow);
            return;
        }

        if (_selectedReceipt is null)
        {
            _selectedReceiptCorrectionIntent = null;
            return;
        }

        TenantAuditRow? selectedRow = _snapshot.Rows.FirstOrDefault(row =>
            string.Equals(row.EventReference, _selectedReceipt.AuditReference, StringComparison.Ordinal));
        _selectedReceipt = selectedRow is null
            ? null
            : TenantAuditReceipt.FromRow(selectedRow, SupportSafeCommandReference, _snapshot.Kind);
        _selectedReceiptCorrectionIntent = selectedRow is null ? null : CreateCorrectionIntent(selectedRow);
    }

    private TenantCorrectionStartIntent CreateCorrectionIntent(TenantAuditRow row)
    {
        if (IsGlobalAdministratorRow(row))
        {
            return CreateGlobalAdministratorCorrectionIntent(row);
        }

        Hexalith.Tenants.Contracts.Queries.TenantDetail? detail = _tenantDetailSnapshot?.Detail;
        TenantMember? member = detail?.Members.FirstOrDefault(member =>
            string.Equals(member.UserId, ReferenceValue(row, "userId") ?? row.Target, StringComparison.Ordinal));
        TenantRole? intendedRole = _selectedCorrectionRoles.TryGetValue(row.EventReference, out TenantRole selectedRole)
            ? selectedRole
            : IntendedRoleFromNarrative(row);

        return TenantCorrectionStartIntent.Evaluate(new(
            TenantAuditReceipt.FromRow(row, SupportSafeCommandReference, _snapshot.Kind),
            row,
            IsAuthorized: true,
            HasCurrentProjectionSnapshot: _tenantDetailSnapshot?.Kind is TenantDetailSurfaceKind.Ready && _tenantDetailSnapshot.Freshness is ReadModelFreshnessState.Current,
            CurrentProjectionSnapshotReference: _tenantDetailSnapshot?.Kind is TenantDetailSurfaceKind.Ready
                ? "Current tenant projection is available."
                : "Current tenant projection is not available.",
            TenantStatus: detail?.Status ?? TenantStatus.Unknown,
            CurrentRole: member?.Role,
            IntendedRole: intendedRole,
            HasTenantCommandSupport: true,
            HasGlobalAdministratorCommandSupport: false));
    }

    // Build the fixed-scope global-administrator correction intent. Command support is enabled only
    // when authorization reflection, both BFF surfaces, and a current fixed global-administrator
    // projection are all present; any missing evidence leaves the intent fail-closed (AC1/AC2/AC8).
    // Tenant detail, tenant members, and tenant roles are never consulted for platform authority.
    private TenantCorrectionStartIntent CreateGlobalAdministratorCorrectionIntent(TenantAuditRow row)
    {
        bool projectionReady = _globalAdministratorsSnapshot is
            {
                Kind: GlobalAdministratorsSurfaceKind.Ready
                    or GlobalAdministratorsSurfaceKind.Empty,
                IsCompleteEvidence: true,
                HasMore: false,
                Lifecycle: ProjectionLifecycleState.Current,
            }
            && _globalAdministratorsSnapshot.Freshness is ReadModelFreshnessState.Current;
        bool commandSupport = IsGlobalAdministratorAuthorized
            && BffComposition.IsReadSurfaceConnected
            && BffComposition.IsCommandSurfaceConnected
            && projectionReady;

        return TenantCorrectionStartIntent.Evaluate(new(
            TenantAuditReceipt.FromRow(row, SupportSafeCommandReference, _snapshot.Kind),
            row,
            IsAuthorized: IsGlobalAdministratorAuthorized,
            HasCurrentProjectionSnapshot: projectionReady,
            CurrentProjectionSnapshotReference: projectionReady
                ? "global-administrators:current"
                : "global-administrators:unavailable",
            TenantStatus: TenantStatus.Active,
            HasTenantCommandSupport: false,
            HasGlobalAdministratorCommandSupport: commandSupport));
    }

    private Task SelectCorrectionRoleAsync(TenantCorrectionRoleSelection selection)
    {
        if (selection.Role is TenantRole.TenantOwner or TenantRole.TenantContributor or TenantRole.TenantReader)
        {
            _selectedCorrectionRoles[selection.AuditReference] = selection.Role;
            ResolveReceiptSelection();
        }

        return Task.CompletedTask;
    }

    private async Task<Hexalith.Tenants.Contracts.Queries.TenantDetail?> RefreshTenantProjectionAsync()
    {
        string tenantId = TenantId;
        TenantDetailSnapshot? snapshot = await QueryGateway
            .GetTenantAsync(new TenantDetailRequest(tenantId, _tenantDetailSnapshot?.ETag), _tenantDetailSnapshot, CancellationToken.None)
            .ConfigureAwait(false);
        // Assign on the renderer's dispatcher: this also runs as a correction panel
        // ProjectionRefreshProvider, i.e. off the Blazor sync context after ConfigureAwait(false).
        await InvokeAsync(() =>
        {
            if (!_disposed && string.Equals(TenantId, tenantId, StringComparison.Ordinal))
            {
                _tenantDetailSnapshot = snapshot;
            }
        }).ConfigureAwait(false);

        // Confirm-time provider contract: only a Current (fresh, Ready) projection is admissible as
        // correction proof. A Stale/Degraded/Unknown snapshot returns null so the panel's
        // ConfirmProjection(null) fails closed instead of confirming a tenant correction off stale evidence
        // (parity with the global-administrator panel's Freshness=Current confirm gate).
        return snapshot?.Freshness is ReadModelFreshnessState.Current ? snapshot.Detail : null;
    }

    private async Task RefreshTenantProjectionForLoadAsync(
        string tenantId,
        long generation,
        CancellationToken cancellationToken)
    {
        TenantDetailSnapshot? previous = _tenantDetailSnapshot;
        TenantDetailSnapshot? snapshot = await QueryGateway
            .GetTenantAsync(new TenantDetailRequest(tenantId, previous?.ETag), previous, cancellationToken)
            .ConfigureAwait(false);
        if (CanApply(tenantId, generation))
        {
            await InvokeAsync(() => _tenantDetailSnapshot = snapshot).ConfigureAwait(false);
        }
    }

    // Always re-read the fixed platform-authority projection. This is also the correction panel's
    // confirm-time ProjectionRefreshProvider, so it must never short-circuit on the current audit
    // page contents: a correction can be open while the page has paged to rows without a
    // global-administrator entry, and the confirmation must still observe the applied change.
    // The page-load path applies its own "only when global-administrator rows are present" guard at
    // the call site so a tenant audit page with no such rows never pays for an extra query.
    private async Task<GlobalAdministratorsSnapshot?> RefreshGlobalAdministratorsProjectionAsync()
    {
        GlobalAdministratorsSnapshot snapshot = await GlobalAdministratorsProjectionLoader
            .LoadAsync(QueryGateway, cancellationToken: CancellationToken.None)
            .ConfigureAwait(false);
        // Assign on the renderer's dispatcher: this also runs as the correction panel's confirm-time
        // ProjectionRefreshProvider, i.e. off the Blazor sync context after ConfigureAwait(false).
        await InvokeAsync(() => _globalAdministratorsSnapshot = snapshot).ConfigureAwait(false);
        return snapshot;
    }

    private async Task RefreshGlobalAdministratorsProjectionForLoadAsync(
        string tenantId,
        long generation,
        CancellationToken cancellationToken)
    {
        GlobalAdministratorsSnapshot snapshot = await GlobalAdministratorsProjectionLoader
            .LoadAsync(QueryGateway, cancellationToken: cancellationToken)
            .ConfigureAwait(false);
        if (CanApply(tenantId, generation))
        {
            await InvokeAsync(() => _globalAdministratorsSnapshot = snapshot).ConfigureAwait(false);
        }
    }

    private static bool IsGlobalAdministratorRow(TenantAuditRow row)
        => row.EventType is "GlobalAdministratorRemoved" or "GlobalAdministratorSet";

    private bool IsGlobalAdministratorAuthorized
        => BffComposition.GlobalAdministratorsAuthorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized;

    private static TenantRole? IntendedRoleFromNarrative(TenantAuditRow row)
        => row.EventType switch
        {
            "UserRemovedFromTenant" => RoleFromReference(row, "previousRole") ?? RoleFromReference(row, "role"),
            "UserRoleChanged" => RoleFromReference(row, "oldRole"),
            _ => null,
        };

    private static TenantRole? RoleFromReference(TenantAuditRow row, string key)
        => Enum.TryParse(ReferenceValue(row, key), ignoreCase: false, out TenantRole role)
            && role is TenantRole.TenantOwner or TenantRole.TenantContributor or TenantRole.TenantReader
                ? role
                : null;

    private static string? ReferenceValue(TenantAuditRow row, string key)
    {
        string marker = key + ": ";
        string? segment = row.ReferenceContext
            .Split(';', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault(value => value.StartsWith(marker, StringComparison.Ordinal));

        return segment?.Length > marker.Length ? segment[marker.Length..] : null;
    }

    // The datetime-local filter input carries no timezone. Interpret it as UTC so the absolute
    // date-range filter stays deterministic and aligns with the UTC-rendered timestamp column,
    // rather than depending on the InteractiveServer host's local timezone.
    private static DateTimeOffset? ParseDate(string? value)
        => DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out DateTimeOffset parsed)
            ? parsed
            : null;

    private static string TestIdState(string resourceState)
    {
        string result = string.Empty;
        foreach (char character in resourceState)
        {
            if (char.IsUpper(character) && result.Length > 0)
            {
                result += "-";
            }

            result += char.ToLowerInvariant(character);
        }

        return result;
    }

    private static bool IsSafeReturnUrl(string? returnUrl)
        => !string.IsNullOrWhiteSpace(returnUrl)
            && returnUrl.StartsWith("/tenants", StringComparison.Ordinal)
            && !returnUrl.StartsWith("//", StringComparison.Ordinal);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation();

        if (_readRefreshLease is not null)
        {
            await _readRefreshLease.DisposeAsync().ConfigureAwait(false);
            _readRefreshLease = null;
        }

        _subscriptionTenantId = null;
        _loadedTenantId = null;

        if (_focusModule is null)
        {
            return;
        }

        try
        {
            await _focusModule.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; no support-safe value is logged or surfaced here.
        }
    }

    private PendingOperation BeginLoad()
    {
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = source;
        }

        // Interlocked, not ++: OnParametersSetAsync reaches BeginLoad from a ConfigureAwait(false)
        // continuation (it awaits the previous lease's DisposeAsync, a remote unsubscribe) while Refresh
        // reaches it on the dispatcher. A lost increment gives two loads the same generation, and the older
        // completion then passes CanApply and writes its stale page over the newer rows.
        return new(
            Interlocked.Increment(ref _loadGeneration),
            source,
            () => CompleteCancellation(source));
    }

    private void CancelActiveCancellation()
    {
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = null;
        }
    }

    private void RetireCancellationCore(CancellationTokenSource? source)
    {
        if (source is null)
        {
            return;
        }

        source.Cancel();
    }

    private void CompleteCancellation(CancellationTokenSource source)
    {
        lock (_cancellationLock)
        {
            if (ReferenceEquals(_loadCancellation, source))
            {
                _loadCancellation = null;
            }
        }

        source.Dispose();
    }

    private bool CanApply(string tenantId, long generation)
        => !_disposed
            && generation == Volatile.Read(ref _loadGeneration)
            && string.Equals(TenantId, tenantId, StringComparison.Ordinal);

    private static bool IsAppliedRequestedPage(TenantAuditSnapshot? snapshot, string? requestedCursor)
        => snapshot is not null
            && (snapshot.Kind is TenantAuditSurfaceKind.Ready
                or TenantAuditSurfaceKind.Stale
                or TenantAuditSurfaceKind.Empty
                or TenantAuditSurfaceKind.FilteredEmpty
                or TenantAuditSurfaceKind.Degraded)
            && string.Equals(snapshot.RequestCursor, requestedCursor, StringComparison.Ordinal);

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }
}
