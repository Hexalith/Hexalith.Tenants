@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop

<fluent-button @ref="_button"
               appearance="outline"
               class="global-admins__mutation-initiation"
               data-testid="tenants-global-admin-remove"
               data-user-id="@UserId"
               disabled="@(Disabled ? string.Empty : null)"
               aria-describedby="@AriaDescribedBy"
               @onclick="HandleClickAsync">
    @Label
</fluent-button>

@code {
    private ElementReference _button;

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? AriaDescribedBy { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<GlobalAdministratorRemoveLauncher> OnPreview { get; set; }

    public async Task<bool> TryFocusAsync()
    {
        try
        {
            await _button.FocusAsync().ConfigureAwait(false);
            return true;
        }
        catch (JSDisconnectedException)
        {
            return false;
        }
        catch (ObjectDisposedException)
        {
            return false;
        }
        catch (JSException)
        {
            return false;
        }
        catch (InvalidOperationException)
        {
            return false;
        }
    }

    private Task HandleClickAsync(MouseEventArgs _)
        => OnPreview.InvokeAsync(this);
}
