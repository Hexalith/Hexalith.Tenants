@page "/"
@page "/tenants"
@using Hexalith.Tenants.Contracts.Enums
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway

<FcPageLayout Mode="FcPageLayoutMode.FullWidth">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="24px" Class="tenants-workspace" data-testid="tenants-workspace">
    <FcPageHeader @ref="_pageHeader"
                  PageTitle="@Localizer["Tenants.List.Title"]"
                  Heading="@Localizer["Tenants.List.Title"]"
                  HeadingId="tenants-list-heading"
                  HeadingTabIndex="-1"
                  Eyebrow="@Localizer["Tenants.Workspace.Eyebrow"]"
                  TestId="tenants-list-page-header">
        <Metadata>
            @if (!string.IsNullOrWhiteSpace(_selectedTenantId))
            {
                <p class="tenants-workspace__return-context" data-testid="tenants-list-return-context">
                    @Localizer["Tenants.List.ReturnContext", _selectedTenantId]
                </p>
            }
        </Metadata>
    </FcPageHeader>

    <section class="tenants-workspace__controls" aria-label="@Localizer["Tenants.List.ControlsLabel"]">
        <FluentGrid Class="tenants-workspace__filters" Spacing="3">
            <FluentGridItem Xs="12" Md="6" Lg="4">
                <FluentTextInput TextInputType="TextInputType.Search"
                                 Value="@_search"
                                 ValueChanged="OnSearchChanged"
                                 Immediate="true"
                                 ImmediateDelay="350"
                                 Label="@Localizer["Tenants.List.SearchLabel"]"
                                 Placeholder="@Localizer["Tenants.List.SearchPlaceholder"]"
                                 data-testid="tenants-list-search"
                                 aria-label="@Localizer["Tenants.List.SearchLabel"]" />
            </FluentGridItem>
            <FluentGridItem Xs="12" Md="6" Lg="4">
                <FluentSelect TOption="string" TValue="string"
                              Value="@_statusFilter"
                              ValueChanged="OnStatusFilterChanged"
                              Label="@Localizer["Tenants.List.StatusFilterLabel"]"
                              data-testid="tenants-list-status-filter"
                              aria-label="@Localizer["Tenants.List.StatusFilterLabel"]">
                    <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.List.StatusFilter.All"]</FluentOption>
                    <FluentOption TValue="string" Value="@TenantStatus.Active.ToString()">@Localizer["Tenants.List.StatusFilter.Active"]</FluentOption>
                    <FluentOption TValue="string" Value="@TenantStatus.Disabled.ToString()">@Localizer["Tenants.List.StatusFilter.Disabled"]</FluentOption>
                    <FluentOption TValue="string" Value="@TenantStatus.Unknown.ToString()">@Localizer["Tenants.List.StatusFilter.Unknown"]</FluentOption>
                </FluentSelect>
            </FluentGridItem>
        @* Sorting is now performed in-grid via the FluentDataGrid sortable column headers
           (Tenant → name, Status → status), replacing the former sort/direction comboboxes. *@
        </FluentGrid>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12px" VerticalGap="12px" Wrap="true" Class="tenants-workspace__actions">
            <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-list-refresh" OnClick="RefreshAsync">
                @Localizer["Tenants.List.Refresh"]
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-reset" OnClick="ResetFiltersAsync">
                @Localizer["Tenants.List.Reset"]
            </FluentButton>
            <span class="tenants-workspace__actions-spacer" aria-hidden="true"></span>
            <FluentAnchorButton Href="/tenants/my"
                                Appearance="ButtonAppearance.Subtle"
                                data-testid="tenants-my-link">
                @Localizer["Tenants.MyTenants.Link"]
            </FluentAnchorButton>
            <FluentAnchorButton Href="/tenants/users"
                                Appearance="ButtonAppearance.Subtle"
                                data-testid="tenants-user-lookup-link">
                @Localizer["Tenants.UserLookup.Link"]
            </FluentAnchorButton>
        </FluentStack>
    </section>

    <CreateTenantFlow IsAuthorized="@(_snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized))"
                      IsFresh="@(_snapshot.Freshness is TenantFreshnessState.Current or TenantFreshnessState.Unknown)"
                      OnProjectionRefreshRequested="RefreshAsync"
                      ProjectionEvidenceProvider="FindTenantProjectionEvidenceAsync" />

    @if (_snapshot.Kind is TenantListSurfaceKind.Loading)
    {
        <ListSurfaceStates Kind="TenantListSurfaceKind.Loading" />
    }
    else if (_visibleRows.Count == 0 && HasActiveFilters)
    {
        <ListSurfaceStates Kind="TenantListSurfaceKind.FilteredEmpty" OnReset="ResetFiltersAsync" />
    }
    else if (_snapshot.Kind is TenantListSurfaceKind.FilteredEmpty)
    {
        <ListSurfaceStates Kind="TenantListSurfaceKind.FilteredEmpty" OnReset="ResetFiltersAsync" />
    }
    else if (_snapshot.Kind is TenantListSurfaceKind.Empty)
    {
        <ListSurfaceStates Kind="TenantListSurfaceKind.Empty" />
    }
    else if (_snapshot.Kind is TenantListSurfaceKind.Error)
    {
        <ListSurfaceStates Kind="TenantListSurfaceKind.Error" Detail="@_snapshot.ErrorMessage" />
    }
    else if (_snapshot.Kind is TenantListSurfaceKind.Unauthorized)
    {
        <ListSurfaceStates Kind="TenantListSurfaceKind.Unauthorized" />
    }
    else
    {
        @if (_snapshot.Kind is TenantListSurfaceKind.Stale)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Stale" OnRefresh="RefreshAsync" />
        }
        else if (_snapshot.Kind is TenantListSurfaceKind.Degraded)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Degraded" Detail="@_snapshot.ErrorMessage" />
        }

        <TenantDataGrid Rows="@_visibleRows" DetailHref="CreateDetailHref" AuditHref="CreateAuditHref" />

        <nav class="tenants-workspace__pager" aria-label="@Localizer["Tenants.List.PaginationLabel"]">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="12px" Wrap="true">
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-previous" Disabled="@(_cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                    @Localizer["Tenants.List.Previous"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-next" Disabled="@(!_snapshot.HasMore)" OnClick="NextPageAsync">
                    @Localizer["Tenants.List.Next"]
                </FluentButton>
            </FluentStack>
        </nav>
    }
    </FluentStack>
</FcPageLayout>

@code {
    private TenantListSnapshot _snapshot = TenantListSnapshot.Loading();
    private IReadOnlyList<TenantListRow> _visibleRows = [];
    private readonly Stack<string?> _cursorHistory = new();
    private string? _currentCursor;
    private string? _search;
    private string? _statusFilter;
    private string _sortColumn = TenantListSortColumns.TenantId;
    private bool _sortDescending;
    private string? _selectedTenantId;
    private string? _returnAnchor;
    private FcPageHeader _pageHeader = default!;
    private bool _focusHeadingPending;

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? QuerySort { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "desc")]
    public bool QuerySortDescending { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "cursor")]
    public string? QueryCursor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "selected")]
    public string? QuerySelectedTenantId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "anchor")]
    public string? QueryAnchor { get; set; }

    private bool HasActiveFilters
        => !string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_statusFilter);

    protected override async Task OnInitializedAsync()
    {
        RestoreContextFromQuery();

        // When returning from a tenant detail surface the launching row may no longer be visible
        // after the list reloads, so move keyboard focus to the list heading and let the visible
        // return-context message explain that filters/sort/cursor/selection were restored.
        _focusHeadingPending = !string.IsNullOrWhiteSpace(_selectedTenantId);

        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHeadingPending)
        {
            _focusHeadingPending = false;
            await _pageHeader.FocusHeadingAsync().ConfigureAwait(false);
        }
    }

    private async Task LoadAsync(bool reuseETag)
    {
        TenantListSnapshot previous = _snapshot;
        _snapshot = TenantListSnapshot.Loading();
        ApplyVisibleRows();

        TenantStatus? status = Enum.TryParse(_statusFilter, out TenantStatus parsedStatus) ? parsedStatus : null;
        TenantListRequest request = new(
            Cursor: _currentCursor,
            PageSize: 20,
            Search: _search,
            Status: status,
            SortColumn: _sortColumn,
            SortDescending: _sortDescending,
            ETag: reuseETag ? previous.ETag : null);

        _snapshot = await QueryGateway
            .ListTenantsAsync(request, previous, CancellationToken.None)
            .ConfigureAwait(false);
        ApplyVisibleRows();
    }

    private async Task RefreshAsync()
        => await LoadAsync(reuseETag: true).ConfigureAwait(false);

    private async Task<TenantSummary?> FindTenantProjectionEvidenceAsync(string tenantId)
    {
        if (!_snapshot.Rows.Any(row => string.Equals(row.TenantId, tenantId, StringComparison.Ordinal)))
        {
            await LoadAsync(reuseETag: false).ConfigureAwait(false);
        }

        TenantListRow? row = _snapshot.Rows.FirstOrDefault(r => string.Equals(r.TenantId, tenantId, StringComparison.Ordinal));
        return row is null
            ? null
            : new TenantSummary(row.TenantId, row.Name, row.Status);
    }

    private async Task ResetFiltersAsync()
    {
        // Clearing the search term must reload the full cursor list from the server, not re-filter the
        // (now stale) search snapshot still held in _snapshot.
        _search = null;
        _statusFilter = null;
        _sortColumn = TenantListSortColumns.TenantId;
        _sortDescending = false;
        _selectedTenantId = null;
        _returnAnchor = null;
        ResetPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task NextPageAsync()
    {
        _cursorHistory.Push(_currentCursor);
        _currentCursor = _snapshot.NextCursor;
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task PreviousPageAsync()
    {
        if (_cursorHistory.Count > 0)
        {
            _currentCursor = _cursorHistory.Pop();
            await LoadAsync(reuseETag: false).ConfigureAwait(false);
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        // Cross-set server search, debounced by FluentTextInput (Immediate/ImmediateDelay) on the
        // renderer Dispatcher — NOT an in-memory re-filter. A changed term is a fresh query → first page.
        _search = value;
        ResetPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        // Status participates in the server query (the search index for a term; the hydrated detail for the
        // cursor list), so a change reloads from the server rather than filtering only the loaded page.
        _statusFilter = value;
        ResetPaging();
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private void ResetPaging()
    {
        _currentCursor = null;
        _cursorHistory.Clear();
    }

    private void ApplyVisibleRows()
    {
        IEnumerable<TenantListRow> rows = _snapshot.Rows;

        // Search is performed server-side across the whole tenant set (Memories index), not by filtering
        // the loaded page. Status stays a page-local filter for the cursor list (the tenant read backend
        // has no server-side status filter); for a search the gateway already applied it to hydrated rows.
        if (Enum.TryParse(_statusFilter, out TenantStatus status))
        {
            rows = rows.Where(r => r.Status == status);
        }

        rows = _sortColumn switch
        {
            TenantListSortColumns.Name => _sortDescending
                ? rows.OrderByDescending(r => r.Name, StringComparer.OrdinalIgnoreCase)
                : rows.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
            TenantListSortColumns.Status => _sortDescending
                ? rows.OrderByDescending(r => r.Status)
                : rows.OrderBy(r => r.Status),
            _ => _sortDescending
                ? rows.OrderByDescending(r => r.TenantId, StringComparer.Ordinal)
                : rows.OrderBy(r => r.TenantId, StringComparer.Ordinal),
        };

        _visibleRows = rows.ToArray();
    }

    private string CreateDetailHref(TenantListRow row)
        => CurrentNavigationContext().ToDetailUrl(row);

    private string CreateAuditHref(TenantListRow row)
        => CurrentNavigationContext().ToAuditUrl(row);

    private TenantListNavigationContext CurrentNavigationContext()
        => new(
            _search,
            _statusFilter,
            _sortColumn,
            _sortDescending,
            _currentCursor,
            _selectedTenantId,
            _returnAnchor);

    private void RestoreContextFromQuery()
    {
        _search = QuerySearch;
        _statusFilter = QueryStatus;
        _sortColumn = string.IsNullOrWhiteSpace(QuerySort) ? TenantListSortColumns.TenantId : QuerySort;
        _sortDescending = QuerySortDescending;
        _currentCursor = QueryCursor;
        _selectedTenantId = QuerySelectedTenantId;
        _returnAnchor = QueryAnchor;
    }
}
