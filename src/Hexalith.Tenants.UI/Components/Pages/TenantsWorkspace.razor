@page "/"
@page "/tenants"
@implements IDisposable
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.UI.Components.Users
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject NavigationManager Navigation
@inject IServiceProvider Services

<FcAggregateListPage TItem="TenantListRow"
                     @ref="_listPage"
                     LayoutMode="FcPageLayoutMode.FullWidth"
                     RootTestId="tenants-workspace"
                     RootClass="tenants-workspace"
                     PageTitle="@Localizer["Tenants.Workspace.Title"]"
                     Heading="@Localizer["Tenants.Workspace.Title"]"
                     HeadingId="tenants-list-heading"
                     HeadingTabIndex="-1"
                     Eyebrow="@Localizer["Tenants.Workspace.Eyebrow"]"
                     HeaderTestId="tenants-list-page-header">
    <Toolbar>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12px" Width="100%">
            <FluentTabs ActiveTabId="@_activeTabId"
                        ActiveTabIdChanged="OnActiveTabChanged"
                        Appearance="TabsAppearance.Subtle"
                        Width="100%"
                        aria-label="@Localizer["Tenants.Workspace.Tabs.Label"]"
                        data-testid="tenants-workspace-tabs">
                <FluentTab Id="@TenantsTabId" Header="@Localizer["Tenants.Workspace.Tabs.Tenants"]" />
                <FluentTab Id="@UsersTabId" Header="@Localizer["Tenants.Workspace.Tabs.Users"]" />
            </FluentTabs>

            @if (IsTenantsTab)
            {
                <FluentStack Orientation="Orientation.Horizontal"
                             HorizontalGap="12px"
                             VerticalGap="12px"
                             VerticalAlignment="VerticalAlignment.Bottom"
                             Wrap="true"
                             Width="100%">
                    <FluentSelect TOption="string" TValue="string"
                                  Value="@_tenantScope"
                                  ValueChanged="OnTenantScopeChanged"
                                  Label="@Localizer["Tenants.Workspace.Scope.Label"]"
                                  data-testid="tenants-workspace-scope"
                                  aria-label="@Localizer["Tenants.Workspace.Scope.Label"]">
                        <FluentOption TValue="string" Value="@AllTenantsScope">@Localizer["Tenants.Workspace.Scope.All"]</FluentOption>
                        <FluentOption TValue="string" Value="@MyTenantsScope">@Localizer["Tenants.Workspace.Scope.Mine"]</FluentOption>
                    </FluentSelect>

                    @if (IsTenantListView)
                    {
                        @* Maxlength stops the interactive path reaching the rejection at all: without it a
                           pasted over-length term was accepted by the input, dropped by normalization, and
                           the operator watched their own text disappear. A URL-supplied term still bypasses
                           the input, which is why the rejection also raises a localized notice. *@
                        <FluentTextInput TextInputType="TextInputType.Search"
                                         Value="@_search"
                                         ValueChanged="OnSearchChanged"
                                         MaxLength="TenantWorkspaceState.MaximumSearchLength"
                                         Immediate="true"
                                         ImmediateDelay="350"
                                         Label="@Localizer["Tenants.List.SearchLabel"]"
                                         Placeholder="@Localizer["Tenants.List.SearchPlaceholder"]"
                                         data-testid="tenants-list-search"
                                         aria-label="@Localizer["Tenants.List.SearchLabel"]" />
                        <FluentSelect TOption="string" TValue="string"
                                      Value="@_statusFilter"
                                      ValueChanged="OnStatusFilterChanged"
                                  Label="@Localizer[StatusFilterLabelKey]"
                                      data-testid="tenants-list-status-filter"
                                      aria-label="@Localizer["Tenants.List.StatusFilterLabel"]">
                            <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.List.StatusFilter.All"]</FluentOption>
                            <FluentOption TValue="string" Value="@TenantStatus.Active.ToString()">@Localizer["Tenants.List.StatusFilter.Active"]</FluentOption>
                            <FluentOption TValue="string" Value="@TenantStatus.Disabled.ToString()">@Localizer["Tenants.List.StatusFilter.Disabled"]</FluentOption>
                            <FluentOption TValue="string" Value="@TenantStatus.Unknown.ToString()">@Localizer["Tenants.List.StatusFilter.Unknown"]</FluentOption>
                        </FluentSelect>
                        <FluentSelect TOption="int" TValue="int"
                                      Value="@_pageSize"
                                      ValueChanged="OnPageSizeChanged"
                                      Label="@Localizer["Tenants.List.PageSizeLabel"]"
                                      data-testid="tenants-list-page-size"
                                      aria-label="@Localizer["Tenants.List.PageSizeLabel"]">
                            @foreach (int pageSize in _pageSizes)
                            {
                                <FluentOption TValue="int" Value="@pageSize">
                                    @Localizer["Tenants.List.PageSizeOption", pageSize]
                                </FluentOption>
                            }
                        </FluentSelect>
                        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-list-refresh" OnClick="RefreshAsync">
                            @Localizer["Tenants.List.Refresh"]
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-reset" OnClick="ResetFiltersAsync">
                            @Localizer["Tenants.List.Reset"]
                        </FluentButton>
                    }
                </FluentStack>
                @if (IsTenantListView)
                {
                    <FluentText As="TextTag.Paragraph"
                                Size="TextSize.Size200"
                                Color="Color.Lightweight"
                                data-testid="tenants-list-page-local-semantics">
                        @Localizer[_snapshot.IsAuthoritativeSearch
                            ? "Tenants.List.AuthoritativeSearchSemantics"
                            : "Tenants.List.PageLocalSemantics"]
                    </FluentText>
                }
            }
        </FluentStack>
    </Toolbar>
    <HeaderMetadata>
        @if (IsTenantListView && !string.IsNullOrWhiteSpace(_selectedTenantId))
        {
            <FluentText As="TextTag.Paragraph"
                        Size="TextSize.Size300"
                        Color="Color.Lightweight"
                        data-testid="tenants-list-return-context">
                @Localizer["Tenants.List.ReturnContext", _selectedTenantId]
            </FluentText>
        }
        @if (IsMyTenantsView && !string.IsNullOrWhiteSpace(_selectedTenantId))
        {
            <FluentText As="TextTag.Paragraph"
                        Size="TextSize.Size300"
                        Color="Color.Lightweight"
                        data-testid="tenants-my-return-context">
                @Localizer["Tenants.MyTenants.ReturnContext", _selectedTenantId]
            </FluentText>
        }
    </HeaderMetadata>
    @* Search + status moved up into the single toolbar control bar (Aspire-style); the former
       Filters band is intentionally empty. Sorting is performed in-grid via the FluentDataGrid
       sortable column headers (Tenant → name, Status → status). *@
    <Filters></Filters>
    <Commands>
        @if (IsTenantListView)
        {
            <FluentAccordion ExpandMode="AccordionExpandMode.Multi">
                <FluentAccordionItem Header="@Localizer["Tenants.Create.Title"]"
                                     Expanded="false"
                                     data-testid="tenants-create-accordion">
                    <CreateTenantFlow IsAuthorized="@(_snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized))"
                                      IsFresh="@(_snapshot.Freshness is ReadModelFreshnessState.Current or ReadModelFreshnessState.Unknown)"
                                      ShowHeading="false"
                                      OnProjectionRefreshRequested="RefreshAsync"
                                      ProjectionEvidenceProvider="FindTenantProjectionEvidenceAsync" />
                </FluentAccordionItem>
            </FluentAccordion>
        }
    </Commands>
    <States>
        @* Both notices share exactly one polite live region. Two sibling live regions announcing together
           are routinely coalesced or dropped by screen readers, so the region wraps the bars instead. The
           region itself renders unconditionally -- including across a workspace tab round trip, which must
           not re-insert it together with an already-populated notice -- because a live region inserted in
           the same render that first populates it is routinely not announced. Only the bars inside are
           conditional. *@
        <FluentStack Orientation="Orientation.Vertical"
                     VerticalGap="8px"
                     Width="100%"
                     role="status"
                     aria-live="polite"
                     aria-atomic="true"
                     data-testid="tenants-list-notices">
            @if (HasPrimaryNotice)
            {
                <FluentMessageBar Intent="MessageBarIntent.Info"
                                  Title="@NoticeMessage"
                                  data-testid="@NoticeTestId" />
            }
            @if (HasSecondaryNotice)
            {
                <FluentMessageBar Intent="MessageBarIntent.Info"
                                  Title="@PagingNoticeMessage"
                                  data-testid="@PagingNoticeTestId" />
            }
        </FluentStack>
        @if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.Loading)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Loading" />
        }
        else if (IsTenantListView && _visibleRows.Count == 0 && HasPageLocalFilter && _snapshot.Kind is not (TenantListSurfaceKind.Degraded or TenantListSurfaceKind.Stale))
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.FilteredEmpty" OnReset="ResetFiltersAsync" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.FilteredEmpty)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.FilteredEmpty" OnReset="ResetFiltersAsync" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.SearchPageEmpty)
        {
            @* This surface offers the same way out as the filtered-empty verdict, because the operator who
               simply mistyped the term would otherwise reach a dead end. Reason is deliberately NOT passed:
               ListSurfaceStates prefers a reason string over the state message, so a window emptied with a
               dropped record attached would render different copy than a genuine no-match and re-disclose
               that candidates existed -- the exact difference this surface exists to erase. *@
            <ListSurfaceStates Kind="TenantListSurfaceKind.SearchPageEmpty"
                               HasMore="@_snapshot.HasMore"
                               OnReset="ResetFiltersAsync" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.Empty)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Empty" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.Error)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Error" Reason="@_snapshot.Reason" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.Unauthorized)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Unauthorized" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.Stale)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Stale" OnRefresh="RefreshAsync" />
        }
        else if (IsTenantListView && _snapshot.Kind is TenantListSurfaceKind.Degraded)
        {
            <ListSurfaceStates Kind="TenantListSurfaceKind.Degraded" Reason="@_snapshot.Reason" />
        }
    </States>
    <Body>
        @if (IsTenantListView && ShowList)
        {
            <TenantDataGrid Rows="@_visibleRows"
                            DetailHref="CreateDetailHref"
                            AuditHref="CreateAuditHref"
                            SortColumn="@_sortColumn"
                            SortDescending="@_sortDescending"
                            PreserveRowOrder="@_snapshot.IsAuthoritativeSearch"
                            SortChanged="OnTenantSortChanged" />
        }
        else if (IsMyTenantsView)
        {
            <MyTenantsPanel InitialCursor="@_workspaceState.Cursor" />
        }
        else if (IsUsersTab)
        {
            <UserMembershipLookupPanel InitialUserId="@_workspaceState.UserId"
                                       InitialSort="@_workspaceState.Sort"
                                       InitialCursor="@_workspaceState.Cursor"
                                       UseWorkspaceRoute="true"
                                       ShowBackLink="false" />
        }
    </Body>
    <Pager>
        @if (ShowPager)
        {
            <nav aria-label="@Localizer["Tenants.List.PaginationLabel"]">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.End" HorizontalGap="12px" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-previous" Disabled="@(!HasPreviousPage)" OnClick="PreviousPageAsync">
                        @Localizer["Tenants.List.Previous"]
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-next" Disabled="@(!HasNextPage)" OnClick="NextPageAsync">
                        @Localizer["Tenants.List.Next"]
                    </FluentButton>
                </FluentStack>
            </nav>
        }
    </Pager>
</FcAggregateListPage>

@code {
    private const string TenantsTabId = "tenants";
    private const string UsersTabId = "users";
    private const string AllTenantsScope = "all";
    private const string MyTenantsScope = "mine";
    private static readonly int[] _pageSizes = [20, 50, 100];
    private TenantListSnapshot _snapshot = TenantListSnapshot.Loading();
    private TenantListSnapshot? _lastConfirmedSnapshot;
    private TenantWorkspaceState _workspaceState = TenantWorkspaceState.FromQuery(
        tab: null,
        scope: null,
        userId: null,
        search: null,
        status: null,
        sort: null,
        sortDescending: null,
        cursor: null,
        selectedTenantId: null,
        anchor: null);
    private TenantWorkspaceState _tenantWorkspaceState = TenantWorkspaceState.FromQuery(
        tab: null,
        scope: null,
        userId: null,
        search: null,
        status: null,
        sort: null,
        sortDescending: null,
        cursor: null,
        selectedTenantId: null,
        anchor: null);
    private IReadOnlyList<TenantListRow> _visibleRows = [];
    private readonly Stack<string?> _cursorHistory = new();
    private string? _currentCursor;
    private int _pageSize = 20;
    private string? _search;
    private string? _statusFilter;
    private string _sortColumn = TenantListSortColumns.TenantId;
    private bool _sortDescending;
    private string? _selectedTenantId;
    private string? _returnAnchor;
    private string _activeTabId = TenantsTabId;
    private string? _usersTabUserId;
    private string _usersTabSort = UserTenantMembershipSortColumns.Tenant;
    private string _tenantScope = AllTenantsScope;
    private FcAggregateListPage<TenantListRow> _listPage = default!;
    private bool _focusHeadingPending;
    private bool _initialized;
    private bool _disposed;
    private bool _restoreSearchPagingContextPending = true;

    // Blazor Server does not serialise async event handlers, and a pager button stays live until the
    // render batch that disables it is acknowledged. Without this guard a second click landed while
    // _snapshot was the transient Loading() value and mutated the cursor stack of the wrong paging mode.
    private bool _pagingInFlight;

    private long _loadVersion;
    private CancellationTokenSource? _loadCancellation;
    private TenantSearchPagingState? _searchPaging;

    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? QueryTab { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "scope")]
    public string? QueryScope { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? QuerySort { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "desc")]
    public string? QuerySortDescending { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "cursor")]
    public string? QueryCursor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "selected")]
    public string? QuerySelectedTenantId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "anchor")]
    public string? QueryAnchor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "userId")]
    public string? QueryUserId { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private bool IsTenantsTab
        => string.Equals(_activeTabId, TenantsTabId, StringComparison.Ordinal);

    private bool IsUsersTab
        => string.Equals(_activeTabId, UsersTabId, StringComparison.Ordinal);

    private bool IsTenantListView
        => IsTenantsTab && string.Equals(_tenantScope, AllTenantsScope, StringComparison.Ordinal);

    private bool IsMyTenantsView
        => IsTenantsTab && string.Equals(_tenantScope, MyTenantsScope, StringComparison.Ordinal);

    private bool HasPageLocalFilter
        => !_snapshot.IsAuthoritativeSearch && !string.IsNullOrWhiteSpace(_statusFilter);

    private bool HasActiveSearch
        => !string.IsNullOrWhiteSpace(_search);

    // The scoped paging service resolved on a non-interactive (static SSR / prerender) render pass belongs
    // to that request's scope, not to the interactive circuit, so retained protected paging must neither be
    // restored nor reported from it. The cascading HttpContext cannot carry this signal: it does not cross
    // render-mode boundaries and is null on both passes of an InteractiveServer component.
    private bool IsInteractiveCircuit
        => RendererInfo.IsInteractive;

    private bool HasValidatedTenantDetailReturnContext
        => !string.IsNullOrWhiteSpace(_selectedTenantId)
            && string.Equals(QuerySelectedTenantId, _selectedTenantId, StringComparison.Ordinal)
            && string.Equals(QueryAnchor, _returnAnchor, StringComparison.Ordinal)
            && string.Equals(_returnAnchor, $"tenant-row-{_selectedTenantId}", StringComparison.Ordinal);

    private bool HasPreviousPage
        => HasActiveSearch
            ? IsInteractiveCircuit && SearchPaging.HasPrevious(ActivePagingModeAuthoritative)
            : _cursorHistory.Count > 0;

    // Next is offered only when the click can actually advance. Enablement read _snapshot.HasMore while both
    // branches of NextPageAsync require a non-null cursor, and the ordinary list path passes the server's
    // HasMore and Cursor through independently with no consistency check -- so HasMore = true beside a null
    // cursor produced a live button whose every click did nothing: no load, no re-render, no notice. The
    // Loading() snapshot still reports HasMore = false, so Next stays disabled for the duration of a load.
    private bool HasNextPage
        => _snapshot.HasMore && PagingSnapshot.NextCursor is not null;

    // Resolved as a required service so a dropped registration fails loudly instead of silently degrading
    // to per-component paging that cannot survive tenant-detail navigation.
    private TenantSearchPagingState SearchPaging
        => _searchPaging ??= Services.GetRequiredService<TenantSearchPagingState>();

    private string? AuthenticatedUserId
        => (Services.GetService(typeof(IUserContextAccessor)) as IUserContextAccessor)?.UserId;

    private string StatusFilterLabelKey
        => _snapshot.IsAuthoritativeSearch
            ? "Tenants.List.StatusFilterLabel.Authoritative"
            : "Tenants.List.StatusFilterLabel";

    // The list/grid surface (the former else branch): everything that is not a blocking/empty list state.
    // The Stale/Degraded list-surface banners still render in the States slot above this body.
    private bool ShowList
        => _snapshot.Kind is not TenantListSurfaceKind.Loading
            && !(_visibleRows.Count == 0 && HasPageLocalFilter && _snapshot.Kind is not (TenantListSurfaceKind.Degraded or TenantListSurfaceKind.Stale))
            && _snapshot.Kind is not (TenantListSurfaceKind.FilteredEmpty
                or TenantListSurfaceKind.SearchPageEmpty
                or TenantListSurfaceKind.Empty
                or TenantListSurfaceKind.Error
                or TenantListSurfaceKind.Unauthorized);

    private bool ShowPager
        => IsTenantListView
            && _snapshot.Kind is not (TenantListSurfaceKind.Loading
                or TenantListSurfaceKind.Error
                or TenantListSurfaceKind.Unauthorized)
            && (ShowList || HasPreviousPage || _snapshot.HasMore);

    private string NoticeMessage
        => NoticeMessageFor(_snapshot.Notice);

    private string PagingNoticeMessage
        => NoticeMessageFor(_snapshot.PagingNotice);

    private string NoticeTestId
        => NoticeTestIdFor(_snapshot.Notice);

    private string PagingNoticeTestId
        => NoticeTestIdFor(_snapshot.PagingNotice);

    // Neither notice bar may render without a mapped localized message and a stable non-empty test id, so
    // no reason can produce a blank titled message bar or an unaddressable selector.
    private bool HasPrimaryNotice
        => IsTenantListView
            && _snapshot.Notice is not TenantListReason.None
            && !string.IsNullOrEmpty(NoticeMessage)
            && !string.IsNullOrEmpty(NoticeTestId);

    private bool HasSecondaryNotice
        => IsTenantListView
            && _snapshot.PagingNotice is not TenantListReason.None
            && _snapshot.PagingNotice != _snapshot.Notice
            && !string.IsNullOrEmpty(PagingNoticeMessage)
            && !string.IsNullOrEmpty(PagingNoticeTestId);

    private string NoticeMessageFor(TenantListReason reason)
        => reason switch
        {
            TenantListReason.ListRefreshed => Localizer["Tenants.List.Notice.ListRefreshed"],
            TenantListReason.SearchRefreshed => Localizer["Tenants.List.Notice.SearchRefreshed"],
            TenantListReason.SearchUnavailable => Localizer["Tenants.List.Notice.SearchUnavailable"],
            TenantListReason.SearchAndListUnavailable => Localizer["Tenants.List.Notice.SearchAndListUnavailable"],
            TenantListReason.SearchTermTooLong => Localizer["Tenants.List.Notice.SearchTermTooLong"],
            TenantListReason.SearchPagingRestarted => Localizer["Tenants.List.Notice.SearchPagingRestarted"],
            _ => string.Empty,
        };

    private static string NoticeTestIdFor(TenantListReason reason)
        => reason switch
        {
            TenantListReason.ListRefreshed => "tenants-list-refreshed-notice",
            TenantListReason.SearchRefreshed => "tenants-list-search-refreshed-notice",
            TenantListReason.SearchUnavailable => "tenants-list-search-unavailable-notice",
            TenantListReason.SearchAndListUnavailable => "tenants-list-search-and-list-unavailable-notice",
            TenantListReason.SearchTermTooLong => "tenants-list-search-term-too-long-notice",
            TenantListReason.SearchPagingRestarted => "tenants-list-search-paging-restarted-notice",
            _ => string.Empty,
        };

    protected override async Task OnInitializedAsync()
    {
        bool querySearchTermTooLong = TenantWorkspaceState.IsSearchTooLong(QuerySearch);
        RestoreContextFromQuery();
        NavigateToCanonicalWorkspaceIfNeeded(_workspaceState);
        _initialized = true;

        // When returning from a tenant detail surface the launching row may no longer be visible
        // after the list reloads, so move keyboard focus to the list heading and let the visible
        // return-context message explain that filters/sort/cursor/selection were restored.
        _focusHeadingPending = !string.IsNullOrWhiteSpace(_selectedTenantId);

        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false, searchTermTooLong: querySearchTermTooLong);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || _disposed)
        {
            return;
        }

        bool incomingSearchTermTooLong = TenantWorkspaceState.IsSearchTooLong(QuerySearch);
        TenantWorkspaceState incoming = WorkspaceStateFromQuery();
        if (incoming == _workspaceState)
        {
            NavigateToCanonicalWorkspaceIfNeeded(incoming);
            if (incomingSearchTermTooLong && IsTenantListView)
            {
                await LoadAsync(reuseETag: false, searchTermTooLong: true);
            }

            return;
        }

        ApplyWorkspaceState(incoming, clearCursorHistory: true);
        NavigateToCanonicalWorkspaceIfNeeded(incoming);
        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false, searchTermTooLong: incomingSearchTermTooLong);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHeadingPending)
        {
            _focusHeadingPending = false;
            await _listPage.FocusHeadingAsync();
        }
    }

    private async Task LoadAsync(bool reuseETag, bool searchTermTooLong = false, bool retainConfirmed = false)
    {
        // A disposed component must never issue another load: it would keep consuming and mutating the
        // circuit-scoped paging state it no longer renders, so its outcome could retire a paging mode or
        // clear protected history behind a surface that no operator can see.
        if (_disposed)
        {
            return;
        }

        long loadVersion = System.Threading.Interlocked.Increment(ref _loadVersion);
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        CancellationToken cancellationToken = _loadCancellation.Token;
        TenantListSnapshot previous = _lastConfirmedSnapshot ?? _snapshot;
        if (!retainConfirmed)
        {
            _snapshot = TenantListSnapshot.Loading();
        }
        ApplyVisibleRows();

        TenantStatus? status = Enum.TryParse(_statusFilter, out TenantStatus parsedStatus) ? parsedStatus : null;
        string? authenticatedUserId = AuthenticatedUserId;
        bool interactiveCircuit = IsInteractiveCircuit;
        bool restoreSearchPagingContext = interactiveCircuit && _restoreSearchPagingContextPending;
        bool eligibleDetailReturn = HasValidatedTenantDetailReturnContext
            && HasActiveSearch
            && !string.IsNullOrWhiteSpace(authenticatedUserId);
        bool retainedPagingMatched = false;
        bool discardedRetainedPosition = false;
        bool discardedAuthoritativePosition = false;
        if (restoreSearchPagingContext)
        {
            if (eligibleDetailReturn)
            {
                // The retained page size is server-held, so the exact retained scope is identified by
                // probing the supported page sizes instead of trusting anything from the URL.
                foreach (int retainedPageSize in _pageSizes)
                {
                    string retainedScope = TenantSearchCursorScopes.Create(
                        authenticatedUserId!,
                        _search!,
                        status?.ToString(),
                        _sortColumn,
                        _sortDescending,
                        retainedPageSize);
                    if (!SearchPaging.MatchesScope(retainedScope))
                    {
                        continue;
                    }

                    _pageSize = retainedPageSize;
                    retainedPagingMatched = true;
                    break;
                }
            }

            if (!eligibleDetailReturn)
            {
                // Returning by browser Back lands on /tenants?search=... with no selected/anchor, so the
                // return context cannot be validated and retained paging is discarded. That is correct, but
                // it was silent: the operator who was on search page 4 arrived at page 1 with no bar
                // explaining why. Only an actual retained position is worth a notice -- a first visit with
                // nothing retained has restarted nothing.
                // Which mode's position was discarded decides the copy: explaining an ordinary-list discard
                // as protected search paging restarting asserts a protected search page that never existed.
                discardedAuthoritativePosition = SearchPaging.SearchCursor is not null
                    || SearchPaging.HasPrevious(authoritative: true);
                discardedRetainedPosition = discardedAuthoritativePosition
                    || SearchPaging.FallbackCursor is not null
                    || SearchPaging.HasPrevious(authoritative: false);

                SearchPaging.Reset();
            }

            _restoreSearchPagingContextPending = false;
        }

        string? searchScope = HasActiveSearch && !string.IsNullOrWhiteSpace(authenticatedUserId)
            ? TenantSearchCursorScopes.Create(
                authenticatedUserId!,
                _search!,
                status?.ToString(),
                _sortColumn,
                _sortDescending,
                _pageSize)
            : null;
        if (interactiveCircuit)
        {
            SearchPaging.EnsureScope(searchScope);

            // Armed strictly after EnsureScope: that call resets positions when the scope changes, and a
            // pending scope set before it would be wiped by the very reset it is meant to explain.
            if (discardedRetainedPosition && searchScope is not null)
            {
                SearchPaging.SetPendingRecoveryScope(searchScope, discardedAuthoritativePosition);
            }
        }

        if (restoreSearchPagingContext
            && eligibleDetailReturn
            && searchScope is not null
            && !retainedPagingMatched)
        {
            // Retained protected paging could not be validated. The honest page-one recovery notice stays
            // pending until a load for this exact scope actually resolves, so a superseding load cannot
            // silently discard it. The decision lives in the circuit-scoped paging service beside the
            // cursors it governs, never in a component field.
            SearchPaging.SetPendingRecoveryScope(searchScope);
        }

        string? recoveryScopeForLoad = interactiveCircuit ? SearchPaging.PendingRecoveryScope : null;

        // The authoritative/fallback crossing is resolved before the outgoing request is built: only the
        // currently active paging mode may contribute a retained cursor. If this load crosses the boundary,
        // the mode it enters therefore starts at its own first page instead of resuming the stale cursor it
        // left behind, which is what makes the "paging restarted from the first page" notice honest about
        // the very load that carried it. A null mode means no load has resolved yet, so nothing is retained.
        bool? activeMode = interactiveCircuit ? SearchPaging.ActiveModeAuthoritative : null;
        TenantListRequest request = new(
            Cursor: HasActiveSearch
                ? activeMode is false ? SearchPaging.FallbackCursor : null
                : _currentCursor,
            PageSize: _pageSize,
            Search: _search,
            Status: status,
            SortColumn: _sortColumn,
            SortDescending: _sortDescending,
            ETag: reuseETag ? previous.ETag : null,
            SearchCursor: HasActiveSearch && interactiveCircuit && activeMode is not false
                ? SearchPaging.SearchCursor
                : null);

        TenantListSnapshot snapshot;
        try
        {
            snapshot = await QueryGateway.ListTenantsAsync(request, previous, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            // The disposal guard covers the post-await apply block as well as the load entry: a load that
            // returns after disposal must mutate no paging state, or it could retire a paging mode and
            // clear protected history behind a surface no operator can see.
            if (_disposed || loadVersion != _loadVersion)
            {
                return;
            }

            // The pending decision is consumed only when the notice is actually applied. A transient error
            // on the detail-return load must not silently swallow it: the next same-scope load reports it.
            if (recoveryScopeForLoad is not null
                && snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized)
                && string.Equals(searchScope, recoveryScopeForLoad, StringComparison.Ordinal)
                && string.Equals(SearchPaging.PendingRecoveryScope, recoveryScopeForLoad, StringComparison.Ordinal))
            {
                // Read the owed mode before clearing it: an ordinary-list discard gets the source-changed
                // copy, because the protected-search copy would assert a protected search page that never
                // existed in fallback mode.
                bool owedAuthoritative = SearchPaging.PendingRecoveryAuthoritative ?? true;
                SearchPaging.ClearPendingRecoveryScope();
                snapshot = snapshot with
                {
                    PagingRecovered = true,
                    PagingNotice = snapshot.PagingNotice is TenantListReason.None
                        ? owedAuthoritative
                            ? TenantListReason.SearchRefreshed
                            : TenantListReason.SearchPagingRestarted
                        : snapshot.PagingNotice,
                };
            }

            if (interactiveCircuit)
            {
                snapshot = ReconcileSearchPaging(snapshot);
            }

            // A term rejected for length is explained on the very load it caused, and only when nothing more
            // specific is already reported. Without this the operator watched their term vanish from the
            // input and the unfiltered list load, with no statement that a search had been refused at all.
            if (searchTermTooLong
                && snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized)
                && snapshot.Notice is TenantListReason.None)
            {
                snapshot = snapshot with { Notice = TenantListReason.SearchTermTooLong };
            }

            _snapshot = snapshot;
            if (snapshot.Kind is TenantListSurfaceKind.Ready
                or TenantListSurfaceKind.Empty
                or TenantListSurfaceKind.FilteredEmpty
                or TenantListSurfaceKind.SearchPageEmpty
                or TenantListSurfaceKind.Stale
                or TenantListSurfaceKind.Degraded)
            {
                _lastConfirmedSnapshot = snapshot;
            }

            if (snapshot.Notice == TenantListReason.ListRefreshed)
            {
                TenantWorkspaceState recovered = CurrentWorkspaceState() with { Cursor = null };
                ApplyWorkspaceState(recovered, clearCursorHistory: true);
                NavigateToCanonicalWorkspaceIfNeeded(recovered);
            }

            ApplyVisibleRows();
        });
    }

    private async Task RefreshAsync()
        => await LoadAsync(reuseETag: true);

    // Reconciles the two search paging modes. Crossing the authoritative/fallback boundary retires the
    // mode that is no longer active, so its Previous affordance cannot offer unreachable pages and a
    // retained protected cursor can never silently reactivate on a later recovery. Retiring a mode is
    // never silent: in both directions the operator gets a mapped, localized paging notice explaining why
    // paging jumped back to the first page, and the crossing notice yields its slot only to copy that
    // already explains a search restart. The mode itself lives in the circuit-scoped paging service, so
    // the crossing is still detected after a tenant-detail return recreates this component.
    private TenantListSnapshot ReconcileSearchPaging(TenantListSnapshot snapshot)
    {
        if (!HasActiveSearch)
        {
            SearchPaging.ClearActiveMode();
            return snapshot;
        }

        bool renderable = snapshot.Kind is not (TenantListSurfaceKind.Error or TenantListSurfaceKind.Unauthorized);
        if (renderable)
        {
            bool authoritative = snapshot.IsAuthoritativeSearch;
            if (SearchPaging.ActiveModeAuthoritative is bool previousMode && previousMode != authoritative)
            {
                if (authoritative)
                {
                    SearchPaging.RecoverFallback();
                }
                else
                {
                    SearchPaging.RecoverSearch();
                }

                if (!ExplainsSearchRestart(snapshot.PagingNotice))
                {
                    snapshot = snapshot with { PagingNotice = TenantListReason.SearchPagingRestarted };
                }
            }

            SearchPaging.SetActiveMode(authoritative);
        }

        // Protected paging history is cleared on the very load that reports the invalidation, terminal
        // surfaces included: both bars render from the notice reasons alone and never consult Kind, so an
        // Error/Unauthorized surface still carries the copy that explains the clearing. No deferred or
        // pending mechanism exists, and none may be reintroduced -- a decision that outlives a load would
        // have to live in the circuit-scoped paging service, never in a component field a tenant-detail
        // return discards.
        if (snapshot.PagingRecovered || snapshot.Notice == TenantListReason.SearchRefreshed)
        {
            SearchPaging.RecoverSearch();
            if (!ExplainsSearchRestart(snapshot.Notice) && !ExplainsSearchRestart(snapshot.PagingNotice))
            {
                snapshot = snapshot with { PagingNotice = TenantListReason.SearchRefreshed };
            }
        }

        if (snapshot.FallbackPagingRecovered)
        {
            SearchPaging.RecoverFallback();
        }

        return snapshot;
    }

    // Copy that tells the operator protected search paging restarted from the first page. A load that
    // clears protected search history must always render one of these, in whichever slot carries it.
    private static bool ExplainsSearchRestart(TenantListReason reason)
        => reason is TenantListReason.SearchRefreshed or TenantListReason.SearchPagingRestarted;

    private async Task<TenantSummary?> FindTenantProjectionEvidenceAsync(string tenantId)
    {
        IReadOnlyList<TenantListRow> confirmedRows = _lastConfirmedSnapshot?.Rows ?? _snapshot.Rows;
        if (!confirmedRows.Any(row => string.Equals(row.TenantId, tenantId, StringComparison.Ordinal)))
        {
            await LoadAsync(reuseETag: false);
            confirmedRows = _lastConfirmedSnapshot?.Rows ?? _snapshot.Rows;
        }

        TenantListRow? row = confirmedRows.FirstOrDefault(r => string.Equals(r.TenantId, tenantId, StringComparison.Ordinal));
        return row is null
            ? null
            : new TenantSummary(row.TenantId, row.Name, row.Status);
    }

    private async Task ResetFiltersAsync()
    {
        // Clearing the search term must reload the full cursor list from the server, not re-filter the
        // (now stale) search snapshot still held in _snapshot.
        ApplyWorkspaceState(TenantWorkspaceState.FromQuery(
            tab: TenantsTabId,
            scope: AllTenantsScope,
            userId: null,
            search: null,
            status: null,
            sort: null,
            sortDescending: null,
            cursor: null,
            selectedTenantId: null,
            anchor: null), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    /// <summary>
    /// The snapshot paging decisions may be read from. Never <c>_snapshot</c>: that is the transient
    /// <c>Loading()</c> value for the whole duration of a load, whose IsAuthoritativeSearch is false and
    /// whose NextCursor is null, so a click arriving mid-load would page the wrong mode from nowhere.
    /// </summary>
    private TenantListSnapshot PagingSnapshot => _lastConfirmedSnapshot ?? _snapshot;

    /// <summary>
    /// The active paging mode, taken from the circuit-scoped service that owns the cursors it describes and
    /// survives the component recreation a tenant-detail return causes.
    /// </summary>
    private bool ActivePagingModeAuthoritative
        => SearchPaging.ActiveModeAuthoritative ?? PagingSnapshot.IsAuthoritativeSearch;

    private async Task NextPageAsync()
    {
        if (_pagingInFlight)
        {
            return;
        }

        _pagingInFlight = true;
        try
        {
            TenantListSnapshot paging = PagingSnapshot;
            if (HasActiveSearch)
            {
                // Refused when there is no next cursor, so Next can never record a back-step it cannot
                // honour and then enable a Previous that lands on the same page.
                if (SearchPaging.MoveNext(ActivePagingModeAuthoritative, paging.NextCursor))
                {
                    await LoadAsync(reuseETag: false);
                }

                return;
            }

            if (paging.NextCursor is null)
            {
                return;
            }

            _cursorHistory.Push(_currentCursor);
            ApplyWorkspaceState(CurrentWorkspaceState() with { Cursor = paging.NextCursor });
            NavigateToCanonicalWorkspace();
            await LoadAsync(reuseETag: false);
        }
        finally
        {
            _pagingInFlight = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_pagingInFlight)
        {
            return;
        }

        _pagingInFlight = true;
        try
        {
            if (HasActiveSearch)
            {
                if (SearchPaging.TryMovePrevious(ActivePagingModeAuthoritative))
                {
                    await LoadAsync(reuseETag: false);
                }

                return;
            }

            if (_cursorHistory.Count > 0)
            {
                ApplyWorkspaceState(CurrentWorkspaceState() with { Cursor = _cursorHistory.Pop() });
                NavigateToCanonicalWorkspace();
                await LoadAsync(reuseETag: false);
            }
        }
        finally
        {
            _pagingInFlight = false;
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        bool searchTermTooLong = TenantWorkspaceState.IsSearchTooLong(value);
        ApplyWorkspaceState(CurrentWorkspaceState().WithSearch(value), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false, searchTermTooLong: searchTermTooLong);
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        // The current backend has no status field, so this is an explicitly page-local presentation filter.
        // Reload page one first so the filter never silently retains an older cursor page.
        ApplyWorkspaceState(CurrentWorkspaceState().WithStatus(value), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    private async Task OnPageSizeChanged(int value)
    {
        int normalized = _pageSizes.Contains(value) ? value : 20;
        if (normalized == _pageSize)
        {
            return;
        }

        _pageSize = normalized;
        ApplyWorkspaceState(CurrentWorkspaceState() with { Cursor = null }, clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    private void ApplyVisibleRows()
    {
        IEnumerable<TenantListRow> rows = _snapshot.Rows;

        if (_snapshot.IsAuthoritativeSearch)
        {
            _visibleRows = _snapshot.Rows;
            return;
        }

        // Ordinary-list fallback retains the existing page-local status and sorting semantics.
        if (Enum.TryParse(_statusFilter, out TenantStatus status))
        {
            rows = rows.Where(r => r.Status == status);
        }

        rows = _sortColumn switch
        {
            TenantListSortColumns.Name => _sortDescending
                ? rows.OrderByDescending(r => r.Name, StringComparer.OrdinalIgnoreCase)
                : rows.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
            TenantListSortColumns.Status => _sortDescending
                ? rows.OrderByDescending(r => r.Status)
                : rows.OrderBy(r => r.Status),
            _ => _sortDescending
                ? rows.OrderByDescending(r => r.TenantId, StringComparer.Ordinal)
                : rows.OrderBy(r => r.TenantId, StringComparer.Ordinal),
        };

        _visibleRows = rows.ToArray();
    }

    private string CreateDetailHref(TenantListRow row)
        => CurrentNavigationContext().ToDetailUrl(row);

    private string CreateAuditHref(TenantListRow row)
        => CurrentNavigationContext().ToAuditUrl(row);

    private TenantListNavigationContext CurrentNavigationContext()
        => new(CurrentWorkspaceState());

    private void RestoreContextFromQuery()
    {
        ApplyWorkspaceState(WorkspaceStateFromQuery(), clearCursorHistory: true);
    }

    private TenantWorkspaceState WorkspaceStateFromQuery()
        => TenantWorkspaceState.FromQuery(
            QueryTab,
            QueryScope,
            QueryUserId,
            QuerySearch,
            QueryStatus,
            QuerySort,
            QuerySortDescending,
            QueryCursor,
            QuerySelectedTenantId,
            QueryAnchor);

    private async Task OnActiveTabChanged(string? activeTabId)
    {
        if (!IsInteractiveCircuit || _disposed || string.IsNullOrWhiteSpace(activeTabId))
        {
            return;
        }

        string previousTab = _activeTabId;

        // Remember the last looked-up user so a Users -> Tenants -> Users round-trip restores it (mirrors the
        // remembered tenant scope). The userId lives in the URL only while the Users tab is active, so capture
        // it before navigating away from that tab.
        if (string.Equals(previousTab, UsersTabId, StringComparison.Ordinal))
        {
            _usersTabUserId = _workspaceState.UserId;
            _usersTabSort = _workspaceState.Sort;
        }

        if (string.Equals(NormalizeTab(activeTabId), UsersTabId, StringComparison.Ordinal))
        {
            // Keep the remembered tenant scope so a Tenants -> Users -> Tenants round-trip can restore the
            // My tenants view, and restore the last looked-up user so the Users tab is not reset to a blank
            // form. Scope is inert on the Users tab (IsMyTenantsView requires the Tenants tab).
            TenantWorkspaceState usersState = TenantWorkspaceState.FromQuery(
                UsersTabId,
                AllTenantsScope,
                _usersTabUserId,
                search: null,
                status: null,
                _usersTabSort,
                sortDescending: null,
                cursor: null,
                selectedTenantId: null,
                anchor: null);
            ApplyWorkspaceState(usersState, clearCursorHistory: true);
            NavigateToCanonicalWorkspaceIfNeeded(usersState);
            return;
        }

        // Restore the last tenant surface while resetting its cursor at the tab boundary.
        TenantWorkspaceState tenantsState = _tenantWorkspaceState.WithTab(TenantsTabId);
        ApplyWorkspaceState(tenantsState, clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false);
        }
    }

    private async Task OnTenantScopeChanged(string? scope)
    {
        ApplyWorkspaceState(CurrentWorkspaceState().WithScope(scope), clearCursorHistory: true);
        NavigateToCanonicalWorkspace();

        if (IsTenantListView)
        {
            await LoadAsync(reuseETag: false);
        }
    }

    private static string NormalizeTab(string? value)
        => string.Equals(value, UsersTabId, StringComparison.OrdinalIgnoreCase) ? UsersTabId : TenantsTabId;

    private async Task OnTenantSortChanged(DataGridSortEventArgs<TenantListRow> args)
    {
        string sortColumn = args.Column?.ColumnId switch
        {
            "tenant-id" => TenantListSortColumns.Name,
            "tenant-status" => TenantListSortColumns.Status,
            _ => TenantListSortColumns.TenantId,
        };
        ApplyWorkspaceState(
            CurrentWorkspaceState().WithSort(sortColumn, descending: args.SortByAscending is false),
            clearCursorHistory: true);
        NavigateToCanonicalWorkspace();
        await LoadAsync(reuseETag: false);
    }

    private TenantWorkspaceState CurrentWorkspaceState()
        => IsUsersTab
            ? _workspaceState
            : TenantWorkspaceState.FromQuery(
                _activeTabId,
                _tenantScope,
                userId: null,
                _search,
                _statusFilter,
                _sortColumn,
                _sortDescending ? bool.TrueString : null,
                _currentCursor,
                _selectedTenantId,
                _returnAnchor);

    private void ApplyWorkspaceState(TenantWorkspaceState state, bool clearCursorHistory = false)
    {
        _workspaceState = state;
        _activeTabId = state.Tab;
        if (clearCursorHistory)
        {
            // No pending-recovery clear here. It was unreachable on the path that mattered -- this runs from
            // RestoreContextFromQuery before SearchPaging is ever resolved, so the null-conditional made it a
            // guaranteed no-op on a fresh instance -- and it is redundant everywhere else: EnsureScope resets
            // PendingRecoveryScope whenever the search scope actually changes. Clearing it on a transition
            // that keeps the same scope would destroy copy the operator is still owed.
            _cursorHistory.Clear();
            if (state.Tab == TenantsTabId && !string.IsNullOrWhiteSpace(state.Cursor))
            {
                _cursorHistory.Push(null);
            }
        }

        if (state.Tab == UsersTabId)
        {
            _usersTabUserId = state.UserId;
            _usersTabSort = state.Sort;
            return;
        }

        _tenantWorkspaceState = state;
        _tenantScope = state.Scope;
        _search = state.Search;
        _statusFilter = state.Status;
        _sortColumn = state.Sort;
        _sortDescending = state.SortDescending;
        _currentCursor = state.Cursor;
        _selectedTenantId = state.SelectedTenantId;
        _returnAnchor = state.Anchor;
    }

    private void NavigateToCanonicalWorkspace()
    {
        _workspaceState = CurrentWorkspaceState();
        if (_workspaceState.Tab == TenantsTabId)
        {
            _tenantWorkspaceState = _workspaceState;
        }

        NavigateToCanonicalWorkspaceIfNeeded(_workspaceState);
    }

    private bool NavigateToCanonicalWorkspaceIfNeeded(TenantWorkspaceState state)
    {
        string canonicalUrl = state.ToCanonicalUrl();
        string currentUrl = HttpContext is null
            ? Navigation.ToBaseRelativePath(Navigation.Uri)
            : $"{HttpContext.Request.Path}{HttpContext.Request.QueryString}";
        int fragmentIndex = currentUrl.IndexOf('#', StringComparison.Ordinal);
        if (fragmentIndex >= 0)
        {
            currentUrl = currentUrl[..fragmentIndex];
        }

        currentUrl = $"/{currentUrl.TrimStart('/')}";
        if (string.Equals(currentUrl, canonicalUrl, StringComparison.Ordinal))
        {
            return false;
        }

        Navigation.NavigateTo(canonicalUrl, replace: true);
        return true;
    }

    public void Dispose()
    {
        // The pending recovery scope is deliberately NOT cleared here. It is owed copy explaining that
        // protected paging restarted at page one, it is bound to the exact search scope that owes it, and
        // it lives in the circuit-scoped service precisely so it survives the component disposal a
        // tenant-detail navigation causes. Clearing it here destroyed it on the way out and the operator
        // came back to a silently restarted search with no notice -- the invariant ExplainsSearchRestart
        // exists to prevent. A later load for a different scope discards it through EnsureScope.
        _disposed = true;
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
    }
}
