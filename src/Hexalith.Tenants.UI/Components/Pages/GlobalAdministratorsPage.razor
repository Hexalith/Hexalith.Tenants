    private void SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot snapshot)
    {
        _grantSnapshot = snapshot;
        if (CreateReconciliation(snapshot) is { } reconciliation)
        {
            _ = _grantAdmissionLease?.TryAdvanceReconciliation(_fixedAggregateOwner, reconciliation);
        }
        if (_grantAdmissionLease?.TryReleaseTerminal(_fixedAggregateOwner, snapshot.State) == true)
        {
            _grantAdmissionLease = null;
