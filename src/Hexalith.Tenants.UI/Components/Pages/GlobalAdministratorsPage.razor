        _removeAdmissionLease = null;
        _removeAcknowledgement = null;
        SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Idle());
        _focusRemoveLauncherPending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

