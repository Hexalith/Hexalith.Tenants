                Localizer["Tenants.GlobalAdministrators.Grant.State.UnableToVerify"]);
        }

        GlobalAdministratorGrantCommandSnapshot statusSnapshot = statusBasis.ApplyStatus(status);
        bool statusApplied = false;
        bool resumeAdopted = false;
        await InvokeAsync(() =>
