    private async Task HandleRemovePreviewKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await CancelRemoveAsync().ConfigureAwait(false);
        }
    }

    private async Task FocusRemoveSubmitAsync(FocusEventArgs args)
        => await _removeSubmitElement.FocusAsync().ConfigureAwait(false);

