                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.ProjectionLifecycle.Label"]"
                                    ColumnId="global-admin-projection-lifecycle"
                                    Width="180px">
                        <ProjectionLifecycleBadge Lifecycle="@context.Lifecycle"
                                                  TestId="tenants-global-admins-projection-lifecycle" />
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Actions"]"
                                    ColumnId="global-admin-actions"
                                    Width="300px">
                        <FluentStack Orientation="Orientation.Vertical"
                                     VerticalGap="0.375rem"
                                     Class="global-admins__actions"
                                     role="group"
                                     aria-describedby="@RemoveDescribedBy(context)"
                                     data-testid="tenants-global-admins-action-reasons">
                            @* When grant is available, hide the affirmative Available claim with the initiation
                               controls on narrow viewports so AC5 does not advertise availability beside CSS-hidden
                               high-impact actions. The mobile-only reason stays visible at that breakpoint. *@
                            <FluentText data-testid="tenants-global-admins-grant-reason"
                                  class="@(string.IsNullOrWhiteSpace(GrantUnavailableReason) ? "global-admins__mutation-initiation" : null)">
                                @(GrantUnavailableReason ?? Localizer["Tenants.GlobalAdministrators.Grant.Available"])
                            </FluentText>
                            <span class="global-admins__mobile-mutation-reason"
