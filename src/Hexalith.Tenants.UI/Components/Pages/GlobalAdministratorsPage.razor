    protected override async Task OnInitializedAsync()
    {
        _aggregateAdmissionGate = Services.GetService<TenantAggregateCommandAdmissionGate>();
        if (_aggregateAdmissionGate is not null)
        {
            _aggregateAdmissionGate.StateChanged += OnFixedAggregateAdmissionChanged;
            AdoptRetainedReconciliation();
        }

        _viewportObservation = Services.GetService<TenantHighImpactViewportObservation>();
        if (_viewportObservation is not null)
        {
            _viewportObservation.StateChanged += OnViewportObservationChanged;
        }

        // Subscribed BEFORE the resolve, not after it. Attaching afterwards left a window in which a sign-out
        // fired against no handler at all and was simply lost; the pre-sign-out Authorized was then written
        // unconditionally and the whole privileged surface rendered for a signed-out principal, with no later
        // transition left to correct it. This method starts on the dispatcher, so the subscription needs no hop.
        // TenantDetailPage.OnInitialized subscribes on the same edge for the same reason.
        _authenticationStateProvider = Services.GetService(typeof(AuthenticationStateProvider)) as AuthenticationStateProvider;
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        }

        // Captured before the resolve for the same reason ReauthorizeAsync captures it: a transition landing
        // while this resolve is in flight must win over the answer that was already in flight.
        long version = Volatile.Read(ref _authorizationTransitionVersion);
        TenantLifecycleAuthorizationReflectionState reflection =
            await ResolveAuthorizationReflectionAsync().ConfigureAwait(false);
        bool shouldLoad = false;
        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (!CanApplyAuthorizationTransition(version))
            {
                return;
            }

            _authorizationReflection = reflection;
            if (!IsAuthorized)
            {
                _snapshot = GlobalAdministratorsSnapshot.Unauthorized();
                return;
            }

            if (!BffComposition.IsReadSurfaceConnected)
            {
                _snapshot = GlobalAdministratorsSnapshot.Unavailable();
                return;
            }

            shouldLoad = true;
        }).ConfigureAwait(false);

        if (shouldLoad)
        {
            await LoadAsync(reuseETag: false).ConfigureAwait(false);
            await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Retry optional notification setup after later renders when an earlier transient setup returned no
        // lease. The method's in-flight and existing-lease guards keep successful setup single-instance.
        await EnsureReadRefreshLeaseAsync().ConfigureAwait(false);

        if (_focusGrantUserIdPending)
        {
            _focusGrantUserIdPending = false;
            await FocusSafelyAsync(_grantUserIdElement.Element).ConfigureAwait(false);
        }

        if (_focusGrantLauncherPending)
        {
            _focusGrantLauncherPending = false;
            await FocusSafelyAsync(_grantLauncherElement).ConfigureAwait(false);
        }

        if (_focusGrantLifecyclePending)
        {
            _focusGrantLifecyclePending = false;
            await FocusSafelyAsync(_grantLifecycleElement).ConfigureAwait(false);
        }

        if (_focusGrantPreviewCancelPending)
        {
            _focusGrantPreviewCancelPending = false;
            await FocusSafelyAsync(_grantPreviewCancelElement).ConfigureAwait(false);
        }

        if (_focusRemoveAcknowledgementPending)
        {
            _focusRemoveAcknowledgementPending = false;
            await FocusSafelyAsync(_removeAcknowledgementElement.Element).ConfigureAwait(false);
        }

        if (_focusRemoveLauncherPending)
        {
            _focusRemoveLauncherPending = false;
            GlobalAdministratorRemoveLauncher? launcher = _removeLauncher;
            _removeLauncher = null;
            if (launcher is null || !await launcher.TryFocusAsync().ConfigureAwait(false))
            {
                _focusRemoveLifecyclePending = true;
                StateHasChanged();
            }
        }

        if (_focusRemoveLifecyclePending)
        {
            _focusRemoveLifecyclePending = false;
            await FocusSafelyAsync(_removeLifecycleElement).ConfigureAwait(false);
        }
    }

    // A pending focus can outlive its circuit: the flag is set during a render that the operator then
    // abandons (navigation, tab close, dropped connection). The interop call is the first thing to notice,
    // and an unguarded throw here escapes OnAfterRenderAsync. Every sibling focus call in this project --
    // including GlobalAdministratorCorrectionPanel in this same flow -- swallows the disconnect instead.
    private static Task FocusSafelyAsync(ElementReference element)
        => ExecuteFocusSafelyAsync(async () => await element.FocusAsync().ConfigureAwait(false));

    private static async Task ExecuteFocusSafelyAsync(Func<Task> focus)
    {
        try
        {
            await focus().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // Circuit dropped between the render that requested focus and this call; focus is unobservable.
        }
        catch (ObjectDisposedException)
        {
            // The renderer or its JS runtime was torn down while the focus call was in flight.
        }
        catch (JSException)
        {
            // A rerender detached the captured element before focus reached the browser.
        }
    }

    private async Task FocusElementByIdSafelyAsync(
        string elementId,
        GlobalAdministratorRemovePreview expectedPreview)
    {
        if (!IsCurrentRemovePreview(expectedPreview))
        {
            await FocusRemoveFallbackAsync(expectedPreview).ConfigureAwait(false);
            return;
        }

        bool useFallback = false;
        IJSObjectReference? importedModule = null;
        try
        {
            IJSObjectReference? module;
            lock (_focusModuleLock)
            {
                module = _focusModule;
            }

            if (module is null)
            {
                importedModule = await JS
                    .InvokeAsync<IJSObjectReference>("import", FocusModulePath)
                    .ConfigureAwait(false);
                lock (_focusModuleLock)
                {
                    if (IsCurrentRemovePreview(expectedPreview) && _focusModule is null)
                    {
                        _focusModule = importedModule;
                        module = importedModule;
                        importedModule = null;
                    }
                    else
                    {
                        module = _focusModule;
                    }
                }
            }

            if (importedModule is not null)
            {
                await DisposeFocusModuleSafelyAsync(importedModule).ConfigureAwait(false);
                importedModule = null;
            }

            if (module is not null && IsCurrentRemovePreview(expectedPreview))
            {
                useFallback = !await module
                    .InvokeAsync<bool>("focusElementById", elementId)
                    .ConfigureAwait(false);
            }
            else
            {
                useFallback = true;
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit disappeared while the semantic sentinel routed focus to the Fluent action.
            useFallback = true;
        }
        catch (ObjectDisposedException)
        {
            // The renderer or imported module was disposed during focus routing.
            useFallback = true;
        }
        catch (JSException)
        {
            // A newer render detached the exact focus target before JavaScript observed it.
            useFallback = true;
        }
        finally
        {
            if (importedModule is not null)
            {
                await DisposeFocusModuleSafelyAsync(importedModule).ConfigureAwait(false);
            }
        }

        if (useFallback || !IsCurrentRemovePreview(expectedPreview))
        {
            await FocusRemoveFallbackAsync(expectedPreview).ConfigureAwait(false);
        }
    }

    private async Task FocusRemoveFallbackAsync(GlobalAdministratorRemovePreview expectedPreview)
    {
        if (IsCurrentRemovePreview(expectedPreview))
        {
            await FocusSafelyAsync(_removeAcknowledgementElement.Element).ConfigureAwait(false);
        }
        else if (!_disposed)
        {
            await FocusSafelyAsync(_removeLifecycleElement).ConfigureAwait(false);
        }
    }

    private static async Task DisposeFocusModuleSafelyAsync(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone and the orphaned module is no longer observable.
        }
        catch (ObjectDisposedException)
        {
            // A concurrent teardown already disposed the module.
        }
        catch (JSException)
        {
            // Browser teardown can reject disposal after navigation; containment is sufficient.
        }
    }

    private bool IsCurrentRemovePreview(GlobalAdministratorRemovePreview expectedPreview)
        => !_disposed
            && _removeSnapshot.State is TenantCommandLifecycleState.Previewed
            && ReferenceEquals(_removeSnapshot.PreviewEvidence, expectedPreview);

    private async Task<GlobalAdministratorsSnapshot?> LoadAsync(
        bool reuseETag,
        bool retainConfirmed = false,
        string? requestedCursor = null,
        bool useRequestedCursor = false,
        bool reauthorize = true)
    {
        if (reauthorize && !await ReauthorizeAsync().ConfigureAwait(false))
        {
            return null;
        }

        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        GlobalAdministratorsSnapshot previous = _snapshot;
        if (!retainConfirmed)
        {
            // ReauthorizeAsync above is awaited with ConfigureAwait(false), so this runs on a thread-pool
            // thread whenever it actually suspends. Marshalled and generation-guarded like the result write
            // below: an unguarded write here can overwrite a newer applied snapshot with Loading, and
            // Loading is not in CanRecover, so the page would offer neither Retry nor Reset.
            await InvokeAsync(() =>
            {
                if (CanApply(generation))
                {
                    _snapshot = GlobalAdministratorsSnapshot.Loading();
                }
            }).ConfigureAwait(false);
        }

        GlobalAdministratorsRequest request = new(
            Cursor: useRequestedCursor ? requestedCursor : _currentCursor,
            PageSize: PageSize,
            ETag: reuseETag ? previous.ETag : null);

        try
        {
            GlobalAdministratorsSnapshot result = await QueryGateway
                .GetGlobalAdministratorsAsync(request, previous, cancellationToken)
                .ConfigureAwait(false);
            if (!CanApply(generation))
            {
                return null;
            }

            if (result.Kind is GlobalAdministratorsSurfaceKind.Unauthorized)
            {
                await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                    .ConfigureAwait(false);
                return result;
            }

            // A complete-population walk is mutation evidence, not a display recovery mechanism. Starting
            // it for Loading/Error/Stale/legacy Ready shapes both spends an unnecessary request and can turn
            // a perfectly usable authorized read-only surface into a gateway exception. Only a qualified
            // direct-read result may seed the independent bounded walk. Every other shape deliberately gets
            // an incomplete sentinel, so the evaluator remains fail closed without disturbing review rows.
            GlobalAdministratorsSnapshot completeResult = result.IsCompleteEvidence
                ? result
                : CanSeedCompletePopulationWalk(result)
                    ? await LoadCompletePopulationSafelyAsync(cancellationToken).ConfigureAwait(false)
                    : GlobalAdministratorsSnapshot.Unavailable(GlobalAdministratorsReason.GatewayUnavailable);
            if (!CanApply(generation))
            {
                return null;
            }

            if (completeResult.Kind is GlobalAdministratorsSurfaceKind.Unauthorized)
            {
                await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                    .ConfigureAwait(false);
                return completeResult;
            }

            // Re-checked inside the dispatcher callback: the CanApply above ran on a thread-pool
            // continuation, so a newer load -- or ResetPagingAsync, which clears the cursor state -- can win
            // between that check and this write and have page-N rows land on top of a newer page-one
            // snapshot. The Loading write earlier in this method already guards this way.
            await InvokeAsync(() =>
            {
                if (!CanApply(generation))
                {
                    return;
                }

                _snapshot = result;
                _completeSnapshot = completeResult;

                // The truncation notice describes one past navigation step, not a property of the current
                // page. Clear it on every successfully applied load, including notification and command-driven
                // refreshes. PreviousPageAsync sets it again after this method returns when this very load is
                // the jump to page one.
                _pagingJumpedToFirstPage = false;
                _authorizationPagingReset = false;
                if (result.PagingRecovered)
                {
                    _cursorHistory.Clear();
                    _pagingHistoryTruncated = false;
                    _currentCursor = null;
                }

                StateHasChanged();
            }).ConfigureAwait(false);
            return result;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return null;
        }
    }

    private static bool CanSeedCompletePopulationWalk(GlobalAdministratorsSnapshot snapshot)
        => snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready or GlobalAdministratorsSurfaceKind.Empty
            && snapshot.RequestCursor is null
            && snapshot.Freshness is ReadModelFreshnessState.Current
            && snapshot.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(snapshot.ProjectionVersion)
            && (snapshot.Kind is not GlobalAdministratorsSurfaceKind.Empty
                || snapshot.IsAuthorizationScopedEmpty);

    private async Task<GlobalAdministratorsSnapshot> LoadCompletePopulationSafelyAsync(
        CancellationToken cancellationToken)
    {
        try
        {
            return await GlobalAdministratorsProjectionLoader.LoadAsync(
                QueryGateway,
                new GlobalAdministratorsRequest(PageSize: PageSize),
                cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception exception)
        {
            if (Services.GetService(typeof(ILoggerFactory)) is ILoggerFactory loggerFactory)
            {
                loggerFactory.CreateLogger<GlobalAdministratorsPage>().LogWarning(
                    exception,
                    "The bounded global-administrator population walk failed; removal remains unavailable.");
            }

            return GlobalAdministratorsSnapshot.Unavailable(GlobalAdministratorsReason.GatewayFailure);
        }
    }

    internal async Task RefreshAsync()
    {
        // Refresh takes the same exclusion gate as Retry, Reset, Next and Previous. Without it, a Refresh click
        // during an in-flight Next bumped _loadGeneration and cancelled Next's token, so Next's LoadAsync
        // returned null, no cursor was pushed, and the operator's click produced no navigation, no notice and no
        // lifecycle state. AC4's "newest scoped request wins" does not cover this: Refresh re-reads the SAME
        // cursor rather than supplying fresher evidence, so there is nothing newer to prefer.
        if (!TryBeginPageLoad())
        {
            return;
        }

        // An explicit refresh is the operator asking for a fresh attempt at everything, including the
        // optional notification subscription. It is also the only thing that resets the setup budget:
        // OnAfterRenderAsync retries a failed subscribe, but a failing backend records no lease, so every
        // guard passed again on the next render -- two remote round trips per render, unbounded, for the
        // life of the circuit. With the budget, "manual refresh retries notification setup" is a real
        // behaviour rather than a restatement of "any render retries".
        Volatile.Write(ref _readRefreshAttempts, 0);

        // Cleared here, unconditionally, as well as on each applied load. The per-load clear alone left the
        // notice rendered for good when a refresh was cancelled, superseded or faulted, because it only runs
        // inside the CanApply block -- the stale one-shot notice this placement originally fixed.
        _pagingJumpedToFirstPage = false;

        // The authorization-restart notice is the same shape of one-shot evidence and needs the same treatment;
        // it was added with only the per-load clear, so a superseded or faulted refresh stranded it forever.
        _authorizationPagingReset = false;

        try
        {
            await LoadAsync(reuseETag: true).ConfigureAwait(false);
        }
        finally
        {
            EndPageLoad();
        }
    }

    // Retry and Reset share the pager's in-flight gate. Both render alongside the pager whenever a rows-
    // bearing snapshot is also recoverable (Stale, for example), and neither used to set or read it: a Next
    // click followed by Reset cleared the cursor state synchronously, Next's LoadAsync then returned null as
    // superseded and its finally re-enabled the pager against the pre-reset snapshot, so the next Next
    // pushed a null prior cursor and recorded page one for a view showing page four.
    // internal, not private: like the member pager guards, these exist for the click dispatched BEFORE the
    // Disabled re-render lands, so asserting the rendered `disabled` attribute cannot observe them. The test
    // project has InternalsVisibleTo and invokes them directly.
    internal async Task RetryAsync()
    {
        if (!TryBeginPageLoad())
        {
            return;
        }

        // Retry is the rows-free recovery path; Refresh is rendered only with rows. Both must reopen the
        // bounded optional-subscription setup budget or an Error/Empty surface can never restore nudges.
        Volatile.Write(ref _readRefreshAttempts, 0);
        try
        {
            _ = await LoadAsync(reuseETag: false, retainConfirmed: true).ConfigureAwait(false);
        }
        finally
        {
            EndPageLoad();
        }
    }

    internal async Task RetryAuthorizationAsync()
    {
        if (_disposed
            || _authorizationReflection is not TenantLifecycleAuthorizationReflectionState.Indeterminate
            || !TryBeginPageLoad())
        {
            return;
        }

        // A recovered authorization boundary starts a fresh subscription opportunity as well as a fresh read.
        Volatile.Write(ref _readRefreshAttempts, 0);
        StateHasChanged();
        try
        {
            if (!await ReauthorizeAsync().ConfigureAwait(false))
            {
                return;
            }

            if (!BffComposition.IsReadSurfaceConnected)
            {
                await InvokeAsync(() =>
                {
                    _snapshot = GlobalAdministratorsSnapshot.Unavailable();
                    StateHasChanged();
                }).ConfigureAwait(false);
                return;
            }

            _ = await LoadAsync(reuseETag: false, reauthorize: false).ConfigureAwait(false);
        }
        finally
        {
            // The gate is released directly, not from inside the dispatch. If the circuit tears down while the
            // BFF resolve is suspended, InvokeAsync throws ObjectDisposedException, EndPageLoad() never runs and
            // every recovery control -- including the authorization Retry that exists for exactly this state --
            // stays disabled, while the exception escapes a finally. The four sibling handlers release the gate
            // directly for this reason; only the re-render needs the dispatcher, and it can fail harmlessly.
            EndPageLoad();
            try
            {
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
            catch (ObjectDisposedException)
            {
                // The circuit went away while authorization was resolving; there is nothing left to re-render.
            }
        }
    }

    internal async Task ResetPagingAsync()
    {
        if (!TryBeginPageLoad())
        {
            return;
        }

        // Reset is also rendered on rows-free recoverable states and therefore carries the same optional
        // subscription recovery responsibility as Retry and the rows-bearing Refresh control.
        Volatile.Write(ref _readRefreshAttempts, 0);
        try
        {
            // Marshalled: the renderer reads _cursorHistory.Count for the Previous button's Disabled
            // binding, so this non-thread-safe Stack must not be cleared from a pool thread.
            await InvokeAsync(() =>
            {
                _cursorHistory.Clear();
                _pagingHistoryTruncated = false;
                _pagingJumpedToFirstPage = false;
                _authorizationPagingReset = false;
                _currentCursor = null;
            }).ConfigureAwait(false);
            _ = await LoadAsync(
                reuseETag: false,
                retainConfirmed: false,
                requestedCursor: null,
                useRequestedCursor: true).ConfigureAwait(false);
        }
        finally
        {
            EndPageLoad();
        }
    }

    private async Task RefreshFromNotificationAsync()
    {
        // Deliberately NOT gated on _pageLoadInFlight. A notification landing during a pending cursor load must
        // supersede it: AC4 requires that only the newest scoped request renders, and
        // Newer_notification_refresh_rejects_a_late_cursor_result_and_preserves_cursor_history pins that a late
        // cursor result is rejected while cursor history stays valid. Letting an in-flight pager outrank a
        // fresher notification would render stale rows as current.
        if (_disposed || !IsAuthorized || !BffComposition.IsReadSurfaceConnected)
        {
            return;
        }

        if (_grantAdmissionLease?.IsDispatchMarked == true
            && _grantSnapshot.State is TenantCommandLifecycleState.RequestSent
                or TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify)
        {
            await InvokeAsync(() =>
            {
                SetGrantSnapshot(_grantSnapshot.SignalRNudge());
                StateHasChanged();
            }).ConfigureAwait(false);
            await RefreshGrantStatusAsync().ConfigureAwait(false);
            return;
        }


        if (_removeAdmissionLease?.IsDispatchMarked == true
            && _removeSnapshot.MessageId is not null
            && _removeSnapshot.State is TenantCommandLifecycleState.RequestSent
                or TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify)
        {
            GlobalAdministratorRemoveCommandSnapshot notificationAttempt = _removeSnapshot;
            if (notificationAttempt.CorrelationId is not null)
            {
                await QueueRemoveStatusNudgeAsync(notificationAttempt).ConfigureAwait(false);
            }

            // A correlationless attempt has no read-only status handle. A notification must never route it
            // through the operator recovery method because that method deliberately performs same-id delivery
            // retry. Leave the retained attempt unchanged and wait for explicit operator action.
            return;
        }

        _isNotificationRefreshing = true;
        StateHasChanged();
        try
        {
            await LoadAsync(reuseETag: true, retainConfirmed: true).ConfigureAwait(false);
        }
        finally
        {
            if (!_disposed)
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        _isNotificationRefreshing = false;
                        StateHasChanged();
                    });
                }
                catch (ObjectDisposedException)
                {
                    // Disposed between the check above and the dispatch; nothing left to update. Without
                    // this the throw escaped an unobserved fire-and-forget path, leaving
                    // _isNotificationRefreshing set and the surface announcing "refreshing" for good.
                }
            }
        }
    }

    private async Task QueueRemoveStatusNudgeAsync(GlobalAdministratorRemoveCommandSnapshot exactAttempt)
    {
        TenantAggregateCommandLease? exactLease = _removeAdmissionLease;
        if (exactAttempt.CorrelationId is null
            || exactLease?.IsDispatchMarked != true
            || !HasSameRemoveAttempt(_removeSnapshot, exactAttempt, exactLease))
        {
            return;
        }

        lock (_removeStatusNudgeLock)
        {
            // The fixed aggregate admits one removal at a time. One exact-attempt slot therefore coalesces an
            // arbitrary notification burst without retaining an unbounded queue of stale snapshots.
            _pendingRemoveStatusNudge = (exactAttempt, exactLease);
        }

        await DrainRemoveStatusNudgesAsync().ConfigureAwait(false);
    }

    private async Task DrainRemoveStatusNudgesAsync()
    {
        if (_disposed || Interlocked.CompareExchange(ref _removeStatusNudgeDrainInFlight, 1, 0) != 0)
        {
            return;
        }

        try
        {
            while (!_disposed && Volatile.Read(ref _removeSubmissionInFlight) == 0)
            {
                (GlobalAdministratorRemoveCommandSnapshot Attempt, TenantAggregateCommandLease Lease)? pending;
                lock (_removeStatusNudgeLock)
                {
                    pending = _pendingRemoveStatusNudge;
                    _pendingRemoveStatusNudge = null;
                }

                if (pending is not { } exactWork)
                {
                    break;
                }

                await RefreshRemoveStatusFromNotificationAsync(
                    exactWork.Attempt,
                    exactWork.Lease).ConfigureAwait(false);
            }
        }
        finally
        {
            Volatile.Write(ref _removeStatusNudgeDrainInFlight, 0);
        }

        // Closing the drain gate before this check prevents the classic lost-wakeup interleaving: an enqueue
        // either observes the released gate and becomes the next drainer, or is observed here and re-acquired.
        bool hasPending;
        lock (_removeStatusNudgeLock)
        {
            hasPending = _pendingRemoveStatusNudge is not null;
        }

        if (!_disposed && Volatile.Read(ref _removeSubmissionInFlight) == 0 && hasPending)
        {
            await DrainRemoveStatusNudgesAsync().ConfigureAwait(false);
        }
    }

    private async Task RefreshRemoveStatusFromNotificationAsync(
        GlobalAdministratorRemoveCommandSnapshot exactAttempt,
        TenantAggregateCommandLease exactLease)
    {
        if (exactAttempt.CorrelationId is null
            || Interlocked.CompareExchange(ref _removeSubmissionInFlight, 1, 0) != 0)
        {
            if (exactAttempt.CorrelationId is not null)
            {
                lock (_removeStatusNudgeLock)
                {
                    _pendingRemoveStatusNudge = (exactAttempt, exactLease);
                }
            }

            return;
        }

        try
        {
            if (!HasSameRemoveAttempt(_removeSnapshot, exactAttempt, exactLease))
            {
                return;
            }

            await RenderIfAliveAsync().ConfigureAwait(false);

            using PendingOperation operation = BeginRemoveMutation();
            if (!await ReauthorizeAsync(operation.CancellationToken).ConfigureAwait(false)
                || !HasSameRemoveAttempt(_removeSnapshot, exactAttempt, exactLease)
                || !CanRefreshCorrelatedRemoveStatus)
            {
                return;
            }

            await RefreshRemoveStatusCoreAsync(
                operation.Generation,
                operation.CancellationToken,
                exactAttempt,
                exactLease).ConfigureAwait(false);
        }
        finally
        {
            await CompleteRemoveSingleFlightAsync().ConfigureAwait(false);
        }
    }

    private async Task CompleteRemoveSingleFlightAsync()
    {
        Volatile.Write(ref _removeSubmissionInFlight, 0);
        if (!_disposed)
        {
            try
            {
                await InvokeAsync(() =>
                {
                    _isRemoveSubmitting = false;
                    StateHasChanged();
                }).ConfigureAwait(false);
            }
            catch (ObjectDisposedException)
            {
                // Navigation can dispose the renderer between the alive check and dispatch.
            }
        }

        await DrainRemoveStatusNudgesAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// Records that optional notification setup failed, using a fixed reason code only.
    /// </summary>
    /// <remarks>
    /// The catch below is deliberately broad, so without this the surface could stop auto-refreshing for the
    /// whole circuit with no signal anywhere. The logger is resolved optionally and the message carries a
    /// constant reason code — no tenant id, projection scope, transport detail, or exception is emitted.
    /// </remarks>
    private void LogNotificationSetupFailure()
    {
        if (Services.GetService(typeof(ILoggerFactory)) is ILoggerFactory loggerFactory)
        {
            loggerFactory
                .CreateLogger<GlobalAdministratorsPage>()
                .LogWarning("Optional projection refresh setup failed. ReasonCode={NotificationReasonCode}", "notification-setup-failed");
        }
    }

    private async Task EnsureReadRefreshLeaseAsync()
    {
        if (_disposed
            || !IsAuthorized
            || !BffComposition.IsReadSurfaceConnected
            || _readRefreshLease is not null
            || Volatile.Read(ref _readRefreshAttempts) >= MaximumReadRefreshAttempts
            || Services.GetService(typeof(TenantReadRefreshSubscription)) is not TenantReadRefreshSubscription refreshSubscription)
        {
            return;
        }

        // Atomic test-and-set, like the sibling page-load gate. This method is entered from OnAfterRenderAsync
        // (dispatcher) and from ApplyAuthenticationStateChangedAsync, which resumes on the thread pool after a
        // ConfigureAwait(false). A plain bool let both pass the guard, both subscribe, and the loser's finally
        // clear the flag while the winner was still in flight -- so the mutual exclusion this flag exists to
        // provide was absent on exactly the two paths that race. Acquired after the cheap guards so a bail-out
        // never has to release it.
        if (Interlocked.CompareExchange(ref _readRefreshSubscriptionInFlight, 1, 0) != 0)
        {
            return;
        }

        TenantReadRefreshLease? lease = null;
        try
        {
            lease = await refreshSubscription.SubscribeAsync(
                GetGlobalAdministratorsQuery.ProjectionType,
                "system",
                () => InvokeAsync(RefreshFromNotificationAsync),
                CancellationToken.None).ConfigureAwait(false);
            if (_disposed || !IsAuthorized || !BffComposition.IsReadSurfaceConnected || _readRefreshLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
                return;
            }

            if (!lease.IsSubscribed)
            {
                // Setup registered no callback. Storing it would satisfy the "_readRefreshLease is not null"
                // guard above forever, permanently disabling auto-refresh for this circuit. This is a failed
                // attempt, so it is what the bounded budget is for.
                Interlocked.Increment(ref _readRefreshAttempts);
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
                lease = null;
                return;
            }

            _readRefreshLease = lease;
            lease = null;

            // Re-checked after the assignment, not only before it. DisposeAsync sets _disposed and then reads a
            // still-null _readRefreshLease, so a continuation that passed the guard above and was preempted
            // could assign the lease afterwards -- leaving the callback registered for the life of the circuit
            // and invoking InvokeAsync on a disposed component. TenantDetailPage guards the same race.
            if (_disposed)
            {
                IAsyncDisposable orphaned = _readRefreshLease;
                _readRefreshLease = null;
                await DisposeLeaseSupportSafelyAsync(orphaned).ConfigureAwait(false);
            }
        }
        catch
        {
            // The budget is charged here, not before the attempt. Counting every attempt charged the
            // successful ones too, so three ordinary authorization transitions -- a JWT renewal, a
            // sign-out/sign-in -- exhausted it even though every subscribe had worked, and auto-refresh went
            // silently off for the rest of the circuit. It also defeated the !lease.IsSubscribed path below,
            // which exists precisely so a later render can retry.
            Interlocked.Increment(ref _readRefreshAttempts);
            // Optional nudge only; never surface transport detail. The reason code is recorded so a
            // permanently non-refreshing surface is diagnosable instead of silent.
            LogNotificationSetupFailure();
            if (lease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
            }
        }
        finally
        {
            Volatile.Write(ref _readRefreshSubscriptionInFlight, 0);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_aggregateAdmissionGate is not null)
        {
            _aggregateAdmissionGate.StateChanged -= OnFixedAggregateAdmissionChanged;
        }

        if (_viewportObservation is not null)
        {
            _viewportObservation.StateChanged -= OnViewportObservationChanged;
        }
        Interlocked.Increment(ref _authorizationTransitionVersion);
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            _authenticationStateProvider = null;
        }
        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation(ref _loadCancellation);
        InvalidateAllMutations();

        if (_grantAdmissionLease is { IsDispatchMarked: false } grantLease
            && grantLease.TryAbandonBeforeDispatch(_fixedAggregateOwner))
        {
            _grantAdmissionLease = null;
        }

        if (_removeAdmissionLease is { IsDispatchMarked: false } removeLease
            && removeLease.TryAbandonBeforeDispatch(_fixedAggregateOwner))
        {
            _removeAdmissionLease = null;
        }

        RetainReconciliationForReplacement();
        IAsyncDisposable? lease = _readRefreshLease;
        _readRefreshLease = null;
        if (lease is not null)
        {
            await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
        }

        IJSObjectReference? focusModule;
        lock (_focusModuleLock)
        {
            focusModule = _focusModule;
            _focusModule = null;
        }

        if (focusModule is not null)
        {
            await DisposeFocusModuleSafelyAsync(focusModule).ConfigureAwait(false);
        }

        _ = _grantAdmissionLease?.TryAbandonBeforeDispatch(_fixedAggregateOwner);
        _ = _removeAdmissionLease?.TryAbandonBeforeDispatch(_fixedAggregateOwner);
    }

    private void OnFixedAggregateAdmissionChanged(object? sender, EventArgs args)
        => _ = ApplyFixedAggregateAdmissionChangeAsync();

    private async Task ApplyFixedAggregateAdmissionChangeAsync()
    {
        GlobalAdministratorRemoveCommandSnapshot? resume = null;
        if (!await InvokeRendererSafelyAsync(() =>
            {
                if (SynchronizeOwnedRemoveReconciliation()
                    && _removeSnapshot.CorrelationId is not null
                    && HasRemoveRecoveryState)
                {
                    resume = _removeSnapshot;
                }

                StateHasChanged();
            }).ConfigureAwait(false))
        {
            return;
        }

        if (resume is not null)
        {
            await QueueRemoveStatusNudgeAsync(resume).ConfigureAwait(false);
        }
    }

    private void OnViewportObservationChanged(object? sender, EventArgs args)
        => _ = RenderIfAliveAsync();

    private async Task<bool> InvokeRendererSafelyAsync(Action callback)
    {
        ArgumentNullException.ThrowIfNull(callback);
        if (_disposed)
        {
            return false;
        }

        bool invoked = false;
        try
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                callback();
                invoked = true;
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // Navigation can tear down the renderer between the alive check and dispatch.
        }

        return invoked;
    }

    private async Task RenderIfAliveAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // A state notification raced component disposal.
        }
    }

    private async Task NextPageAsync()
    {
        // Both conditions, matching the Disabled binding and LoadNextMemberPageAsync. These handler guards exist
        // for the click dispatched BEFORE the disabled attribute lands, so checking only the cursor let that
        // click page past a declared end and push a history entry for a page that does not exist.
        if (!_snapshot.HasMore || string.IsNullOrWhiteSpace(_snapshot.NextCursor) || !TryBeginPageLoad())
        {
            return;
        }

        string? priorCursor = _currentCursor;
        string nextCursor = _snapshot.NextCursor;
        try
        {
            GlobalAdministratorsSnapshot? result = await LoadAsync(
                reuseETag: false,
                requestedCursor: nextCursor,
                useRequestedCursor: true).ConfigureAwait(false);
            // Marshalled: this continuation resumes on a thread-pool thread while the render LoadAsync
            // queued through InvokeAsync is in flight, and that render reads _cursorHistory.Count for the
            // Previous button's Disabled binding. Pushing onto a non-thread-safe Stack concurrently with
            // that read is a data race, and could render page-2 rows with Previous still disabled.
            //
            // No PagingRecovered check here: page-one recovery re-requests with Cursor = null and every
            // snapshot is stamped RequestCursor = request.Cursor, so a recovered snapshot always carries a
            // null RequestCursor -- which IsAppliedRequestedPage already rejects, since this method returns
            // early on a blank NextCursor. The clause was unreachable. PreviousPageAsync keeps it, where a
            // null previousCursor is legitimate.
            await InvokeAsync(() =>
            {
                if (IsAppliedRequestedPage(result, nextCursor)
                    && ReferenceEquals(_snapshot, result))
                {
                    _cursorHistory.Push(priorCursor);
                    _currentCursor = nextCursor;
                    _pagingHistoryTruncated |= CursorHistory.Trim(_cursorHistory, MaximumCursorHistory);
                    _pagingJumpedToFirstPage = false;
                }
            }).ConfigureAwait(false);
        }
        finally
        {
            EndPageLoad();
        }
    }


    private async Task PreviousPageAsync()
    {
        if (_cursorHistory.Count == 0 || !TryBeginPageLoad())
        {
            return;
        }

        string? previousCursor = _cursorHistory.Peek();
        try
        {
            GlobalAdministratorsSnapshot? result = await LoadAsync(
                reuseETag: false,
                requestedCursor: previousCursor,
                useRequestedCursor: true).ConfigureAwait(false);
            // Marshalled for the same reason as NextPageAsync: Pop mutates the Stack the renderer reads.
            await InvokeAsync(() =>
            {
                if (IsAppliedRequestedPage(result, previousCursor)
                    && ReferenceEquals(_snapshot, result)
                    && !result!.PagingRecovered
                    && _cursorHistory.Count > 0)
                {
                    _currentCursor = _cursorHistory.Pop();

                    // A trimmed history re-appends the first-page sentinel beneath the newest entries, so one
                    // Previous click walks the operator from the middle of the sequence straight to page one.
                    // Rendered as an ordinary step back it silently misstates where they are.
                    _pagingJumpedToFirstPage = _pagingHistoryTruncated
                        && _currentCursor is null
                        && _cursorHistory.Count == 0;
                    if (_pagingJumpedToFirstPage)
                    {
                        _pagingHistoryTruncated = false;
                    }
                }
            }).ConfigureAwait(false);
        }
        finally
        {
            EndPageLoad();
        }
    }

    private PendingOperation BeginLoad()
    {
        CancellationTokenSource source = ReplaceActiveCancellation(ref _loadCancellation);
        return new(
            Interlocked.Increment(ref _loadGeneration),
            source,
            () => CompleteCancellation(ref _loadCancellation, source));
    }

    private CancellationTokenSource ReplaceActiveCancellation(ref CancellationTokenSource? active)
    {
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(active);
            active = source;
        }

        return source;
    }

    private void CancelActiveCancellation(ref CancellationTokenSource? active)
    {
        lock (_cancellationLock)
        {
            RetireCancellationCore(active);
            active = null;
        }
    }

    private void RetireCancellationCore(CancellationTokenSource? source)
    {
        if (source is null)
        {
            return;
        }

        source.Cancel();
    }

    private void CompleteCancellation(
        ref CancellationTokenSource? active,
        CancellationTokenSource source)
    {
        lock (_cancellationLock)
        {
            if (ReferenceEquals(active, source))
            {
                active = null;
            }
        }

        source.Dispose();
    }

    private bool CanApply(long generation)
        => !_disposed && generation == Volatile.Read(ref _loadGeneration);

    private PendingOperation BeginGrantMutation()
    {
        CancellationTokenSource source = ReplaceActiveCancellation(ref _grantMutationCancellation);
        return new(
            Interlocked.Increment(ref _grantMutationGeneration),
            source,
            () => CompleteCancellation(ref _grantMutationCancellation, source));
    }

    private PendingOperation BeginRemoveMutation()
    {
        CancellationTokenSource source = ReplaceActiveCancellation(ref _removeMutationCancellation);
        return new(
            Interlocked.Increment(ref _removeMutationGeneration),
            source,
            () => CompleteCancellation(ref _removeMutationCancellation, source));
    }

    private void InvalidateGrantMutation()
    {
        Interlocked.Increment(ref _grantMutationGeneration);
        CancelActiveCancellation(ref _grantMutationCancellation);

        _isGrantSubmitting = false;
    }

    private void InvalidateRemoveMutation()
    {
        Interlocked.Increment(ref _removeMutationGeneration);
        CancelActiveCancellation(ref _removeMutationCancellation);

        _isRemoveSubmitting = false;
    }

    private void InvalidateAllMutations()
    {
        // Cancelling or superseding an in-flight submit moves its generation forward, so the owning
        // submit's finally can no longer clear its own flag. Each invalidation clears the matching flag so
        // that grant and remove stay independently reachable.
        InvalidateGrantMutation();
        InvalidateRemoveMutation();
    }

    private bool CanApplyGrantMutation(long generation)
        => !_disposed && IsAuthorized && generation == Volatile.Read(ref _grantMutationGeneration);

    private bool CanApplyRemoveMutation(long generation)
        => !_disposed && IsAuthorized && generation == Volatile.Read(ref _removeMutationGeneration);

    private static bool IsAppliedRequestedPage(
        GlobalAdministratorsSnapshot? snapshot,
        string? requestedCursor)
        => snapshot is not null
            && (snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
                or GlobalAdministratorsSurfaceKind.Stale
                or GlobalAdministratorsSurfaceKind.Unknown
                or GlobalAdministratorsSurfaceKind.Empty
                or GlobalAdministratorsSurfaceKind.Degraded)
            && string.Equals(snapshot.RequestCursor, requestedCursor, StringComparison.Ordinal);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        long version = Interlocked.Increment(ref _authorizationTransitionVersion);
        Task callback = InvokeAsync(() => ApplyAuthenticationStateChangedAsync(authenticationStateTask, version));
        _ = ObserveAuthenticationCallbackAsync(callback);
    }

    private async Task ApplyAuthenticationStateChangedAsync(
        Task<AuthenticationState> authenticationStateTask,
        long version)
    {
        if (!CanApplyAuthorizationTransition(version))
        {
            return;
        }

        await CollapseAuthorizationAsync(
            TenantLifecycleAuthorizationReflectionState.Indeterminate,
            invalidateTransition: false).ConfigureAwait(false);
        if (!CanApplyAuthorizationTransition(version))
        {
            return;
        }

        try
        {
            // Awaited only to let the transition settle before re-resolving. The event's own principal is
            // deliberately NOT used as evidence: Evaluate() runs without the IUserContextAccessor corroboration
            // that governs every other path, so trusting it here made the authentication-transition path the
            // weakest gate on the surface it re-enables.
            _ = await authenticationStateTask.ConfigureAwait(false);
        }
        catch
        {
            return;
        }

        if (!CanApplyAuthorizationTransition(version))
        {
            return;
        }

        TenantLifecycleAuthorizationReflectionState reflection =
            await ResolveAuthorizationReflectionAsync().ConfigureAwait(false);
        if (reflection is not TenantLifecycleAuthorizationReflectionState.Authorized)
        {
            await CollapseAuthorizationAsync(reflection, invalidateTransition: false).ConfigureAwait(false);
            return;
        }

        // Guarded INSIDE the callback, not only around it. The version was last checked before the resolve
        // above; a sign-out landing while that resolve was in flight bumps it, and that newer transition's own
        // collapse can run before this continuation is dispatched. Writing Authorized unconditionally here
        // restored the grant and remove forms for an operator who had already signed out -- and when the newer
        // transition then faulted on its authentication-state task it returned without re-collapsing, so the
        // privileged surface persisted with nothing left to correct it. The post-hoc check below cannot undo a
        // write that has already rendered. ReauthorizeAsync guards the same field the same way.
        bool applied = false;
        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (!CanApplyAuthorizationTransition(version))
            {
                return;
            }

            _authorizationReflection = TenantLifecycleAuthorizationReflectionState.Authorized;
            AdoptRetainedReconciliation();
            _snapshot = BffComposition.IsReadSurfaceConnected
                ? GlobalAdministratorsSnapshot.Loading()
                : GlobalAdministratorsSnapshot.Unavailable();
            applied = true;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (!applied || !CanApplyAuthorizationTransition(version) || !BffComposition.IsReadSurfaceConnected)
        {
            return;
        }

        _ = await LoadAsync(reuseETag: false, reauthorize: false).ConfigureAwait(false);
        if (!CanApplyAuthorizationTransition(version) || !IsAuthorized)
        {
            return;
        }

        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (CanApplyAuthorizationTransition(version) && IsAuthorized)
            {
                _authorizationPagingReset = true;
                StateHasChanged();
            }
        }).ConfigureAwait(false);

        await EnsureReadRefreshLeaseAsync().ConfigureAwait(false);
        await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
    }

    private bool CanApplyAuthorizationTransition(long version)
        => !_disposed && version == Volatile.Read(ref _authorizationTransitionVersion);

    private static async Task ObserveAuthenticationCallbackAsync(Task callback)
    {
        try
        {
            await callback.ConfigureAwait(false);
        }
        catch
        {
            // Authentication transitions contain faults and leave the surface failed closed.
        }
    }

    private async Task<bool> ReauthorizeAsync(CancellationToken cancellationToken = default)
    {
        // The transition version is captured before the resolve. A sign-out landing while this resolve is in
        // flight must not be overwritten by the pre-sign-out answer -- that restored Authorized and re-rendered
        // the grant and remove forms after the operator had signed out. The write is marshalled for the same
        // reason every other write to this field is: it gates the whole render tree.
        long version = Volatile.Read(ref _authorizationTransitionVersion);
        TenantLifecycleAuthorizationReflectionState reflection = await ResolveAuthorizationReflectionAsync(cancellationToken)
            .ConfigureAwait(false);
        if (reflection is TenantLifecycleAuthorizationReflectionState.Authorized)
        {
            if (!CanApplyAuthorizationTransition(version))
            {
                return false;
            }

            _ = await InvokeRendererSafelyAsync(() =>
            {
                if (CanApplyAuthorizationTransition(version))
                {
                    _authorizationReflection = reflection;
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
            return CanApplyAuthorizationTransition(version);
        }

        await CollapseAuthorizationAsync(reflection).ConfigureAwait(false);
        return false;
    }

    private async ValueTask<TenantLifecycleAuthorizationReflectionState> ResolveAuthorizationReflectionAsync(
        CancellationToken cancellationToken = default)
    {
        try
        {
            return await BffComposition.ResolveGlobalAdministratorsAuthorizationAsync(cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            return TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
    }

    private async Task CollapseAuthorizationAsync(
        TenantLifecycleAuthorizationReflectionState reflection,
        bool invalidateTransition = true)
    {
        IAsyncDisposable? lease = null;
        if (!await InvokeRendererSafelyAsync(
                () => lease = CollapseAuthorizationState(reflection, invalidateTransition))
            .ConfigureAwait(false))
        {
            return;
        }

        await CompleteAuthorizationCollapseAsync(lease).ConfigureAwait(false);
    }

    private async Task CollapseAuthorizationIfCurrentAsync(
        TenantLifecycleAuthorizationReflectionState reflection,
        Func<bool> canCollapse)
    {
        IAsyncDisposable? lease = null;
        if (!await InvokeRendererSafelyAsync(() =>
        {
            // The generation/reference predicate and every state mutation that hides the privileged
            // surface execute in the same renderer work item. A newer operation therefore cannot land
            // between authorization validation and collapse.
            if (canCollapse())
            {
                lease = CollapseAuthorizationState(reflection, invalidateTransition: true);
            }
        }).ConfigureAwait(false))
        {
            return;
        }

        await CompleteAuthorizationCollapseAsync(lease).ConfigureAwait(false);
    }

    private IAsyncDisposable? CollapseAuthorizationState(
        TenantLifecycleAuthorizationReflectionState reflection,
        bool invalidateTransition)
    {
        if (invalidateTransition)
        {
            Interlocked.Increment(ref _authorizationTransitionVersion);
        }

        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation(ref _loadCancellation);
        InvalidateAllMutations();

        if (_grantAdmissionLease is { IsDispatchMarked: false } grantLease
            && grantLease.TryAbandonBeforeDispatch(_fixedAggregateOwner))
        {
            _grantAdmissionLease = null;
        }

        if (_removeAdmissionLease is { IsDispatchMarked: false } removeLease
            && removeLease.TryAbandonBeforeDispatch(_fixedAggregateOwner))
        {
            _removeAdmissionLease = null;
        }

        RetainReconciliationForReplacement();
        IAsyncDisposable? lease = _readRefreshLease;
        _readRefreshLease = null;

        // Releasing the lease here without clearing the budget meant the re-authorization path re-entered
        // EnsureReadRefreshLeaseAsync with the counter already spent. TenantDetailPage avoids this by scoping
        // the counter to the route; this surface has no route to key on, so the reset belongs to the
        // transition that drops the lease.
        Volatile.Write(ref _readRefreshAttempts, 0);
        _authorizationReflection = reflection;
        _cursorHistory.Clear();
        _pagingHistoryTruncated = false;
        _pagingJumpedToFirstPage = false;
        _authorizationPagingReset = false;
        _currentCursor = null;
        _snapshot = GlobalAdministratorsSnapshot.Unauthorized();
        _completeSnapshot = GlobalAdministratorsSnapshot.Unauthorized();
        if (_grantAdmissionLease is null)
        {
            _grantSnapshot = GlobalAdministratorGrantCommandSnapshot.Idle();
        }

        if (_removeAdmissionLease is null)
        {
            _removeSnapshot = GlobalAdministratorRemoveCommandSnapshot.Idle();
        }

        _grantUserId = null;
        _grantValidationMessage = null;
        _grantAcknowledged = false;
        Interlocked.Increment(ref _grantPreviewGeneration);
        _isGrantSubmitting = false;
        _isRemoveSubmitting = false;
        _isNotificationRefreshing = false;
        // Do not force-release the atomic page-load gate here. Collapse cancels the owning operation,
        // whose finally releases it; clearing it early would let a new recovery acquire the gate and
        // then have the superseded owner's finally clear that newer lease (an ABA race).
        _focusGrantUserIdPending = false;
        _focusGrantLauncherPending = false;
        _focusGrantLifecyclePending = false;
        _focusGrantPreviewCancelPending = false;
        _focusRemoveAcknowledgementPending = false;
        _focusRemoveLifecyclePending = false;
        _removeAcknowledgement = null;
        StateHasChanged();
        return lease;
    }

    private async Task CompleteAuthorizationCollapseAsync(IAsyncDisposable? lease)
    {
        try
        {
            if (lease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
            }
        }
        finally
        {
            _ = await InvokeRendererSafelyAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private static async Task DisposeLeaseSupportSafelyAsync(IAsyncDisposable lease)
    {
        try
        {
            await lease.DisposeAsync().ConfigureAwait(false);
        }
        catch
        {
            // Lease cleanup must never disclose transport details or block fail-closed rendering.
        }
    }

    private static string NormalizeReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || returnUrl.Any(char.IsControl)
            || returnUrl.Contains('\\')
            || returnUrl.Contains('#')
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || (!string.Equals(returnUrl, "/tenants", StringComparison.Ordinal)
                && !returnUrl.StartsWith("/tenants?", StringComparison.Ordinal)))
        {
            return "/tenants";
        }

        int queryIndex = returnUrl.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex < 0)
        {
            return "/tenants";
        }

        Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query = QueryHelpers
            .ParseQuery(returnUrl[(queryIndex + 1)..]);
        string[] allowedKeys = ["tab", "scope", "userId", "search", "status", "sort", "desc", "selected", "anchor"];
        if (query.Count == 0
            || query.Any(pair => !allowedKeys.Contains(pair.Key, StringComparer.Ordinal) || pair.Value.Count != 1))
        {
            return "/tenants";
        }

        string? Get(string key)
            => query.TryGetValue(key, out Microsoft.Extensions.Primitives.StringValues value)
                ? value[0]
                : null;
        TenantWorkspaceState state = TenantWorkspaceState.FromQuery(
            Get("tab"),
            Get("scope"),
            Get("userId"),
            Get("search"),
            Get("status"),
            Get("sort"),
            Get("desc"),
            cursor: null,
            Get("selected"),
            Get("anchor"));
        string canonical = state.ToCanonicalUrl();
        return string.Equals(canonical, returnUrl, StringComparison.Ordinal)
            ? canonical
            : "/tenants";
    }

    private void OnGrantUserIdInput(string? value)
    {
        if (string.Equals(_grantUserId, value, StringComparison.Ordinal))
        {
            return;
        }

        _grantUserId = value;
        if (Volatile.Read(ref _grantPreviewInFlight) != 0)
        {
            InvalidateGrantMutation();
            Interlocked.Increment(ref _grantPreviewGeneration);
            return;
        }

        TenantAggregateCommandLease? previewLease = _grantAdmissionLease;
        GlobalAdministratorGrantCommandSnapshot previewSnapshot = _grantSnapshot;
        if (previewSnapshot.State is TenantCommandLifecycleState.Previewed
            && previewLease is { IsDispatchMarked: false })
        {
            InvalidateGrantMutation();
            InvalidateUndispatchedGrantPreview(previewSnapshot, previewLease);
            StateHasChanged();
        }
    }

    // Marshalled: both callers run on a thread-pool continuation after the hoisted re-authorization, and both
    // fields are renderer-read -- the validation paragraph and its aria-describedby wiring, and the focus flag
    // OnAfterRenderAsync consumes.
    private Task RejectGrantInputAsync(string resourceKey)
        => InvokeAsync(() =>
        {
            _grantValidationMessage = Localizer[resourceKey];
            _focusGrantUserIdPending = true;
            StateHasChanged();
        });

    private async Task SubmitGrantAsync()
    {
        _grantValidationMessage = null;

        if (string.IsNullOrWhiteSpace(_grantUserId))
        {
            await RejectGrantInputAsync("Tenants.GlobalAdministrators.Grant.Validation.UserIdRequired").ConfigureAwait(false);
            return;
        }

        string targetUserId = _grantUserId;
        if (targetUserId.Length > MaximumGrantUserIdLength || targetUserId.Any(char.IsControl))
        {
            await RejectGrantInputAsync("Tenants.GlobalAdministrators.Grant.Validation.UserIdInvalid").ConfigureAwait(false);
            return;
        }

        if (Interlocked.CompareExchange(ref _grantPreviewInFlight, 1, 0) != 0)
        {
            return;
        }

        using PendingOperation operation = BeginGrantMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        long previewGeneration = Interlocked.Increment(ref _grantPreviewGeneration);

        try
        {
            if (!await ReauthorizeAsync(cancellationToken).ConfigureAwait(false)
                || !CanApplyGrantPreviewOperation(generation, previewGeneration, targetUserId))
            {
                return;
            }

            if (!string.IsNullOrWhiteSpace(GrantUnavailableReason))
            {
                string blockedReason = GrantUnavailableReason;
                await InvokeAsync(() => SetGrantSnapshot(
                    GlobalAdministratorGrantCommandSnapshot.Blocked(blockedReason, TenantCommandFocusTarget.Submit)))
                    .ConfigureAwait(false);
                return;
            }

            GlobalAdministratorsSnapshot current = await LoadCompletePopulationSafelyAsync(cancellationToken)
                .ConfigureAwait(false);
            if (!CanApplyGrantPreviewOperation(generation, previewGeneration, targetUserId))
            {
                return;
            }

            if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized)
            {
                await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                    .ConfigureAwait(false);
                return;
            }

            GlobalAdministratorGrantPreview preview = await ComposeGrantPreviewSafelyAsync(
                    targetUserId,
                    current,
                    cancellationToken)
                .ConfigureAwait(false);
            if (!CanApplyGrantPreviewOperation(generation, previewGeneration, targetUserId))
            {
                return;
            }

            if (string.Equals(
                    preview.UnavailableReasonKey,
                    "Tenants.GlobalAdministrators.Grant.Preview.Unavailable.Authorization",
                    StringComparison.Ordinal))
            {
                await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                    .ConfigureAwait(false);
                return;
            }

            if (!preview.IsComplete)
            {
                await InvokeAsync(() =>
                {
                    if (!CanApplyGrantPreviewOperation(generation, previewGeneration, targetUserId))
                    {
                        return;
                    }

                    _completeSnapshot = current;
                    SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.UnavailablePreview(preview));
                    StateHasChanged();
                }).ConfigureAwait(false);
                return;
            }

            string messageId = NUlid.Ulid.NewUlid().ToString();
            await InvokeAsync(() =>
            {
                if (!CanApplyGrantPreviewOperation(generation, previewGeneration, targetUserId)
                    || IsGrantPreviewOpen
                    || _grantAdmissionLease is not null)
                {
                    return;
                }

                _completeSnapshot = current;
                if (!AreGrantPreviewPrerequisitesCurrent(preview))
                {
                    SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Blocked(
                        Localizer["Tenants.GlobalAdministrators.Grant.Preview.Invalidated"],
                        TenantCommandFocusTarget.Submit));
                    StateHasChanged();
                    return;
                }

                if (_aggregateAdmissionGate is null
                    || !_aggregateAdmissionGate.TryAcquireLease(
                        TenantCommandAggregateLock.ForGlobalAdministrators(),
                        _fixedAggregateOwner,
                        out TenantAggregateCommandLease? acquiredLease)
                    || acquiredLease is null)
                {
                    SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Blocked(
                        Localizer["Tenants.GlobalAdministrators.Availability.Grant.Unavailable.AggregateBusy"],
                        TenantCommandFocusTarget.Submit));
                    StateHasChanged();
                    return;
                }

                _grantAdmissionLease = acquiredLease;
                _grantAcknowledged = false;
                SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Idle().Preview(preview, messageId));
                _focusGrantPreviewCancelPending = true;
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Cancellation invalidates this composition attempt; no preview or lease may survive it.
        }
        finally
        {
            Volatile.Write(ref _grantPreviewInFlight, 0);
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
    }

    private bool CanApplyGrantPreviewOperation(
        long generation,
        long previewGeneration,
        string targetUserId)
        => CanApplyGrantMutation(generation)
            && previewGeneration == Volatile.Read(ref _grantPreviewGeneration)
            && string.Equals(_grantUserId, targetUserId, StringComparison.Ordinal);

    private void OnGrantAcknowledgementChanged(bool value)
    {
        _grantAcknowledged = IsGrantPreviewOpen && value;
        StateHasChanged();
    }

    private async Task ConfirmGrantAsync()
    {
        if (IsGrantConfirmDisabled
            || Interlocked.CompareExchange(ref _grantConfirmationInFlight, 1, 0) != 0)
        {
            return;
        }

        try
        {
            using PendingOperation operation = BeginGrantMutation();
            long generation = operation.Generation;
            CancellationToken cancellationToken = operation.CancellationToken;
            GlobalAdministratorGrantCommandSnapshot expectedSnapshot = _grantSnapshot;
            GlobalAdministratorGrantPreview? expectedPreview = expectedSnapshot.PreviewEvidence;
            TenantAggregateCommandLease? expectedLease = _grantAdmissionLease;
            string? expectedMessageId = expectedSnapshot.MessageId;
            long previewGeneration = Volatile.Read(ref _grantPreviewGeneration);
            if (expectedPreview?.IsComplete != true
                || expectedLease is null
                || expectedMessageId is null
                || !MatchesGrantPreviewAttempt(
                    expectedSnapshot,
                    expectedPreview,
                    expectedLease,
                    expectedMessageId,
                    previewGeneration)
                || !await RevalidateGrantPreviewAsync(
                    expectedSnapshot,
                    expectedPreview,
                    expectedLease,
                    expectedMessageId,
                    previewGeneration,
                    generation,
                    cancellationToken).ConfigureAwait(false))
            {
                return;
            }

            await DispatchGrantAsync(
                isRedispatch: false,
                expectedSnapshot,
                expectedPreview,
                expectedLease,
                expectedMessageId,
                previewGeneration,
                generation,
                cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // Cancel, authorization collapse, and replacement attempts all invalidate confirmation.
        }
        finally
        {
            Volatile.Write(ref _grantConfirmationInFlight, 0);
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
    }

    private async Task<GlobalAdministratorGrantPreview> ComposeGrantPreviewSafelyAsync(
        string targetUserId,
        GlobalAdministratorsSnapshot current,
        CancellationToken cancellationToken)
    {
        try
        {
            return await BffComposition
                .ComposeGlobalAdministratorGrantPreviewAsync(targetUserId, current, cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            return GlobalAdministratorGrantPreview.Unavailable(targetUserId);
        }
    }

    private async Task<bool> RevalidateGrantPreviewAsync(
        GlobalAdministratorGrantCommandSnapshot expectedSnapshot,
        GlobalAdministratorGrantPreview preview,
        TenantAggregateCommandLease expectedLease,
        string expectedMessageId,
        long previewGeneration,
        long generation,
        CancellationToken cancellationToken)
    {
        if (!await ReauthorizeAsync(cancellationToken).ConfigureAwait(false)
            || !CanApplyGrantMutation(generation)
            || !MatchesGrantPreviewAttempt(
                expectedSnapshot,
                preview,
                expectedLease,
                expectedMessageId,
                previewGeneration))
        {
            return false;
        }

        GlobalAdministratorsSnapshot current = await LoadCompletePopulationSafelyAsync(cancellationToken)
            .ConfigureAwait(false);
        if (!CanApplyGrantMutation(generation))
        {
            return false;
        }

        if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized)
        {
            await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                .ConfigureAwait(false);
            return false;
        }

        GlobalAdministratorGrantPreview rebuilt = await ComposeGrantPreviewSafelyAsync(
                preview.TargetUserId,
                current,
                cancellationToken)
            .ConfigureAwait(false);
        if (string.Equals(
                rebuilt.UnavailableReasonKey,
                "Tenants.GlobalAdministrators.Grant.Preview.Unavailable.Authorization",
                StringComparison.Ordinal))
        {
            await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                .ConfigureAwait(false);
            return false;
        }

        bool supportStillAvailable = BffComposition.IsGlobalAdministratorDispatchConnected
            && BffComposition.IsGlobalAdministratorStatusConnected
            && BffComposition.IsGlobalAdministratorRequeryConnected
            && CommandGateway.SupportsGlobalAdministratorDispatch
            && CommandGateway.SupportsTrackedGlobalAdministratorDispatch
            && CommandGateway.SupportsCommandStatusLookup;
        bool viewportStillSafe = _viewportObservation?.HasMeasurement == true
            && _viewportObservation.State is TenantHighImpactViewportState.Safe;
        bool validated = false;

        await InvokeAsync(() =>
        {
            if (!CanApplyGrantMutation(generation)
                || !MatchesGrantPreviewAttempt(
                    expectedSnapshot,
                    preview,
                    expectedLease,
                    expectedMessageId,
                    previewGeneration))
            {
                if (!_disposed)
                {
                    InvalidateUndispatchedGrantPreview(expectedSnapshot, expectedLease);
                    StateHasChanged();
                }

                return;
            }

            _completeSnapshot = current;
            if (preview.Matches(rebuilt) && supportStillAvailable && viewportStillSafe && !IsRemoveInFlight)
            {
                validated = true;
                return;
            }

            InvalidateUndispatchedGrantPreview(
                expectedSnapshot,
                expectedLease,
                rebuilt.UnavailableReasonKey
                    ?? "Tenants.GlobalAdministrators.Grant.Preview.Invalidated");
            StateHasChanged();
        }).ConfigureAwait(false);
        return validated;
    }

    private bool MatchesGrantPreviewAttempt(
        GlobalAdministratorGrantCommandSnapshot expectedSnapshot,
        GlobalAdministratorGrantPreview expectedPreview,
        TenantAggregateCommandLease expectedLease,
        string expectedMessageId,
        long previewGeneration)
        => !_disposed
            && Volatile.Read(ref _grantPreviewGeneration) == previewGeneration
            && ReferenceEquals(_grantSnapshot, expectedSnapshot)
            && ReferenceEquals(_grantSnapshot.PreviewEvidence, expectedPreview)
            && ReferenceEquals(_grantAdmissionLease, expectedLease)
            && string.Equals(_grantSnapshot.MessageId, expectedMessageId, StringComparison.Ordinal);

    private async Task DispatchGrantAsync(
        bool isRedispatch,
        GlobalAdministratorGrantCommandSnapshot expectedSnapshot,
        GlobalAdministratorGrantPreview expectedPreview,
        TenantAggregateCommandLease expectedLease,
        string expectedMessageId,
        long previewGeneration,
        long generation,
        CancellationToken cancellationToken)
    {
        if (expectedSnapshot.Intent is not { } request
            || isRedispatch && (!expectedLease.IsDispatchMarked
                || !expectedSnapshot.IsSubmissionAmbiguous
                || expectedSnapshot.CorrelationId is not null))
        {
            return;
        }

        bool grantRequestArmed = false;
        GlobalAdministratorGrantCommandSnapshot? requestSentSnapshot = null;
        await InvokeAsync(() =>
        {
            bool exactAttempt = MatchesGrantPreviewAttempt(
                    expectedSnapshot,
                    expectedPreview,
                    expectedLease,
                    expectedMessageId,
                    previewGeneration);
            if (!exactAttempt)
            {
                if (!isRedispatch)
                {
                    InvalidateUndispatchedGrantPreview(expectedSnapshot, expectedLease);
                    StateHasChanged();
                }

                return;
            }

            bool livePrerequisites = CanApplyGrantMutation(generation)
                && AreGrantDispatchCapabilitiesCurrent()
                && BffComposition.IsGlobalAdministratorGrantPreviewReady;
            if (isRedispatch)
            {
                if (!livePrerequisites || !expectedLease.IsDispatchMarked)
                {
                    return;
                }
            }
            else if (!livePrerequisites
                || !AreGrantPreviewPrerequisitesCurrent(expectedPreview)
                || !_grantAcknowledged
                || expectedLease.IsDispatchMarked
                || !expectedLease.TryMarkDispatched(_fixedAggregateOwner))
            {
                InvalidateUndispatchedGrantPreview(expectedSnapshot, expectedLease);
                StateHasChanged();
                return;
            }

            SetGrantSnapshot(expectedSnapshot.RequestSent());
            requestSentSnapshot = _grantSnapshot;
            _grantAcknowledged = false;
            _isGrantSubmitting = true;
            grantRequestArmed = true;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (!grantRequestArmed || requestSentSnapshot is null)
        {
            return;
        }

        try
        {
            TenantCommandSubmissionResult result = await CommandGateway
                .SetGlobalAdministratorTrackedAsync(request, expectedMessageId, cancellationToken)
                .ConfigureAwait(false);
            GlobalAdministratorGrantCommandSnapshot submissionSnapshot = requestSentSnapshot.ApplySubmission(result);
            bool submissionApplied = false;
            bool resumeAdopted = false;
            await InvokeAsync(() =>
            {
                if (!CanApplyGrantMutation(generation) || !ReferenceEquals(_grantSnapshot, requestSentSnapshot))
                {
                    resumeAdopted = RetainOrReleaseGrantCompletion(submissionSnapshot, expectedLease);
                    return;
                }

                SetGrantSnapshot(submissionSnapshot);
                submissionApplied = true;
                StateHasChanged();
            }).ConfigureAwait(false);
            if (resumeAdopted)
            {
                await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
                return;
            }

            if (submissionApplied && result.State is TenantCommandLifecycleState.Accepted)
            {
                await RefreshGrantStatusCoreAsync(generation, cancellationToken).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            await ApplyGrantSubmissionExceptionAsync(generation, requestSentSnapshot, expectedLease).ConfigureAwait(false);
        }
        catch
        {
            await ApplyGrantSubmissionExceptionAsync(generation, requestSentSnapshot, expectedLease).ConfigureAwait(false);
        }
        finally
        {
            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    if (CanApplyGrantMutation(generation))
                    {
                        _isGrantSubmitting = false;
                    }
                }).ConfigureAwait(false);
            }
        }
    }

    private async Task RefreshGrantStatusAsync()
    {
        if (!await ReauthorizeAsync().ConfigureAwait(false)
            || _grantSnapshot.MessageId is null)
        {
            return;
        }

        if (_grantSnapshot.IsSubmissionAmbiguous && _grantSnapshot.CorrelationId is null)
        {
            GlobalAdministratorGrantCommandSnapshot expectedSnapshot = _grantSnapshot;
            GlobalAdministratorGrantPreview? expectedPreview = expectedSnapshot.PreviewEvidence;
            TenantAggregateCommandLease? expectedLease = _grantAdmissionLease;
            string expectedMessageId = expectedSnapshot.MessageId;
            long previewGeneration = Volatile.Read(ref _grantPreviewGeneration);
            if (expectedPreview?.IsComplete == true
                && expectedLease?.IsDispatchMarked == true
                && AreGrantDispatchCapabilitiesCurrent()
                && MatchesGrantPreviewAttempt(
                    expectedSnapshot,
                    expectedPreview,
                    expectedLease,
                    expectedMessageId,
                    previewGeneration))
            {
                // This is delivery recovery, not a new authorization decision. Rebuilding the preview here
                // would reject a safe same-id retry precisely when the first delivery already advanced the
                // projection but lost its response. The retained preview, baseline, lock, and ULID remain the
                // only admissible retry basis.
                using PendingOperation deliveryOperation = BeginGrantMutation();
                await DispatchGrantAsync(
                        isRedispatch: true,
                        expectedSnapshot,
                        expectedPreview,
                        expectedLease,
                        expectedMessageId,
                        previewGeneration,
                        deliveryOperation.Generation,
                        deliveryOperation.CancellationToken)
                    .ConfigureAwait(false);
            }

            return;
        }

        if (_grantSnapshot.CorrelationId is null)
        {
            return;
        }

        using PendingOperation operation = BeginGrantMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        await RefreshGrantStatusCoreAsync(generation, cancellationToken).ConfigureAwait(false);
    }

    private async Task RefreshGrantStatusCoreAsync(long generation, CancellationToken cancellationToken)
    {
        if (!CanApplyGrantMutation(generation)
            || _grantSnapshot.MessageId is not { } messageId
            || _grantSnapshot.CorrelationId is not { } correlationId)
        {
            return;
        }

        GlobalAdministratorGrantCommandSnapshot statusBasis = _grantSnapshot;
        TenantAggregateCommandLease? statusLease = _grantAdmissionLease;

        TenantCommandStatusResult status;
        try
        {
            status = await CommandGateway
                .GetStatusAsync(
                    new TenantCommandTrackingHandle(
                        messageId,
                        correlationId,
                        GlobalAdministratorGrantPreview.FixedAggregateId),
                    cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            status = TenantCommandStatusResult.Unknown(
                Localizer["Tenants.GlobalAdministrators.Grant.State.UnableToVerify"]);
        }

        GlobalAdministratorGrantCommandSnapshot statusSnapshot = statusBasis.ApplyStatus(status);
        bool statusApplied = false;
        bool resumeAdopted = false;
        await InvokeAsync(() =>
        {
            if (!CanApplyGrantMutation(generation) || !ReferenceEquals(_grantSnapshot, statusBasis))
            {
                if (statusLease is not null)
                {
                    resumeAdopted = RetainOrReleaseGrantCompletion(statusSnapshot, statusLease);
                }

                return;
            }

            SetGrantSnapshot(statusSnapshot);
            statusApplied = true;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (resumeAdopted)
        {
            await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
            return;
        }

        if (statusApplied
            && statusSnapshot.Intent is not null
            && statusSnapshot.State is TenantCommandLifecycleState.ProjectionPending)
        {
            await RequeryGrantProjectionAsync(generation, cancellationToken).ConfigureAwait(false);
        }
    }

    private async Task RequeryGrantProjectionAsync(long generation, CancellationToken cancellationToken)
    {
        if (!CanApplyGrantMutation(generation))
        {
            return;
        }

        GlobalAdministratorGrantCommandSnapshot projectionBasis = _grantSnapshot;
        TenantAggregateCommandLease? projectionLease = _grantAdmissionLease;
        GlobalAdministratorsSnapshot snapshot = await LoadCompletePopulationSafelyAsync(cancellationToken)
            .ConfigureAwait(false);
        GlobalAdministratorGrantCommandSnapshot projectionSnapshot = projectionBasis.ConfirmProjection(snapshot);
        bool resumeAdopted = false;
        await InvokeAsync(() =>
        {
            if (!CanApplyGrantMutation(generation)
                || !ReferenceEquals(_grantSnapshot, projectionBasis))
            {
                if (projectionLease is not null)
                {
                    resumeAdopted = RetainOrReleaseGrantCompletion(projectionSnapshot, projectionLease);
                }

                return;
            }

            if (projectionSnapshot.State is TenantCommandLifecycleState.Confirmed)
            {
                _completeSnapshot = snapshot;
            }

            SetGrantSnapshot(projectionSnapshot);
            StateHasChanged();
        }).ConfigureAwait(false);
        if (resumeAdopted)
        {
            await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
        }
        else if (projectionSnapshot.State is TenantCommandLifecycleState.Confirmed
            && CanApplyGrantMutation(generation))
        {
            // Confirmation comes from a complete bounded walk, but the review surface remains a paged
            // contract. Refresh the currently displayed cursor instead of replacing it with the complete
            // population or silently navigating to page one.
            _ = await LoadAsync(reuseETag: false, retainConfirmed: true).ConfigureAwait(false);
        }
    }

    private async Task CancelGrantAsync()
    {
        if (_grantAdmissionLease?.IsDispatchMarked == true)
        {
            return;
        }

        InvalidateGrantMutation();
        TenantAggregateCommandLease? lease = _grantAdmissionLease;
        if (lease is not null
            && lease.TryAbandonBeforeDispatch(_fixedAggregateOwner)
            && ReferenceEquals(_grantAdmissionLease, lease))
        {
            _grantAdmissionLease = null;
        }

        Interlocked.Increment(ref _grantPreviewGeneration);
        _grantUserId = null;
        _grantValidationMessage = null;
        _grantAcknowledged = false;
        SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Idle());
        _focusGrantLauncherPending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

