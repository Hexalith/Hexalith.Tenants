    protected override async Task OnInitializedAsync()
    {
        _authorizationReflection = await ResolveAuthorizationReflectionAsync().ConfigureAwait(false);
        _authenticationStateProvider = Services.GetService(typeof(AuthenticationStateProvider)) as AuthenticationStateProvider;
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        }

        if (!IsAuthorized)
        {
            _snapshot = GlobalAdministratorsSnapshot.Unauthorized();
            return;
        }

        if (!BffComposition.IsReadSurfaceConnected)
        {
            _snapshot = GlobalAdministratorsSnapshot.Unavailable();
            return;
        }

        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Retry optional notification setup after later renders when an earlier transient setup returned no
        // lease. The method's in-flight and existing-lease guards keep successful setup single-instance.
        await EnsureReadRefreshLeaseAsync().ConfigureAwait(false);

        if (_focusGrantUserIdPending)
        {
            _focusGrantUserIdPending = false;
            await _grantUserIdElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusGrantLauncherPending)
        {
            _focusGrantLauncherPending = false;
            await _grantLauncherElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusGrantLifecyclePending)
        {
            _focusGrantLifecyclePending = false;
            await _grantLifecycleElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRemoveSubmitPending)
        {
            _focusRemoveSubmitPending = false;
            await _removeSubmitElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRemoveLifecyclePending)
        {
            _focusRemoveLifecyclePending = false;
            await _removeLifecycleElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private async Task<GlobalAdministratorsSnapshot?> LoadAsync(
        bool reuseETag,
        bool retainConfirmed = false,
        string? requestedCursor = null,
        bool useRequestedCursor = false,
        bool reauthorize = true)
    {
        if (reauthorize && !await ReauthorizeAsync().ConfigureAwait(false))
        {
            return null;
        }

        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        GlobalAdministratorsSnapshot previous = _snapshot;
        if (!retainConfirmed)
        {
            // ReauthorizeAsync above is awaited with ConfigureAwait(false), so this runs on a thread-pool
            // thread whenever it actually suspends. Marshalled and generation-guarded like the result write
            // below: an unguarded write here can overwrite a newer applied snapshot with Loading, and
            // Loading is not in CanRecover, so the page would offer neither Retry nor Reset.
            await InvokeAsync(() =>
            {
                if (CanApply(generation))
                {
                    _snapshot = GlobalAdministratorsSnapshot.Loading();
                }
            }).ConfigureAwait(false);
        }

        GlobalAdministratorsRequest request = new(
            Cursor: useRequestedCursor ? requestedCursor : _currentCursor,
            PageSize: PageSize,
            ETag: reuseETag ? previous.ETag : null);

        try
        {
            GlobalAdministratorsSnapshot result = await QueryGateway
                .GetGlobalAdministratorsAsync(request, previous, cancellationToken)
                .ConfigureAwait(false);
            if (!CanApply(generation))
            {
                return null;
            }

            if (result.Kind is GlobalAdministratorsSurfaceKind.Unauthorized)
            {
                await CollapseAuthorizationAsync(TenantLifecycleAuthorizationReflectionState.MissingPermission)
                    .ConfigureAwait(false);
                return result;
            }

            // Re-checked inside the dispatcher callback: the CanApply above ran on a thread-pool
            // continuation, so a newer load -- or ResetPagingAsync, which clears the cursor state -- can win
            // between that check and this write and have page-N rows land on top of a newer page-one
            // snapshot. The Loading write earlier in this method already guards this way.
            await InvokeAsync(() =>
            {
                if (!CanApply(generation))
                {
                    return;
                }

                _snapshot = result;
                if (result.PagingRecovered)
                {
                    _cursorHistory.Clear();
                    _currentCursor = null;
                }

                StateHasChanged();
            }).ConfigureAwait(false);
            return result;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return null;
        }
    }

    private async Task RefreshAsync()
        => await LoadAsync(reuseETag: true).ConfigureAwait(false);

    // Retry and Reset share the pager's in-flight gate. Both render alongside the pager whenever a rows-
    // bearing snapshot is also recoverable (Stale, for example), and neither used to set or read it: a Next
    // click followed by Reset cleared the cursor state synchronously, Next's LoadAsync then returned null as
    // superseded and its finally re-enabled the pager against the pre-reset snapshot, so the next Next
    // pushed a null prior cursor and recorded page one for a view showing page four.
    private async Task RetryAsync()
    {
        if (_pageLoadInFlight)
        {
            return;
        }

        _pageLoadInFlight = true;
        try
        {
            _ = await LoadAsync(reuseETag: false, retainConfirmed: true).ConfigureAwait(false);
        }
        finally
        {
            _pageLoadInFlight = false;
        }
    }

    private async Task ResetPagingAsync()
    {
        if (_pageLoadInFlight)
        {
            return;
        }

        _pageLoadInFlight = true;
        try
        {
            // Marshalled: the renderer reads _cursorHistory.Count for the Previous button's Disabled
            // binding, so this non-thread-safe Stack must not be cleared from a pool thread.
            await InvokeAsync(() =>
            {
                _cursorHistory.Clear();
                _currentCursor = null;
            }).ConfigureAwait(false);
            _ = await LoadAsync(
                reuseETag: false,
                retainConfirmed: false,
                requestedCursor: null,
                useRequestedCursor: true).ConfigureAwait(false);
        }
        finally
        {
            _pageLoadInFlight = false;
        }
    }

    private async Task RefreshFromNotificationAsync()
    {
        if (_disposed || !IsAuthorized || !BffComposition.IsReadSurfaceConnected)
        {
            return;
        }

        _isNotificationRefreshing = true;
        StateHasChanged();
        try
        {
            await LoadAsync(reuseETag: true, retainConfirmed: true).ConfigureAwait(false);
        }
        finally
        {
            if (!_disposed)
            {
                try
                {
                    await InvokeAsync(() =>
                    {
                        _isNotificationRefreshing = false;
                        StateHasChanged();
                    });
                }
                catch (ObjectDisposedException)
                {
                    // Disposed between the check above and the dispatch; nothing left to update. Without
                    // this the throw escaped an unobserved fire-and-forget path, leaving
                    // _isNotificationRefreshing set and the surface announcing "refreshing" for good.
                }
            }
        }
    }

    /// <summary>
    /// Records that optional notification setup failed, using a fixed reason code only.
    /// </summary>
    /// <remarks>
    /// The catch below is deliberately broad, so without this the surface could stop auto-refreshing for the
    /// whole circuit with no signal anywhere. The logger is resolved optionally and the message carries a
    /// constant reason code — no tenant id, projection scope, transport detail, or exception is emitted.
    /// </remarks>
    private void LogNotificationSetupFailure()
    {
        if (Services.GetService(typeof(ILoggerFactory)) is ILoggerFactory loggerFactory)
        {
            loggerFactory
                .CreateLogger<GlobalAdministratorsPage>()
                .LogWarning("Optional projection refresh setup failed. ReasonCode={NotificationReasonCode}", "notification-setup-failed");
        }
    }

    private async Task EnsureReadRefreshLeaseAsync()
    {
        if (_disposed
            || !IsAuthorized
            || !BffComposition.IsReadSurfaceConnected
            || _readRefreshLease is not null
            || _readRefreshSubscriptionInFlight
            || Services.GetService(typeof(TenantReadRefreshSubscription)) is not TenantReadRefreshSubscription refreshSubscription)
        {
            return;
        }

        _readRefreshSubscriptionInFlight = true;
        TenantReadRefreshLease? lease = null;
        try
        {
            lease = await refreshSubscription.SubscribeAsync(
                GetGlobalAdministratorsQuery.ProjectionType,
                "system",
                () => InvokeAsync(RefreshFromNotificationAsync),
                CancellationToken.None).ConfigureAwait(false);
            if (_disposed || !IsAuthorized || !BffComposition.IsReadSurfaceConnected || _readRefreshLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
                return;
            }

            if (!lease.IsSubscribed)
            {
                // Setup registered no callback. Storing it would satisfy the "_readRefreshLease is not null"
                // guard above forever, permanently disabling auto-refresh for this circuit.
                return;
            }

            _readRefreshLease = lease;
            lease = null;
        }
        catch
        {
            // Optional nudge only; never surface transport detail. The reason code is recorded so a
            // permanently non-refreshing surface is diagnosable instead of silent.
            LogNotificationSetupFailure();
            if (lease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
            }
        }
        finally
        {
            _readRefreshSubscriptionInFlight = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Interlocked.Increment(ref _authorizationTransitionVersion);
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            _authenticationStateProvider = null;
        }
        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation(ref _loadCancellation);
        InvalidateAllMutations();
        IAsyncDisposable? lease = _readRefreshLease;
        _readRefreshLease = null;
        if (lease is not null)
        {
            await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
        }

    }

    private async Task NextPageAsync()
    {
        if (_pageLoadInFlight || string.IsNullOrWhiteSpace(_snapshot.NextCursor))
        {
            return;
        }

        string? priorCursor = _currentCursor;
        string nextCursor = _snapshot.NextCursor;
        _pageLoadInFlight = true;
        try
        {
            GlobalAdministratorsSnapshot? result = await LoadAsync(
                reuseETag: false,
                requestedCursor: nextCursor,
                useRequestedCursor: true).ConfigureAwait(false);
            // Marshalled: this continuation resumes on a thread-pool thread while the render LoadAsync
            // queued through InvokeAsync is in flight, and that render reads _cursorHistory.Count for the
            // Previous button's Disabled binding. Pushing onto a non-thread-safe Stack concurrently with
            // that read is a data race, and could render page-2 rows with Previous still disabled.
            //
            // No PagingRecovered check here: page-one recovery re-requests with Cursor = null and every
            // snapshot is stamped RequestCursor = request.Cursor, so a recovered snapshot always carries a
            // null RequestCursor -- which IsAppliedRequestedPage already rejects, since this method returns
            // early on a blank NextCursor. The clause was unreachable. PreviousPageAsync keeps it, where a
            // null previousCursor is legitimate.
            await InvokeAsync(() =>
            {
                if (IsAppliedRequestedPage(result, nextCursor)
                    && ReferenceEquals(_snapshot, result))
                {
                    _cursorHistory.Push(priorCursor);
                    _currentCursor = nextCursor;
                    CursorHistory.Trim(_cursorHistory, MaximumCursorHistory);
                }
            }).ConfigureAwait(false);
        }
        finally
        {
            _pageLoadInFlight = false;
        }
    }


    private async Task PreviousPageAsync()
    {
        if (_pageLoadInFlight || _cursorHistory.Count == 0)
        {
            return;
        }

        string? previousCursor = _cursorHistory.Peek();
        _pageLoadInFlight = true;
        try
        {
            GlobalAdministratorsSnapshot? result = await LoadAsync(
                reuseETag: false,
                requestedCursor: previousCursor,
                useRequestedCursor: true).ConfigureAwait(false);
            // Marshalled for the same reason as NextPageAsync: Pop mutates the Stack the renderer reads.
            await InvokeAsync(() =>
            {
                if (IsAppliedRequestedPage(result, previousCursor)
                    && ReferenceEquals(_snapshot, result)
                    && !result!.PagingRecovered
                    && _cursorHistory.Count > 0)
                {
                    _currentCursor = _cursorHistory.Pop();
                }
            }).ConfigureAwait(false);
        }
        finally
        {
            _pageLoadInFlight = false;
        }
    }

    private PendingOperation BeginLoad()
    {
        CancellationTokenSource source = ReplaceActiveCancellation(ref _loadCancellation);
        return new(
            Interlocked.Increment(ref _loadGeneration),
            source,
            () => CompleteCancellation(ref _loadCancellation, source));
    }

    private CancellationTokenSource ReplaceActiveCancellation(ref CancellationTokenSource? active)
    {
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(active);
            active = source;
        }

        return source;
    }

    private void CancelActiveCancellation(ref CancellationTokenSource? active)
    {
        lock (_cancellationLock)
        {
            RetireCancellationCore(active);
            active = null;
        }
    }

    private void RetireCancellationCore(CancellationTokenSource? source)
    {
        if (source is null)
        {
            return;
        }

        source.Cancel();
    }

    private void CompleteCancellation(
        ref CancellationTokenSource? active,
        CancellationTokenSource source)
    {
        lock (_cancellationLock)
        {
            if (ReferenceEquals(active, source))
            {
                active = null;
            }
        }

        source.Dispose();
    }

    private bool CanApply(long generation)
        => !_disposed && generation == Volatile.Read(ref _loadGeneration);

    private PendingOperation BeginGrantMutation()
    {
        CancellationTokenSource source = ReplaceActiveCancellation(ref _grantMutationCancellation);
        return new(
            Interlocked.Increment(ref _grantMutationGeneration),
            source,
            () => CompleteCancellation(ref _grantMutationCancellation, source));
    }

    private PendingOperation BeginRemoveMutation()
    {
        CancellationTokenSource source = ReplaceActiveCancellation(ref _removeMutationCancellation);
        return new(
            Interlocked.Increment(ref _removeMutationGeneration),
            source,
            () => CompleteCancellation(ref _removeMutationCancellation, source));
    }

    private void InvalidateGrantMutation()
    {
        Interlocked.Increment(ref _grantMutationGeneration);
        CancelActiveCancellation(ref _grantMutationCancellation);

        _isGrantSubmitting = false;
    }

    private void InvalidateRemoveMutation()
    {
        Interlocked.Increment(ref _removeMutationGeneration);
        CancelActiveCancellation(ref _removeMutationCancellation);

        _isRemoveSubmitting = false;
    }

    private void InvalidateAllMutations()
    {
        // Cancelling or superseding an in-flight submit moves its generation forward, so the owning
        // submit's finally can no longer clear its own flag. Each invalidation clears the matching flag so
        // that grant and remove stay independently reachable.
        InvalidateGrantMutation();
        InvalidateRemoveMutation();
    }

    private bool CanApplyGrantMutation(long generation)
        => !_disposed && IsAuthorized && generation == Volatile.Read(ref _grantMutationGeneration);

    private bool CanApplyRemoveMutation(long generation)
        => !_disposed && IsAuthorized && generation == Volatile.Read(ref _removeMutationGeneration);

    private static bool IsAppliedRequestedPage(
        GlobalAdministratorsSnapshot? snapshot,
        string? requestedCursor)
        => snapshot is not null
            && (snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
                or GlobalAdministratorsSurfaceKind.Stale
                or GlobalAdministratorsSurfaceKind.Unknown
                or GlobalAdministratorsSurfaceKind.Empty
                or GlobalAdministratorsSurfaceKind.Degraded)
            && string.Equals(snapshot.RequestCursor, requestedCursor, StringComparison.Ordinal);

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authenticationStateTask)
    {
        long version = Interlocked.Increment(ref _authorizationTransitionVersion);
        Task callback = InvokeAsync(() => ApplyAuthenticationStateChangedAsync(authenticationStateTask, version));
        _ = ObserveAuthenticationCallbackAsync(callback);
    }

    private async Task ApplyAuthenticationStateChangedAsync(
        Task<AuthenticationState> authenticationStateTask,
        long version)
    {
        if (!CanApplyAuthorizationTransition(version))
        {
            return;
        }

        await CollapseAuthorizationAsync(
            TenantLifecycleAuthorizationReflectionState.Indeterminate,
            invalidateTransition: false).ConfigureAwait(false);
        if (!CanApplyAuthorizationTransition(version))
        {
            return;
        }

        AuthenticationState authenticationState;
        try
        {
            authenticationState = await authenticationStateTask.ConfigureAwait(false);
        }
        catch
        {
            return;
        }

        if (!CanApplyAuthorizationTransition(version))
        {
            return;
        }

        TenantLifecycleAuthorizationReflectionState reflection = TenantsGlobalAdministratorClaims.Evaluate(authenticationState.User);
        if (reflection is not TenantLifecycleAuthorizationReflectionState.Authorized)
        {
            await CollapseAuthorizationAsync(reflection, invalidateTransition: false).ConfigureAwait(false);
            return;
        }

        await InvokeAsync(() =>
        {
            _authorizationReflection = TenantLifecycleAuthorizationReflectionState.Authorized;
            _snapshot = BffComposition.IsReadSurfaceConnected
                ? GlobalAdministratorsSnapshot.Loading()
                : GlobalAdministratorsSnapshot.Unavailable();
            StateHasChanged();
        }).ConfigureAwait(false);
        if (!CanApplyAuthorizationTransition(version) || !BffComposition.IsReadSurfaceConnected)
        {
            return;
        }

        _ = await LoadAsync(reuseETag: false, reauthorize: false).ConfigureAwait(false);
        if (!CanApplyAuthorizationTransition(version) || !IsAuthorized)
        {
            return;
        }

        await EnsureReadRefreshLeaseAsync().ConfigureAwait(false);
    }

    private bool CanApplyAuthorizationTransition(long version)
        => !_disposed && version == Volatile.Read(ref _authorizationTransitionVersion);

    private static async Task ObserveAuthenticationCallbackAsync(Task callback)
    {
        try
        {
            await callback.ConfigureAwait(false);
        }
        catch
        {
            // Authentication transitions contain faults and leave the surface failed closed.
        }
    }

    private async Task<bool> ReauthorizeAsync()
    {
        TenantLifecycleAuthorizationReflectionState reflection = await ResolveAuthorizationReflectionAsync().ConfigureAwait(false);
        if (reflection is TenantLifecycleAuthorizationReflectionState.Authorized)
        {
            _authorizationReflection = reflection;
            return true;
        }

        await CollapseAuthorizationAsync(reflection).ConfigureAwait(false);
        return false;
    }

    private async ValueTask<TenantLifecycleAuthorizationReflectionState> ResolveAuthorizationReflectionAsync()
    {
        try
        {
            return await BffComposition.ResolveGlobalAdministratorsAuthorizationAsync().ConfigureAwait(false);
        }
        catch
        {
            return TenantLifecycleAuthorizationReflectionState.Indeterminate;
        }
    }

    private async Task CollapseAuthorizationAsync(
        TenantLifecycleAuthorizationReflectionState reflection,
        bool invalidateTransition = true)
    {
        if (invalidateTransition)
        {
            Interlocked.Increment(ref _authorizationTransitionVersion);
        }

        Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation(ref _loadCancellation);
        InvalidateAllMutations();
        IAsyncDisposable? lease = _readRefreshLease;
        _readRefreshLease = null;
        await InvokeAsync(() =>
        {
            _authorizationReflection = reflection;
            _cursorHistory.Clear();
            _currentCursor = null;
            _snapshot = GlobalAdministratorsSnapshot.Unauthorized();
            _grantSnapshot = GlobalAdministratorGrantCommandSnapshot.Idle();
            _removeSnapshot = GlobalAdministratorRemoveCommandSnapshot.Idle();
            _grantUserId = null;
            _grantValidationMessage = null;
            _isGrantSubmitting = false;
            _isRemoveSubmitting = false;
            _isNotificationRefreshing = false;
            _pageLoadInFlight = false;
            _focusGrantUserIdPending = false;
            _focusGrantLauncherPending = false;
            _focusGrantLifecyclePending = false;
            _focusRemoveSubmitPending = false;
            _focusRemoveLifecyclePending = false;
            StateHasChanged();
        }).ConfigureAwait(false);

        try
        {
            if (lease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
            }
        }
        finally
        {
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
    }

    private static async Task DisposeLeaseSupportSafelyAsync(IAsyncDisposable lease)
    {
        try
        {
            await lease.DisposeAsync().ConfigureAwait(false);
        }
        catch
        {
            // Lease cleanup must never disclose transport details or block fail-closed rendering.
        }
    }

    private static string NormalizeReturnUrl(string? returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)
            || returnUrl.Any(char.IsControl)
            || returnUrl.Contains('\\')
            || returnUrl.Contains('#')
            || returnUrl.StartsWith("//", StringComparison.Ordinal)
            || (!string.Equals(returnUrl, "/tenants", StringComparison.Ordinal)
                && !returnUrl.StartsWith("/tenants?", StringComparison.Ordinal)))
        {
            return "/tenants";
        }

        int queryIndex = returnUrl.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex < 0)
        {
            return "/tenants";
        }

        Dictionary<string, Microsoft.Extensions.Primitives.StringValues> query = QueryHelpers
            .ParseQuery(returnUrl[(queryIndex + 1)..]);
        string[] allowedKeys = ["tab", "scope", "userId", "search", "status", "sort", "desc", "selected", "anchor"];
        if (query.Count == 0
            || query.Any(pair => !allowedKeys.Contains(pair.Key, StringComparer.Ordinal) || pair.Value.Count != 1))
        {
            return "/tenants";
        }

        string? Get(string key)
            => query.TryGetValue(key, out Microsoft.Extensions.Primitives.StringValues value)
                ? value[0]
                : null;
        TenantWorkspaceState state = TenantWorkspaceState.FromQuery(
            Get("tab"),
            Get("scope"),
            Get("userId"),
            Get("search"),
            Get("status"),
            Get("sort"),
            Get("desc"),
            cursor: null,
            Get("selected"),
            Get("anchor"));
        string canonical = state.ToCanonicalUrl();
        return string.Equals(canonical, returnUrl, StringComparison.Ordinal)
            ? canonical
            : "/tenants";
    }

    private void OnGrantUserIdInput(string? value)
        => _grantUserId = value;

    private async Task SubmitGrantAsync()
    {
        _grantValidationMessage = null;

        if (!await ReauthorizeAsync().ConfigureAwait(false))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(GrantUnavailableReason))
        {
            SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Blocked(GrantUnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        if (string.IsNullOrWhiteSpace(_grantUserId))
        {
            _grantValidationMessage = Localizer["Tenants.GlobalAdministrators.Grant.Validation.UserIdRequired"];
            _focusGrantUserIdPending = true;
            return;
        }

        var request = new SetGlobalAdministrator(_grantUserId.Trim());
        using PendingOperation operation = BeginGrantMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        SetGrantSnapshot(_grantSnapshot.RequestSent(request));
        _isGrantSubmitting = true;

        try
        {
            TenantCommandSubmissionResult result = await CommandGateway
                .SetGlobalAdministratorAsync(request, cancellationToken)
                .ConfigureAwait(false);
            if (!CanApplyGrantMutation(generation))
            {
                return;
            }

            SetGrantSnapshot(_grantSnapshot.ApplySubmission(result));
            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                await RefreshGrantStatusCoreAsync(generation, cancellationToken).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Authorization collapse and explicit cancellation invalidate late command continuations.
        }
        finally
        {
            if (CanApplyGrantMutation(generation))
            {
                _isGrantSubmitting = false;
            }
        }
    }

    private async Task RefreshGrantStatusAsync()
    {
        if (!await ReauthorizeAsync().ConfigureAwait(false)
            || _grantSnapshot.MessageId is null
            || _grantSnapshot.CorrelationId is null)
        {
            return;
        }

        using PendingOperation operation = BeginGrantMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        await RefreshGrantStatusCoreAsync(generation, cancellationToken).ConfigureAwait(false);
    }

    private async Task RefreshGrantStatusCoreAsync(long generation, CancellationToken cancellationToken)
    {
        if (!CanApplyGrantMutation(generation)
            || _grantSnapshot.MessageId is not { } messageId
            || _grantSnapshot.CorrelationId is not { } correlationId)
        {
            return;
        }

        TenantCommandStatusResult status;
        try
        {
            status = await CommandGateway
                .GetStatusAsync(new TenantCommandTrackingHandle(messageId, correlationId), cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (!CanApplyGrantMutation(generation))
        {
            return;
        }

        SetGrantSnapshot(_grantSnapshot.ApplyStatus(status));

        if (_grantSnapshot.Intent is not null
            && _grantSnapshot.State is TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending)
        {
            await RequeryGrantProjectionAsync(generation).ConfigureAwait(false);
        }
    }

    private async Task RequeryGrantProjectionAsync(long generation)
    {
        await InvokeAsync(() =>
        {
            // The re-query below deliberately renders page one; reset the cursor state that describes the
            // view so Previous is not offered on page one and a later Next cannot push a stale cursor.
            _cursorHistory.Clear();
            _currentCursor = null;
        }).ConfigureAwait(false);
        GlobalAdministratorsSnapshot? snapshot = await LoadAsync(
            reuseETag: false,
            retainConfirmed: true,
            requestedCursor: null,
            useRequestedCursor: true).ConfigureAwait(false);
        if (snapshot is not null && CanApplyGrantMutation(generation))
        {
            SetGrantSnapshot(_grantSnapshot.ConfirmProjection(snapshot));
        }
    }

    private async Task CancelGrantAsync()
    {
        InvalidateGrantMutation();
        _grantUserId = null;
        _grantValidationMessage = null;
        SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Idle());
        _focusGrantLauncherPending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private void SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot snapshot)
    {
        _grantSnapshot = snapshot;
        if (_grantSnapshot.FocusTarget is TenantCommandFocusTarget.UserId)
        {
            _focusGrantUserIdPending = true;
        }
        else if (_grantSnapshot.FocusTarget is TenantCommandFocusTarget.Submit)
        {
            _focusGrantLauncherPending = true;
        }
        else if (_grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _grantSnapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle
            || _grantSnapshot.FocusTarget is TenantCommandFocusTarget.Refresh)
        {
            _focusGrantLifecyclePending = true;
        }
    }

    private void PreviewRemove(string userId)
    {
        GlobalAdministratorRow? row = _snapshot.Rows.FirstOrDefault(candidate => string.Equals(candidate.UserId, userId, StringComparison.Ordinal));
        if (RemoveUnavailableReason(row) is { Length: > 0 } unavailableReason)
        {
            SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Blocked(unavailableReason, TenantCommandFocusTarget.Lifecycle));
            return;
        }

        var request = new RemoveGlobalAdministrator(userId);
        SetRemoveSnapshot(_removeSnapshot.Preview(request, _snapshot.Rows));
    }

    private async Task SubmitRemoveAsync()
    {
        if (!await ReauthorizeAsync().ConfigureAwait(false)
            || _removeSnapshot.Intent is null)
        {
            return;
        }

        // Re-check the previewed intent against the current snapshot. The preview may have been taken before
        // a notification refresh replaced _snapshot, so this is where the last-administrator hard stop,
        // freshness and completeness gates actually bind. Report the reason instead of failing silently.
        if (RemoveIntentUnavailableReason is { Length: > 0 } blockedReason)
        {
            await InvokeAsync(() => SetRemoveSnapshot(
                GlobalAdministratorRemoveCommandSnapshot.Blocked(blockedReason, TenantCommandFocusTarget.Lifecycle)))
                .ConfigureAwait(false);
            return;
        }

        if (IsRemoveSubmitDisabled)
        {
            return;
        }

        RemoveGlobalAdministrator request = _removeSnapshot.Intent;
        using PendingOperation operation = BeginRemoveMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        SetRemoveSnapshot(_removeSnapshot.RequestSent());
        _isRemoveSubmitting = true;

        try
        {
            TenantCommandSubmissionResult result = await CommandGateway
                .RemoveGlobalAdministratorAsync(request, cancellationToken)
                .ConfigureAwait(false);
            if (!CanApplyRemoveMutation(generation))
            {
                return;
            }

            SetRemoveSnapshot(_removeSnapshot.ApplySubmission(result));
            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                await RefreshRemoveStatusCoreAsync(generation, cancellationToken).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Authorization collapse and explicit cancellation invalidate late command continuations.
        }
        finally
        {
            if (CanApplyRemoveMutation(generation))
            {
                _isRemoveSubmitting = false;
            }
        }
    }

    private async Task RefreshRemoveStatusAsync()
    {
        if (!await ReauthorizeAsync().ConfigureAwait(false)
            || _removeSnapshot.MessageId is null
            || _removeSnapshot.CorrelationId is null)
