    private void AdoptRetainedReconciliation()
    {
        if (_aggregateAdmissionGate?.TryAdoptRetainedLease(
                TenantCommandAggregateLock.ForGlobalAdministrators(),
                _fixedAggregateOwner,
                out TenantAggregateCommandLease? lease,
                out GlobalAdministratorReconciliationState? reconciliation) != true
            || lease is null
            || reconciliation is null)
        {
            return;
        }

        if (reconciliation.ActionKind is GlobalAdministratorActionKind.Grant)
        {
            _grantAdmissionLease = lease;
            _grantSnapshot = new(
                reconciliation.LifecycleState,
                new SetGlobalAdministrator(reconciliation.TargetUserId),
                MessageId: reconciliation.MessageId,
                CorrelationId: reconciliation.CorrelationId,
                AuditState: TenantCommandAuditState.AuditPending,
                FocusTarget: TenantCommandFocusTarget.Refresh,
                PreviewEvidence: reconciliation.GrantPreview,
                HasCommandEventEvidence: reconciliation.HasCommandEventEvidence,
                IsSubmissionAmbiguous: reconciliation.IsSubmissionAmbiguous);
        }
        else
        {
            _removeAdmissionLease = lease;
            _removeSnapshot = new(
                reconciliation.LifecycleState,
                new RemoveGlobalAdministrator(reconciliation.TargetUserId),
                MessageId: reconciliation.MessageId,
                CorrelationId: reconciliation.CorrelationId,
                AuditState: TenantCommandAuditState.AuditPending,
                FocusTarget: TenantCommandFocusTarget.Refresh);
