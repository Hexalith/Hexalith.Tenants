        => _grantSnapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            TenantCommandLifecycleState.ProjectionPending => "...",
            _ => ">",
        };

    private bool HasRemoveRecoveryState
        => _removeSnapshot.MessageId is not null
        && _removeSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.Degraded
            or TenantCommandLifecycleState.UnableToVerify;

    private bool IsAmbiguousRemoveDeliveryRetry
        => HasRemoveRecoveryState
            && _removeSnapshot.IsSubmissionAmbiguous
            && _removeSnapshot.CorrelationId is null;

    private bool IsCorrelatedRemoveStatusRefresh
        => HasRemoveRecoveryState && _removeSnapshot.CorrelationId is not null;

    private bool HasOwnedRemoveLease
        => _removeAdmissionLease is { IsDispatchMarked: true } lease
            && _aggregateAdmissionGate?.IsLockedByAnother(
                TenantCommandAggregateLock.ForGlobalAdministrators(),
                _fixedAggregateOwner) == false
            && !lease.IsReleased;

    private bool CanRefreshCorrelatedRemoveStatus
        => IsCorrelatedRemoveStatusRefresh
            && HasOwnedRemoveLease
            && BffComposition.IsGlobalAdministratorStatusConnected
            && CommandGateway.SupportsCommandStatusLookup;

    private bool CanRetryAmbiguousRemoveDelivery
        => IsAmbiguousRemoveDeliveryRetry
            && _removeSnapshot.Intent is { } request
            && _removeSnapshot.PreviewEvidence?.IsComplete == true
            && HasOwnedRemoveLease
            && _removeAdmissionLease?.IsReconciliationDispatchInFlight != true
            && BffComposition.IsGlobalAdministratorRemovePreviewReady
            && BffComposition.IsGlobalAdministratorDispatchConnected
            && BffComposition.IsGlobalAdministratorStatusConnected
            && BffComposition.IsGlobalAdministratorRequeryConnected
            && CommandGateway.SupportsGlobalAdministratorDispatch
            && CommandGateway.SupportsTrackedGlobalAdministratorRemoveDispatch
            && CommandGateway.SupportsCommandStatusLookup
            && _viewportObservation?.HasMeasurement == true
            && _viewportObservation.State is TenantHighImpactViewportState.Safe
            && RemoveAvailability(request.UserId, allowOwnedRemoveReconciliation: true).IsAvailable;

    private bool ShouldRenderRemoveRecovery
        => IsCorrelatedRemoveStatusRefresh
            || IsAmbiguousRemoveDeliveryRetry
                && (CanRetryAmbiguousRemoveDelivery
                    || Volatile.Read(ref _removeSubmissionInFlight) != 0
                    || _removeAdmissionLease?.IsReconciliationDispatchInFlight == true);

    private bool CanRefreshRemoveStatus
        => Volatile.Read(ref _removeSubmissionInFlight) == 0
            && _removeAdmissionLease?.IsReconciliationDispatchInFlight != true
            && (CanRefreshCorrelatedRemoveStatus || CanRetryAmbiguousRemoveDelivery);

