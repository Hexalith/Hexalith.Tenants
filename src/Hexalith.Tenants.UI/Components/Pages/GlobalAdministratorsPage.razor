    private async Task PublishRemoveDeliveryCompletionAsync(
        GlobalAdministratorRemoveCommandSnapshot requestSentSnapshot,
        GlobalAdministratorRemoveCommandSnapshot completionSnapshot,
        TenantAggregateCommandLease submissionLease,
        long generation)
    {
        if (await InvokeRendererSafelyAsync(() =>
            {
                if (!CanApplyRemoveMutation(generation)
                    || !ReferenceEquals(_removeSnapshot, requestSentSnapshot)
                    || !ReferenceEquals(_removeAdmissionLease, submissionLease))
                {
                    _ = RetainOrReleaseRemoveCompletion(completionSnapshot, submissionLease);
                    return;
                }

                SetRemoveSnapshot(completionSnapshot);
                StateHasChanged();
            }).ConfigureAwait(false))
        {
            return;
        }

        _ = RetainOrReleaseRemoveCompletion(completionSnapshot, submissionLease);
    }

    private void AdoptRetainedReconciliation()
    {
        if (_aggregateAdmissionGate?.TryAdoptRetainedLease(
                TenantCommandAggregateLock.ForGlobalAdministrators(),
                _fixedAggregateOwner,
                out TenantAggregateCommandLease? lease,
                out GlobalAdministratorReconciliationState? reconciliation) != true
            || lease is null
            || reconciliation is null)
        {
            return;
        }

        if (reconciliation.ActionKind is GlobalAdministratorActionKind.Grant)
        {
            _grantAdmissionLease = lease;
            _grantSnapshot = new(
                reconciliation.LifecycleState,
                new SetGlobalAdministrator(reconciliation.TargetUserId),
                MessageId: reconciliation.MessageId,
                CorrelationId: reconciliation.CorrelationId,
                AuditState: reconciliation.IsSubmissionAmbiguous
                    ? TenantCommandAuditState.AuditDelayed
                    : TenantCommandAuditState.AuditPending,
                FocusTarget: TenantCommandFocusTarget.Refresh,
                SafeMessageKey: reconciliation.IsSubmissionAmbiguous
                    ? reconciliation.SafeMessageKey
                        ?? "Tenants.GlobalAdministrators.Grant.SubmissionEvidence.Ambiguous"
                    : reconciliation.SafeMessageKey,
                SafeRecoveryKey: reconciliation.IsSubmissionAmbiguous
                    ? reconciliation.SafeRecoveryKey
                        ?? "Tenants.GlobalAdministrators.Grant.DeliveryRetry.Recovery"
                    : reconciliation.SafeRecoveryKey,
                PreviewEvidence: reconciliation.GrantPreview,
                HasCommandEventEvidence: reconciliation.HasCommandEventEvidence,
                IsSubmissionAmbiguous: reconciliation.IsSubmissionAmbiguous);
        }
        else
        {
            _removeAdmissionLease = lease;
            _removeSnapshot = CreateRemoveSnapshot(reconciliation);
        }
    }

    private async Task ResumeAdoptedReconciliationAsync()
    {
        if (!IsAuthorized)
        {
            return;
        }

        if (_grantAdmissionLease?.IsDispatchMarked == true && _grantSnapshot.MessageId is not null)
        {
            await RefreshGrantStatusAsync().ConfigureAwait(false);
        }
        else if (_removeAdmissionLease?.IsDispatchMarked == true
            && _removeSnapshot.MessageId is not null
            && _removeSnapshot.CorrelationId is not null)
        {
            await QueueRemoveStatusNudgeAsync(_removeSnapshot).ConfigureAwait(false);
        }
    }

    private void RetainReconciliationForReplacement()
    {
        _ = SynchronizeOwnedRemoveReconciliation();
        if (CreateReconciliation(_grantSnapshot) is { } grantReconciliation
            && _grantAdmissionLease?.TryRetainReconciliation(_fixedAggregateOwner, grantReconciliation) == true)
        {
            _grantAdmissionLease = null;
        }

        if (CreateReconciliation(_removeSnapshot) is { } removeReconciliation
            && _removeAdmissionLease?.TryRetainReconciliation(_fixedAggregateOwner, removeReconciliation) == true)
        {
            _removeAdmissionLease = null;
        }
    }

    private bool SynchronizeOwnedRemoveReconciliation()
    {
        if (_removeAdmissionLease is not { } lease
            || !lease.TryReadReconciliation(_fixedAggregateOwner, out GlobalAdministratorReconciliationState? reconciliation)
            || reconciliation is null
            || reconciliation.ActionKind is not GlobalAdministratorActionKind.Remove
            || _removeSnapshot.Intent is not null
                && (!string.Equals(
                        _removeSnapshot.Intent.UserId,
                        reconciliation.TargetUserId,
                        StringComparison.Ordinal)
                    || _removeSnapshot.MessageId is not null
                        && !string.Equals(
                            _removeSnapshot.MessageId,
                            reconciliation.MessageId,
                            StringComparison.Ordinal)
                    || _removeSnapshot.PreviewEvidence is not null
                        && !Equals(_removeSnapshot.PreviewEvidence, reconciliation.RemovePreview)))
        {
            return false;
        }

        GlobalAdministratorRemoveCommandSnapshot synchronized = CreateRemoveSnapshot(reconciliation);
        if (Equals(_removeSnapshot, synchronized))
        {
            return false;
        }

        SetRemoveSnapshot(synchronized);
        return true;
    }

    private static GlobalAdministratorRemoveCommandSnapshot CreateRemoveSnapshot(
        GlobalAdministratorReconciliationState reconciliation)
    {
        bool terminalFailure = reconciliation.LifecycleState is TenantCommandLifecycleState.Failed
            or TenantCommandLifecycleState.Rejected;
        TenantCommandAuditState auditState = reconciliation.LifecycleState switch
        {
            TenantCommandLifecycleState.RequestSent when reconciliation.IsSubmissionAmbiguous
                => TenantCommandAuditState.AuditDelayed,
            TenantCommandLifecycleState.RequestSent => TenantCommandAuditState.NotStarted,
            TenantCommandLifecycleState.Accepted or TenantCommandLifecycleState.ProjectionPending
                => TenantCommandAuditState.AuditPending,
            TenantCommandLifecycleState.Degraded => TenantCommandAuditState.AuditDelayed,
            TenantCommandLifecycleState.UnableToVerify when reconciliation.IsSubmissionAmbiguous
                => TenantCommandAuditState.AuditDelayed,
            TenantCommandLifecycleState.UnableToVerify
                when string.Equals(
                    reconciliation.SafeRecoveryKey,
                    "Tenants.GlobalAdministrators.Remove.Recovery.TimedOut",
                    StringComparison.Ordinal)
                => TenantCommandAuditState.AuditDelayed,
            TenantCommandLifecycleState.UnableToVerify => TenantCommandAuditState.AuditUnavailable,
            _ when terminalFailure => TenantCommandAuditState.AuditUnavailable,
            _ => TenantCommandAuditState.AuditPending,
        };
        bool assertive = terminalFailure
            || reconciliation.IsSubmissionAmbiguous
            || reconciliation.LifecycleState is TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify;
        return new(
            reconciliation.LifecycleState,
            new RemoveGlobalAdministrator(reconciliation.TargetUserId),
            MessageId: reconciliation.MessageId,
            CorrelationId: reconciliation.CorrelationId,
            AuditState: auditState,
            FocusTarget: terminalFailure
                ? TenantCommandFocusTarget.Lifecycle
                : TenantCommandFocusTarget.Refresh,
            LiveRegionPoliteness: assertive
                ? TenantCommandLiveRegionPoliteness.Assertive
                : TenantCommandLiveRegionPoliteness.Polite,
            PreviewEvidence: reconciliation.RemovePreview,
            HasCommandEventEvidence: reconciliation.HasCommandEventEvidence,
            IsSubmissionAmbiguous: reconciliation.IsSubmissionAmbiguous,
            SafeMessageKey: reconciliation.SafeMessageKey,
            SafeRecoveryKey: reconciliation.SafeRecoveryKey,
            RejectionCode: reconciliation.RejectionCode);
    }

    private static GlobalAdministratorReconciliationState? CreateReconciliation(
        GlobalAdministratorGrantCommandSnapshot snapshot)
        => snapshot.Intent is not null
            && snapshot.PreviewEvidence?.IsComplete == true
            && snapshot.MessageId is { Length: > 0 } messageId
            && (snapshot.CorrelationId is { Length: > 0 }
                || snapshot.State is TenantCommandLifecycleState.RequestSent)
            && snapshot.State is TenantCommandLifecycleState.RequestSent
                or TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify
            ? new(
                GlobalAdministratorActionKind.Grant,
                snapshot.Intent.UserId,
                messageId,
                snapshot.CorrelationId,
                snapshot.State,
                snapshot.PreviewEvidence,
                snapshot.HasCommandEventEvidence,
                snapshot.IsSubmissionAmbiguous
                    || snapshot.State is TenantCommandLifecycleState.RequestSent
                        && string.IsNullOrWhiteSpace(snapshot.CorrelationId),
                snapshot.SafeMessageKey,
                snapshot.SafeRecoveryKey,
                RejectionCode: snapshot.RejectionCode)
            : null;

    private static GlobalAdministratorReconciliationState? CreateCompletionReconciliation(
        GlobalAdministratorRemoveCommandSnapshot snapshot)
        => snapshot.Intent is not null
            && snapshot.PreviewEvidence?.IsComplete == true
            && snapshot.MessageId is { Length: > 0 } messageId
            ? new(
                GlobalAdministratorActionKind.Remove,
                snapshot.Intent.UserId,
                messageId,
                snapshot.CorrelationId,
                snapshot.State,
            HasCommandEventEvidence: snapshot.HasCommandEventEvidence,
            IsSubmissionAmbiguous: snapshot.IsSubmissionAmbiguous,
            SafeMessageKey: snapshot.SafeMessageKey,
            SafeRecoveryKey: snapshot.SafeRecoveryKey,
            RemovePreview: snapshot.PreviewEvidence,
            RejectionCode: snapshot.RejectionCode)
            : null;

    private static GlobalAdministratorReconciliationState? CreateReconciliation(
        GlobalAdministratorRemoveCommandSnapshot snapshot)
        => snapshot.Intent is not null
            && snapshot.PreviewEvidence?.IsComplete == true
            && snapshot.MessageId is { Length: > 0 } messageId
            && (snapshot.CorrelationId is { Length: > 0 }
                || snapshot.State is TenantCommandLifecycleState.RequestSent
                || snapshot.State is TenantCommandLifecycleState.UnableToVerify
                    && snapshot.IsSubmissionAmbiguous)
            && snapshot.State is TenantCommandLifecycleState.RequestSent
                or TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify
            ? new(
                GlobalAdministratorActionKind.Remove,
                snapshot.Intent.UserId,
                messageId,
                snapshot.CorrelationId,
                snapshot.State,
                HasCommandEventEvidence: snapshot.HasCommandEventEvidence,
                IsSubmissionAmbiguous: snapshot.IsSubmissionAmbiguous,
                SafeMessageKey: snapshot.SafeMessageKey,
                SafeRecoveryKey: snapshot.SafeRecoveryKey,
                RemovePreview: snapshot.PreviewEvidence,
                RejectionCode: snapshot.RejectionCode)
            : null;

    private bool HasSameRemoveAttempt(
        GlobalAdministratorRemoveCommandSnapshot current,
        GlobalAdministratorRemoveCommandSnapshot expected,
        TenantAggregateCommandLease expectedLease)
        => string.Equals(current.MessageId, expected.MessageId, StringComparison.Ordinal)
            && string.Equals(current.CorrelationId, expected.CorrelationId, StringComparison.Ordinal)
            && string.Equals(current.Intent?.UserId, expected.Intent?.UserId, StringComparison.Ordinal)
            && Equals(current.PreviewEvidence, expected.PreviewEvidence)
            && current.State == expected.State
            && current.HasCommandEventEvidence == expected.HasCommandEventEvidence
            && current.IsSubmissionAmbiguous == expected.IsSubmissionAmbiguous
            && current.State is not (TenantCommandLifecycleState.Confirmed
                or TenantCommandLifecycleState.Failed
                or TenantCommandLifecycleState.Rejected
                or TenantCommandLifecycleState.AlreadyApplied)
            && ReferenceEquals(_removeAdmissionLease, expectedLease)
            && expectedLease.IsDispatchMarked
            && _aggregateAdmissionGate?.IsLockedByAnother(
                TenantCommandAggregateLock.ForGlobalAdministrators(),
                _fixedAggregateOwner) == false;

    private static bool HasSameRemoveCommandIdentity(
        GlobalAdministratorRemoveCommandSnapshot current,
        GlobalAdministratorRemoveCommandSnapshot expected)
        => string.Equals(current.MessageId, expected.MessageId, StringComparison.Ordinal)
            && string.Equals(current.Intent?.UserId, expected.Intent?.UserId, StringComparison.Ordinal)
            && Equals(current.PreviewEvidence, expected.PreviewEvidence);

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }
}
