            StateHasChanged();
        }).ConfigureAwait(false);
    }

    private async Task PreviewRemoveAsync(GlobalAdministratorRemoveLauncher launcher)
    {
        string userId = launcher.UserId;
        if (Interlocked.CompareExchange(ref _removePreviewInFlight, 1, 0) != 0)
        {
            return;
        }

        try
        {
            if (!await ReauthorizeAsync().ConfigureAwait(false))
            {
                return;
            }

            GlobalAdministratorRow? row = _snapshot.Rows.FirstOrDefault(candidate =>
                string.Equals(candidate.UserId, userId, StringComparison.Ordinal));
            if (RemoveUnavailableReason(row) is { Length: > 0 } unavailableReason)
            {
                await InvokeAsync(() => SetRemoveSnapshot(
                    GlobalAdministratorRemoveCommandSnapshot.Blocked(
                        unavailableReason,
                        TenantCommandFocusTarget.Lifecycle))).ConfigureAwait(false);
                return;
            }

            using PendingOperation operation = BeginRemoveMutation();
            long generation = operation.Generation;
            CancellationToken cancellationToken = operation.CancellationToken;
            GlobalAdministratorsSnapshot current = await LoadCompletePopulationSafelyAsync(cancellationToken)
                .ConfigureAwait(false);
            GlobalAdministratorRemovePreview preview;
            try
            {
                preview = await BffComposition.ComposeGlobalAdministratorRemovePreviewAsync(
                    userId,
                    current,
                    cancellationToken).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch
            {
                preview = GlobalAdministratorRemovePreview.Unavailable(userId);
            }

            if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized
                || string.Equals(
                    preview.UnavailableReasonKey,
                    "Tenants.GlobalAdministrators.Remove.Preview.Unavailable.Authorization",
                    StringComparison.Ordinal))
            {
                await CollapseAuthorizationIfCurrentAsync(
                    TenantLifecycleAuthorizationReflectionState.MissingPermission,
                    () => CanApplyRemoveMutation(generation)).ConfigureAwait(false);

                return;
            }

            await InvokeAsync(() =>
            {
                if (!CanApplyRemoveMutation(generation))
                {
                    return;
                }

                _completeSnapshot = current;
                if (!preview.IsComplete
                    || !RemoveAvailability(userId).IsAvailable)
                {
                    SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.UnavailablePreview(preview));
                    return;
                }

                if (_aggregateAdmissionGate is null
                    || !_aggregateAdmissionGate.TryAcquireLease(
                        TenantCommandAggregateLock.ForGlobalAdministrators(),
                        _fixedAggregateOwner,
                        out TenantAggregateCommandLease? lease)
                    || lease is null)
                {
                    SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Blocked(
                        "Tenants.GlobalAdministrators.Availability.Remove.Unavailable.AggregateBusy",
                        TenantCommandFocusTarget.Lifecycle));
                    return;
                }

                string messageId = NUlid.Ulid.NewUlid().ToString();
                _removeAdmissionLease = lease;
                _removeLauncher = launcher;
                _removeAcknowledgement = null;
                SetRemoveSnapshot(_removeSnapshot.Preview(preview, messageId));
                _focusRemoveAcknowledgementPending = true;
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        finally
        {
            Interlocked.Exchange(ref _removePreviewInFlight, 0);
        }
    }

    private async Task SubmitRemoveAsync()
    {
        if (Interlocked.CompareExchange(ref _removeSubmissionInFlight, 1, 0) != 0)
        {
            return;
        }

        GlobalAdministratorRemoveCommandSnapshot expectedSnapshot = _removeSnapshot;
        GlobalAdministratorRemovePreview? expectedPreview = expectedSnapshot.PreviewEvidence;
        TenantAggregateCommandLease? submissionLease = _removeAdmissionLease;
        try
        {
            if (expectedSnapshot.State is not TenantCommandLifecycleState.Previewed
                || expectedSnapshot.Intent is not { } request
                || expectedPreview is not { IsComplete: true }
                || expectedSnapshot.MessageId is not { Length: > 0 } messageId
                || submissionLease is null
                || submissionLease.IsDispatchMarked
                || !string.Equals(_removeAcknowledgement, request.UserId, StringComparison.Ordinal))
            {
                return;
            }

            using PendingOperation operation = BeginRemoveMutation();
            long generation = operation.Generation;
            CancellationToken cancellationToken = operation.CancellationToken;
            if (!await ReauthorizeAsync(cancellationToken).ConfigureAwait(false))
            {
                return;
            }

            GlobalAdministratorsSnapshot current = await LoadCompletePopulationSafelyAsync(cancellationToken)
                .ConfigureAwait(false);
            GlobalAdministratorRemovePreview rebuilt;
            try
            {
                rebuilt = await BffComposition.ComposeGlobalAdministratorRemovePreviewAsync(
                    request.UserId,
                    current,
                    cancellationToken).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch
            {
                rebuilt = GlobalAdministratorRemovePreview.Unavailable(request.UserId);
            }

            if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized
                || string.Equals(
                    rebuilt.UnavailableReasonKey,
                    "Tenants.GlobalAdministrators.Remove.Preview.Unavailable.Authorization",
                    StringComparison.Ordinal))
            {
                await CollapseAuthorizationIfCurrentAsync(
                    TenantLifecycleAuthorizationReflectionState.MissingPermission,
                    () => CanApplyRemoveMutation(generation)
                        && ReferenceEquals(_removeSnapshot, expectedSnapshot)
                        && ReferenceEquals(_removeAdmissionLease, submissionLease)).ConfigureAwait(false);

                return;
            }

            bool armed = false;
            GlobalAdministratorRemoveCommandSnapshot? requestSentSnapshot = null;
            long completionToken = 0;
            _ = await InvokeRendererSafelyAsync(() =>
            {
                if (!CanApplyRemoveMutation(generation)
                    || !ReferenceEquals(_removeSnapshot, expectedSnapshot)
                    || !ReferenceEquals(_removeAdmissionLease, submissionLease))
                {
                    return;
                }

                _completeSnapshot = current;
                GlobalAdministratorActionAvailability availability = RemoveAvailability(request.UserId);
                if (!rebuilt.IsComplete
                    || !expectedPreview.Matches(current)
                    || !rebuilt.Matches(current)
                    || !string.Equals(expectedPreview.TargetUserId, rebuilt.TargetUserId, StringComparison.Ordinal)
                    || !availability.IsAvailable)
                {
                    _ = submissionLease.TryAbandonBeforeDispatch(_fixedAggregateOwner);
                    _removeAdmissionLease = null;
                    SetRemoveSnapshot(expectedSnapshot.InvalidatePreview(
                        rebuilt.UnavailableReasonKey ?? availability.ReasonKey,
                        rebuilt.RecoveryKey ?? availability.RecoveryKey));
                    StateHasChanged();
                    return;
                }

                GlobalAdministratorRemoveCommandSnapshot requestSent = expectedSnapshot.RequestSent();
                if (CreateReconciliation(requestSent) is not { } dispatchBasis
                    || !submissionLease.TryBeginInitialReconciliationDispatch(
                        _fixedAggregateOwner,
                        dispatchBasis,
                        out completionToken))
                {
                    _ = submissionLease.TryAbandonBeforeDispatch(_fixedAggregateOwner);
                    _removeAdmissionLease = null;
                    SetRemoveSnapshot(expectedSnapshot.InvalidatePreview(
                        "Tenants.GlobalAdministrators.Availability.Remove.Unavailable.AggregateBusy",
                        "Tenants.GlobalAdministrators.Availability.Recovery.AggregateBusy"));
                    return;
                }

                SetRemoveSnapshot(requestSent);
                requestSentSnapshot = _removeSnapshot;
                _isRemoveSubmitting = true;
                _removeAcknowledgement = null;
                armed = true;
                StateHasChanged();
            }).ConfigureAwait(false);
            if (!armed || requestSentSnapshot is null)
            {
                return;
            }

            TenantCommandSubmissionResult result;
            try
            {
                result = await CommandGateway
                    .RemoveGlobalAdministratorTrackedAsync(request, messageId, cancellationToken)
                    .ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                result = TenantCommandSubmissionResult.Ambiguous(
                    messageId,
                    "Tenants.GlobalAdministrators.Remove.SubmissionEvidence.Ambiguous");
            }
            catch
            {
                result = TenantCommandSubmissionResult.Ambiguous(
                    messageId,
                    "Tenants.GlobalAdministrators.Remove.SubmissionEvidence.Ambiguous");
            }

            GlobalAdministratorRemoveCommandSnapshot submissionSnapshot = requestSentSnapshot.ApplySubmission(result);
            if (CreateCompletionReconciliation(submissionSnapshot) is not { } durableCompletion
                || !submissionLease.TryCompleteReconciliationDispatch(completionToken, durableCompletion))
            {
                _ = submissionLease.TryAbortReconciliationDispatch(completionToken);
                await PublishRemoveDeliveryCompletionAsync(
                    requestSentSnapshot,
                    submissionSnapshot,
                    submissionLease,
                    generation).ConfigureAwait(false);
            }

            // Successful completion publishes through the gate notification so the current renderer and a
            // replacement owner share one wake-up. Abort above still applies Failed/unsupported evidence so
            // the lease cannot remain a non-recoverable RequestSent identity.
        }
        catch (OperationCanceledException)
        {
            // Cancellation before delivery is fail-closed; cancellation during delivery is converted into a
            // durable ambiguous result in the gateway block above.
        }
        catch
        {
            // Every post-admission delivery exception is contained above and durably published. Remaining
            // preflight failures leave the undispatched preview fail closed.
        }
        finally
        {
            await CompleteRemoveSingleFlightAsync().ConfigureAwait(false);
        }
    }

    private async Task RefreshRemoveStatusAsync()
    {
        if (Interlocked.CompareExchange(ref _removeSubmissionInFlight, 1, 0) != 0)
        {
            return;
        }

        try
        {
            await RenderIfAliveAsync().ConfigureAwait(false);
            GlobalAdministratorRemoveCommandSnapshot expected = _removeSnapshot;
            TenantAggregateCommandLease? expectedLease = _removeAdmissionLease;
            if (expected.IsSubmissionAmbiguous && expected.CorrelationId is null)
            {
                if (expectedLease is null
                    || !HasSameRemoveAttempt(_removeSnapshot, expected, expectedLease)
                    || !CanRetryAmbiguousRemoveDelivery)
                {
                    return;
                }

                await RetryAmbiguousRemoveDeliveryAsync(expected).ConfigureAwait(false);
                return;
            }

            if (expected.MessageId is null
                || expected.CorrelationId is null
                || expectedLease is null
                || !HasSameRemoveAttempt(_removeSnapshot, expected, expectedLease)
                || !CanRefreshCorrelatedRemoveStatus)
            {
                return;
            }

            using PendingOperation operation = BeginRemoveMutation();
            if (!await ReauthorizeAsync(operation.CancellationToken).ConfigureAwait(false)
                || !HasSameRemoveAttempt(_removeSnapshot, expected, expectedLease)
                || !CanRefreshCorrelatedRemoveStatus)
            {
                return;
            }

            await RefreshRemoveStatusCoreAsync(
                operation.Generation,
                operation.CancellationToken,
                expected,
                expectedLease).ConfigureAwait(false);
        }
        finally
        {
            await CompleteRemoveSingleFlightAsync().ConfigureAwait(false);
        }
    }

    private async Task RetryAmbiguousRemoveDeliveryAsync(
        GlobalAdministratorRemoveCommandSnapshot expected)
    {
        if (expected.Intent is not { } request
            || expected.PreviewEvidence is not { IsComplete: true } retainedPreview
            || expected.MessageId is not { Length: > 0 } messageId
            || _removeAdmissionLease is not { IsDispatchMarked: true } lease)
        {
            return;
        }

        using PendingOperation operation = BeginRemoveMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        if (!await ReauthorizeAsync(cancellationToken).ConfigureAwait(false))
        {
            return;
        }

        GlobalAdministratorsSnapshot current = await LoadCompletePopulationSafelyAsync(cancellationToken)
            .ConfigureAwait(false);
        GlobalAdministratorRemovePreview rebuilt;
        try
        {
            rebuilt = await BffComposition.ComposeGlobalAdministratorRemovePreviewAsync(
                request.UserId,
                current,
                cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            rebuilt = GlobalAdministratorRemovePreview.Unavailable(request.UserId);
        }

        if (current.Kind is GlobalAdministratorsSurfaceKind.Unauthorized
            || string.Equals(
                rebuilt.UnavailableReasonKey,
                "Tenants.GlobalAdministrators.Remove.Preview.Unavailable.Authorization",
                StringComparison.Ordinal))
        {
            await CollapseAuthorizationIfCurrentAsync(
                TenantLifecycleAuthorizationReflectionState.MissingPermission,
                () => CanApplyRemoveMutation(generation)
                    && ReferenceEquals(_removeSnapshot, expected)
                    && ReferenceEquals(_removeAdmissionLease, lease)).ConfigureAwait(false);

            return;
        }

        bool retry = false;
        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (!CanApplyRemoveMutation(generation)
                || !ReferenceEquals(_removeSnapshot, expected)
                || !ReferenceEquals(_removeAdmissionLease, lease))
            {
                return;
            }

            _completeSnapshot = current;
            GlobalAdministratorActionAvailability availability = RemoveAvailability(
                request.UserId,
                allowOwnedRemoveReconciliation: true);
            if (!retainedPreview.Matches(current)
                || !rebuilt.IsComplete
                || !rebuilt.Matches(current)
                || !availability.IsAvailable)
            {
                SetRemoveSnapshot(expected.RetainAmbiguousPreflight(
                    rebuilt.UnavailableReasonKey ?? availability.ReasonKey,
                    rebuilt.RecoveryKey ?? availability.RecoveryKey));
                StateHasChanged();
                return;
            }

            retry = true;
            _isRemoveSubmitting = true;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (!retry)
        {
            return;
        }

        if (CreateReconciliation(expected) is not { } dispatchBasis
            || !lease.TryBeginReconciliationDispatch(
                _fixedAggregateOwner,
                dispatchBasis,
                out long completionToken))
        {
            return;
        }

        TenantCommandSubmissionResult result;
        try
        {
            result = await CommandGateway.RemoveGlobalAdministratorTrackedAsync(
                request,
                messageId,
                cancellationToken).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            result = TenantCommandSubmissionResult.Ambiguous(
                messageId,
                "Tenants.GlobalAdministrators.Remove.SubmissionEvidence.Ambiguous");
        }
        catch
        {
            result = TenantCommandSubmissionResult.Ambiguous(
                messageId,
                "Tenants.GlobalAdministrators.Remove.SubmissionEvidence.Ambiguous");
        }

        GlobalAdministratorRemoveCommandSnapshot applied = expected.ApplySubmission(result);
        if (CreateCompletionReconciliation(applied) is not { } durableCompletion
            || !lease.TryCompleteReconciliationDispatch(completionToken, durableCompletion))
        {
            _ = lease.TryAbortReconciliationDispatch(completionToken);
            await PublishRemoveDeliveryCompletionAsync(expected, applied, lease, generation).ConfigureAwait(false);
        }

        // Successful completion publishes through the gate notification. Abort still applies the exact
        // result so a Failed delivery cannot leave a non-recoverable RequestSent lease.
    }

    private async Task RefreshRemoveStatusCoreAsync(
        long generation,
        CancellationToken cancellationToken,
        GlobalAdministratorRemoveCommandSnapshot? exactAttempt = null,
        TenantAggregateCommandLease? exactLease = null)
    {
        if (!CanApplyRemoveMutation(generation)
            || exactAttempt is not null
                && (exactLease is null || !HasSameRemoveAttempt(_removeSnapshot, exactAttempt, exactLease))
            || _removeSnapshot.MessageId is not { } messageId
            || _removeSnapshot.CorrelationId is not { } correlationId)
        {
            return;
        }

        GlobalAdministratorRemoveCommandSnapshot statusBasis = _removeSnapshot;
        TenantAggregateCommandLease? statusLease = _removeAdmissionLease;

        TenantCommandStatusResult status;
        try
        {
            status = await CommandGateway
                .GetStatusAsync(
                    new TenantCommandTrackingHandle(
                        messageId,
                        correlationId,
                        GlobalAdministratorRemovePreview.FixedAggregateId),
                    cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            status = TenantCommandStatusResult.Unknown(
                Localizer["Tenants.GlobalAdministrators.Remove.State.UnableToVerify"]);
        }

        GlobalAdministratorRemoveCommandSnapshot statusSnapshot = statusBasis.ApplyStatus(status);
        bool statusApplied = false;
        bool resumeAdopted = false;
        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (!CanApplyRemoveMutation(generation) || !ReferenceEquals(_removeSnapshot, statusBasis))
            {
                if (statusLease is not null)
                {
                    resumeAdopted = RetainOrReleaseRemoveCompletion(statusSnapshot, statusLease);
                }

                return;
            }

            SetRemoveSnapshot(statusSnapshot);
            statusApplied = true;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (resumeAdopted)
        {
            await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
            return;
        }

        if (statusApplied
            && statusSnapshot.Intent is not null
            && statusSnapshot.State is TenantCommandLifecycleState.ProjectionPending)
        {
            await RequeryRemoveProjectionAsync(generation).ConfigureAwait(false);
        }
    }

    private async Task RequeryRemoveProjectionAsync(long generation)
    {
        if (!CanApplyRemoveMutation(generation))
        {
            return;
        }

        GlobalAdministratorRemoveCommandSnapshot projectionBasis = _removeSnapshot;
        TenantAggregateCommandLease? projectionLease = _removeAdmissionLease;
        GlobalAdministratorsSnapshot snapshot = await LoadCompletePopulationSafelyAsync(CancellationToken.None)
            .ConfigureAwait(false);
        GlobalAdministratorRemoveCommandSnapshot projectionSnapshot = projectionBasis.ConfirmProjection(snapshot);
        if (snapshot.Kind is GlobalAdministratorsSurfaceKind.Unauthorized)
        {
            await CollapseAuthorizationIfCurrentAsync(
                TenantLifecycleAuthorizationReflectionState.MissingPermission,
                () => CanApplyRemoveMutation(generation)
                    && ReferenceEquals(_removeSnapshot, projectionBasis)
                    && ReferenceEquals(_removeAdmissionLease, projectionLease)).ConfigureAwait(false);
            return;
        }

        bool resumeAdopted = false;
        bool confirmed = false;
        _ = await InvokeRendererSafelyAsync(() =>
        {
            if (!CanApplyRemoveMutation(generation)
                || !ReferenceEquals(_removeSnapshot, projectionBasis))
            {
                if (projectionLease is not null)
                {
                    resumeAdopted = RetainOrReleaseRemoveCompletion(projectionSnapshot, projectionLease);
                }

                return;
            }

            _completeSnapshot = snapshot;
            SetRemoveSnapshot(projectionSnapshot);
            confirmed = projectionSnapshot.State is TenantCommandLifecycleState.Confirmed;
            StateHasChanged();
        }).ConfigureAwait(false);
        if (resumeAdopted)
        {
            await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
        }
        else if (confirmed)
        {
            _ = await LoadAsync(
                reuseETag: false,
                retainConfirmed: true,
                requestedCursor: _currentCursor,
                useRequestedCursor: true).ConfigureAwait(false);
        }
    }

    private async Task CancelRemoveAsync()
