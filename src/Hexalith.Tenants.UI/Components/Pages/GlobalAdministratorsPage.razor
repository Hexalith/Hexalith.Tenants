@page "/global-administrators"
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantsBffComposition BffComposition
@inject ITenantQueryGateway QueryGateway
@inject ITenantCommandGateway CommandGateway

<PageTitle>@PageTitleText</PageTitle>

<main class="global-admins" data-testid="tenants-global-admins-area" aria-labelledby="global-admins-heading">
    <header class="global-admins__header">
        <p class="global-admins__eyebrow">@Localizer["Tenants.GlobalAdministrators.Eyebrow"]</p>
        <h1 id="global-admins-heading">@PageTitleText</h1>
        <p>@Localizer["Tenants.GlobalAdministrators.Description"]</p>
    </header>

    <FluentAccordion Class="global-admins__sections"
                     ExpandMode="AccordionExpandMode.Multi"
                     Block="true">
        <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.Scope.Title"]"
                             Expanded="true">
            <section class="global-admins__scope"
                     aria-labelledby="global-admins-scope-heading"
                     data-testid="tenants-global-admins-scope">
                <h2 id="global-admins-scope-heading">@Localizer["Tenants.GlobalAdministrators.Scope.Title"]</h2>
                <p>@Localizer["Tenants.GlobalAdministrators.Scope.Message"]</p>
                <dl>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Value"]</dd>
                    </div>
                </dl>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@StatusHeading"
                             Expanded="true">
            <section class="global-admins__state global-admins__state--@StateCss"
                     role="@StatusRole"
                     aria-live="@StatusLive"
                     tabindex="0"
                     data-testid="@StateTestId">
                <span class="global-admins__state-icon" aria-hidden="true">@StateIcon</span>
                <div class="global-admins__state-copy">
                    <h2>@StatusHeading</h2>
                    <p id="global-admins-live-region" data-testid="tenants-global-admins-live-region">@StatusMessage</p>
                </div>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.Grant.Title"]"
                             Expanded="true">
            <section class="global-admins__grant"
                     aria-labelledby="global-admins-grant-heading"
                     data-testid="tenants-global-admin-grant">
        <div class="global-admins__grant-heading">
            <h2 id="global-admins-grant-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Title"]</h2>
            <p>@Localizer["Tenants.GlobalAdministrators.Grant.Description"]</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(GrantUnavailableReason))
        {
            <p class="global-admins__grant-unavailable"
               role="alert"
               data-testid="tenants-global-admin-grant-unavailable-reason">
                @GrantUnavailableReason
            </p>
        }

        <EditForm Model="@_grantFormModel"
                  FormName="tenants-global-admin-grant"
                  class="global-admins__grant-form"
                  data-testid="tenants-global-admin-grant-form"
                  OnSubmit="SubmitGrantAsync">
            <div class="global-admins__grant-field">
                <FluentTextInput Id="tenants-global-admin-grant-user-id"
                                 @ref="_grantUserIdElement"
                                 name="global-administrator-user-id"
                                 Label="@Localizer["Tenants.GlobalAdministrators.Grant.UserId.Label"]"
                                 Value="@_grantUserId"
                                 ValueChanged="OnGrantUserIdInput"
                                 data-testid="tenants-global-admin-grant-user-id"
                                 aria-describedby="@GrantUserIdDescribedBy" />
                <span id="tenants-global-admin-grant-user-id-help">
                    @Localizer["Tenants.GlobalAdministrators.Grant.UserId.Help"]
                </span>
            </div>

            <dl class="global-admins__grant-scope" data-testid="tenants-global-admin-grant-scope">
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Value"]</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Value"]</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Value"]</dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_grantValidationMessage))
            {
                <p id="tenants-global-admin-grant-validation"
                   class="global-admins__grant-validation"
                   role="alert"
                   data-testid="tenants-global-admin-grant-validation">
                    @_grantValidationMessage
                </p>
            }

            <div class="global-admins__grant-actions">
                <span class="global-admins__grant-submit-focus" tabindex="-1" @ref="_grantLauncherElement">
                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="ButtonAppearance.Primary"
                                  data-testid="tenants-global-admin-grant-submit"
                                  Disabled="@IsGrantSubmitDisabled">
                        @Localizer["Tenants.GlobalAdministrators.Grant.Submit"]
                    </FluentButton>
                </span>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-global-admin-grant-cancel"
                              Disabled="@(!CanCancelGrant)"
                              OnClick="CancelGrantAsync">
                    @Localizer["Tenants.GlobalAdministrators.Grant.Cancel"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-global-admin-grant-refresh"
                              Disabled="@(!CanRefreshGrantStatus)"
                              OnClick="RefreshGrantStatusAsync">
                    @Localizer["Tenants.GlobalAdministrators.Grant.Refresh"]
                </FluentButton>
            </div>
        </EditForm>

        <section class="global-admins__grant-lifecycle global-admins__grant-lifecycle--@GrantStateCss"
                 @ref="_grantLifecycleElement"
                 tabindex="-1"
                 role="@GrantLifecycleRole"
                 aria-labelledby="global-admins-grant-lifecycle-heading"
                 data-testid="tenants-global-admin-grant-lifecycle">
            <h3 id="global-admins-grant-lifecycle-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Lifecycle.Title"]</h3>
            <p data-testid="tenants-global-admin-grant-state">
                <span class="global-admins__grant-state-symbol" aria-hidden="true">@GrantStateSymbol</span>
                <span>@GrantStateText</span>
            </p>
            @if (!string.IsNullOrWhiteSpace(_grantSnapshot.SafeMessage))
            {
                <p data-testid="tenants-global-admin-grant-safe-message">@_grantSnapshot.SafeMessage</p>
            }
            <p data-testid="tenants-global-admin-grant-audit-state">@GrantAuditText</p>
            <p class="global-admins__grant-live"
               data-testid="tenants-global-admin-grant-live-region"
               aria-live="@GrantLiveRegionMode"
               aria-atomic="true">
                @GrantStateText
            </p>
        </section>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.Remove.Title"]"
                             Expanded="true">
            <section class="global-admins__remove"
                     aria-labelledby="global-admins-remove-heading"
                     data-testid="tenants-global-admin-remove-flow">
        <div class="global-admins__remove-heading">
            <h2 id="global-admins-remove-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Title"]</h2>
            <p>@Localizer["Tenants.GlobalAdministrators.Remove.Description"]</p>
        </div>

        @if (_removeSnapshot.State is TenantCommandLifecycleState.Previewed
            or TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending)
        {
            <section class="global-admins__remove-preview"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="global-admins-remove-preview-heading"
                     data-testid="tenants-global-admin-remove-preview"
                     @onkeydown="HandleRemovePreviewKeyDownAsync">
                <span class="global-admins__remove-focus-sentinel"
                      tabindex="0"
                      data-testid="tenants-global-admin-remove-focus-start"
                      @onfocus="FocusRemoveCancelAsync"></span>
                <h3 id="global-admins-remove-preview-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Title"]</h3>
                <dl class="global-admins__remove-preview-grid">
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Scope"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Scope.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Target"]</dt>
                        <dd data-testid="tenants-global-admin-remove-target">@_removeSnapshot.Intent?.UserId</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Count"]</dt>
                        <dd>@(_removeSnapshot.PreviewRows?.Count ?? 0)</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Freshness"]</dt>
                        <dd>@_snapshot.Freshness</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.LastAdminImpact"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.LastAdminImpact.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.AccessRevoked"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.AccessRevoked.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-known-consequences">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownConsequences"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownConsequences.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-known-unknowns">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownUnknowns"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownUnknowns.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-audit-expectation">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Audit"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Audit.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-recovery">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Recovery"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Recovery.Value"]</dd>
                    </div>
                </dl>
                <div class="global-admins__remove-actions">
                    <span class="global-admins__remove-submit-focus" tabindex="-1" @ref="_removeSubmitElement">
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      data-testid="tenants-global-admin-remove-submit"
                                      Disabled="@IsRemoveSubmitDisabled"
                                      OnClick="SubmitRemoveAsync">
                            @Localizer["Tenants.GlobalAdministrators.Remove.Submit"]
                        </FluentButton>
                    </span>
                    <span class="global-admins__remove-cancel-focus" tabindex="-1" @ref="_removeCancelElement">
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      data-testid="tenants-global-admin-remove-cancel"
                                      OnClick="CancelRemoveAsync">
                            @Localizer["Tenants.GlobalAdministrators.Remove.Cancel"]
                        </FluentButton>
                    </span>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  data-testid="tenants-global-admin-remove-refresh"
                                  Disabled="@(!CanRefreshRemoveStatus)"
                                  OnClick="RefreshRemoveStatusAsync">
                        @Localizer["Tenants.GlobalAdministrators.Remove.Refresh"]
                    </FluentButton>
                </div>
                <span class="global-admins__remove-focus-sentinel"
                      tabindex="0"
                      data-testid="tenants-global-admin-remove-focus-end"
                      @onfocus="FocusRemoveSubmitAsync"></span>
            </section>
        }

        <section class="global-admins__remove-lifecycle global-admins__remove-lifecycle--@RemoveStateCss"
                 @ref="_removeLifecycleElement"
                 tabindex="-1"
                 role="@RemoveLifecycleRole"
                 aria-labelledby="global-admins-remove-lifecycle-heading"
                 data-testid="tenants-global-admin-remove-lifecycle">
            <h3 id="global-admins-remove-lifecycle-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Lifecycle.Title"]</h3>
            <p data-testid="tenants-global-admin-remove-state">
                <span class="global-admins__remove-state-symbol" aria-hidden="true">@RemoveStateSymbol</span>
                <span>@RemoveStateText</span>
            </p>
            @if (!string.IsNullOrWhiteSpace(_removeSnapshot.SafeMessage))
            {
                <p data-testid="tenants-global-admin-remove-safe-message">@_removeSnapshot.SafeMessage</p>
            }
            <p data-testid="tenants-global-admin-remove-audit-state">@RemoveAuditText</p>
            <p class="global-admins__remove-live"
               data-testid="tenants-global-admin-remove-live-region"
               aria-live="@RemoveLiveRegionMode"
               aria-atomic="true">
                @RemoveStateText
            </p>
        </section>
            </section>
        </FluentAccordionItem>

        @if (ShouldRenderRows)
        {
            <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.List.Title"]"
                                 Expanded="true">
                <section class="global-admins__table-shell"
                         aria-labelledby="global-admins-list-heading"
                         data-testid="tenants-global-admins-list">
            <div class="global-admins__table-header">
                <h2 id="global-admins-list-heading">@Localizer["Tenants.GlobalAdministrators.List.Title"]</h2>
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-global-admins-refresh" OnClick="RefreshAsync">
                    @Localizer["Tenants.GlobalAdministrators.Refresh"]
                </FluentButton>
            </div>
            <div class="global-admins__table-scroll">
                <FluentDataGrid Items="@_snapshot.Rows.AsQueryable()"
                                Class="global-admins__data-grid"
                                ResizableColumns="true"
                                ReorderableColumns="false"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                ItemKey="@(row => row.UserId)">
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Identity"]"
                                    ColumnId="global-admin-identity"
                                    Width="260px"
                                    Pin="DataGridColumnPin.Start">
                        <div class="global-admins__identity" data-testid="tenants-global-admins-row">
                            <span class="global-admins__identity-value"
                                  title="@context.UserId"
                                  aria-label="@Localizer["Tenants.GlobalAdministrators.Identity.Accessible", context.UserId]"
                                  data-testid="tenants-global-admins-user-id">@context.UserId</span>
                            <SupportSafeCopyButton Value="@context.UserId"
                                                   ValueKind="SupportSafeCopyValueKind.UserId"
                                                   AccessibleName="@Localizer["Tenants.GlobalAdministrators.Copy.UserId", context.UserId]"
                                                   TestId="tenants-global-admins-copy-user-id" />
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Scope"]"
                                    ColumnId="global-admin-scope"
                                    Width="220px">
                        <span data-testid="tenants-global-admins-authority-scope">
                            @Localizer["Tenants.GlobalAdministrators.Row.Scope"]
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Freshness"]"
                                    ColumnId="global-admin-freshness"
                                    Width="180px">
                        <span data-testid="tenants-global-admins-freshness">
                            <TruthStateBadge Freshness="@context.Freshness"
                                             TestId="tenants-global-admins-truth-state"
                                             ResourcePrefix="Tenants.GlobalAdministrators" />
                        </span>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Actions"]"
                                    ColumnId="global-admin-actions"
                                    Width="300px">
                        <div class="global-admins__actions" data-testid="tenants-global-admins-action-reasons">
                            <span data-testid="tenants-global-admins-grant-reason">@(GrantUnavailableReason ?? Localizer["Tenants.GlobalAdministrators.Grant.Available"])</span>
                            @if (RemoveUnavailableReason(context) is { Length: > 0 } removeUnavailableReason)
                            {
                                <span data-testid="tenants-global-admins-remove-reason">@removeUnavailableReason</span>
                            }
                            else
                            {
                                <FluentButton Appearance="ButtonAppearance.Outline"
                                              data-testid="tenants-global-admin-remove"
                                              OnClick="() => PreviewRemove(context.UserId)">
                                    @Localizer["Tenants.GlobalAdministrators.Remove.Launch"]
                                </FluentButton>
                            }
                        </div>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
            <nav class="global-admins__pager" aria-label="@Localizer["Tenants.GlobalAdministrators.PaginationLabel"]">
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-global-admins-previous" Disabled="@(_cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                    @Localizer["Tenants.GlobalAdministrators.Previous"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-global-admins-next" Disabled="@(!_snapshot.HasMore)" OnClick="NextPageAsync">
                    @Localizer["Tenants.GlobalAdministrators.Next"]
                </FluentButton>
            </nav>
                </section>
            </FluentAccordionItem>
        }
    </FluentAccordion>
</main>

@code {
    private const int PageSize = 20;
    private readonly object _grantFormModel = new();
    private GlobalAdministratorsSnapshot _snapshot = GlobalAdministratorsSnapshot.Loading();
    private GlobalAdministratorGrantCommandSnapshot _grantSnapshot = GlobalAdministratorGrantCommandSnapshot.Idle();
    private GlobalAdministratorRemoveCommandSnapshot _removeSnapshot = GlobalAdministratorRemoveCommandSnapshot.Idle();
    private readonly Stack<string?> _cursorHistory = new();
    private string? _currentCursor;
    private string? _grantUserId;
    private string? _grantValidationMessage;
    private bool _isGrantSubmitting;
    private bool _isRemoveSubmitting;
    private FluentTextInput _grantUserIdElement = default!;
    private ElementReference _grantLauncherElement;
    private ElementReference _grantLifecycleElement;
    private ElementReference _removeSubmitElement;
    private ElementReference _removeCancelElement;
    private ElementReference _removeLifecycleElement;
    private bool _focusGrantUserIdPending;
    private bool _focusGrantLauncherPending;
    private bool _focusGrantLifecyclePending;
    private bool _focusRemoveSubmitPending;
    private bool _focusRemoveLifecyclePending;

    private bool IsAuthorized
        => BffComposition.GlobalAdministratorsAuthorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized;

    private bool ShouldRenderRows
        => (_snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
            or GlobalAdministratorsSurfaceKind.Stale
            or GlobalAdministratorsSurfaceKind.Degraded)
            && _snapshot.Rows.Count > 0;

    private string PageTitleText
        => IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Title"]
            : Localizer["Tenants.GlobalAdministrators.RestrictedTitle"];

    private string StatusHeading
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Title"]
            : Localizer[$"Tenants.GlobalAdministrators.State.{ResourceState}.Title"];

    private string StatusMessage
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Message"]
            : Localizer[$"Tenants.GlobalAdministrators.State.{ResourceState}.Message"];

    private string ResourceState => _snapshot.Kind switch
    {
        GlobalAdministratorsSurfaceKind.Loading => "Loading",
        GlobalAdministratorsSurfaceKind.Ready => "Ready",
        GlobalAdministratorsSurfaceKind.Empty => "Empty",
        GlobalAdministratorsSurfaceKind.Stale => "Stale",
        GlobalAdministratorsSurfaceKind.Degraded => "Degraded",
        GlobalAdministratorsSurfaceKind.Unauthorized => "Unauthorized",
        GlobalAdministratorsSurfaceKind.Unavailable => "Unavailable",
        GlobalAdministratorsSurfaceKind.Invalid => "Invalid",
        _ => "Unavailable",
    };

    private string StateTestId
        => IsAuthorized
            ? $"tenants-global-admins-{ResourceState.ToLowerInvariant()}"
            : "tenants-global-admins-unavailable";

    private string StateCss
        => IsAuthorized ? ResourceState.ToLowerInvariant() : "unauthorized";

    private string StatusRole
        => !IsAuthorized
            || _snapshot.Kind is GlobalAdministratorsSurfaceKind.Invalid
                or GlobalAdministratorsSurfaceKind.Stale
                or GlobalAdministratorsSurfaceKind.Degraded
                or GlobalAdministratorsSurfaceKind.Unauthorized
                or GlobalAdministratorsSurfaceKind.Unavailable
            ? "alert"
            : "status";

    private string StatusLive => StatusRole == "alert" ? "assertive" : "polite";

    private string StateIcon => _snapshot.Kind switch
    {
        GlobalAdministratorsSurfaceKind.Ready => "OK",
        GlobalAdministratorsSurfaceKind.Empty => "0",
        GlobalAdministratorsSurfaceKind.Loading => "...",
        GlobalAdministratorsSurfaceKind.Stale => "!",
        GlobalAdministratorsSurfaceKind.Degraded => "!",
        GlobalAdministratorsSurfaceKind.Invalid => "!",
        _ => "?",
    };

    private string UnavailableActionReason
        => _snapshot.Freshness is TenantFreshnessState.Current
            ? Localizer["Tenants.GlobalAdministrators.Action.Unavailable.ReadOnly"]
            : Localizer["Tenants.GlobalAdministrators.Action.Unavailable.Freshness"];

    private bool IsGrantInFlight
        => _isGrantSubmitting
        || _grantSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending;

    private bool IsRemoveInFlight
        => _isRemoveSubmitting
        || _removeSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending;

    private string? GrantUnavailableReason
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.Authorization"].Value
            : !BffComposition.IsReadSurfaceConnected
                ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.ReadSurface"].Value
                : !BffComposition.IsCommandSurfaceConnected
                    ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.CommandSurface"].Value
                    : _snapshot.Freshness is not TenantFreshnessState.Current
                        ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.Freshness"].Value
                        : _snapshot.Kind is GlobalAdministratorsSurfaceKind.Loading
                            or GlobalAdministratorsSurfaceKind.Degraded
                            or GlobalAdministratorsSurfaceKind.Unauthorized
                            or GlobalAdministratorsSurfaceKind.Unavailable
                            or GlobalAdministratorsSurfaceKind.Invalid
                            ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.ReadSurface"].Value
                            : IsGrantInFlight
                                ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.InFlight"].Value
                                : IsRemoveInFlight
                                    ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.InFlight"].Value
                                    : null;

    private string? RemoveUnavailableReason(GlobalAdministratorRow? row)
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.Authorization"].Value
            : !BffComposition.IsReadSurfaceConnected
                ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.ReadSurface"].Value
                : !BffComposition.IsCommandSurfaceConnected
                    ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.CommandSurface"].Value
                    : _snapshot.Freshness is not TenantFreshnessState.Current
                        ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.Freshness"].Value
                        : _snapshot.Kind is GlobalAdministratorsSurfaceKind.Loading
                            or GlobalAdministratorsSurfaceKind.Degraded
                            or GlobalAdministratorsSurfaceKind.Unauthorized
                            or GlobalAdministratorsSurfaceKind.Unavailable
                            or GlobalAdministratorsSurfaceKind.Invalid
                            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.ReadSurface"].Value
                            : IsGrantInFlight
                                ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.InFlight"].Value
                                : IsRemoveInFlight
                                    ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.InFlight"].Value
                                    : _snapshot.Rows.Count <= 1
                                        ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.LastAdmin"].Value
                                        : row is not null && !_snapshot.Rows.Any(candidate => string.Equals(candidate.UserId, row.UserId, StringComparison.Ordinal))
                                            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.TargetMissing"].Value
                                            : null;

    private bool IsGrantSubmitDisabled => !string.IsNullOrWhiteSpace(GrantUnavailableReason);

    private bool IsRemoveSubmitDisabled
        => _removeSnapshot.State is not TenantCommandLifecycleState.Previewed
        || IsGrantInFlight
        || IsRemoveInFlight
        || _removeSnapshot.Intent is null;

    private bool CanCancelGrant
        => _grantSnapshot.State is not TenantCommandLifecycleState.Idle || !string.IsNullOrWhiteSpace(_grantUserId);

    private bool CanRefreshGrantStatus
        => _grantSnapshot.MessageId is not null
        && _grantSnapshot.CorrelationId is not null
        && _grantSnapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.Degraded
            or TenantCommandLifecycleState.UnableToVerify;

    private string GrantUserIdDescribedBy
        => string.IsNullOrWhiteSpace(_grantValidationMessage)
            ? "tenants-global-admin-grant-user-id-help"
            : "tenants-global-admin-grant-user-id-help tenants-global-admin-grant-validation";

    private string GrantStateCss
        => _grantSnapshot.State.ToString().ToLowerInvariant();

    private string GrantStateText
        => Localizer[$"Tenants.GlobalAdministrators.Grant.State.{_grantSnapshot.State}"];

    private string GrantAuditText
        => Localizer[$"Tenants.GlobalAdministrators.Grant.Audit.{_grantSnapshot.AuditState}"];

    private string GrantLiveRegionMode
        => _grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string GrantLifecycleRole
        => _grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "alert" : "status";

    private string GrantStateSymbol
        => _grantSnapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            TenantCommandLifecycleState.ProjectionPending => "...",
            _ => ">",
        };

    private bool CanRefreshRemoveStatus
        => _removeSnapshot.MessageId is not null
        && _removeSnapshot.CorrelationId is not null
        && _removeSnapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.Degraded
            or TenantCommandLifecycleState.UnableToVerify;

    private string RemoveStateCss
        => _removeSnapshot.State.ToString().ToLowerInvariant();

    private string RemoveStateText
        => Localizer[$"Tenants.GlobalAdministrators.Remove.State.{_removeSnapshot.State}"];

    private string RemoveAuditText
        => Localizer[$"Tenants.GlobalAdministrators.Remove.Audit.{_removeSnapshot.AuditState}"];

    private string RemoveLiveRegionMode
        => _removeSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string RemoveLifecycleRole
        => _removeSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "alert" : "status";

    private string RemoveStateSymbol
        => _removeSnapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            TenantCommandLifecycleState.ProjectionPending => "...",
            _ => ">",
        };

    protected override async Task OnInitializedAsync()
    {
        if (!IsAuthorized)
        {
            _snapshot = GlobalAdministratorsSnapshot.Unauthorized();
            return;
        }

        if (!BffComposition.IsReadSurfaceConnected)
        {
            _snapshot = GlobalAdministratorsSnapshot.Unavailable();
            return;
        }

        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusGrantUserIdPending)
        {
            _focusGrantUserIdPending = false;
            await _grantUserIdElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusGrantLauncherPending)
        {
            _focusGrantLauncherPending = false;
            await _grantLauncherElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusGrantLifecyclePending)
        {
            _focusGrantLifecyclePending = false;
            await _grantLifecycleElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRemoveSubmitPending)
        {
            _focusRemoveSubmitPending = false;
            await _removeSubmitElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRemoveLifecyclePending)
        {
            _focusRemoveLifecyclePending = false;
            await _removeLifecycleElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private async Task LoadAsync(bool reuseETag)
    {
        GlobalAdministratorsSnapshot previous = _snapshot;
        _snapshot = GlobalAdministratorsSnapshot.Loading();

        GlobalAdministratorsRequest request = new(
            Cursor: _currentCursor,
            PageSize: PageSize,
            ETag: reuseETag ? previous.ETag : null);

        _snapshot = await QueryGateway
            .GetGlobalAdministratorsAsync(request, previous, CancellationToken.None)
            .ConfigureAwait(false);
    }

    private async Task RefreshAsync()
        => await LoadAsync(reuseETag: true).ConfigureAwait(false);

    private async Task NextPageAsync()
    {
        _cursorHistory.Push(_currentCursor);
        _currentCursor = _snapshot.NextCursor;
        await LoadAsync(reuseETag: false).ConfigureAwait(false);
    }

    private async Task PreviousPageAsync()
    {
        if (_cursorHistory.Count > 0)
        {
            _currentCursor = _cursorHistory.Pop();
            await LoadAsync(reuseETag: false).ConfigureAwait(false);
        }
    }

    private void OnGrantUserIdInput(string? value)
        => _grantUserId = value;

    private async Task SubmitGrantAsync()
    {
        _grantValidationMessage = null;

        if (!string.IsNullOrWhiteSpace(GrantUnavailableReason))
        {
            SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Blocked(GrantUnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        if (string.IsNullOrWhiteSpace(_grantUserId))
        {
            _grantValidationMessage = Localizer["Tenants.GlobalAdministrators.Grant.Validation.UserIdRequired"];
            _focusGrantUserIdPending = true;
            return;
        }

        var request = new SetGlobalAdministratorCommandRequest(_grantUserId.Trim());
        SetGrantSnapshot(_grantSnapshot.RequestSent(request));
        _isGrantSubmitting = true;

        try
        {
            TenantCommandSubmissionResult result = await CommandGateway
                .SetGlobalAdministratorAsync(request, CancellationToken.None)
                .ConfigureAwait(false);

            SetGrantSnapshot(_grantSnapshot.ApplySubmission(result));
            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                await RefreshGrantStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            _isGrantSubmitting = false;
        }
    }

    private async Task RefreshGrantStatusAsync()
    {
        if (_grantSnapshot.MessageId is null || _grantSnapshot.CorrelationId is null)
        {
            return;
        }

        TenantCommandStatusResult status = await CommandGateway
            .GetStatusAsync(new TenantCommandTrackingHandle(_grantSnapshot.MessageId, _grantSnapshot.CorrelationId), CancellationToken.None)
            .ConfigureAwait(false);
        SetGrantSnapshot(_grantSnapshot.ApplyStatus(status));

        if (_grantSnapshot.Intent is not null
            && _grantSnapshot.State is TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending)
        {
            await RequeryGrantProjectionAsync().ConfigureAwait(false);
        }
    }

    private async Task RequeryGrantProjectionAsync()
    {
        GlobalAdministratorsSnapshot previous = _snapshot;
        GlobalAdministratorsRequest request = new(Cursor: null, PageSize: PageSize, ETag: null);
        _snapshot = await QueryGateway
            .GetGlobalAdministratorsAsync(request, previous, CancellationToken.None)
            .ConfigureAwait(false);
        SetGrantSnapshot(_grantSnapshot.ConfirmProjection(_snapshot));
    }

    private async Task CancelGrantAsync()
    {
        _grantUserId = null;
        _grantValidationMessage = null;
        SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Idle());
        _focusGrantLauncherPending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private void SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot snapshot)
    {
        _grantSnapshot = snapshot;
        if (_grantSnapshot.FocusTarget is TenantCommandFocusTarget.UserId)
        {
            _focusGrantUserIdPending = true;
        }
        else if (_grantSnapshot.FocusTarget is TenantCommandFocusTarget.Submit)
        {
            _focusGrantLauncherPending = true;
        }
        else if (_grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _grantSnapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle
            || _grantSnapshot.FocusTarget is TenantCommandFocusTarget.Refresh)
        {
            _focusGrantLifecyclePending = true;
        }
    }

    private void PreviewRemove(string userId)
    {
        GlobalAdministratorRow? row = _snapshot.Rows.FirstOrDefault(candidate => string.Equals(candidate.UserId, userId, StringComparison.Ordinal));
        if (RemoveUnavailableReason(row) is { Length: > 0 } unavailableReason)
        {
            SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Blocked(unavailableReason, TenantCommandFocusTarget.Lifecycle));
            return;
        }

        var request = new RemoveGlobalAdministratorCommandRequest(userId);
        SetRemoveSnapshot(_removeSnapshot.Preview(request, _snapshot.Rows));
    }

    private async Task SubmitRemoveAsync()
    {
        if (_removeSnapshot.Intent is null || IsRemoveSubmitDisabled)
        {
            return;
        }

        SetRemoveSnapshot(_removeSnapshot.RequestSent());
        _isRemoveSubmitting = true;

        try
        {
            TenantCommandSubmissionResult result = await CommandGateway
                .RemoveGlobalAdministratorAsync(_removeSnapshot.Intent, CancellationToken.None)
                .ConfigureAwait(false);

            SetRemoveSnapshot(_removeSnapshot.ApplySubmission(result));
            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                await RefreshRemoveStatusAsync().ConfigureAwait(false);
            }
        }
        finally
        {
            _isRemoveSubmitting = false;
        }
    }

    private async Task RefreshRemoveStatusAsync()
    {
        if (_removeSnapshot.MessageId is null || _removeSnapshot.CorrelationId is null)
        {
            return;
        }

        TenantCommandStatusResult status = await CommandGateway
            .GetStatusAsync(new TenantCommandTrackingHandle(_removeSnapshot.MessageId, _removeSnapshot.CorrelationId), CancellationToken.None)
            .ConfigureAwait(false);
        SetRemoveSnapshot(_removeSnapshot.ApplyStatus(status));

        if (_removeSnapshot.Intent is not null
            && _removeSnapshot.State is TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending)
        {
            await RequeryRemoveProjectionAsync().ConfigureAwait(false);
        }
    }

    private async Task RequeryRemoveProjectionAsync()
    {
        GlobalAdministratorsSnapshot previous = _snapshot;
        GlobalAdministratorsRequest request = new(Cursor: null, PageSize: PageSize, ETag: null);
        _snapshot = await QueryGateway
            .GetGlobalAdministratorsAsync(request, previous, CancellationToken.None)
            .ConfigureAwait(false);
        SetRemoveSnapshot(_removeSnapshot.ConfirmProjection(_snapshot));
    }

    private async Task CancelRemoveAsync()
    {
        SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Idle());
        _focusRemoveLifecyclePending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private async Task HandleRemovePreviewKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal))
        {
            await CancelRemoveAsync().ConfigureAwait(false);
        }
    }

    private async Task FocusRemoveSubmitAsync(FocusEventArgs args)
        => await _removeSubmitElement.FocusAsync().ConfigureAwait(false);

    private async Task FocusRemoveCancelAsync(FocusEventArgs args)
        => await _removeCancelElement.FocusAsync().ConfigureAwait(false);

    private void SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot snapshot)
    {
        _removeSnapshot = snapshot;
        if (_removeSnapshot.FocusTarget is TenantCommandFocusTarget.Submit)
        {
            _focusRemoveSubmitPending = true;
        }
        else if (_removeSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _removeSnapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle
            || _removeSnapshot.FocusTarget is TenantCommandFocusTarget.Refresh)
        {
            _focusRemoveLifecyclePending = true;
        }
    }
}
