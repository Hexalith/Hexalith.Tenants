        => _grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string GrantLifecycleRole
        => _grantSnapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "alert" : "status";

