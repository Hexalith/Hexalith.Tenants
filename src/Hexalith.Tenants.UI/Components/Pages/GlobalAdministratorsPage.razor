    {
        if (CreateReconciliation(_grantSnapshot) is { } grantReconciliation
            && _grantAdmissionLease?.TryRetainReconciliation(_fixedAggregateOwner, grantReconciliation) == true)
        {
            _grantAdmissionLease = null;
        }

        if (CreateReconciliation(_removeSnapshot) is { } removeReconciliation
            && _removeAdmissionLease?.TryRetainReconciliation(_fixedAggregateOwner, removeReconciliation) == true)
        {
            _removeAdmissionLease = null;
        }
    }

    private static GlobalAdministratorReconciliationState? CreateReconciliation(
        GlobalAdministratorGrantCommandSnapshot snapshot)
        => snapshot.Intent is not null
            && snapshot.PreviewEvidence?.IsComplete == true
            && snapshot.MessageId is { Length: > 0 } messageId
            && (snapshot.CorrelationId is { Length: > 0 }
                || snapshot.State is TenantCommandLifecycleState.RequestSent)
            && snapshot.State is TenantCommandLifecycleState.RequestSent
                or TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify
            ? new(
                GlobalAdministratorActionKind.Grant,
                snapshot.Intent.UserId,
                messageId,
                snapshot.CorrelationId,
                snapshot.State,
                snapshot.PreviewEvidence,
                snapshot.HasCommandEventEvidence,
                snapshot.IsSubmissionAmbiguous
                    || snapshot.State is TenantCommandLifecycleState.RequestSent
                        && string.IsNullOrWhiteSpace(snapshot.CorrelationId))
            : null;

    private static GlobalAdministratorReconciliationState? CreateReconciliation(
        GlobalAdministratorRemoveCommandSnapshot snapshot)
        => snapshot.Intent is not null
            && snapshot.MessageId is { Length: > 0 } messageId
            && snapshot.CorrelationId is { Length: > 0 } correlationId
            && snapshot.State is TenantCommandLifecycleState.Accepted
                or TenantCommandLifecycleState.ProjectionPending
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify
            ? new(
                GlobalAdministratorActionKind.Remove,
                snapshot.Intent.UserId,
                messageId,
                correlationId,
                snapshot.State)
            : null;

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }
}
