    // was emptied by a concurrent removal is a normal outcome (IsSuccessfulPage accepts Empty, so the cursor
    // commits), and without Reset the operator is stranded on that cursor with only a browser reload to
    // recover.
    private bool CanRecover
        => IsAuthorized
        && (_snapshot.Kind is GlobalAdministratorsSurfaceKind.Unknown
            or GlobalAdministratorsSurfaceKind.Stale
            or GlobalAdministratorsSurfaceKind.Degraded
            or GlobalAdministratorsSurfaceKind.Error
            or GlobalAdministratorsSurfaceKind.Unavailable
            or GlobalAdministratorsSurfaceKind.Invalid
            or GlobalAdministratorsSurfaceKind.Empty);

    private string? GrantUnavailableReason
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.Authorization"].Value
            : !BffComposition.IsReadSurfaceConnected
                ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.ReadSurface"].Value
                : !BffComposition.IsCommandSurfaceConnected
                    ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.CommandSurface"].Value
                    : !_snapshot.IsMutationEvidenceBacked
                        ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.Freshness"].Value
                        : _snapshot.Kind is GlobalAdministratorsSurfaceKind.Loading
                            or GlobalAdministratorsSurfaceKind.Unknown
                            or GlobalAdministratorsSurfaceKind.Degraded
                            or GlobalAdministratorsSurfaceKind.Error
                            or GlobalAdministratorsSurfaceKind.Unauthorized
                            or GlobalAdministratorsSurfaceKind.Unavailable
                            or GlobalAdministratorsSurfaceKind.Invalid
                            ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.ReadSurface"].Value
                            : IsGrantInFlight
                                ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.InFlight"].Value
                                : IsRemoveInFlight
                                    ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.InFlight"].Value
                                    : null;

    private string? RemoveUnavailableReason(GlobalAdministratorRow? row)
        => RemoveUnavailableReasonForUser(row?.UserId);

    // Evaluated against a user id rather than a row so the submit path can re-check the previewed intent
    // against the *current* snapshot. Preview alone is not a durable authorization: a notification refresh
    // replaces _snapshot underneath a Previewed intent without resetting it, so the last-administrator,
    // freshness and completeness gates must be re-evaluated at submit or Remove fails open through them.
    private string? RemoveUnavailableReasonForUser(string? userId)
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.Authorization"].Value
            : !BffComposition.IsReadSurfaceConnected
                ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.ReadSurface"].Value
                : !BffComposition.IsCommandSurfaceConnected
                    ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.CommandSurface"].Value
                    : !_snapshot.IsMutationEvidenceBacked
                        ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.Freshness"].Value
                        : _snapshot.Kind is GlobalAdministratorsSurfaceKind.Loading
                            or GlobalAdministratorsSurfaceKind.Unknown
                            or GlobalAdministratorsSurfaceKind.Degraded
                            or GlobalAdministratorsSurfaceKind.Error
                            or GlobalAdministratorsSurfaceKind.Unauthorized
                            or GlobalAdministratorsSurfaceKind.Unavailable
                            or GlobalAdministratorsSurfaceKind.Invalid
                            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.ReadSurface"].Value
                            : IsGrantInFlight
                                ? Localizer["Tenants.GlobalAdministrators.Grant.Unavailable.InFlight"].Value
                                : IsRemoveInFlight
                                    ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.InFlight"].Value
                                    : userId is not null && !_snapshot.Rows.Any(candidate => string.Equals(candidate.UserId, userId, StringComparison.Ordinal))
                                            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.TargetMissing"].Value
                                        : _snapshot.IsCompleteEvidence && _snapshot.Rows.Count <= 1
                                            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.LastAdmin"].Value
                                        : !HasPositiveRemovalPopulationEvidence
                                            ? Localizer["Tenants.GlobalAdministrators.Remove.Unavailable.Incomplete"].Value
                                            : null;

    // Only server-stated population counts. _cursorHistory is client-local paging bookkeeping: it records
    // that this circuit navigated forward at some point, which says nothing about how many administrators
    // exist *now*. Treating it as evidence let the last-administrator hard stop fail open -- on page 2 the
    // completeness gate is false, so the LastAdmin branch is skipped, and a non-empty history alone then
    // enabled Remove against a platform that may have exactly one administrator left. HasMore is kept
    // because it is the service's own statement that rows exist beyond the current page.
    private bool HasPositiveRemovalPopulationEvidence
        => (_snapshot.IsCompleteEvidence && _snapshot.Rows.Count > 1)
        || _snapshot.HasMore;

