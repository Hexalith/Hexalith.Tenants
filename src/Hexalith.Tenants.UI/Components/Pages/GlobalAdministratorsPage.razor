@page "/global-administrators"
@* Platform authority always fails closed in the rendered state below. Program.cs additionally attaches
   endpoint authorization when OIDC is configured; keeping that metadata out of this static component lets
   the Keycloak-disabled topology render safely instead of challenging through a missing auth scheme. *@
@using Hexalith.Tenants.UI.State
@using Hexalith.Tenants.UI.State.TenantDetail
@using Microsoft.Extensions.Logging
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantsBffComposition BffComposition
@inject ITenantQueryGateway QueryGateway
@inject ITenantCommandGateway CommandGateway
@inject IServiceProvider Services
@implements IAsyncDisposable

<FcPageLayout Mode="FcPageLayoutMode.FullWidth">
    @if (!IsAuthorized)
    {
        @* The restricted surface keeps the page area and the live region the authorized surface
           publishes. Only the read contract, navigation, and administrator data are withheld. *@
        <FluentStack Orientation="Orientation.Vertical"
                     VerticalGap="20px"
                     Class="global-admins"
                     data-testid="tenants-global-admins-area"
                     aria-labelledby="global-admins-restricted-heading">
            <FcPageHeader PageTitle="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                          Heading="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                          HeadingId="global-admins-restricted-heading"
                          TestId="tenants-global-admins-restricted-header" />
            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="12px"
                         data-testid="tenants-global-admins-unavailable"
                         role="alert">
                <FluentMessageBar Intent="MessageBarIntent.Warning"
                                  Title="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                                  data-testid="tenants-global-admins-denied-message">
                    <p id="global-admins-live-region" data-testid="tenants-global-admins-live-region">
                        @Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Message"]
                    </p>
                </FluentMessageBar>
                @if (_authorizationReflection is TenantLifecycleAuthorizationReflectionState.Indeterminate)
                {
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@PageLoadInFlight"
                                  data-testid="tenants-global-admins-authorization-retry"
                                  OnClick="RetryAuthorizationAsync">
                        @Localizer["Tenants.GlobalAdministrators.Recovery.Retry"]
                    </FluentButton>
                }
            </FluentStack>
        </FluentStack>
    }
    else
    {
    <FluentStack Orientation="Orientation.Vertical"
                 VerticalGap="20px"
                 Class="global-admins"
                 data-testid="tenants-global-admins-area"
                 inert="@(IsGrantPreviewOpen ? string.Empty : null)"
                 aria-hidden="@(IsGrantPreviewOpen ? "true" : null)"
                 aria-labelledby="global-admins-heading">
    <FcPageHeader PageTitle="@PageTitleText"
                  Heading="@PageTitleText"
                  HeadingId="global-admins-heading"
                  Eyebrow="@Localizer["Tenants.GlobalAdministrators.Eyebrow"]"
                  Description="@Localizer["Tenants.GlobalAdministrators.Description"]"
                  TestId="tenants-global-admins-page-header" />

    <FluentAnchorButton Href="@(IsGrantPreviewOpen ? null : SafeReturnUrl)"
                        Appearance="ButtonAppearance.Outline"
                        aria-disabled="@(IsGrantPreviewOpen ? "true" : null)"
                        tabindex="@(IsGrantPreviewOpen ? "-1" : null)"
                        data-testid="tenants-global-admins-return">
        @Localizer["Tenants.GlobalAdministrators.Return"]
    </FluentAnchorButton>

    @* Plain-HTML host so CSS isolation has something to scope. ::deep compiles to "[b-xxx] <selector>" and
       needs a scoped ancestor rendered by THIS component; a FluentMessageBar written directly under
       FcPageLayout has none, so the rule matched nothing and the notice showed at every width. *@
    <div class="global-admins__mobile-readonly-host">
        <FluentMessageBar Class="global-admins__mobile-readonly"
                          Intent="MessageBarIntent.Info"
                          Title="@Localizer["Tenants.GlobalAdministrators.Mobile.ReadOnly.Title"]"
                          data-testid="tenants-global-admins-mobile-readonly">
            @Localizer["Tenants.GlobalAdministrators.Mobile.ReadOnly.Message"]
        </FluentMessageBar>
    </div>

    <FluentAccordion Class="global-admins__sections"
                     ExpandMode="AccordionExpandMode.Multi"
                     Block="true">
        <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.Scope.Title"]"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__scope"
                     aria-labelledby="global-admins-scope-heading"
                     data-testid="tenants-global-admins-scope">
                <h2 id="global-admins-scope-heading">@Localizer["Tenants.GlobalAdministrators.Scope.Title"]</h2>
                <p>@Localizer["Tenants.GlobalAdministrators.Scope.Message"]</p>
                <dl>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Value"]</dd>
                    </div>
                </dl>
                <dl data-testid="tenants-global-admins-evidence">
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Scope.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-scope">@Localizer["Tenants.GlobalAdministrators.Evidence.Scope.Fixed"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Freshness.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-freshness">@QualifiedFreshnessEvidenceText</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Count.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-count">@QualifiedCountEvidenceText</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Admission.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-admission">@AdmissionEvidenceText</dd>
                    </div>
                </dl>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@StatusHeading"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__state global-admins__state--@StateCss"
                     role="@StatusRole"
                     aria-live="@StatusLive"
                     tabindex="0"
                     data-testid="@StateTestId">
                <FluentText Class="global-admins__state-icon" aria-hidden="true">@StateIcon</FluentText>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="global-admins__state-copy">
                    <h2>@StatusHeading</h2>
                    <p id="global-admins-live-region" data-testid="tenants-global-admins-live-region">@StatusMessage</p>
                </FluentStack>
            </section>
            <ProjectionLifecycleStatus Lifecycle="@_snapshot.Lifecycle"
                                       TestId="tenants-global-admins-projection-lifecycle-status"
                                       BadgeTestId="tenants-global-admins-projection-lifecycle-status-badge" />
            @if (CanRecover)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@(PageLoadInFlight || IsGrantPreviewOpen)"
                                  data-testid="tenants-global-admins-retry"
                                  OnClick="RetryAsync">
                        @Localizer["Tenants.GlobalAdministrators.Recovery.Retry"]
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@(PageLoadInFlight || IsGrantPreviewOpen)"
                                  data-testid="tenants-global-admins-reset"
                                  OnClick="ResetPagingAsync">
                        @Localizer["Tenants.GlobalAdministrators.Recovery.Reset"]
                    </FluentButton>
                </FluentStack>
            }
            @if (HasIncompletePagingEvidence)
            {
                <p class="global-admins__nudge"
                   role="status"
                   aria-live="polite"
                   data-testid="tenants-global-admins-incomplete-paging">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.IncompletePaging"]
                </p>
            }
            @* Rendered as siblings of the state section, not children. StatusRole/StatusLive resolve to
               alert/assertive for Invalid, Stale, Unknown, Degraded, Error, Unauthorized and Unavailable,
               and inserting or removing a child mutates that region's own subtree -- so every projection
               nudge re-announced the whole state block assertively and interrupted the screen-reader user.
               These are polite, non-authoritative signals and must own their live regions. *@
            @if (_isNotificationRefreshing)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-notification-refreshing">
                    @Localizer["Tenants.GlobalAdministrators.Freshness.Refreshing"]
                </p>
            }
            @if (_pagingJumpedToFirstPage)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-history-truncated">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.HistoryTruncated"]
                </p>
            }
            @if (_authorizationPagingReset)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-authorization-page-reset">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.AuthorizationChanged"]
                </p>
            }
            @if (_snapshot.PagingRecovered)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-page-recovered">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.PageRecovered"]
                </p>
            }
        </FluentAccordionItem>

        <FluentAccordionItem Class="global-admins__mutation-section"
                             Header="@Localizer["Tenants.GlobalAdministrators.Grant.Title"]"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__grant"
                     aria-labelledby="global-admins-grant-heading"
                     data-testid="tenants-global-admin-grant">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="global-admins__grant-heading">
            <h2 id="global-admins-grant-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Title"]</h2>
            <p>@Localizer["Tenants.GlobalAdministrators.Grant.Description"]</p>
        </FluentStack>

        @if (!string.IsNullOrWhiteSpace(GrantUnavailableReason))
        {
            <FluentText class="global-admins__grant-unavailable"
                        id="tenants-global-admin-grant-unavailable-reason"
                        role="alert"
                        data-testid="tenants-global-admin-grant-unavailable-reason">
                @GrantUnavailableReason
            </FluentText>
            <FluentText id="tenants-global-admin-grant-recovery"
                        data-testid="tenants-global-admin-grant-recovery">
                @GrantRecovery
            </FluentText>
        }

        <EditForm Model="@_grantFormModel"
                  FormName="tenants-global-admin-grant"
                  class="global-admins__grant-form"
                  data-testid="tenants-global-admin-grant-form"
                  OnSubmit="SubmitGrantAsync">
            <div class="global-admins__grant-field global-admins__mutation-initiation">
                <FluentTextInput Id="tenants-global-admin-grant-user-id"
                                 @ref="_grantUserIdElement"
                                 name="global-administrator-user-id"
                                 Label="@Localizer["Tenants.GlobalAdministrators.Grant.UserId.Label"]"
                                 @* No MaxLength: the attribute renders the DOM `maxlength`, which truncates
                                    typed and pasted input in the browser. A pasted over-long id was silently
                                    shortened and dispatched as a platform-authority grant against a DIFFERENT
                                    identity, and it made the length half of the submit guard unreachable from
                                    the real UI. The bound is advertised by the help text and enforced at submit,
                                    where an over-long id gets an explicit localized rejection instead. *@
                                 Value="@_grantUserId"
                                 ValueChanged="OnGrantUserIdInput"
                                 Disabled="@(_grantSnapshot.State is TenantCommandLifecycleState.Previewed || IsGrantInFlight || Volatile.Read(ref _grantPreviewInFlight) != 0)"
                                 data-testid="tenants-global-admin-grant-user-id"
                                 aria-describedby="@GrantUserIdDescribedBy" />
                <FluentText id="tenants-global-admin-grant-user-id-help">
                    @Localizer["Tenants.GlobalAdministrators.Grant.UserId.Help"]
                </FluentText>
            </div>

            <dl class="global-admins__grant-scope global-admins__mutation-initiation" data-testid="tenants-global-admin-grant-scope">
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Value"]</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Value"]</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Value"]</dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_grantValidationMessage))
            {
                <p id="tenants-global-admin-grant-validation"
                   class="global-admins__grant-validation"
                   role="alert"
                   data-testid="tenants-global-admin-grant-validation">
                    @_grantValidationMessage
                </p>
            }

            <div class="global-admins__grant-actions">
                <span class="global-admins__grant-submit-focus global-admins__mutation-initiation" tabindex="-1">
                    <FluentButton Type="ButtonType.Submit"
                                  @key="_grantLauncherFocusVersion"
                                  Appearance="ButtonAppearance.Primary"
                                  AutoFocus="@_focusGrantLauncherPending"
                                  data-testid="tenants-global-admin-grant-submit"
                                  aria-describedby="@(GrantAvailability.IsAvailable ? null : "tenants-global-admin-grant-unavailable-reason tenants-global-admin-grant-recovery")"
                                  Disabled="@IsGrantSubmitDisabled">
                        @Localizer["Tenants.GlobalAdministrators.Grant.Preview.Launch"]
                    </FluentButton>
                </span>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Class="global-admins__mutation-initiation"
                              data-testid="tenants-global-admin-grant-cancel"
                              Disabled="@(!CanCancelGrant || IsGrantPreviewOpen)"
                              OnClick="CancelGrantAsync">
                    @Localizer["Tenants.GlobalAdministrators.Grant.Cancel"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Class="global-admins__mutation-initiation"
                              data-testid="tenants-global-admin-grant-refresh"
                              Disabled="@(!CanRefreshGrantStatus)"
                              OnClick="RefreshGrantStatusAsync">
                    @GrantRefreshActionText
                </FluentButton>
            </div>
        </EditForm>

        <section class="global-admins__grant-lifecycle global-admins__grant-lifecycle--@GrantStateCss"
                 @ref="_grantLifecycleElement"
                 tabindex="-1"
                 role="@GrantLifecycleRole"
                 aria-labelledby="global-admins-grant-lifecycle-heading"
                 data-testid="tenants-global-admin-grant-lifecycle">
            <h3 id="global-admins-grant-lifecycle-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Lifecycle.Title"]</h3>
            <p data-testid="tenants-global-admin-grant-state">
                <FluentText Class="global-admins__grant-state-symbol" aria-hidden="true">@GrantStateSymbol</FluentText>
                <FluentText>@GrantStateText</FluentText>
            </p>
            @if (!string.IsNullOrWhiteSpace(GrantSafeMessage))
            {
                <p data-testid="tenants-global-admin-grant-safe-message">@GrantSafeMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(GrantSafeRecovery))
            {
                <p data-testid="tenants-global-admin-grant-safe-recovery">@GrantSafeRecovery</p>
            }
            <p data-testid="tenants-global-admin-grant-audit-state">@GrantAuditText</p>
            <p class="global-admins__grant-live"
               data-testid="tenants-global-admin-grant-live-region"
               aria-live="@GrantLiveRegionMode"
               aria-atomic="true">
                @GrantStateText
            </p>
        </section>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Class="global-admins__mutation-section"
                             Header="@Localizer["Tenants.GlobalAdministrators.Remove.Title"]"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__remove"
                     aria-labelledby="global-admins-remove-heading"
                     data-testid="tenants-global-admin-remove-flow">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="global-admins__remove-heading">
            <h2 id="global-admins-remove-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Title"]</h2>
            <p>@Localizer["Tenants.GlobalAdministrators.Remove.Description"]</p>
        </FluentStack>

        @if (_removeSnapshot.State is TenantCommandLifecycleState.Previewed
            or TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending)
        {
            <section class="global-admins__remove-preview"
                     role="dialog"
                     aria-modal="true"
                     aria-labelledby="global-admins-remove-preview-heading"
                     data-testid="tenants-global-admin-remove-preview"
                     @onkeydown="HandleRemovePreviewKeyDownAsync">
                <span class="global-admins__remove-focus-sentinel"
                      tabindex="0"
                      data-testid="tenants-global-admin-remove-focus-start"
                      @onfocus="FocusRemoveCancelAsync"></span>
                <h3 id="global-admins-remove-preview-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Title"]</h3>
                <dl class="global-admins__remove-preview-grid">
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Scope"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Scope.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Target"]</dt>
                        <dd data-testid="tenants-global-admin-remove-target">@_removeSnapshot.Intent?.UserId</dd>
                    </div>
                    <div>
                        @* PreviewRows is one PageSize-bounded page, not the platform total. Labelling a
                           paged count "Current administrator count" overstated the evidence on exactly the
                           incomplete-evidence path Remove stays enabled for (HasMore alone), so the label
                           follows IsCompleteEvidence -- the flag that distinguishes the two.
                           Read from the preview snapshot, not the live one: the count beside it is
                           _removeSnapshot.PreviewRows, captured at preview time, so selecting the label from
                           _snapshot paired "Current administrator count" with a page-one count whenever a
                           notification refresh landed between preview and render. *@
                        <dt data-testid="tenants-global-admin-remove-count-label">@(_removeSnapshot.PreviewIsCompleteEvidence
                            ? Localizer["Tenants.GlobalAdministrators.Remove.Preview.Count"]
                            : Localizer["Tenants.GlobalAdministrators.Remove.Preview.Count.VisiblePage"])</dt>
                        <dd data-testid="tenants-global-admin-remove-count">@(_removeSnapshot.PreviewRows?.Count ?? 0)</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Freshness"]</dt>
                        <dd>@_removeSnapshot.PreviewFreshness</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.LastAdminImpact"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.LastAdminImpact.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.AccessRevoked"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.AccessRevoked.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-known-consequences">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownConsequences"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownConsequences.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-known-unknowns">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownUnknowns"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownUnknowns.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-audit-expectation">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Audit"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Audit.Value"]</dd>
                    </div>
                    <div data-testid="tenants-global-admin-remove-recovery">
                        <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Recovery"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Recovery.Value"]</dd>
                    </div>
                </dl>
                @if (RemoveIntentUnavailableReason is { Length: > 0 } previewUnavailableReason)
                {
                    <FluentText id="tenants-global-admin-remove-preview-unavailable-reason"
                                role="alert"
                                data-testid="tenants-global-admin-remove-preview-unavailable-reason">
                        @previewUnavailableReason
                    </FluentText>
                    <FluentText id="tenants-global-admin-remove-preview-unavailable-recovery"
                                data-testid="tenants-global-admin-remove-preview-unavailable-recovery">
                        @RemoveIntentRecovery
                    </FluentText>
                }
                <div class="global-admins__remove-actions">
                    <span class="global-admins__remove-submit-focus global-admins__mutation-initiation" tabindex="-1" @ref="_removeSubmitElement">
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      data-testid="tenants-global-admin-remove-submit"
                                      aria-describedby="@(RemoveIntentUnavailableReason is null ? null : "tenants-global-admin-remove-preview-unavailable-reason tenants-global-admin-remove-preview-unavailable-recovery")"
                                      Disabled="@IsRemoveSubmitDisabled"
                                      OnClick="SubmitRemoveAsync">
                            @Localizer["Tenants.GlobalAdministrators.Remove.Submit"]
                        </FluentButton>
                    </span>
                    <span class="global-admins__remove-cancel-focus global-admins__mutation-initiation" tabindex="-1" @ref="_removeCancelElement">
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      data-testid="tenants-global-admin-remove-cancel"
                                      Disabled="@IsGrantPreviewOpen"
                                      OnClick="CancelRemoveAsync">
                            @Localizer["Tenants.GlobalAdministrators.Remove.Cancel"]
                        </FluentButton>
                    </span>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Class="global-admins__mutation-initiation"
                                  data-testid="tenants-global-admin-remove-refresh"
                                  Disabled="@(!CanRefreshRemoveStatus || IsGrantPreviewOpen)"
                                  OnClick="RefreshRemoveStatusAsync">
                        @Localizer["Tenants.GlobalAdministrators.Remove.Refresh"]
                    </FluentButton>
                </div>
                <span class="global-admins__remove-focus-sentinel"
                      tabindex="0"
                      data-testid="tenants-global-admin-remove-focus-end"
                      @onfocus="FocusRemoveSubmitAsync"></span>
            </section>
        }

        <section class="global-admins__remove-lifecycle global-admins__remove-lifecycle--@RemoveStateCss"
                 @ref="_removeLifecycleElement"
                 tabindex="-1"
                 role="@RemoveLifecycleRole"
                 aria-labelledby="global-admins-remove-lifecycle-heading"
                 data-testid="tenants-global-admin-remove-lifecycle">
            <h3 id="global-admins-remove-lifecycle-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Lifecycle.Title"]</h3>
            <p data-testid="tenants-global-admin-remove-state">
                <FluentText Class="global-admins__remove-state-symbol" aria-hidden="true">@RemoveStateSymbol</FluentText>
                <FluentText>@RemoveStateText</FluentText>
            </p>
            @if (!string.IsNullOrWhiteSpace(_removeSnapshot.SafeMessage))
            {
                <p data-testid="tenants-global-admin-remove-safe-message">@ResolveSafeMessage(_removeSnapshot.SafeMessage)</p>
            }
            <p data-testid="tenants-global-admin-remove-audit-state">@RemoveAuditText</p>
            <p class="global-admins__remove-live"
               data-testid="tenants-global-admin-remove-live-region"
               aria-live="@RemoveLiveRegionMode"
               aria-atomic="true">
                @RemoveStateText
            </p>
        </section>
            </section>
        </FluentAccordionItem>

        @if (ShouldRenderRows)
        {
            <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.List.Title"]"
                                 Disabled="@IsGrantPreviewOpen"
                                 Expanded="true">
                <section class="global-admins__table-shell"
                         aria-labelledby="global-admins-list-heading"
                         inert="@(IsGrantPreviewOpen ? string.Empty : null)"
                         data-testid="tenants-global-admins-list">
            <div class="global-admins__table-header">
                <h2 id="global-admins-list-heading">@Localizer["Tenants.GlobalAdministrators.List.Title"]</h2>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Disabled="@(PageLoadInFlight || IsGrantPreviewOpen)"
                              data-testid="tenants-global-admins-refresh"
                              OnClick="RefreshAsync">
                    @Localizer["Tenants.GlobalAdministrators.Refresh"]
                </FluentButton>
            </div>
            <div class="global-admins__table-scroll">
                <FluentDataGrid Items="@_snapshot.Rows.AsQueryable()"
                                Class="global-admins__data-grid"
                                ResizableColumns="true"
                                ReorderableColumns="false"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                ItemKey="@(row => row.UserId)">
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Identity"]"
                                    ColumnId="global-admin-identity"
                                    Width="260px"
                                    Pin="DataGridColumnPin.Start">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.375rem" Class="global-admins__identity" data-testid="tenants-global-admins-row">
                            <FluentText Class="global-admins__identity-value"
                                  title="@context.UserId"
                                  aria-label="@Localizer["Tenants.GlobalAdministrators.Identity.Accessible", context.UserId]"
