    private async Task SubmitRemoveAsync()
    {
        if (!await ReauthorizeAsync().ConfigureAwait(false)
            || _removeSnapshot.Intent is null)
        {
            return;
        }

        // Re-check the previewed intent against the current snapshot. The preview may have been taken before
        // a notification refresh replaced _snapshot, so this is where the last-administrator hard stop,
        // freshness and completeness gates actually bind. Report the reason instead of failing silently.
        if (RemoveIntentUnavailableReason is { Length: > 0 } blockedReason)
        {
            await InvokeAsync(() => SetRemoveSnapshot(
                GlobalAdministratorRemoveCommandSnapshot.Blocked(blockedReason, TenantCommandFocusTarget.Lifecycle)))
                .ConfigureAwait(false);
            return;
        }

        // Captured in the same read the guard validates. Re-reading _removeSnapshot.Intent afterwards let a
        // CancelRemoveAsync running on the dispatcher replace the snapshot with Idle() in between -- this body
        // runs off-dispatcher after the hoisted re-authorization -- making request null and raising an
        // ArgumentNullException that the OperationCanceledException filter below does not match. An unhandled
        // exception from an event callback tears down the circuit.
        if (IsRemoveSubmitDisabled || _removeSnapshot.Intent is not { } request)
        {
            return;
        }
        if (_aggregateAdmissionGate is null
            || !_aggregateAdmissionGate.TryAcquireLease(
                TenantCommandAggregateLock.ForGlobalAdministrators(),
                _fixedAggregateOwner,
                out TenantAggregateCommandLease? acquiredLease)
            || acquiredLease is null)
        {
            await InvokeAsync(() => SetRemoveSnapshot(GlobalAdministratorRemoveCommandSnapshot.Blocked(
                Localizer["Tenants.GlobalAdministrators.Availability.Remove.Unavailable.AggregateBusy"],
                TenantCommandFocusTarget.Lifecycle))).ConfigureAwait(false);
            return;
        }

        using PendingOperation operation = BeginRemoveMutation();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        bool removeRequestArmed = false;
        GlobalAdministratorRemoveCommandSnapshot? requestSentSnapshot = null;
        TenantAggregateCommandLease? submissionLease = null;
        await InvokeAsync(() =>
        {
            if (!CanApplyRemoveMutation(generation))
            {
                _ = acquiredLease.TryAbandonBeforeDispatch(_fixedAggregateOwner);
                return;
            }

            if (!acquiredLease.TryMarkDispatched(_fixedAggregateOwner))
            {
                _ = acquiredLease.TryAbandonBeforeDispatch(_fixedAggregateOwner);
                return;
            }

            _removeAdmissionLease = acquiredLease;
            SetRemoveSnapshot(_removeSnapshot.RequestSent());
            requestSentSnapshot = _removeSnapshot;
            submissionLease = acquiredLease;
            _isRemoveSubmitting = true;
            removeRequestArmed = true;
        }).ConfigureAwait(false);
        if (!removeRequestArmed || requestSentSnapshot is null || submissionLease is null)
        {
            return;
        }

        // Same reason as the grant submit: the hoisted re-authorization consumed the automatic render, so the
        // in-flight state needs an explicit marshalled one.
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);

        try
        {
            TenantCommandSubmissionResult result = await CommandGateway
                .RemoveGlobalAdministratorAsync(request, cancellationToken)
                .ConfigureAwait(false);
            GlobalAdministratorRemoveCommandSnapshot submissionSnapshot = requestSentSnapshot.ApplySubmission(result);
            bool submissionApplied = false;
            bool resumeAdopted = false;
            await InvokeAsync(() =>
            {
                if (!CanApplyRemoveMutation(generation) || !ReferenceEquals(_removeSnapshot, requestSentSnapshot))
                {
                    resumeAdopted = RetainOrReleaseRemoveCompletion(submissionSnapshot, submissionLease);
                    return;
                }

                SetRemoveSnapshot(submissionSnapshot);
                submissionApplied = true;
                StateHasChanged();
            }).ConfigureAwait(false);
            if (resumeAdopted)
            {
                await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
                return;
            }

            if (submissionApplied && result.State is TenantCommandLifecycleState.Accepted)
            {
                await RefreshRemoveStatusCoreAsync(generation, cancellationToken).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            await ApplyRemoveSubmissionExceptionAsync(generation, requestSentSnapshot, submissionLease).ConfigureAwait(false);
        }
        catch
        {
            await ApplyRemoveSubmissionExceptionAsync(generation, requestSentSnapshot, submissionLease).ConfigureAwait(false);
        }
        finally
        {
            if (!_disposed)
            {
                await InvokeAsync(() =>
                {
                    if (CanApplyRemoveMutation(generation))
                    {
                        _isRemoveSubmitting = false;
                    }
                }).ConfigureAwait(false);
            }
        }
    }

