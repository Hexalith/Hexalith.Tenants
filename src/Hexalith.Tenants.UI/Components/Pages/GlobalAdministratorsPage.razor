    private async Task RequeryGrantProjectionAsync(long generation, CancellationToken cancellationToken)
    {
        if (!CanApplyGrantMutation(generation))
        {
            return;
        }

        GlobalAdministratorGrantCommandSnapshot projectionBasis = _grantSnapshot;
        TenantAggregateCommandLease? projectionLease = _grantAdmissionLease;
        GlobalAdministratorsSnapshot snapshot = await LoadCompletePopulationSafelyAsync(cancellationToken)
            .ConfigureAwait(false);
        GlobalAdministratorGrantCommandSnapshot projectionSnapshot = projectionBasis.ConfirmProjection(snapshot);
        bool resumeAdopted = false;
        await InvokeAsync(() =>
        {
            if (!CanApplyGrantMutation(generation)
                || !ReferenceEquals(_grantSnapshot, projectionBasis))
            {
                if (projectionLease is not null)
                {
                    resumeAdopted = RetainOrReleaseGrantCompletion(projectionSnapshot, projectionLease);
                }

                return;
            }

            if (projectionSnapshot.State is TenantCommandLifecycleState.Confirmed)
            {
                _completeSnapshot = snapshot;
            }

            SetGrantSnapshot(projectionSnapshot);
            StateHasChanged();
        }).ConfigureAwait(false);
        if (resumeAdopted)
        {
            await ResumeAdoptedReconciliationAsync().ConfigureAwait(false);
        }
        else if (projectionSnapshot.State is TenantCommandLifecycleState.Confirmed
            && CanApplyGrantMutation(generation))
        {
            // Confirmation comes from a complete bounded walk, but the review surface remains a paged
            // contract. Refresh the currently displayed cursor instead of replacing it with the complete
            // population or silently navigating to page one.
            _ = await LoadAsync(reuseETag: false, retainConfirmed: true).ConfigureAwait(false);
        }
    }

    private async Task CancelGrantAsync()
    {
        if (_grantAdmissionLease?.IsDispatchMarked == true)
        {
            return;
        }

        InvalidateGrantMutation();
        TenantAggregateCommandLease? lease = _grantAdmissionLease;
        if (lease is not null
            && lease.TryAbandonBeforeDispatch(_fixedAggregateOwner)
            && ReferenceEquals(_grantAdmissionLease, lease))
        {
            _grantAdmissionLease = null;
        }

        Interlocked.Increment(ref _grantPreviewGeneration);
        _grantUserId = null;
        _grantValidationMessage = null;
        _grantAcknowledged = false;
        SetGrantSnapshot(GlobalAdministratorGrantCommandSnapshot.Idle());
        _focusGrantLauncherPending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

