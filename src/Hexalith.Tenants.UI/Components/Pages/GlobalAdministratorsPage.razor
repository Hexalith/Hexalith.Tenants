@page "/global-administrators"
@* Platform authority always fails closed in the rendered state below. Program.cs additionally attaches
   endpoint authorization when OIDC is configured; keeping that metadata out of this static component lets
   the Keycloak-disabled topology render safely instead of challenging through a missing auth scheme. *@
@using Hexalith.Tenants.UI.State
@using Hexalith.Tenants.UI.State.TenantDetail
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantsBffComposition BffComposition
@inject ITenantQueryGateway QueryGateway
@inject ITenantCommandGateway CommandGateway
@inject IJSRuntime JS
@inject IServiceProvider Services
@implements IAsyncDisposable

<FcPageLayout Mode="FcPageLayoutMode.FullWidth">
    @if (!IsAuthorized)
    {
        @* The restricted surface keeps the page area and the live region the authorized surface
           publishes. Only the read contract, navigation, and administrator data are withheld. *@
        <FluentStack Orientation="Orientation.Vertical"
                     VerticalGap="20px"
                     Class="global-admins"
                     data-testid="tenants-global-admins-area"
                     aria-labelledby="global-admins-restricted-heading">
            <FcPageHeader PageTitle="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                          Heading="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                          HeadingId="global-admins-restricted-heading"
                          TestId="tenants-global-admins-restricted-header" />
            <FluentStack Orientation="Orientation.Vertical"
                         VerticalGap="12px"
                         data-testid="tenants-global-admins-unavailable"
                         role="alert">
                <FluentMessageBar Intent="MessageBarIntent.Warning"
                                  Title="@Localizer["Tenants.GlobalAdministrators.RestrictedTitle"]"
                                  data-testid="tenants-global-admins-denied-message">
                    <p id="global-admins-live-region" data-testid="tenants-global-admins-live-region">
                        @Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Message"]
                    </p>
                </FluentMessageBar>
                @if (_authorizationReflection is TenantLifecycleAuthorizationReflectionState.Indeterminate)
                {
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@PageLoadInFlight"
                                  data-testid="tenants-global-admins-authorization-retry"
                                  OnClick="RetryAuthorizationAsync">
                        @Localizer["Tenants.GlobalAdministrators.Recovery.Retry"]
                    </FluentButton>
                }
            </FluentStack>
        </FluentStack>
    }
    else
    {
    <FluentStack Orientation="Orientation.Vertical"
                 VerticalGap="20px"
                 Class="global-admins"
                 data-testid="tenants-global-admins-area"
                 inert="@(IsAnyPreviewOpen ? string.Empty : null)"
                 aria-hidden="@(IsAnyPreviewOpen ? "true" : null)"
                 aria-labelledby="global-admins-heading">
    <FcPageHeader PageTitle="@PageTitleText"
                  Heading="@PageTitleText"
                  HeadingId="global-admins-heading"
                  Eyebrow="@Localizer["Tenants.GlobalAdministrators.Eyebrow"]"
                  Description="@Localizer["Tenants.GlobalAdministrators.Description"]"
                  TestId="tenants-global-admins-page-header" />

    <FluentAnchorButton Href="@(IsAnyPreviewOpen ? null : SafeReturnUrl)"
                        Appearance="ButtonAppearance.Outline"
                        aria-disabled="@(IsAnyPreviewOpen ? "true" : null)"
                        tabindex="@(IsAnyPreviewOpen ? "-1" : null)"
                        data-testid="tenants-global-admins-return">
        @Localizer["Tenants.GlobalAdministrators.Return"]
    </FluentAnchorButton>

    @* Plain-HTML host so CSS isolation has something to scope. ::deep compiles to "[b-xxx] <selector>" and
       needs a scoped ancestor rendered by THIS component; a FluentMessageBar written directly under
       FcPageLayout has none, so the rule matched nothing and the notice showed at every width. *@
    <div class="global-admins__mobile-readonly-host">
        <FluentMessageBar Class="global-admins__mobile-readonly"
                          Intent="MessageBarIntent.Info"
                          Title="@Localizer["Tenants.GlobalAdministrators.Mobile.ReadOnly.Title"]"
                          data-testid="tenants-global-admins-mobile-readonly">
            @Localizer["Tenants.GlobalAdministrators.Mobile.ReadOnly.Message"]
        </FluentMessageBar>
    </div>

    <FluentAccordion Class="global-admins__sections"
                     ExpandMode="AccordionExpandMode.Multi"
                     Block="true">
        <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.Scope.Title"]"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__scope"
                     aria-labelledby="global-admins-scope-heading"
                     data-testid="tenants-global-admins-scope">
                <h2 id="global-admins-scope-heading">@Localizer["Tenants.GlobalAdministrators.Scope.Title"]</h2>
                <p>@Localizer["Tenants.GlobalAdministrators.Scope.Message"]</p>
                <dl>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Value"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Label"]</dt>
                        <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Value"]</dd>
                    </div>
                </dl>
                <dl data-testid="tenants-global-admins-evidence">
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Scope.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-scope">@Localizer["Tenants.GlobalAdministrators.Evidence.Scope.Fixed"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Freshness.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-freshness">@QualifiedFreshnessEvidenceText</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Count.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-count">@QualifiedCountEvidenceText</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.GlobalAdministrators.Evidence.Admission.Label"]</dt>
                        <dd data-testid="tenants-global-admins-evidence-admission">@AdmissionEvidenceText</dd>
                    </div>
                </dl>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@StatusHeading"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__state global-admins__state--@StateCss"
                     role="@StatusRole"
                     aria-live="@StatusLive"
                     tabindex="0"
                     data-testid="@StateTestId">
                <FluentText Class="global-admins__state-icon" aria-hidden="true">@StateIcon</FluentText>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="global-admins__state-copy">
                    <h2>@StatusHeading</h2>
                    <p id="global-admins-live-region" data-testid="tenants-global-admins-live-region">@StatusMessage</p>
                </FluentStack>
            </section>
            <ProjectionLifecycleStatus Lifecycle="@_snapshot.Lifecycle"
                                       TestId="tenants-global-admins-projection-lifecycle-status"
                                       BadgeTestId="tenants-global-admins-projection-lifecycle-status-badge" />
            @if (CanRecover)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8px" Wrap="true">
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@(PageLoadInFlight || IsGrantPreviewOpen)"
                                  data-testid="tenants-global-admins-retry"
                                  OnClick="RetryAsync">
                        @Localizer["Tenants.GlobalAdministrators.Recovery.Retry"]
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Outline"
                                  Disabled="@(PageLoadInFlight || IsGrantPreviewOpen)"
                                  data-testid="tenants-global-admins-reset"
                                  OnClick="ResetPagingAsync">
                        @Localizer["Tenants.GlobalAdministrators.Recovery.Reset"]
                    </FluentButton>
                </FluentStack>
            }
            @if (HasIncompletePagingEvidence)
            {
                <p class="global-admins__nudge"
                   role="status"
                   aria-live="polite"
                   data-testid="tenants-global-admins-incomplete-paging">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.IncompletePaging"]
                </p>
            }
            @* Rendered as siblings of the state section, not children. StatusRole/StatusLive resolve to
               alert/assertive for Invalid, Stale, Unknown, Degraded, Error, Unauthorized and Unavailable,
               and inserting or removing a child mutates that region's own subtree -- so every projection
               nudge re-announced the whole state block assertively and interrupted the screen-reader user.
               These are polite, non-authoritative signals and must own their live regions. *@
            @if (_isNotificationRefreshing)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-notification-refreshing">
                    @Localizer["Tenants.GlobalAdministrators.Freshness.Refreshing"]
                </p>
            }
            @if (_pagingJumpedToFirstPage)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-history-truncated">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.HistoryTruncated"]
                </p>
            }
            @if (_authorizationPagingReset)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-authorization-page-reset">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.AuthorizationChanged"]
                </p>
            }
            @if (_snapshot.PagingRecovered)
            {
                <p class="global-admins__nudge" role="status" aria-live="polite" data-testid="tenants-global-admins-page-recovered">
                    @Localizer["Tenants.GlobalAdministrators.Recovery.PageRecovered"]
                </p>
            }
        </FluentAccordionItem>

        <FluentAccordionItem Class="global-admins__mutation-section"
                             Header="@Localizer["Tenants.GlobalAdministrators.Grant.Title"]"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__grant"
                     aria-labelledby="global-admins-grant-heading"
                     data-testid="tenants-global-admin-grant">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="global-admins__grant-heading">
            <h2 id="global-admins-grant-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Title"]</h2>
            <p>@Localizer["Tenants.GlobalAdministrators.Grant.Description"]</p>
        </FluentStack>

        @if (!string.IsNullOrWhiteSpace(GrantUnavailableReason))
        {
            <FluentText class="global-admins__grant-unavailable"
                        id="tenants-global-admin-grant-unavailable-reason"
                        role="alert"
                        data-testid="tenants-global-admin-grant-unavailable-reason">
                @GrantUnavailableReason
            </FluentText>
            <FluentText id="tenants-global-admin-grant-recovery"
                        data-testid="tenants-global-admin-grant-recovery">
                @GrantRecovery
            </FluentText>
        }

        <EditForm Model="@_grantFormModel"
                  FormName="tenants-global-admin-grant"
                  class="global-admins__grant-form"
                  data-testid="tenants-global-admin-grant-form"
                  OnSubmit="SubmitGrantAsync">
            <div class="global-admins__grant-field global-admins__mutation-initiation">
                <FluentTextInput Id="tenants-global-admin-grant-user-id"
                                 @ref="_grantUserIdElement"
                                 name="global-administrator-user-id"
                                 Label="@Localizer["Tenants.GlobalAdministrators.Grant.UserId.Label"]"
                                 @* No MaxLength: the attribute renders the DOM `maxlength`, which truncates
                                    typed and pasted input in the browser. A pasted over-long id was silently
                                    shortened and dispatched as a platform-authority grant against a DIFFERENT
                                    identity, and it made the length half of the submit guard unreachable from
                                    the real UI. The bound is advertised by the help text and enforced at submit,
                                    where an over-long id gets an explicit localized rejection instead. *@
                                 Value="@_grantUserId"
                                 ValueChanged="OnGrantUserIdInput"
                                 Disabled="@(_grantSnapshot.State is TenantCommandLifecycleState.Previewed || IsGrantInFlight || Volatile.Read(ref _grantPreviewInFlight) != 0)"
                                 data-testid="tenants-global-admin-grant-user-id"
                                 aria-describedby="@GrantUserIdDescribedBy" />
                <FluentText id="tenants-global-admin-grant-user-id-help">
                    @Localizer["Tenants.GlobalAdministrators.Grant.UserId.Help"]
                </FluentText>
            </div>

            <dl class="global-admins__grant-scope global-admins__mutation-initiation" data-testid="tenants-global-admin-grant-scope">
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Tenant.Value"]</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Domain.Value"]</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Label"]</dt>
                    <dd>@Localizer["Tenants.GlobalAdministrators.Aggregate.Id.Value"]</dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(_grantValidationMessage))
            {
                <p id="tenants-global-admin-grant-validation"
                   class="global-admins__grant-validation"
                   role="alert"
                   data-testid="tenants-global-admin-grant-validation">
                    @_grantValidationMessage
                </p>
            }

            <div class="global-admins__grant-actions">
                <span class="global-admins__grant-submit-focus global-admins__mutation-initiation">
                    <fluent-button type="submit"
                                   appearance="primary"
                                   @ref="_grantLauncherElement"
                                   data-testid="tenants-global-admin-grant-submit"
                                   aria-describedby="@(GrantAvailability.IsAvailable ? null : "tenants-global-admin-grant-unavailable-reason tenants-global-admin-grant-recovery")"
                                   disabled="@IsGrantSubmitDisabled">
                        @Localizer["Tenants.GlobalAdministrators.Grant.Preview.Launch"]
                    </fluent-button>
                </span>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Class="global-admins__mutation-initiation"
                              data-testid="tenants-global-admin-grant-cancel"
                              Disabled="@(!CanCancelGrant || IsGrantPreviewOpen)"
                              OnClick="CancelGrantAsync">
                    @Localizer["Tenants.GlobalAdministrators.Grant.Cancel"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Class="global-admins__mutation-initiation"
                              data-testid="tenants-global-admin-grant-refresh"
                              Disabled="@(!CanRefreshGrantStatus)"
                              OnClick="RefreshGrantStatusAsync">
                    @GrantRefreshActionText
                </FluentButton>
            </div>
        </EditForm>

        <section class="global-admins__grant-lifecycle global-admins__grant-lifecycle--@GrantStateCss"
                 @ref="_grantLifecycleElement"
                 tabindex="-1"
                 role="@GrantLifecycleRole"
                 aria-labelledby="global-admins-grant-lifecycle-heading"
                 data-testid="tenants-global-admin-grant-lifecycle">
            <h3 id="global-admins-grant-lifecycle-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Lifecycle.Title"]</h3>
            <p data-testid="tenants-global-admin-grant-state">
                <FluentText Class="global-admins__grant-state-symbol" aria-hidden="true">@GrantStateSymbol</FluentText>
                <FluentText>@GrantStateText</FluentText>
            </p>
            @if (!string.IsNullOrWhiteSpace(GrantSafeMessage))
            {
                <p data-testid="tenants-global-admin-grant-safe-message">@GrantSafeMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(GrantSafeRecovery))
            {
                <p data-testid="tenants-global-admin-grant-safe-recovery">@GrantSafeRecovery</p>
            }
            <p data-testid="tenants-global-admin-grant-audit-state">@GrantAuditText</p>
            <p class="global-admins__grant-live"
               data-testid="tenants-global-admin-grant-live-region"
               aria-live="@GrantLiveRegionMode"
               aria-atomic="true">
                @GrantStateText
            </p>
        </section>
            </section>
        </FluentAccordionItem>

        <FluentAccordionItem Class="global-admins__mutation-section"
                             Header="@Localizer["Tenants.GlobalAdministrators.Remove.Title"]"
                             Disabled="@IsGrantPreviewOpen"
                             Expanded="true">
            <section class="global-admins__remove"
                     aria-labelledby="global-admins-remove-heading"
                     data-testid="tenants-global-admin-remove-flow">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="global-admins__remove-heading">
            <h2 id="global-admins-remove-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Title"]</h2>
            <p>@Localizer["Tenants.GlobalAdministrators.Remove.Description"]</p>
        </FluentStack>

        <section class="global-admins__remove-lifecycle global-admins__remove-lifecycle--@RemoveStateCss"
                 @ref="_removeLifecycleElement"
                 tabindex="-1"
                 role="@RemoveLifecycleRole"
                 aria-labelledby="global-admins-remove-lifecycle-heading"
                 data-testid="tenants-global-admin-remove-lifecycle">
            <h3 id="global-admins-remove-lifecycle-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Lifecycle.Title"]</h3>
            <p data-testid="tenants-global-admin-remove-state">
                <FluentText Class="global-admins__remove-state-symbol" aria-hidden="true">@RemoveStateSymbol</FluentText>
                <FluentText>@RemoveStateText</FluentText>
            </p>
            @if (!string.IsNullOrWhiteSpace(RemoveSafeMessage))
            {
                <p data-testid="tenants-global-admin-remove-safe-message">@RemoveSafeMessage</p>
            }
            @if (!string.IsNullOrWhiteSpace(RemoveSafeRecovery))
            {
                <p data-testid="tenants-global-admin-remove-safe-recovery">@RemoveSafeRecovery</p>
            }
            <p data-testid="tenants-global-admin-remove-audit-state">@RemoveAuditText</p>
            <p class="global-admins__remove-live"
               data-testid="tenants-global-admin-remove-live-region"
               aria-live="@RemoveLiveRegionMode"
               aria-atomic="true">
                @RemoveStateText
            </p>
        </section>
        @if (ShouldRenderRemoveRecovery)
        {
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Class="@RemoveRecoveryControlClass"
                          data-testid="tenants-global-admin-remove-refresh"
                          data-recovery-kind="@RemoveRecoveryKind"
                          Disabled="@(!CanRefreshRemoveStatus)"
                          OnClick="RefreshRemoveStatusAsync">
                @RemoveRefreshActionText
            </FluentButton>
        }
            </section>
        </FluentAccordionItem>

        @if (ShouldRenderRows)
        {
            <FluentAccordionItem Header="@Localizer["Tenants.GlobalAdministrators.List.Title"]"
                                 Disabled="@IsGrantPreviewOpen"
                                 Expanded="true">
                <section class="global-admins__table-shell"
                         aria-labelledby="global-admins-list-heading"
                         inert="@(IsGrantPreviewOpen ? string.Empty : null)"
                         data-testid="tenants-global-admins-list">
            <div class="global-admins__table-header">
                <h2 id="global-admins-list-heading">@Localizer["Tenants.GlobalAdministrators.List.Title"]</h2>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Disabled="@(PageLoadInFlight || IsGrantPreviewOpen)"
                              data-testid="tenants-global-admins-refresh"
                              OnClick="RefreshAsync">
                    @Localizer["Tenants.GlobalAdministrators.Refresh"]
                </FluentButton>
            </div>
            <div class="global-admins__table-scroll">
                <FluentDataGrid Items="@_snapshot.Rows.AsQueryable()"
                                Class="global-admins__data-grid"
                                ResizableColumns="true"
                                ReorderableColumns="false"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                ItemKey="@(row => row.UserId)">
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Identity"]"
                                    ColumnId="global-admin-identity"
                                    Width="260px"
                                    Pin="DataGridColumnPin.Start">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.375rem" Class="global-admins__identity" data-testid="tenants-global-admins-row">
                            <FluentText Class="global-admins__identity-value"
                                  title="@context.UserId"
                                  aria-label="@Localizer["Tenants.GlobalAdministrators.Identity.Accessible", context.UserId]"
                                  data-testid="tenants-global-admins-user-id">@context.UserId</FluentText>
                            <SupportSafeCopyButton Value="@context.UserId"
                                                   ValueKind="SupportSafeCopyValueKind.UserId"
                                                   IsApproved="true"
                                                   AccessibleName="@Localizer["Tenants.GlobalAdministrators.Copy.UserId", context.UserId]"
                                                   TestId="tenants-global-admins-copy-user-id" />
                        </FluentStack>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Scope"]"
                                    ColumnId="global-admin-scope"
                                    Width="220px">
                        <FluentText data-testid="tenants-global-admins-authority-scope">
                            @Localizer["Tenants.GlobalAdministrators.Row.Scope"]
                        </FluentText>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Freshness"]"
                                    ColumnId="global-admin-freshness"
                                    Width="180px">
                        <FluentText data-testid="tenants-global-admins-freshness">
                            <TruthStateBadge Freshness="@context.Freshness"
                                             TestId="tenants-global-admins-truth-state"
                                             ResourcePrefix="Tenants.GlobalAdministrators" />
                        </FluentText>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.ProjectionLifecycle.Label"]"
                                    ColumnId="global-admin-projection-lifecycle"
                                    Width="180px">
                        <ProjectionLifecycleBadge Lifecycle="@context.Lifecycle"
                                                  TestId="tenants-global-admins-projection-lifecycle" />
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.GlobalAdministrators.Column.Actions"]"
                                    ColumnId="global-admin-actions"
                                    Width="300px">
                        <FluentStack Orientation="Orientation.Vertical"
                                     VerticalGap="0.375rem"
                                     Class="global-admins__actions"
                                     role="group"
                                     aria-describedby="@RemoveDescribedBy(context)"
                                     data-testid="tenants-global-admins-action-reasons">
                            @* When grant is available, hide the affirmative Available claim with the initiation
                               controls on narrow viewports so AC5 does not advertise availability beside CSS-hidden
                               high-impact actions. The mobile-only reason stays visible at that breakpoint. *@
                            <FluentText data-testid="tenants-global-admins-grant-reason"
                                  class="@(string.IsNullOrWhiteSpace(GrantUnavailableReason) ? "global-admins__mutation-initiation" : null)">
                                @(GrantUnavailableReason ?? Localizer["Tenants.GlobalAdministrators.Grant.Available"])
                            </FluentText>
                            <span class="global-admins__mobile-mutation-reason"
                                  data-testid="tenants-global-admins-grant-mobile-reason">
                                @Localizer["Tenants.GlobalAdministrators.Mobile.ReadOnly.Message"]
                            </span>
                            @if (RemoveUnavailableReason(context) is { Length: > 0 } removeUnavailableReason)
                            {
                                <span id="@RemoveReasonId(context)" data-testid="tenants-global-admins-remove-reason">@removeUnavailableReason</span>
                                <span id="@RemoveRecoveryId(context)" data-testid="tenants-global-admins-remove-recovery">@RemoveRecoveryForUser(context.UserId)</span>
                            }
                            else
                            {
                                <span class="global-admins__mobile-mutation-reason"
                                      data-testid="tenants-global-admins-remove-reason">
                                    @Localizer["Tenants.GlobalAdministrators.Mobile.ReadOnly.Message"]
                                </span>
                                <GlobalAdministratorRemoveLauncher UserId="@context.UserId"
                                                                   Label="@Localizer["Tenants.GlobalAdministrators.Remove.Launch"]"
                                                                   Disabled="@IsAnyPreviewOpen"
                                                                   AriaDescribedBy="@RemoveDescribedBy(context)"
                                                                   OnPreview="PreviewRemoveAsync" />
                            }
                        </FluentStack>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
            <nav class="global-admins__pager" aria-label="@Localizer["Tenants.GlobalAdministrators.PaginationLabel"]">
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-global-admins-previous" Disabled="@(PageLoadInFlight || IsGrantPreviewOpen || _cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                    @Localizer["Tenants.GlobalAdministrators.Previous"]
                </FluentButton>
                @* Enabled on HasMore alone rendered a dead button: NextPageAsync also requires a non-blank
                   cursor, so a page reporting HasMore with no cursor left Next clickable and silent. The two
                   conditions must match, as they do on the tenant-detail member pager. *@
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-global-admins-next" Disabled="@(PageLoadInFlight || IsGrantPreviewOpen || !_snapshot.HasMore || string.IsNullOrWhiteSpace(_snapshot.NextCursor))" OnClick="NextPageAsync">
                    @Localizer["Tenants.GlobalAdministrators.Next"]
                </FluentButton>
            </nav>
                </section>
            </FluentAccordionItem>
        }
    </FluentAccordion>
    </FluentStack>
    @if (_removeSnapshot.State is TenantCommandLifecycleState.Previewed
        && _removeSnapshot.PreviewEvidence is { IsComplete: true } removePreview)
    {
        <section class="global-admins__remove-preview"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="global-admins-remove-preview-heading"
                 data-testid="tenants-global-admin-remove-preview"
                 @onkeydown="HandleRemovePreviewKeyDownAsync">
            <span class="global-admins__remove-focus-sentinel"
                  tabindex="0"
                  data-testid="tenants-global-admin-remove-focus-start"
                  @onfocus="@(args => FocusRemoveCancelAsync(args, removePreview))"></span>
            <h3 id="global-admins-remove-preview-heading">@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Title"]</h3>
            <dl class="global-admins__remove-preview-grid">
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Scope"]</dt>
                <dd>@Localizer[removePreview.ScopeFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Target"]</dt>
                <dd class="global-admins__literal-identity" data-testid="tenants-global-admin-remove-target">@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Target.Value", removePreview.TargetUserId]</dd>
                <dt data-testid="tenants-global-admin-remove-count-label">@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Counts"]</dt>
                <dd data-testid="tenants-global-admin-remove-count">@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Counts.Value", removePreview.CurrentAdministratorCount, removePreview.ResultingAdministratorCount]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.AuthorityChange"]</dt>
                <dd>@Localizer[removePreview.AuthorityChangeFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Freshness"]</dt>
                <dd>@Localizer[removePreview.FreshnessFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Recovery"]</dt>
                <dd data-testid="tenants-global-admin-remove-recovery-path">@Localizer[removePreview.RecoveryFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Audit"]</dt>
                <dd data-testid="tenants-global-admin-remove-audit-expectation">@Localizer[removePreview.AuditFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.CallerTargetContext"]</dt>
                <dd data-testid="tenants-global-admin-remove-caller-target">@Localizer[removePreview.CallerTargetContextFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownConsequences"]</dt>
                <dd data-testid="tenants-global-admin-remove-known-consequences">@Localizer[removePreview.KnownConsequencesFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Remove.Preview.KnownUnknowns"]</dt>
                <dd data-testid="tenants-global-admin-remove-known-unknowns">@Localizer[removePreview.KnownUnknownsFactKey!]</dd>
            </dl>
            @if (RemoveIntentUnavailableReason is { Length: > 0 } previewUnavailableReason)
            {
                <p id="tenants-global-admin-remove-preview-unavailable-reason" role="alert">@previewUnavailableReason</p>
                <p id="tenants-global-admin-remove-preview-unavailable-recovery">@RemoveIntentRecovery</p>
            }
            <FluentTextInput @ref="_removeAcknowledgementElement"
                             Label="@Localizer["Tenants.GlobalAdministrators.Remove.Preview.Acknowledge", removePreview.TargetUserId]"
                             Value="@_removeAcknowledgement"
                             ValueChanged="OnRemoveAcknowledgementChanged"
                             data-testid="tenants-global-admin-remove-acknowledge" />
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.75rem" Wrap="true">
                <FluentButton Appearance="ButtonAppearance.Primary"
                              data-testid="tenants-global-admin-remove-submit"
                              aria-describedby="@(RemoveIntentUnavailableReason is null ? null : "tenants-global-admin-remove-preview-unavailable-reason tenants-global-admin-remove-preview-unavailable-recovery")"
                              Disabled="@IsRemoveSubmitDisabled"
                              OnClick="SubmitRemoveAsync">
                    @Localizer["Tenants.GlobalAdministrators.Remove.Preview.Confirm"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Id="@RemoveCancelButtonId"
                              data-testid="tenants-global-admin-remove-cancel"
                              OnClick="CancelRemoveAsync">
                    @Localizer["Tenants.GlobalAdministrators.Remove.Cancel"]
                </FluentButton>
            </FluentStack>
            <span class="global-admins__remove-focus-sentinel"
                  tabindex="0"
                  data-testid="tenants-global-admin-remove-focus-end"
                  @onfocus="@(args => FocusRemoveAcknowledgementAsync(args, removePreview))"></span>
        </section>
    }
    @if (_grantSnapshot.State is TenantCommandLifecycleState.Previewed
        && _grantSnapshot.PreviewEvidence is { IsComplete: true } grantPreview)
    {
        <section class="global-admins__grant-preview"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="global-admins-grant-preview-heading"
                 data-testid="tenants-global-admin-grant-preview"
                 @onkeydown="HandleGrantPreviewKeyDownAsync">
            <span class="global-admins__grant-focus-sentinel"
                  tabindex="0"
                  data-testid="tenants-global-admin-grant-focus-start"
                  @onfocus="FocusGrantCancelAsync"></span>
            <h3 id="global-admins-grant-preview-heading">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Title"]</h3>
            <dl class="global-admins__grant-preview-grid">
                <dt data-testid="tenants-global-admin-grant-preview-scope">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Scope"]</dt>
                <dd>@Localizer[grantPreview.ScopeFactKey!]</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Target"]</dt>
                <dd data-testid="tenants-global-admin-grant-preview-target">@grantPreview.TargetUserId</dd>
                <dt>@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Counts"]</dt>
                <dd data-testid="tenants-global-admin-grant-preview-counts">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Counts.Value", grantPreview.CurrentAdministratorCount, grantPreview.ResultingAdministratorCount]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-authority-change">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.AuthorityChange"]</dt>
                <dd>@Localizer[grantPreview.AuthorityChangeFactKey!]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-freshness">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Freshness"]</dt>
                <dd>@Localizer[grantPreview.FreshnessFactKey!]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-recovery">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Recovery"]</dt>
                <dd>@Localizer[grantPreview.RecoveryFactKey!]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-audit">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Audit"]</dt>
                <dd>@Localizer[grantPreview.AuditFactKey!]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-context">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.CallerTargetContext"]</dt>
                <dd>@Localizer[grantPreview.CallerTargetContextFactKey!]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-known-consequences">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.KnownConsequences"]</dt>
                <dd>@Localizer[grantPreview.KnownConsequencesFactKey!]</dd>
                <dt data-testid="tenants-global-admin-grant-preview-known-unknowns">@Localizer["Tenants.GlobalAdministrators.Grant.Preview.KnownUnknowns"]</dt>
                <dd>@Localizer[grantPreview.KnownUnknownsFactKey!]</dd>
            </dl>
            <FluentCheckbox @ref="_grantAcknowledgementElement"
                            Value="@_grantAcknowledged"
                            ValueChanged="OnGrantAcknowledgementChanged"
                            Label="@Localizer["Tenants.GlobalAdministrators.Grant.Preview.Acknowledge"]"
                            data-testid="tenants-global-admin-grant-acknowledge" />
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.75rem" Wrap="true">
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Disabled="@IsGrantConfirmDisabled"
                              data-testid="tenants-global-admin-grant-confirm"
                              OnClick="ConfirmGrantAsync">
                    @Localizer["Tenants.GlobalAdministrators.Grant.Preview.Confirm"]
                </FluentButton>
                <fluent-button appearance="outline"
                               @ref="_grantPreviewCancelElement"
                               data-testid="tenants-global-admin-grant-preview-cancel"
                               @onclick="CancelGrantAsync">
                    @Localizer["Tenants.GlobalAdministrators.Grant.Cancel"]
                </fluent-button>
            </FluentStack>
            <span class="global-admins__grant-focus-sentinel"
                  tabindex="0"
                  data-testid="tenants-global-admin-grant-focus-end"
                  @onfocus="FocusGrantConfirmAsync"></span>
        </section>
    }
    }
</FcPageLayout>

@code {
    private const string FocusModulePath = "./js/tenantsFocus.js";
    private const string RemoveCancelButtonId = "tenants-global-admin-remove-cancel-button";
    private const int PageSize = 20;
    private const int MaximumGrantUserIdLength = 256;
    private readonly object _grantFormModel = new();
    private GlobalAdministratorsSnapshot _snapshot = GlobalAdministratorsSnapshot.Loading();
    private GlobalAdministratorsSnapshot _completeSnapshot = GlobalAdministratorsSnapshot.Unavailable();
    private IAsyncDisposable? _readRefreshLease;

    /// <summary>Upper bound on optional notification-setup attempts between explicit refreshes.</summary>
    private const int MaximumReadRefreshAttempts = 3;

    private int _readRefreshAttempts;
    private GlobalAdministratorGrantCommandSnapshot _grantSnapshot = GlobalAdministratorGrantCommandSnapshot.Idle();
    private GlobalAdministratorRemoveCommandSnapshot _removeSnapshot = GlobalAdministratorRemoveCommandSnapshot.Idle();
    /// <summary>Upper bound on retained paging history.</summary>
    private const int MaximumCursorHistory = CursorHistory.DefaultMaximum;

    private readonly Stack<string?> _cursorHistory = new();

    // Set when CursorHistory.Trim drops entries, cleared when the resulting jump has been announced. The trim
    // re-appends the first-page sentinel beneath the newest entries, so one later Previous click moves the
    // operator from the middle of the sequence to page one -- which the pager would otherwise render as an
    // ordinary one-page step back.
    private bool _pagingHistoryTruncated;
    private bool _pagingJumpedToFirstPage;
    private bool _authorizationPagingReset;
    private string? _currentCursor;
    private string? _grantUserId;
    private string? _grantValidationMessage;
    private bool _isGrantSubmitting;
    private bool _isRemoveSubmitting;
    private bool _isNotificationRefreshing;
    private int _pageLoadInFlight;
    private int _readRefreshSubscriptionInFlight;
    private bool _disposed;
    private long _loadGeneration;
    private long _grantMutationGeneration;
    private long _removeMutationGeneration;
    private long _authorizationTransitionVersion;
    private CancellationTokenSource? _loadCancellation;
    private CancellationTokenSource? _grantMutationCancellation;
    private CancellationTokenSource? _removeMutationCancellation;

    private bool PageLoadInFlight => Volatile.Read(ref _pageLoadInFlight) != 0;

    private bool TryBeginPageLoad()
        => Interlocked.CompareExchange(ref _pageLoadInFlight, 1, 0) == 0;

    private void EndPageLoad()
        => Volatile.Write(ref _pageLoadInFlight, 0);

    // Serialises the active-cancellation swap. A superseded source is cancelled immediately -- which is what
    // callers observe -- but NOT disposed there: disposing one at the moment it is replaced races the
    // request still inside SendAsync, where a CancellationToken.Register after Dispose throws
    // ObjectDisposedException, which is not an OperationCanceledException and so slips past every caller's
    // cancellation-only handler. Disposal is owned solely by CompleteCancellation, which the owning
    // PendingOperation calls when its operation finishes. A prior version also tracked superseded sources in
    // a List; nothing ever read it, so it is removed rather than left to read as a retention mechanism.
    private readonly Lock _cancellationLock = new();
    private readonly Lock _focusModuleLock = new();
    private FluentTextInput _grantUserIdElement = default!;
    private FluentCheckbox _grantAcknowledgementElement = default!;
    private ElementReference _grantLauncherElement;
    private ElementReference _grantPreviewCancelElement;
    private ElementReference _grantLifecycleElement;
    private ElementReference _removeLifecycleElement;
    private FluentTextInput _removeAcknowledgementElement = default!;
    private IJSObjectReference? _focusModule;
    private GlobalAdministratorRemoveLauncher? _removeLauncher;
    private bool _focusGrantUserIdPending;
    private bool _focusGrantLauncherPending;
    private bool _focusGrantLifecyclePending;
    private bool _focusGrantPreviewCancelPending;
    private bool _focusRemoveAcknowledgementPending;
    private bool _focusRemoveLauncherPending;
    private bool _focusRemoveLifecyclePending;
    private TenantLifecycleAuthorizationReflectionState _authorizationReflection = TenantLifecycleAuthorizationReflectionState.Indeterminate;
    private AuthenticationStateProvider? _authenticationStateProvider;
    private TenantAggregateCommandAdmissionGate? _aggregateAdmissionGate;
    private TenantHighImpactViewportObservation? _viewportObservation;
    private TenantAggregateCommandLease? _grantAdmissionLease;
    private TenantAggregateCommandLease? _removeAdmissionLease;
    private readonly object _fixedAggregateOwner = new();
    private bool _grantAcknowledged;
    private int _grantPreviewInFlight;
    private int _grantConfirmationInFlight;
    private long _grantPreviewGeneration;
    private int _removePreviewInFlight;
    private int _removeSubmissionInFlight;
    private int _removeStatusNudgeDrainInFlight;
    private readonly Lock _removeStatusNudgeLock = new();
    private (GlobalAdministratorRemoveCommandSnapshot Attempt, TenantAggregateCommandLease Lease)?
        _pendingRemoveStatusNudge;
    private string? _removeAcknowledgement;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool IsAuthorized
        => _authorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized;

    private bool ShouldRenderRows
        => (_snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
            or GlobalAdministratorsSurfaceKind.Stale
            or GlobalAdministratorsSurfaceKind.Unknown
            or GlobalAdministratorsSurfaceKind.Degraded)
            && _snapshot.Rows.Count > 0;

    private string PageTitleText
        => IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.Title"]
            : Localizer["Tenants.GlobalAdministrators.RestrictedTitle"];

    private string StatusHeading
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Title"]
            : Localizer[$"Tenants.GlobalAdministrators.State.{ResourceState}.Title"];

    private string StatusMessage
        => !IsAuthorized
            ? Localizer["Tenants.GlobalAdministrators.State.Unauthorized.Message"]
            : Localizer[$"Tenants.GlobalAdministrators.State.{ResourceState}.Message"];

    private string ResourceState => _snapshot.Kind switch
    {
        GlobalAdministratorsSurfaceKind.Loading => "Loading",
        GlobalAdministratorsSurfaceKind.Ready => "Ready",
        GlobalAdministratorsSurfaceKind.Empty => "Empty",
        GlobalAdministratorsSurfaceKind.Unknown => "Unknown",
        GlobalAdministratorsSurfaceKind.Stale => "Stale",
        GlobalAdministratorsSurfaceKind.Degraded => "Degraded",
        GlobalAdministratorsSurfaceKind.Error => "Error",
        GlobalAdministratorsSurfaceKind.Unauthorized => "Unauthorized",
        GlobalAdministratorsSurfaceKind.Unavailable => "Unavailable",
        GlobalAdministratorsSurfaceKind.Invalid => "Invalid",
        _ => "Unavailable",
    };

    private string StateTestId
        => IsAuthorized
            ? $"tenants-global-admins-{ResourceState.ToLowerInvariant()}"
            : "tenants-global-admins-unavailable";

    private string StateCss
        => IsAuthorized ? ResourceState.ToLowerInvariant() : "unauthorized";

    private string StatusRole
        => !IsAuthorized
            || _snapshot.Kind is GlobalAdministratorsSurfaceKind.Invalid
                or GlobalAdministratorsSurfaceKind.Stale
                or GlobalAdministratorsSurfaceKind.Unknown
                or GlobalAdministratorsSurfaceKind.Degraded
                or GlobalAdministratorsSurfaceKind.Error
                or GlobalAdministratorsSurfaceKind.Unauthorized
                or GlobalAdministratorsSurfaceKind.Unavailable
            ? "alert"
            : "status";

    private string StatusLive => StatusRole == "alert" ? "assertive" : "polite";

    private string StateIcon => _snapshot.Kind switch
    {
        GlobalAdministratorsSurfaceKind.Ready => "OK",
        GlobalAdministratorsSurfaceKind.Empty => "0",
        GlobalAdministratorsSurfaceKind.Loading => "...",
        GlobalAdministratorsSurfaceKind.Stale => "!",
        GlobalAdministratorsSurfaceKind.Unknown => "?",
        GlobalAdministratorsSurfaceKind.Degraded => "!",
        GlobalAdministratorsSurfaceKind.Error => "!",
        GlobalAdministratorsSurfaceKind.Invalid => "!",
        _ => "?",
    };

    // Removed: UnavailableActionReason had no call site anywhere in src/ or tests/, so the surface never
    // rendered either of its two strings, and a mutation swapping its IsMutationEvidenceBacked gate for
    // Freshness alone could not fail a test -- while the same swap in the grant and remove gates is caught.
    // The loop-6 change log listed it as a consumer of IsMutationEvidenceBacked; the real consumers are
    // GrantUnavailableReason, RemoveUnavailableReasonForUser and grant projection confirmation. Its two
    // resource keys were removed with it.
    private bool IsGrantInFlight
        => _isGrantSubmitting
        || _grantAdmissionLease?.IsDispatchMarked == true
        || _grantSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending;

    private bool IsRemoveInFlight
        => _isRemoveSubmitting
        || _removeAdmissionLease?.IsDispatchMarked == true
        || _removeSnapshot.State is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending;

    private string SafeReturnUrl => NormalizeReturnUrl(ReturnUrl);

    // ConfirmProjection stores Tenants.* resource keys so EN/FR stay whole-string parity; gateway/status
    // SafeMessages remain support-safe English prose and pass through unchanged.
    private string ResolveSafeMessage(string? safeMessage)
        => string.IsNullOrWhiteSpace(safeMessage)
            ? string.Empty
            : safeMessage.StartsWith("Tenants.", StringComparison.Ordinal)
                ? Localizer[safeMessage].Value
                : safeMessage;

    // Empty is included deliberately. ShouldRenderRows requires Rows.Count > 0, and the pager, Refresh and
    // grid all live inside that branch, so an Empty page renders no controls at all. Paging into a page that
    // was emptied by a concurrent removal is a normal outcome (IsSuccessfulPage accepts Empty, so the cursor
    // commits), and without Reset the operator is stranded on that cursor with only a browser reload to
    // recover.
    // Incomplete paging (HasMore with a blank cursor) and Ready pages that lack complete population evidence
    // are included by owner decision (loop 5): do not broaden bare Ready into CanRecover.
    private bool CanRecover
        => IsAuthorized
        && (HasIncompletePagingEvidence
            || HasIncompletePopulationOnReady
            || _snapshot.Kind is GlobalAdministratorsSurfaceKind.Unknown
            or GlobalAdministratorsSurfaceKind.Stale
            or GlobalAdministratorsSurfaceKind.Degraded
            or GlobalAdministratorsSurfaceKind.Error
            or GlobalAdministratorsSurfaceKind.Unavailable
            or GlobalAdministratorsSurfaceKind.Invalid
            or GlobalAdministratorsSurfaceKind.Empty);

    // Ready claims more administrators exist but supplies no usable continuation cursor.
    private bool HasIncompletePagingEvidence
        => _snapshot.HasMore && string.IsNullOrWhiteSpace(_snapshot.NextCursor);

    // Ready page that is not complete evidence and cannot claim further pages — Remove stays blocked by
    // Incomplete, and without Reset the operator cannot return to a complete first-page population.
    private bool HasIncompletePopulationOnReady
        => _snapshot.Kind is GlobalAdministratorsSurfaceKind.Ready
            && !_snapshot.IsCompleteEvidence
            && !_snapshot.HasMore
            && _snapshot.Rows.Count > 0;

    private GlobalAdministratorActionAvailability GrantAvailability
        => GlobalAdministratorActionAvailabilityEvaluator.EvaluateGrant(ActionEvidence());

    private string? GrantUnavailableReason
        => GrantAvailability.IsAvailable ? null : Localizer[GrantAvailability.ReasonKey].Value;

    private string? GrantRecovery
        => GrantAvailability.IsAvailable ? null : Localizer[GrantAvailability.RecoveryKey].Value;

    private string? RemoveUnavailableReason(GlobalAdministratorRow? row)
        => RemoveUnavailableReasonForUser(row?.UserId);

    // Evaluated against a user id rather than a row so the submit path can re-check the previewed intent
    // against the *current* snapshot. Preview alone is not a durable authorization: a notification refresh
    // replaces _snapshot underneath a Previewed intent without resetting it, so the last-administrator,
    // freshness and completeness gates must be re-evaluated at submit or Remove fails open through them.
    private string? RemoveUnavailableReasonForUser(string? userId)
        => RemoveAvailability(userId) is { IsAvailable: false } availability
            ? Localizer[availability.ReasonKey].Value
            : null;

    private string? RemoveRecoveryForUser(string? userId)
        => RemoveAvailability(userId) is { IsAvailable: false } availability
            ? Localizer[availability.RecoveryKey].Value
            : null;

    private GlobalAdministratorActionAvailability RemoveAvailability(
        string? userId,
        bool allowOwnedRemoveReconciliation = false)
        => GlobalAdministratorActionAvailabilityEvaluator.EvaluateRemove(
            ActionEvidence(allowOwnedRemoveReconciliation),
            userId);

    private GlobalAdministratorActionEvidence ActionEvidence(bool allowOwnedRemoveReconciliation = false)
        => new GlobalAdministratorActionEvidence(
            IsAuthorized,
            _snapshot.Kind,
            _snapshot.Freshness,
            _snapshot.Lifecycle,
            _snapshot.ProjectionVersion,
            _snapshot.IsAuthorizationScopedEmpty,
            _snapshot.Rows,
            _completeSnapshot.Kind,
            _completeSnapshot.Freshness,
            _completeSnapshot.Lifecycle,
            _completeSnapshot.ProjectionVersion,
            _completeSnapshot.IsAuthorizationScopedEmpty,
            _completeSnapshot.Rows,
            _completeSnapshot.IsCompleteEvidence,
            BffComposition.IsGlobalAdministratorDispatchConnected
                && CommandGateway.SupportsGlobalAdministratorDispatch,
            BffComposition.IsGlobalAdministratorStatusConnected
                && CommandGateway.SupportsCommandStatusLookup,
            BffComposition.IsGlobalAdministratorRequeryConnected,
            _aggregateAdmissionGate is not null
                && !IsGrantInFlight
                && (!IsRemoveInFlight
                    || allowOwnedRemoveReconciliation
                        && _removeAdmissionLease?.IsDispatchMarked == true)
                && !_aggregateAdmissionGate.IsLockedByAnother(
                        TenantCommandAggregateLock.ForGlobalAdministrators(),
                        _fixedAggregateOwner),
            BffComposition.IsGlobalAdministratorRemovePreviewReady,
            _viewportObservation?.State ?? TenantHighImpactViewportState.Unknown,
            _viewportObservation?.HasMeasurement == true)
        {
            IsGrantPreviewReady = BffComposition.IsGlobalAdministratorGrantPreviewReady,
            SupportsTrackedGrantDispatch = CommandGateway.SupportsTrackedGlobalAdministratorDispatch,
            SupportsTrackedRemoveDispatch = CommandGateway.SupportsTrackedGlobalAdministratorRemoveDispatch,
        };

    private string RemoveReasonId(GlobalAdministratorRow row)
        => $"tenants-global-admin-remove-reason-{RowOrdinal(row)}";

    private string RemoveRecoveryId(GlobalAdministratorRow row)
        => $"tenants-global-admin-remove-recovery-{RowOrdinal(row)}";

    private string? RemoveDescribedBy(GlobalAdministratorRow row)
        => RemoveAvailability(row.UserId).IsAvailable
            ? null
            : $"{RemoveReasonId(row)} {RemoveRecoveryId(row)}";

    private int RowOrdinal(GlobalAdministratorRow row)
    {
        for (int index = 0; index < _snapshot.Rows.Count; index++)
        {
            if (ReferenceEquals(_snapshot.Rows[index], row))
            {
                return index;
            }
        }

        return -1;
    }

    private bool IsGrantSubmitDisabled
        => !string.IsNullOrWhiteSpace(GrantUnavailableReason)
            || Volatile.Read(ref _grantPreviewInFlight) != 0
            || _grantSnapshot.State is TenantCommandLifecycleState.Previewed
            || IsGrantInFlight;

    private bool IsGrantPreviewOpen
        => _grantSnapshot.State is TenantCommandLifecycleState.Previewed
            && _grantSnapshot.PreviewEvidence?.IsComplete == true;

    private bool IsRemovePreviewOpen
        => _removeSnapshot.State is TenantCommandLifecycleState.Previewed
            && _removeSnapshot.PreviewEvidence?.IsComplete == true;

    private bool IsAnyPreviewOpen => IsGrantPreviewOpen || IsRemovePreviewOpen;

    private bool IsGrantConfirmDisabled
        => !_grantAcknowledged
            || Volatile.Read(ref _grantConfirmationInFlight) != 0
            || _grantSnapshot.State is not TenantCommandLifecycleState.Previewed
            || _grantSnapshot.PreviewEvidence is not { IsComplete: true } preview
            || _grantAdmissionLease is null
            || _grantAdmissionLease.IsDispatchMarked
            || !AreGrantPreviewPrerequisitesCurrent(preview);

    private bool AreGrantPreviewPrerequisitesCurrent(GlobalAdministratorGrantPreview preview)
        => AreGrantDispatchCapabilitiesCurrent()
            && _completeSnapshot.IsCompleteEvidence
            && _completeSnapshot.IsMutationEvidenceBacked
            && string.Equals(
                preview.ProjectionVersion,
                _completeSnapshot.ProjectionVersion,
                StringComparison.Ordinal)
            && preview.CurrentAdministratorCount == _completeSnapshot.Rows.Count
            && !_completeSnapshot.Rows.Any(row =>
                string.Equals(row.UserId, preview.TargetUserId, StringComparison.Ordinal));

    private bool AreGrantDispatchCapabilitiesCurrent()
        => IsAuthorized
            && !IsRemoveInFlight
            && BffComposition.IsGlobalAdministratorGrantPreviewReady
            && BffComposition.IsGlobalAdministratorDispatchConnected
            && BffComposition.IsGlobalAdministratorStatusConnected
            && BffComposition.IsGlobalAdministratorRequeryConnected
            && CommandGateway.SupportsGlobalAdministratorDispatch
            && CommandGateway.SupportsTrackedGlobalAdministratorDispatch
            && CommandGateway.SupportsCommandStatusLookup
            && _viewportObservation?.HasMeasurement == true
            && _viewportObservation.State is TenantHighImpactViewportState.Safe;

    // The reason the previewed intent cannot be submitted *now*, re-derived from the current snapshot.
    private string? RemoveIntentUnavailableReason
        => _removeSnapshot.Intent is null
            ? null
            : !PreviewEvidenceMatchesCurrent
                ? Localizer["Tenants.GlobalAdministrators.Availability.Remove.Unavailable.StaleData"].Value
                : RemoveUnavailableReasonForUser(_removeSnapshot.Intent.UserId);

    private string? RemoveIntentRecovery
        => _removeSnapshot.Intent is null
            ? null
            : !PreviewEvidenceMatchesCurrent
                ? Localizer["Tenants.GlobalAdministrators.Availability.Recovery.StaleData"].Value
                : RemoveRecoveryForUser(_removeSnapshot.Intent.UserId);

    private string QualifiedFreshnessEvidenceText
        => _snapshot.Freshness is ReadModelFreshnessState.Current
            && _snapshot.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(_snapshot.ProjectionVersion)
            ? Localizer["Tenants.GlobalAdministrators.Evidence.Freshness.Qualified"].Value
            : Localizer["Tenants.GlobalAdministrators.Evidence.Unknown"].Value;

    private string QualifiedCountEvidenceText
        => _completeSnapshot.IsCompleteEvidence
            && _completeSnapshot.Freshness is ReadModelFreshnessState.Current
            && _completeSnapshot.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(_completeSnapshot.ProjectionVersion)
            ? Localizer["Tenants.GlobalAdministrators.Evidence.Count.Qualified", _completeSnapshot.Rows.Count].Value
            : Localizer["Tenants.GlobalAdministrators.Evidence.Unknown"].Value;

    private string AdmissionEvidenceText
        => _aggregateAdmissionGate is null
            ? Localizer["Tenants.GlobalAdministrators.Evidence.Unknown"].Value
            : _aggregateAdmissionGate.IsLocked(TenantCommandAggregateLock.ForGlobalAdministrators())
                ? Localizer["Tenants.GlobalAdministrators.Evidence.Admission.Busy"].Value
                : Localizer["Tenants.GlobalAdministrators.Evidence.Admission.Available"].Value;

    private bool PreviewEvidenceMatchesCurrent
        => _removeSnapshot.PreviewEvidence is { IsComplete: true } preview
            && preview.Matches(_completeSnapshot);

    private bool IsRemoveSubmitDisabled
        => _removeSnapshot.State is not TenantCommandLifecycleState.Previewed
        || !string.Equals(
            _removeAcknowledgement,
            _removeSnapshot.PreviewEvidence?.TargetUserId,
            StringComparison.Ordinal)
        || IsGrantInFlight
        || IsRemoveInFlight
        || _removeSnapshot.Intent is null
        || _removeAdmissionLease is null
        || _removeAdmissionLease.IsDispatchMarked
        || !string.IsNullOrWhiteSpace(RemoveIntentUnavailableReason);

    private bool CanCancelGrant
        => _grantAdmissionLease?.IsDispatchMarked != true
            && (_grantSnapshot.State is not TenantCommandLifecycleState.Idle || !string.IsNullOrWhiteSpace(_grantUserId));

    private bool CanRefreshGrantStatus
        => _grantSnapshot.MessageId is not null
        && (_grantSnapshot.IsSubmissionAmbiguous || _grantSnapshot.CorrelationId is not null)
        && _grantSnapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.Degraded
            or TenantCommandLifecycleState.UnableToVerify
        && (!IsAmbiguousGrantDeliveryRetry || CanRetryAmbiguousGrantDelivery);

    // In the ambiguous-delivery state this button is a redispatch, not a status read, so it must advertise
    // itself only while the redispatch's own prerequisites hold. Without this the action stayed enabled and
    // labelled "retry delivery" while RefreshGrantStatusAsync's inner guards silently returned, leaving the
    // operator clicking a live control that did nothing and said nothing.
    private bool IsAmbiguousGrantDeliveryRetry
        => _grantSnapshot.IsSubmissionAmbiguous && _grantSnapshot.CorrelationId is null;

    private bool CanRetryAmbiguousGrantDelivery
        => _grantSnapshot.PreviewEvidence?.IsComplete == true
            && _grantAdmissionLease?.IsDispatchMarked == true
            && AreGrantDispatchCapabilitiesCurrent();

    private string GrantRefreshActionText
        => IsAmbiguousGrantDeliveryRetry
            ? Localizer["Tenants.GlobalAdministrators.Grant.DeliveryRetry"]
            : Localizer["Tenants.GlobalAdministrators.Grant.Refresh"];

