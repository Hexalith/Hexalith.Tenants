    private IDisposable BeginHighImpactRefresh()
    {
        int generation = Interlocked.Increment(ref _highImpactRefreshGeneration);
        _refreshingBaselineWasCurrent = _snapshot.Kind is TenantDetailSurfaceKind.Ready
            && _snapshot.Freshness is ReadModelFreshnessState.Current
            && _snapshot.Lifecycle is ProjectionLifecycleState.Current;
        _detailRefreshInFlight = true;
        return new HighImpactRefreshObservation(this, generation);
    }

    private void EndHighImpactRefresh(int generation)
    {
        if (generation != Volatile.Read(ref _highImpactRefreshGeneration))
        {
            return;
        }

        _detailRefreshInFlight = false;
        _refreshingBaselineWasCurrent = false;
        _ = RenderIfAliveAsync();
    }

    /// <summary>
    /// Releases an admission key whose tracker-owned lifecycle attempt has expired on the clock.
    /// </summary>
    /// <param name="aggregateLockKey">Aggregate lock key for <paramref name="tenantId"/>, or null when there is no route tenant.</param>
    /// <param name="tenantId">Literal tenant id whose retained attempt is being checked.</param>
    /// <returns><see langword="true"/> when a stale lease was reclaimed.</returns>
    /// <remarks>
    /// A retained attempt can expire on the clock with no state transition to release its lease: the tracker
    /// prunes its own maps but holds no reference to the admission gate, so nothing reclaims the key and every
    /// sibling command surface on this tenant stays disabled for the rest of the circuit. Invoked only on
    /// tenant or route change. Tracker-owned only, and only once the tracker reports no pending ownership.
    /// Same-route expiry is owned by TenantLifecycleActionAvailability.
    /// </remarks>
    /// <remarks>
    /// Route-change scoped on purpose. It cannot be hoisted to OnAfterRenderAsync: between a submit acquiring
    /// the lease and BeginDispatch registering the attempt, the tracker reports no pending ownership, so a
    /// render in that window would release the lease out from under an in-flight command. Same-route expiry is
    /// handled by TenantLifecycleActionAvailability, which can tell the two states apart because it observes
    /// the retained attempt going from present to absent.
    /// </remarks>
    private bool TryReclaimExpiredLifecycleLease(string? aggregateLockKey, string tenantId)
    {
        if (aggregateLockKey is null
            || AggregateAdmissionGate is not { } gate
            || LifecycleAttemptTracker is not { } tracker
            || !ReferenceEquals(_aggregateLeaseHolder, _lifecycleLeaseOwner)
            || !string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal)
            || tracker.HasPendingOwnership(tenantId)
            || !gate.IsOwnedBy(aggregateLockKey, tracker.LeaseOwner))
        {
            return false;
        }

        gate.Release(aggregateLockKey, tracker.LeaseOwner);
        _activeAggregateLockKey = null;
        _activeAggregateTenantId = null;
        _aggregateLeaseHolder = null;
        _commandInFlight = false;
        return true;
    }

    private bool TryReclaimExpiredSetConfigurationLease(string? aggregateLockKey, string tenantId)
    {
        if (aggregateLockKey is null
            || AggregateAdmissionGate is not { } gate
            || SetConfigurationAttemptTracker is not { } tracker
            || !ReferenceEquals(_aggregateLeaseHolder, _setConfigurationLeaseOwner)
            || !string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal)
            || tracker.HasPendingOwnership(tenantId)
            || !gate.IsOwnedBy(aggregateLockKey, tracker.LeaseOwner))
        {
            return false;
        }

        gate.Release(aggregateLockKey, tracker.LeaseOwner);
        _activeAggregateLockKey = null;
        _activeAggregateTenantId = null;
        _aggregateLeaseHolder = null;
        _commandInFlight = false;
        return true;
    }

    private async Task<bool> SetCommandActivityLeaseAsync(string leaseTenantId, bool isActive, object surfaceOwner)
    {
        ArgumentNullException.ThrowIfNull(surfaceOwner);
        bool lifecycleSurface = ReferenceEquals(surfaceOwner, _lifecycleLeaseOwner);
        bool setConfigurationSurface = ReferenceEquals(surfaceOwner, _setConfigurationLeaseOwner);
        object admissionOwner = lifecycleSurface && LifecycleAttemptTracker is not null
            ? LifecycleAttemptTracker.LeaseOwner
            : setConfigurationSurface && SetConfigurationAttemptTracker is not null
                ? SetConfigurationAttemptTracker.LeaseOwner
            : _commandLockOwner;
        if (isActive)
        {
            if (_disposed)
            {
                return false;
            }

            TenantAggregateCommandAdmissionGate? gate = AggregateAdmissionGate;
            if (string.IsNullOrWhiteSpace(leaseTenantId)
                || !string.Equals(leaseTenantId, TenantId, StringComparison.Ordinal)
                || gate is null)
            {
                return false;
            }

            string aggregateLockKey = TenantCommandAggregateLock.ForTenant(leaseTenantId);
            if (string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal))
            {
                // Re-entry is idempotent only for the surface that already holds the lease. A different
                // surface must be refused: granting it here made the lease multi-owner, and whichever
                // surface reported completion first released the aggregate while the other command was
                // still in flight, breaking one-at-a-time exclusivity (AD-12).
                if (!ReferenceEquals(_aggregateLeaseHolder, surfaceOwner))
                {
                    return false;
                }

                _commandInFlight = true;
                await RenderIfAliveAsync().ConfigureAwait(false);
                return true;
            }

            if (!gate.TryAcquire(aggregateLockKey, admissionOwner)
                && !gate.IsOwnedBy(aggregateLockKey, admissionOwner))
            {
                _commandInFlight = false;
                return false;
            }

            _activeAggregateLockKey = aggregateLockKey;
            _activeAggregateTenantId = leaseTenantId;
            _aggregateLeaseHolder = surfaceOwner;
            _commandInFlight = true;
        }
        else
        {
            string? aggregateLockKey = string.IsNullOrWhiteSpace(leaseTenantId)
                ? null
                : TenantCommandAggregateLock.ForTenant(leaseTenantId);
            if (aggregateLockKey is not null
                && string.Equals(_activeAggregateLockKey, aggregateLockKey, StringComparison.Ordinal)
                && ReferenceEquals(_aggregateLeaseHolder, surfaceOwner)
                && (!lifecycleSurface
                    || LifecycleAttemptTracker?.HasPendingOwnership(leaseTenantId) is not true)
                && (!setConfigurationSurface
                    || SetConfigurationAttemptTracker?.HasPendingOwnership(leaseTenantId) is not true))
            {
                AggregateAdmissionGate?.Release(aggregateLockKey, admissionOwner);
                _commandInFlight = false;
                _activeAggregateLockKey = null;
                _activeAggregateTenantId = null;
                _aggregateLeaseHolder = null;
            }
            else if (aggregateLockKey is not null
                && (lifecycleSurface || setConfigurationSurface)
                && (lifecycleSurface
                    ? LifecycleAttemptTracker is not null
                        && !LifecycleAttemptTracker.HasPendingOwnership(leaseTenantId)
                    : SetConfigurationAttemptTracker is not null
                        && !SetConfigurationAttemptTracker.HasPendingOwnership(leaseTenantId)))
            {
                // Route change and page disposal deliberately clear page-local bookkeeping while a retained
                // lifecycle attempt keeps the tracker-owned gate lease. A late terminal callback must still
                // release that old key, but only after proving the tracker does not contain a newer retained
                // attempt for the same literal tenant id.
                AggregateAdmissionGate?.Release(aggregateLockKey, admissionOwner);
            }
        }

        // Command surfaces acquire the lease through a Func delegate rather than an EventCallback owned by
        // this component. Blazor therefore does not schedule a TenantDetailPage render when that child event
        // completes. Render explicitly so the owner-aware lock reason and disabled sibling surfaces become
        // visible immediately after acquisition (and disappear immediately after release).
        await RenderIfAliveAsync().ConfigureAwait(false);
        return true;
    }

    private string ConfigurationSummary(TenantConfigurationSafeModel configuration)
        => !configuration.IsAvailable
            ? Localizer["Tenants.Detail.Configuration.Unavailable"]
            : configuration.Rows.Count == 0
            ? Localizer["Tenants.Detail.Configuration.Empty"]
            : Localizer[
                "Tenants.Detail.Configuration.Summary",
                configuration.Rows.Count,
                configuration.Rows.Select(static row => row.Namespace).Distinct(StringComparer.Ordinal).Count()];

    private static int OwnerCount(TenantDetail detail)
        => detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private string StatusLabel(TenantStatus status)
        => Localizer[$"Tenants.Detail.Status.{status}"];

    private static BadgeColor StatusBadgeColor(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => BadgeColor.Success,
            TenantStatus.Disabled => BadgeColor.Danger,
            _ => BadgeColor.Subtle,
        };

    private static Icon StatusIcon(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => FcFluentIcons.Checkmark16(),
            TenantStatus.Disabled => FcFluentIcons.SubtractCircle16(),
            _ => FcFluentIcons.QuestionCircle16(),
        };

    // The "/tenants" prefix check already rejects every protocol-relative value: a string starting "//" has
    // '/' at index 1, where the prefix requires 't'. The former explicit "//" clause was unreachable by
    // construction, so deleting it changes nothing -- it is removed rather than kept, because a guard that
    // cannot decide anything reads as protection that is not there. Any future relaxation of the prefix
    // check must re-add an explicit scheme-relative rejection.
    private static bool IsSafeReturnUrl(string? returnUrl)
        => !string.IsNullOrWhiteSpace(returnUrl)
            && returnUrl.StartsWith("/tenants", StringComparison.Ordinal);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _ = Interlocked.Increment(ref _loadGeneration);
        _ = Interlocked.Increment(ref _lifecycleAuthorizationGeneration);
        ResetMetadataProofScope(tenantId: null);
        ResetLifecycleProofScope(tenantId: null);
        if (_authenticationStateProvider is not null)
        {
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
            _authenticationStateProvider = null;
        }

        if (_highImpactViewportObservation is not null)
        {
            _highImpactViewportObservation.StateChanged -= OnHighImpactViewportStateChanged;
            _highImpactViewportObservation = null;
        }

        CancelLifecycleAuthorizationCancellation();
        CancelActiveCancellation();
        CancelSupplementaryReads();

        if (_activeAggregateLockKey is not null)
        {
            bool lifecycleSurface = ReferenceEquals(_aggregateLeaseHolder, _lifecycleLeaseOwner);
            bool setConfigurationSurface = ReferenceEquals(_aggregateLeaseHolder, _setConfigurationLeaseOwner);
            bool retainLifecycleLease = lifecycleSurface
                && _activeAggregateTenantId is not null
                && LifecycleAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            bool retainSetConfigurationLease = setConfigurationSurface
                && _activeAggregateTenantId is not null
                && SetConfigurationAttemptTracker?.HasPendingOwnership(_activeAggregateTenantId) is true;
            if (!retainLifecycleLease && !retainSetConfigurationLease)
            {
                object admissionOwner = lifecycleSurface && LifecycleAttemptTracker is not null
                    ? LifecycleAttemptTracker.LeaseOwner
                    : setConfigurationSurface && SetConfigurationAttemptTracker is not null
                        ? SetConfigurationAttemptTracker.LeaseOwner
                    : _commandLockOwner;
                AggregateAdmissionGate?.Release(_activeAggregateLockKey, admissionOwner);
            }

            _activeAggregateLockKey = null;
            _activeAggregateTenantId = null;
            _aggregateLeaseHolder = null;
            _commandInFlight = false;
        }

        if (_readRefreshLease is not null)
        {
            // Teardown must not surface a transport fault either; the sibling page disposes safely here too.
            IAsyncDisposable lease = _readRefreshLease;
            _readRefreshLease = null;
            await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
        }
    }

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }

    private sealed class HighImpactRefreshObservation(
        TenantDetailPage owner,
        int generation) : IDisposable
    {
        private TenantDetailPage? _owner = owner;

        public void Dispose()
            => Interlocked.Exchange(ref _owner, null)?.EndHighImpactRefresh(generation);
    }
}
