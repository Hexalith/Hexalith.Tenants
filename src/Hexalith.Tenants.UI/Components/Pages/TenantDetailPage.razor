        => Task.FromResult(
            string.Equals(_snapshot.Detail?.TenantId, request.TenantId, StringComparison.Ordinal)
                ? _snapshot.Detail
                : null);

    private async Task SetCommandActivityAsync(bool isActive)
    {
        _commandInFlight = isActive;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private string ConfigurationSummary(TenantConfigurationSafeModel configuration)
        => !configuration.IsAvailable
            ? Localizer["Tenants.Detail.Configuration.Unavailable"]
            : configuration.Rows.Count == 0
            ? Localizer["Tenants.Detail.Configuration.Empty"]
            : Localizer[
                "Tenants.Detail.Configuration.Summary",
                configuration.Rows.Count,
                configuration.Rows.Select(static row => row.Namespace).Distinct(StringComparer.Ordinal).Count()];

    private static int OwnerCount(TenantDetail detail)
        => detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private string StatusLabel(TenantStatus status)
        => Localizer[$"Tenants.Detail.Status.{status}"];

    private static BadgeColor StatusBadgeColor(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => BadgeColor.Success,
            TenantStatus.Disabled => BadgeColor.Danger,
            _ => BadgeColor.Subtle,
        };

    private static Icon StatusIcon(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => FcFluentIcons.Checkmark16(),
            TenantStatus.Disabled => FcFluentIcons.SubtractCircle16(),
            _ => FcFluentIcons.QuestionCircle16(),
        };

    // The "/tenants" prefix check already rejects every protocol-relative value: a string starting "//" has
    // '/' at index 1, where the prefix requires 't'. The former explicit "//" clause was unreachable by
    // construction, so deleting it changes nothing -- it is removed rather than kept, because a guard that
    // cannot decide anything reads as protection that is not there. Any future relaxation of the prefix
    // check must re-add an explicit scheme-relative rejection.
    private static bool IsSafeReturnUrl(string? returnUrl)
        => !string.IsNullOrWhiteSpace(returnUrl)
            && returnUrl.StartsWith("/tenants", StringComparison.Ordinal);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _ = Interlocked.Increment(ref _loadGeneration);
        CancelActiveCancellation();

        if (_readRefreshLease is not null)
        {
            await _readRefreshLease.DisposeAsync().ConfigureAwait(false);
            _readRefreshLease = null;
        }
    }

    private sealed class PendingOperation : IDisposable
    {
        private Action? _complete;

        public PendingOperation(
            long generation,
            CancellationTokenSource cancellation,
            Action complete)
        {
            Generation = generation;
            CancellationToken = cancellation.Token;
            _complete = complete;
        }

        public long Generation { get; }

        public CancellationToken CancellationToken { get; }

        public void Dispose()
            => Interlocked.Exchange(ref _complete, null)?.Invoke();
    }
}
