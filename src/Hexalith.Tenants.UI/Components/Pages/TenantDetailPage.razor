    // Projection version observed by the last authoritative metadata proof read. The flow asks for evidence
    // first and the version second, so this is always the version of the very read that produced the
    // evidence -- never a version from an unrelated refresh that happened in between.
    private string? _updateMetadataProofProjectionVersion;

    private async Task<TenantDetail?> GetUpdateMetadataProjectionEvidenceAsync(UpdateTenant request)
    {
        using PendingOperation? operation = BeginMetadataProof(request.TenantId);
        if (operation is null)
        {
            return null;
        }

        TenantDetailSnapshot? proof;
        try
        {
            proof = await QueryGateway
                .GetUpdateMetadataProjectionProofAsync(request, operation.CancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (operation.CancellationToken.IsCancellationRequested)
        {
            return null;
        }

        if (!CanApplyMetadataProof(operation.Generation, request.TenantId))
        {
            return null;
        }

        if (proof is null
            || proof.Kind is not TenantDetailSurfaceKind.Ready
            || proof.Freshness is not ReadModelFreshnessState.Current
            || proof.Lifecycle is not ProjectionLifecycleState.Current
            || string.IsNullOrWhiteSpace(proof.ProjectionVersion)
            || proof.Detail?.Status is TenantStatus.Disabled or TenantStatus.Unknown
            || !string.Equals(proof.Detail?.TenantId, request.TenantId, StringComparison.Ordinal))
        {
            // Fail closed: payload presence alone is not authoritative. A stale, unknown, or non-current
            // proof must also clear any version retained from an earlier proof so it cannot qualify this read.
            _ = TryApplyMetadataProofVersion(operation.Generation, request.TenantId, projectionVersion: null);
            return null;
        }

        return TryApplyMetadataProofVersion(operation.Generation, request.TenantId, proof.ProjectionVersion)
            ? proof.Detail
            : null;
    }

    private async Task<TenantAuditRow?> GetUpdateMetadataAuditEvidenceAsync(
        UpdateTenant request,
        string? messageId,
        DateTimeOffset? attemptStartedAtUtc)
    {
        if (string.IsNullOrWhiteSpace(messageId) || attemptStartedAtUtc is null)
        {
            return null;
        }

        using PendingOperation? operation = BeginMetadataProof(request.TenantId);
        if (operation is null)
        {
            return null;
        }

        TenantAuditRequest auditRequest = new(
            request.TenantId,
            From: attemptStartedAtUtc,
            Category: AuditEventCategory.Administrative,
            PageSize: MetadataAuditProofPageSize);
        string? projectionVersion = null;
        var matches = new List<TenantAuditRow>();
        for (int pageNumber = 0; pageNumber < MetadataAuditProofMaximumPageCount; pageNumber++)
        {
            TenantAuditSnapshot audit;
            try
            {
                audit = await QueryGateway
                    .GetTenantAuditAsync(auditRequest, previous: null, operation.CancellationToken)
                    .ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (operation.CancellationToken.IsCancellationRequested)
            {
                return null;
            }

            if (!CanApplyMetadataProof(operation.Generation, request.TenantId))
            {
                return null;
            }

            // Fail closed on the first non-authoritative page: a later page cannot redeem an already-degraded
            // read, and every page must belong to the same projection snapshot as the first. A page that still
            // has more rows beyond it is not itself trustworthy evidence -- only a complete, consistent walk of
            // the whole attempt window (bounded by MetadataAuditProofMaximumPageCount) may confirm.
            projectionVersion ??= audit.ProjectionVersion;
            bool authoritativePage = audit.Kind is TenantAuditSurfaceKind.Ready
                && audit.MatchesScope(auditRequest)
                && audit.Freshness is ReadModelFreshnessState.Current
                && audit.Lifecycle is ProjectionLifecycleState.Current
                && !string.IsNullOrWhiteSpace(audit.ProjectionVersion)
                && string.Equals(projectionVersion, audit.ProjectionVersion, StringComparison.Ordinal)
                && audit.Rows.All(row =>
                    string.Equals(row.TenantId, request.TenantId, StringComparison.Ordinal)
                    && row.Freshness is ReadModelFreshnessState.Current
                    && row.Lifecycle is ProjectionLifecycleState.Current
                    && row.Provenance is QueryResponseProvenance.ProjectionBacked);
            if (!authoritativePage)
            {
                return null;
            }

            matches.AddRange(audit.Rows.Where(row => TenantUpdateMetadataCommandSnapshot.IsMatchingUpdateAuditProof(
                row,
                request,
                messageId,
                attemptStartedAtUtc)));
            if (matches.Count > 1)
            {
                return null;
            }

            if (!audit.HasMore)
            {
                return matches.Count == 1 ? matches[0] : null;
            }

            if (string.IsNullOrWhiteSpace(audit.NextCursor))
            {
                return null;
            }

            auditRequest = auditRequest with { Cursor = audit.NextCursor, ETag = null };
        }

        return null;
    }

