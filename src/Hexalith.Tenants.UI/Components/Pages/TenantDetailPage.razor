    private async Task<TenantDetailSnapshot?> GetLifecycleProjectionEvidenceAsync(
        TenantLifecycleCommandRequest request,
        CancellationToken cancellationToken)
    {
        using PendingOperation? operation = BeginLifecycleProof(request.TenantId);
        if (operation is null)
        {
            return null;
        }

        using var linked = CancellationTokenSource.CreateLinkedTokenSource(
            operation.CancellationToken,
            cancellationToken);
        TenantDetailSnapshot proof;
        try
        {
            proof = await QueryGateway
                .GetLifecycleProjectionProofAsync(request, linked.Token)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (linked.IsCancellationRequested)
        {
            return null;
        }

        return CanApplyLifecycleProof(operation.Generation, request.TenantId)
            ? proof
            : null;
    }

