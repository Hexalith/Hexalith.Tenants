    /// <summary>A page whose rows and paging state may be applied.</summary>
    /// <remarks>
    /// <see cref="TenantUsersSurfaceKind.Unknown"/> is a successful read whose projection freshness could
    /// not be resolved, not a failure. Omitting it sent every such page down the degraded-retention path,
    /// which re-presented the previous page's rows and cursor while leaving Next enabled -- so the operator
    /// could never leave page one and was told the evidence was degraded on a read that succeeded. Every
    /// sibling predicate (IsRetainableTenantUsers, IsUsableGlobalAdministratorsPage, CanOpenMemberAudit,
    /// IsAppliedRequestedPage) admits it.
    /// </remarks>
    private static bool IsUsableMemberPage(TenantUsersSnapshot snapshot, string? requestedCursor)
        => (snapshot.Kind is TenantUsersSurfaceKind.Ready
            or TenantUsersSurfaceKind.Empty
            or TenantUsersSurfaceKind.Stale
            or TenantUsersSurfaceKind.Unknown)
            || (snapshot.Kind is TenantUsersSurfaceKind.Degraded
                && string.Equals(snapshot.RequestCursor, requestedCursor, StringComparison.Ordinal));

    /// <summary>A terminal response that must replace retained rows to avoid disclosure.</summary>
    private static bool IsTerminalMemberPage(TenantUsersSnapshot snapshot)
        => snapshot.Kind is TenantUsersSurfaceKind.Unauthorized
            or TenantUsersSurfaceKind.NotFound
            or TenantUsersSurfaceKind.Invalid;

    private void StartGlobalAdministratorsLoad(
        string tenantId,
        long generation,
        GlobalAdministratorsSnapshot? retained)
    {
        CancellationTokenSource source = ReplaceGlobalAdministratorsCancellation();
        _ = LoadGlobalAdministratorsForGenerationAsync(tenantId, generation, retained, source);
    }

    private async Task LoadGlobalAdministratorsForGenerationAsync(
        string tenantId,
        long generation,
        GlobalAdministratorsSnapshot? retained,
        CancellationTokenSource source)
    {
        GlobalAdministratorsSnapshot snapshot;
        try
        {
            snapshot = await LoadCompleteGlobalAdministratorsAsync(source.Token).ConfigureAwait(false);
            source.Token.ThrowIfCancellationRequested();
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            snapshot = ToFailClosedGlobalAdministrators(retained)
                ?? GlobalAdministratorsSnapshot.Unavailable();
        }
        finally
        {
            CompleteGlobalAdministratorsCancellation(source);
        }

        if (!CanApply(generation, tenantId))
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (CanApply(generation, tenantId))
                {
                    _globalAdministratorsSnapshot = snapshot;
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // Disposed between the generation check and renderer dispatch.
        }
    }

    private async Task<GlobalAdministratorsSnapshot> LoadCompleteGlobalAdministratorsAsync(
        CancellationToken cancellationToken)
        => await GlobalAdministratorsProjectionLoader
            .LoadAsync(QueryGateway, cancellationToken: cancellationToken)
            .ConfigureAwait(false);

    private void StartAuditCapabilityProbe(string tenantId, long generation)
    {
        CancellationTokenSource source = ReplaceAuditCapabilityCancellation();
        _ = LoadAuditCapabilityForGenerationAsync(tenantId, generation, source);
    }

    private async Task LoadAuditCapabilityForGenerationAsync(
        string tenantId,
        long generation,
        CancellationTokenSource source)
    {
        bool available = false;
        try
        {
            if (BffComposition.IsReadSurfaceConnected)
            {
                TenantAuditRequest request = new(tenantId, PageSize: 1);
                TenantAuditSnapshot audit = await QueryGateway
                    .GetTenantAuditAsync(request, previous: null, source.Token)
                    .ConfigureAwait(false);
                source.Token.ThrowIfCancellationRequested();
                available = IsAuthoritativeAuditCapability(audit, request);
            }
        }
        catch (OperationCanceledException) when (source.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            available = false;
        }
        finally
        {
            CompleteAuditCapabilityCancellation(source);
        }

        if (!CanApply(generation, tenantId))
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (CanApply(generation, tenantId))
                {
                    _auditProofCapabilityAvailable = available;
                    StateHasChanged();
                }
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException)
        {
            // Disposed between the generation check and renderer dispatch.
        }
    }

    private static bool IsAuthoritativeAuditCapability(
        TenantAuditSnapshot audit,
        TenantAuditRequest request)
    {
        ArgumentNullException.ThrowIfNull(audit);
        ArgumentNullException.ThrowIfNull(request);

        bool authorizedEmpty = audit.Kind is not (TenantAuditSurfaceKind.Empty or TenantAuditSurfaceKind.FilteredEmpty)
            || audit.IsAuthorizationScopedEmpty;
        return audit.Kind is TenantAuditSurfaceKind.Ready
                or TenantAuditSurfaceKind.Empty
                or TenantAuditSurfaceKind.FilteredEmpty
                or TenantAuditSurfaceKind.ListRefreshed
            && audit.MatchesScope(request)
            && audit.Freshness is ReadModelFreshnessState.Current
            && audit.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(audit.ProjectionVersion)
            && authorizedEmpty
            && audit.Rows.All(static row =>
                row.Freshness is ReadModelFreshnessState.Current
                && row.Lifecycle is ProjectionLifecycleState.Current
                && row.Provenance is QueryResponseProvenance.ProjectionBacked);
    }

    private static GlobalAdministratorsSnapshot? ToFailClosedGlobalAdministrators(
        GlobalAdministratorsSnapshot? retained)
        => retained is null
            ? null
            : retained with
            {
                Kind = GlobalAdministratorsSurfaceKind.Degraded,
                NextCursor = null,
                HasMore = false,
                Freshness = ReadModelFreshnessState.Unknown,
                IsAuthorizationScopedEmpty = false,
                Reason = GlobalAdministratorsReason.GatewayFailure,
                Lifecycle = ProjectionLifecycleState.Unknown,
                ProjectionVersion = null,
                IsCompleteEvidence = false,
                RequestCursor = null,
            };

    private PendingOperation BeginLoad()
    {
        long generation = Interlocked.Increment(ref _loadGeneration);
        CancellationTokenSource source = ReplaceActiveCancellation();
        _memberPageLoadInFlight = false;
        if (_tenantUsersSnapshot.IsRefreshing)
        {
            _tenantUsersSnapshot = _tenantUsersSnapshot with { IsRefreshing = false };
        }

        return new(generation, source, () => CompleteCancellation(source));
    }

    // Volatile.Read matches the two sibling pages: this guard is read from thread-pool continuations and is
    // the sole defence against a superseded completion overwriting newer member rows.
    private bool CanApply(long generation, string tenantId)
        => !_disposed
            && generation == Volatile.Read(ref _loadGeneration)
            && string.Equals(TenantId, tenantId, StringComparison.Ordinal);

    private void ResetMetadataProofScope(string? tenantId)
    {
        lock (_metadataProofLock)
        {
            if (string.Equals(_metadataProofTenantId, tenantId, StringComparison.Ordinal))
            {
                return;
            }

            _metadataProofTenantId = tenantId;
            _ = Interlocked.Increment(ref _metadataProofGeneration);
            _updateMetadataProofProjectionVersion = null;
            // Each proof operation owns disposal of its source. Route invalidation only cancels it, avoiding
            // the CancellationToken.Register-after-Dispose race described for the main page-load path. Keep
            // cancellation under the same lock as completion so a source cannot be disposed between selection
            // and Cancel.
            foreach (CancellationTokenSource source in _metadataProofCancellations)
            {
                RetireCancellationCore(source);
            }

            _metadataProofCancellations.Clear();
        }
    }

    private PendingOperation? BeginMetadataProof(string tenantId)
    {
        lock (_metadataProofLock)
        {
            if (_disposed
                || !string.Equals(_metadataProofTenantId, tenantId, StringComparison.Ordinal)
                || !string.Equals(TenantId, tenantId, StringComparison.Ordinal))
            {
                return null;
            }

            var source = new CancellationTokenSource();
            _ = _metadataProofCancellations.Add(source);
            long generation = Volatile.Read(ref _metadataProofGeneration);
            return new PendingOperation(generation, source, () => CompleteMetadataProof(source));
        }
    }

    private bool CanApplyMetadataProof(long generation, string tenantId)
    {
        lock (_metadataProofLock)
        {
            return CanApplyMetadataProofCore(generation, tenantId);
        }
    }

    private bool TryApplyMetadataProofVersion(long generation, string tenantId, string? projectionVersion)
    {
        lock (_metadataProofLock)
        {
            if (!CanApplyMetadataProofCore(generation, tenantId))
            {
                return false;
            }

            _updateMetadataProofProjectionVersion = projectionVersion;
            return true;
        }
    }

    private bool CanApplyMetadataProofCore(long generation, string tenantId)
        => !_disposed
            && generation == Volatile.Read(ref _metadataProofGeneration)
            && string.Equals(_metadataProofTenantId, tenantId, StringComparison.Ordinal)
            && string.Equals(TenantId, tenantId, StringComparison.Ordinal);

    private void CompleteMetadataProof(CancellationTokenSource source)
    {
        lock (_metadataProofLock)
        {
            _ = _metadataProofCancellations.Remove(source);
        }

        source.Dispose();
    }

