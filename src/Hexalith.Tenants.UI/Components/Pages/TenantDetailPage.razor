@page "/tenants/{TenantId}"
@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.Components.Tenants.Configuration
@using Hexalith.Tenants.UI.Components.Tenants.Lifecycle
@using Hexalith.Tenants.UI.Components.Tenants.Metadata
@using Hexalith.Tenants.UI.Components.Tenants.Members
@using Hexalith.Tenants.UI.State
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantUsers
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject ITenantsBffComposition BffComposition
@inject IServiceProvider Services
@implements IAsyncDisposable

<FcAggregateDetailPage TItem="TenantDetail"
                       LayoutMode="FcPageLayoutMode.Constrained"
                       RootTestId="tenants-detail"
                       RootClass="tenant-detail"
                       State="DetailState"
                       BackHref="@BackHref"
                       BackLinkLabel="@Localizer["Tenants.Detail.Back"]"
                       BackLinkTestId="tenants-detail-back">
    <LoadingContent>
        <section class="tenant-detail__state" role="status" data-testid="tenants-detail-loading">
            <FcPageHeader PageTitle="@Localizer["Tenants.Detail.Title"]"
                          Heading="@Localizer["Tenants.Detail.State.Loading.Title"]"
                          Description="@Localizer["Tenants.Detail.State.Loading.Message"]"
                          TestId="tenants-detail-state-header" />
        </section>
    </LoadingContent>
    <UnauthorizedContent>
        <section class="tenant-detail__state" role="alert" data-testid="tenants-detail-unauthorized">
            <FcPageHeader PageTitle="@Localizer["Tenants.Detail.Title"]"
                          Heading="@Localizer["Tenants.Detail.State.Unauthorized.Title"]"
                          Description="@Localizer["Tenants.Detail.State.Unauthorized.Message"]"
                          TestId="tenants-detail-state-header" />
        </section>
    </UnauthorizedContent>
    <NotFoundContent>
        <section class="tenant-detail__state" role="alert" data-testid="tenants-detail-error">
            <FcPageHeader PageTitle="@Localizer["Tenants.Detail.Title"]"
                          Heading="@Localizer["Tenants.Detail.State.NotFound.Title"]"
                          Description="@Localizer["Tenants.Detail.State.NotFound.Message"]"
                          TestId="tenants-detail-state-header" />
        </section>
    </NotFoundContent>
    <UnavailableContent>
        <section class="tenant-detail__state" role="alert" data-testid="tenants-detail-error">
            <FcPageHeader PageTitle="@Localizer["Tenants.Detail.Title"]"
                          Heading="@Localizer["Tenants.Detail.State.Unavailable.Title"]"
                          Description="@Localizer["Tenants.Detail.State.Unavailable.Message"]"
                          TestId="tenants-detail-state-header" />
        </section>
    </UnavailableContent>
    <StaleBanner>
        <section class="tenant-detail__state" role="status" data-testid="tenants-detail-stale">
            <h2>@Localizer["Tenants.Detail.State.Stale.Title"]</h2>
            <p>@Localizer["Tenants.Detail.State.Stale.Message"]</p>
        </section>
    </StaleBanner>
    <DegradedBanner>
        <section class="tenant-detail__state" role="status" data-testid="tenants-detail-degraded">
            <h2>@Localizer["Tenants.Detail.State.Degraded.Title"]</h2>
            <p>@Localizer["Tenants.Detail.State.Degraded.Message"]</p>
        </section>
    </DegradedBanner>
    <ReadyContent>
        <FluentStack Orientation="Orientation.Vertical"
                     VerticalGap="16px"
                     Class="tenant-detail__summary"
                     aria-label="@Localizer["Tenants.Detail.OverviewLabel"]">
            <FcPageHeader PageTitle="@Localizer["Tenants.Detail.Title"]"
                          Heading="@(string.IsNullOrWhiteSpace(Detail.Name) ? Localizer["Tenants.Detail.UnnamedTenant"] : Detail.Name)"
                          Eyebrow="@Localizer["Tenants.Detail.IdentityLabel"]"
                          Description="@(string.IsNullOrWhiteSpace(Detail.Description) ? null : Detail.Description)"
                          HeadingId="tenants-detail-identity"
                          Class="tenant-detail__identity"
                          TestId="tenants-detail-identity">
                <Metadata>
                <div class="tenant-detail__literal-row">
                    <p class="tenant-detail__literal" aria-label="@Localizer["Tenants.Detail.FullTenantIdLabel", Detail.TenantId]">@Detail.TenantId</p>
                    <SupportSafeCopyButton Value="@Detail.TenantId"
                                           ValueKind="SupportSafeCopyValueKind.TenantId"
                                           IsApproved="true"
                                           AccessibleName="@Localizer["Tenants.Copy.Label.TenantId", Detail.TenantId]"
                                           TestId="tenants-detail-copy-reference" />
                </div>
                <AuditEvidenceEntryPoint TenantId="@Detail.TenantId"
                                         SourceKind="tenant-detail"
                                         SourceTestId="tenants-detail-audit-entrypoint"
                                         Label="@Localizer["Tenants.Audit.EntryPoint.Label"]"
                                         AccessibleName="@Localizer["Tenants.Detail.AuditAccessibleLabel", Detail.TenantId]"
                                         ReturnUrl="@DetailReturnUrl"
                                         ReturnFocus="tenants-detail-identity" />
                </Metadata>
            </FcPageHeader>

            <dl class="tenant-detail__facts">
                <div>
                    <dt>@Localizer["Tenants.Detail.StatusLabel"]</dt>
                    <dd>
                        <FluentBadge Appearance="BadgeAppearance.Tint"
                                     Color="@StatusBadgeColor(Detail.Status)"
                                     IconStart="@StatusIcon(Detail.Status)"
                                     Class="tenant-detail__status"
                                     aria-label="@Localizer["Tenants.Detail.StatusAccessibleLabel", StatusLabel(Detail.Status)]">
                            @StatusLabel(Detail.Status)
                        </FluentBadge>
                    </dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Detail.LifecycleLabel"]</dt>
                    <dd>@StatusLabel(Detail.Status)</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Detail.FreshnessLabel"]</dt>
                    <dd><TruthStateBadge Freshness="@_snapshot.Freshness" TestId="tenants-detail-truth-state" /></dd>
                </div>
                @* The live region sits inside the dd, not on the dl child. ARIA-in-HTML allows only dt, dd,
                   generic div, script and template as dl children, so role="status" on the wrapper detached
                   this dt/dd pair from the definition list. role="alert" (implicitly assertive) replaces the
                   contradictory aria-live="assertive" on role="status" (implicitly polite). *@
                <div>
                    <dt>@Localizer["Tenants.ProjectionLifecycle.Label"]</dt>
                    <dd>
                        <span role="@(_snapshot.Lifecycle is ProjectionLifecycleState.Unavailable ? "alert" : "status")"
                              aria-atomic="true"
                              data-testid="tenants-detail-projection-lifecycle-status">
                            <ProjectionLifecycleBadge Lifecycle="@_snapshot.Lifecycle" TestId="tenants-detail-projection-lifecycle" />
                        </span>
                    </dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Detail.CreatedAtLabel"]</dt>
                    <dd>@Detail.CreatedAt.ToString("u", System.Globalization.CultureInfo.CurrentCulture)</dd>
                </div>
            </dl>

            <FluentAccordion Class="tenant-detail__sections"
                             ExpandMode="AccordionExpandMode.Multi"
                             Block="true">
                <FluentAccordionItem Header="@Localizer["Tenants.EditMetadata.Title"]"
                                     Expanded="true">
                    <EditTenantMetadataFlow Detail="@Detail"
                                            SurfaceKind="@_snapshot.Kind"
                                            Freshness="@_snapshot.Freshness"
                                            Lifecycle="@_snapshot.Lifecycle"
                                            IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                            OnProjectionRefreshRequested="@RefreshTenantDetailAsync"
                                            OnCommandActivityChanged="@SetCommandActivityAsync"
                                            ProjectionEvidenceProvider="@GetUpdateMetadataProjectionEvidenceAsync" />
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Tenants.Lifecycle.Title"]"
                                     Expanded="true">
                    <TenantLifecycleActionAvailability TenantId="@Detail.TenantId"
                                                        Detail="@Detail"
                                                        CurrentStatus="@Detail.Status"
                                                        SurfaceKind="@_snapshot.Kind"
                                                        Freshness="@_snapshot.Freshness"
                                                        Lifecycle="@_snapshot.Lifecycle"
                                                        IsCommandSurfaceConnected="@BffComposition.IsCommandSurfaceConnected"
                                                        AuthorizationReflection="@BffComposition.LifecycleAuthorizationReflection"
                                                        GovernanceReadiness="TenantLifecycleGovernanceReadiness.Ready"
                                                        IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                                        OnProjectionRefreshRequested="@RefreshTenantDetailAsync"
                                                        OnCommandActivityChanged="@SetCommandActivityAsync"
                                                        ProjectionEvidenceProvider="@GetLifecycleProjectionEvidenceAsync" />
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Tenants.Detail.Members.Title"]"
                                     Expanded="true">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px" Class="tenant-detail__accordion-body">
                        <section class="tenant-detail__section" data-testid="tenants-detail-member-summary">
                            <h2>@Localizer["Tenants.Detail.Members.Title"]</h2>
                            <p>@MemberSummary</p>
                        </section>

                        <MemberAccessReview Detail="@Detail"
                                            SurfaceKind="@_snapshot.Kind"
                                            Freshness="@_snapshot.Freshness"
                                            Lifecycle="@_snapshot.Lifecycle"
                                            ProjectionVersion="@_snapshot.ProjectionVersion"
                                            Members="@_tenantUsersSnapshot"
                                            CanGoPrevious="@(_memberCursorHistory.Count > 0)"
                                            PagingJumpedToFirstPage="@_memberPagingJumpedToFirstPage"
                                            OnNextPageRequested="@LoadNextMemberPageAsync"
                                            OnPreviousPageRequested="@LoadPreviousMemberPageAsync"
                                            IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                            OnCommandActivityChanged="@SetCommandActivityAsync"
                                            OnProjectionRefreshRequested="@RefreshTenantReadsAsync"
                                            ProjectionEvidenceProvider="@GetAddMemberProjectionEvidenceAsync"
                                            ChangeRoleProjectionEvidenceProvider="@GetChangeRoleProjectionEvidenceAsync"
                                            RemoveMemberProjectionEvidenceProvider="@GetRemoveMemberProjectionEvidenceAsync" />
                    </FluentStack>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@Localizer["Tenants.Detail.Configuration.Title"]"
                                     Expanded="true">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16px" Class="tenant-detail__accordion-body">
                        <section class="tenant-detail__section" data-testid="tenants-detail-configuration-summary">
                            <h2>@Localizer["Tenants.Detail.Configuration.Title"]</h2>
                            <p>@ConfigurationSummary(_snapshot.Configuration)</p>
                        </section>

                        <TenantConfigurationView Model="@_snapshot.Configuration"
                                                 SurfaceKind="@_snapshot.Kind"
                                                 Freshness="@_snapshot.Freshness"
                                                 Lifecycle="@_snapshot.Lifecycle" />

                        <TenantConfigurationManagement Context="@_snapshot.ConfigurationManagement"
                                                       SurfaceKind="@_snapshot.Kind"
                                                       Freshness="@_snapshot.Freshness"
                                                       Lifecycle="@_snapshot.Lifecycle"
                                                       IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                                       OnProjectionRefreshRequested="@RefreshTenantDetailAsync"
                                                       OnCommandActivityChanged="@SetCommandActivityAsync"
                                                       SetProjectionEvidenceProvider="@GetSetConfigurationProjectionEvidenceAsync"
                                                       RemoveProjectionEvidenceProvider="@GetRemoveConfigurationProjectionEvidenceAsync"
                                                       ReauthorizeProvider="@ReauthorizeConfigurationManagementAsync" />
                    </FluentStack>
                </FluentAccordionItem>
            </FluentAccordion>
        </FluentStack>
    </ReadyContent>
</FcAggregateDetailPage>

@code {
    private TenantDetailSnapshot _snapshot = TenantDetailSnapshot.Loading();
    private TenantUsersSnapshot _tenantUsersSnapshot = TenantUsersSnapshot.Loading();
    /// <summary>Upper bound on retained member paging history.</summary>
    private const int MaximumMemberCursorHistory = CursorHistory.DefaultMaximum;

    private readonly Stack<string?> _memberCursorHistory = new();

    // CursorHistory.Trim re-appends the first-page sentinel beneath the newest entries when it drops the
    // oldest, so one later Previous click walks the operator from mid-sequence straight to page one. The
    // audit and global-administrator pagers announce that; the member pager discarded Trim's return value and
    // rendered the jump as an ordinary step back, silently misstating where the operator is.
    private bool _memberPagingHistoryTruncated;
    private bool _memberPagingJumpedToFirstPage;
    private string? _memberCursor;
    private IAsyncDisposable? _readRefreshLease;
    private string? _subscriptionTenantId;
    private CancellationTokenSource? _loadCancellation;
    // Serialises the active-cancellation swap. A superseded source is cancelled immediately -- which is what
    // callers observe -- but NOT disposed there: disposing one at the moment it is replaced races the
    // request still inside SendAsync, where a CancellationToken.Register after Dispose throws
    // ObjectDisposedException, which is not an OperationCanceledException and so slips past every caller's
    // cancellation-only handler. Disposal is owned solely by CompleteCancellation, which the owning
    // PendingOperation calls when its operation finishes. A prior version also tracked superseded sources in
    // a List; nothing ever read it, so it is removed rather than left to read as a retention mechanism.
    private readonly Lock _cancellationLock = new();
    private long _loadGeneration;
    private bool _disposed;

    /// <summary>Upper bound on optional notification-setup attempts for one route.</summary>
    private const int MaximumReadRefreshAttempts = 3;

    private string? _readRefreshAttemptTenantId;
    private int _readRefreshAttempts;
    private bool _memberPageLoadInFlight;
    private bool _commandInFlight;
    private bool _readRefreshSubscriptionInFlight;

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string BackHref => IsSafeReturnUrl(ReturnUrl) ? ReturnUrl! : "/tenants";

    private string DetailReturnUrl
        => $"/tenants/{Uri.EscapeDataString(TenantId)}";

    private TenantDetail Detail => _snapshot.Detail ?? throw new InvalidOperationException("Detail is only used when a snapshot is available.");

    private bool IsCommandSurfaceAvailable
        => !_commandInFlight && BffComposition.IsCommandSurfaceConnected;

    private bool MemberEvidenceIsVersionConsistent
        => _snapshot.Kind is TenantDetailSurfaceKind.Ready
            && _snapshot.Freshness is ReadModelFreshnessState.Current
            && _snapshot.Lifecycle is ProjectionLifecycleState.Current
            && _tenantUsersSnapshot.Kind is TenantUsersSurfaceKind.Ready or TenantUsersSurfaceKind.Empty
            && _tenantUsersSnapshot.Freshness is ReadModelFreshnessState.Current
            && _tenantUsersSnapshot.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(_snapshot.ProjectionVersion)
            && string.Equals(
                _snapshot.ProjectionVersion,
                _tenantUsersSnapshot.ProjectionVersion,
                StringComparison.Ordinal);

    private string MemberSummary
        => MemberEvidenceIsVersionConsistent
            ? Localizer[
                "Tenants.Detail.Members.VisiblePageSummaryWithOwners",
                _tenantUsersSnapshot.Rows.Count,
                OwnerCount(Detail)]
            : Localizer[
                "Tenants.Detail.Members.VisiblePageSummary",
                _tenantUsersSnapshot.Rows.Count];

    // Maps the Tenants detail snapshot kind onto the domain-agnostic FC-DTL surface state the wrapper
    // routes. Kind takes precedence (loading/unauthorized/not-found/unavailable/unknown render their own
    // state regardless of payload); the ready body (Ready/Stale/Degraded) only renders with a payload, so a
    // missing payload fails closed to Unavailable instead of an optimistic ready surface.
    private FcAggregateDetailState DetailState
        => _snapshot.Kind switch
        {
            TenantDetailSurfaceKind.Loading => FcAggregateDetailState.Loading,
            TenantDetailSurfaceKind.Unauthorized => FcAggregateDetailState.Unauthorized,
            TenantDetailSurfaceKind.NotFound => FcAggregateDetailState.NotFound,
            TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown => FcAggregateDetailState.Unavailable,
            _ when _snapshot.Detail is null => FcAggregateDetailState.Unavailable,
            TenantDetailSurfaceKind.Stale => FcAggregateDetailState.Stale,
            TenantDetailSurfaceKind.Degraded => FcAggregateDetailState.Degraded,
            _ => FcAggregateDetailState.Ready,
        };

    protected override async Task OnParametersSetAsync()
    {
        string tenantId = TenantId;
        if (!string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal)
            && _readRefreshLease is not null)
        {
            await _readRefreshLease.DisposeAsync().ConfigureAwait(false);
            _readRefreshLease = null;
            _subscriptionTenantId = null;
        }

        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;

        // Marshalled for the same reason the result application below is: the optional lease dispose above
        // can genuinely suspend, so this continuation may run on a thread-pool thread while the render
        // ComponentBase queued for the incomplete task is in flight. _memberCursorHistory is a Stack the
        // renderer reads for CanGoPrevious, so clearing it unsynchronised races that read.
        await InvokeAsync(() =>
        {
            if (!CanApply(generation, tenantId))
            {
                return;
            }

            _snapshot = TenantDetailSnapshot.Loading();
            _tenantUsersSnapshot = TenantUsersSnapshot.Loading(tenantId);
            _memberCursor = null;
            _memberCursorHistory.Clear();
            _memberPagingHistoryTruncated = false;
            _memberPagingJumpedToFirstPage = false;
        }).ConfigureAwait(false);

        Task<TenantDetailSnapshot> detailTask = QueryGateway
            .GetTenantAsync(new TenantDetailRequest(tenantId), null, cancellationToken);
        Task<TenantUsersSnapshot> membersTask = QueryGateway
            .GetTenantUsersAsync(new TenantUsersRequest(tenantId), null, cancellationToken);
        // Observe both tasks regardless of which faults first: WhenAll surfaces only one exception, so the
        // other would go unobserved and its surface would keep whatever state it had -- Loading, in practice.
        TenantDetailSnapshot? detailResult = null;
        TenantUsersSnapshot? membersResult = null;
        bool cancelled = false;
        try
        {
            detailResult = await detailTask.ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            cancelled = true;
        }
        catch
        {
            detailResult = null;
        }

        try
        {
            membersResult = await membersTask.ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            cancelled = true;
        }
        catch
        {
            membersResult = null;
        }

        if (cancelled || !CanApply(generation, tenantId))
        {
            return;
        }

        // Marshalled with a re-check inside the dispatcher callback: CanApply above ran on a thread-pool
        // continuation, so a newer load can win between that check and this write.
        await InvokeAsync(() =>
        {
            if (!CanApply(generation, tenantId))
            {
                return;
            }

            // A faulted read resolves to its own terminal state rather than leaving the surface on Loading.
            _snapshot = detailResult ?? TenantDetailSnapshot.Unavailable(tenantId);
            _tenantUsersSnapshot = membersResult ?? TenantUsersSnapshot.Unavailable(tenantId);
            StateHasChanged();
        }).ConfigureAwait(false);

        await EnsureReadRefreshLeaseAsync(tenantId).ConfigureAwait(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Retry optional notification setup after later renders when an earlier attempt was superseded or
        // returned no lease. The method's in-flight and existing-lease guards keep successful setup
        // single-instance. Without this, one cancelled or empty setup disabled projection auto-refresh for
        // the rest of the circuit, because OnParametersSetAsync was its only entry point.
        //
        // Bounded, because a failing backend records neither _readRefreshLease nor _subscriptionTenantId, so
        // every guard passes again on the next render. RefreshTenantReadsAsync calls StateHasChanged, so an
        // unbounded retry was two remote round trips per render for the life of the circuit against a
        // subscription endpoint that is down. The counter resets with the route, so a new tenant retries.
        await EnsureReadRefreshLeaseAsync(TenantId).ConfigureAwait(false);
    }

    /// <summary>Subscribes this tenant's reads to projection notifications, at most once per tenant.</summary>
    /// <remarks>
    /// Deliberately does NOT take the load cancellation token. Binding setup to a load meant any Refresh,
    /// command-driven re-query or member pager click during setup cancelled <c>SubscribeAsync</c>, the catch
    /// returned without recording <c>_subscriptionTenantId</c>, and nothing retried for the same tenant --
    /// silently disabling projection auto-refresh for the rest of the circuit. Both sibling pages already
    /// pass <see cref="CancellationToken.None"/> for this reason.
    /// </remarks>
    private async Task EnsureReadRefreshLeaseAsync(string tenantId)
    {
        if (!string.Equals(_readRefreshAttemptTenantId, tenantId, StringComparison.Ordinal))
        {
            _readRefreshAttemptTenantId = tenantId;
            _readRefreshAttempts = 0;
        }

        if (_disposed
            || string.IsNullOrWhiteSpace(tenantId)
            || !string.Equals(TenantId, tenantId, StringComparison.Ordinal)
            || string.Equals(_subscriptionTenantId, tenantId, StringComparison.Ordinal)
            || _readRefreshLease is not null
            || _readRefreshSubscriptionInFlight
            || _readRefreshAttempts >= MaximumReadRefreshAttempts
            || Services.GetService(typeof(TenantReadRefreshSubscription)) is not TenantReadRefreshSubscription refreshSubscription)
        {
            return;
        }

        _readRefreshAttempts++;
        _readRefreshSubscriptionInFlight = true;
        TenantReadRefreshLease? lease = null;
        try
        {
            lease = await refreshSubscription.SubscribeAsync(
                GetTenantQuery.ProjectionType,
                tenantId,
                () => InvokeAsync(() => RefreshTenantReadsAsync(tenantId)),
                CancellationToken.None).ConfigureAwait(false);
            if (_disposed
                || !string.Equals(TenantId, tenantId, StringComparison.Ordinal)
                || _readRefreshLease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
                return;
            }

            if (!lease.IsSubscribed)
            {
                // Setup registered no callback. Recording it would satisfy the guards above forever and
                // permanently disable auto-refresh; leaving both fields unset lets the next render retry.
                return;
            }

            _readRefreshLease = lease;
            _subscriptionTenantId = tenantId;
            lease = null;

            // Re-checked after the assignment, not only before it. DisposeAsync sets _disposed and then reads
            // a still-null _readRefreshLease, so a continuation that passed the check above and was preempted
            // could assign the lease afterwards -- leaving the callback registered for the life of the
            // circuit and invoking InvokeAsync on a disposed component.
            if (_disposed)
            {
                IAsyncDisposable orphaned = _readRefreshLease;
                _readRefreshLease = null;
                _subscriptionTenantId = null;
                await DisposeLeaseSupportSafelyAsync(orphaned).ConfigureAwait(false);
            }
        }
        catch
        {
            // Optional refresh only; a transport fault must not escape the render lifecycle. The next
            // render retries.
            if (lease is not null)
            {
                await DisposeLeaseSupportSafelyAsync(lease).ConfigureAwait(false);
            }
        }
        finally
        {
            _readRefreshSubscriptionInFlight = false;
        }
    }

    private async Task RefreshTenantDetailAsync()
    {
        string tenantId = TenantId;

        // BeginLoad cancels the shared load token and clears _memberPageLoadInFlight / IsRefreshing, so a
        // member page navigation that was in flight is aborted here. This method never re-reads members, so
        // the abort was silent: the refresh indicator vanished, the pager re-enabled (its Disabled binding
        // reads Members.IsRefreshing, not _memberPageLoadInFlight) and the table sat on the old page with no
        // error and no retry, while the superseded load's finally could restore nothing because its
        // generation no longer matched. Route those cases through the read refresh, which restores
        // Refreshing and re-issues the member read for the current cursor.
        if (_memberPageLoadInFlight)
        {
            await RefreshTenantReadsAsync(tenantId).ConfigureAwait(false);
            return;
        }

        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        TenantDetailSnapshot previous = _snapshot;
        TenantDetailSnapshot snapshot;
        try
        {
            snapshot = await QueryGateway
                .GetTenantAsync(
                    new TenantDetailRequest(tenantId, previous.ETag),
                    previous,
                    cancellationToken)
                .ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        // Marshal back before the generation check. Testing and assigning on a thread-pool continuation let a
        // newer read that completed in between lose to this older one, which is why every sibling load path in
        // this file re-checks inside InvokeAsync.
        await InvokeAsync(() =>
        {
            if (CanApply(generation, tenantId))
            {
                _snapshot = snapshot;
            }
        }).ConfigureAwait(false);
    }

    private Task RefreshTenantReadsAsync()
        => RefreshTenantReadsAsync(TenantId);

    private async Task RefreshTenantReadsAsync(string tenantId)
    {
        if (!string.Equals(TenantId, tenantId, StringComparison.Ordinal))
        {
            return;
        }

        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        TenantDetailSnapshot retainedDetail = _snapshot;
        TenantUsersSnapshot retainedMembers = _tenantUsersSnapshot;
        _tenantUsersSnapshot = TenantUsersSnapshot.Refreshing(retainedMembers);
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        Task<TenantDetailSnapshot> detailTask = QueryGateway
            .GetTenantAsync(
                new TenantDetailRequest(tenantId, retainedDetail.ETag),
                retainedDetail,
                cancellationToken);
        Task<TenantUsersSnapshot> membersTask = QueryGateway
            .GetTenantUsersAsync(
                new TenantUsersRequest(tenantId, _memberCursor, ETag: retainedMembers.ETag),
                retainedMembers,
                cancellationToken);
        try
        {
            await Task.WhenAll(detailTask, membersTask).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (!CanApply(generation, tenantId))
        {
            return;
        }

        TenantDetailSnapshot detail = await detailTask.ConfigureAwait(false);
        TenantUsersSnapshot members = await membersTask.ConfigureAwait(false);
        bool resetMemberPaging = false;
        if (members.Reason is TenantUsersReason.InvalidCursor)
        {
            TenantUsersSnapshot recovered;
            try
            {
                recovered = await QueryGateway
                    .GetTenantUsersAsync(new TenantUsersRequest(tenantId), retainedMembers, cancellationToken)
                    .ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            if (IsUsableMemberPage(recovered, requestedCursor: null))
            {
                members = recovered with
                {
                    PagingRecovered = true,
                    Reason = TenantUsersReason.ListRefreshed,
                };
                resetMemberPaging = true;
            }
            else if (IsTerminalMemberPage(recovered))
            {
                members = recovered;
                resetMemberPaging = true;
            }
            else
            {
                members = TenantUsersSnapshot.Degraded(tenantId, retainedMembers, recovered.Reason);
            }
        }
        else if (members.PagingRecovered && IsUsableMemberPage(members, requestedCursor: null))
        {
            // The gateway already recovered this read to page one, so the retained cursor and history no
            // longer describe what is on screen. Without this the refresh kept re-sending the dead cursor.
            //
            // The usability clause keeps this branch from preempting the retention branch below. The gateway
            // now stamps PagingRecovered only on a page that actually arrived, so the two can no longer
            // disagree -- but when they did, a recovery that mapped to zero-row Error or Degraded matched
            // here first, discarded the operator's last-confirmed rows and cleared their cursor history on a
            // read that had failed, while rendering the "restarted at the first page" notice over it.
            resetMemberPaging = true;
        }
        else if (!IsUsableMemberPage(members, _memberCursor) && !IsTerminalMemberPage(members))
        {
            // Symmetric with LoadMemberPageAsync. A terminal result (unauthorized, not-found, invalid) must
            // replace the retained rows so a refresh cannot keep showing membership the caller may no longer
            // be allowed to see; an operational failure must not blank a surface that was serving confirmed
            // rows a moment ago. Previously every non-usable result was applied verbatim on this path.
            members = TenantUsersSnapshot.Degraded(tenantId, retainedMembers, members.Reason);
        }

        await InvokeAsync(() =>
        {
            if (!CanApply(generation, tenantId))
            {
                return;
            }

            _snapshot = detail;
            _tenantUsersSnapshot = members;
            if (resetMemberPaging)
            {
                _memberCursor = null;
                _memberCursorHistory.Clear();
                _memberPagingHistoryTruncated = false;
                _memberPagingJumpedToFirstPage = false;
            }

            StateHasChanged();
        }).ConfigureAwait(false);
    }

    private async Task LoadNextMemberPageAsync()
    {
        if (_memberPageLoadInFlight
            || !_tenantUsersSnapshot.HasMore
            || string.IsNullOrWhiteSpace(_tenantUsersSnapshot.NextCursor))
        {
            return;
        }

        await LoadMemberPageAsync(_tenantUsersSnapshot.NextCursor, moveForward: true).ConfigureAwait(false);
    }

    private async Task LoadPreviousMemberPageAsync()
    {
        if (_memberPageLoadInFlight || _memberCursorHistory.Count == 0)
        {
            return;
        }

        await LoadMemberPageAsync(_memberCursorHistory.Peek(), moveForward: false).ConfigureAwait(false);
    }

    /// <summary>Disposes an optional refresh lease without surfacing transport detail.</summary>
    private static async Task DisposeLeaseSupportSafelyAsync(IAsyncDisposable lease)
    {
        try
        {
            await lease.DisposeAsync().ConfigureAwait(false);
        }
        catch
        {
            // Lease cleanup must never disclose transport details or block fail-closed rendering.
        }
    }

    private async Task LoadMemberPageAsync(string? requestedCursor, bool moveForward)
    {
        string tenantId = TenantId;
        string? priorCursor = _memberCursor;
        using PendingOperation operation = BeginLoad();
        long generation = operation.Generation;
        CancellationToken cancellationToken = operation.CancellationToken;
        _memberPageLoadInFlight = true;
        TenantUsersSnapshot retained = _tenantUsersSnapshot;
        _tenantUsersSnapshot = TenantUsersSnapshot.Refreshing(retained);
        try
        {
            TenantUsersSnapshot snapshot = await QueryGateway
                .GetTenantUsersAsync(
                    // `retained` is passed so the gateway sees the prior page, but note it does NOT reach the
                    // gateway's conditional-read retention on a paging request: HasMatchingTenantUsers gates
                    // on MatchesPageScope, which compares the retained page's cursor to the requested one and
                    // is therefore false by construction whenever the cursor moves. Gateway retention applies
                    // to same-scope refreshes; the explicit retention below is what covers paging.
                    new TenantUsersRequest(tenantId, requestedCursor),
                    retained,
                    cancellationToken)
                .ConfigureAwait(false);

            if (!CanApply(generation, tenantId))
            {
                return;
            }

            // An explicitly signalled invalid cursor restarts at page one honestly instead of stranding the
            // table on an Invalid surface with no way back.
            if (snapshot.Reason is TenantUsersReason.InvalidCursor)
            {
                TenantUsersSnapshot recovered = await QueryGateway
                    .GetTenantUsersAsync(new TenantUsersRequest(tenantId), retained, cancellationToken)
                    .ConfigureAwait(false);

                // The recovery read gets the same usability guard as the primary read. Assigning it
                // unconditionally meant a transient failure on page one emptied the table *after* the history
                // had already been cleared, leaving neither rows nor a Previous control.
                await InvokeAsync(() =>
                {
                    if (!CanApply(generation, tenantId))
                    {
                        return;
                    }

                    if (IsUsableMemberPage(recovered, requestedCursor: null))
                    {
                        _memberCursor = null;
                        _memberCursorHistory.Clear();
                        _memberPagingHistoryTruncated = false;
                        _memberPagingJumpedToFirstPage = false;
                        _tenantUsersSnapshot = recovered with
                        {
                            PagingRecovered = true,
                            Reason = TenantUsersReason.ListRefreshed,
                        };
                    }
                    else if (IsTerminalMemberPage(recovered))
                    {
                        _memberCursor = null;
                        _memberCursorHistory.Clear();
                        _memberPagingHistoryTruncated = false;
                        _memberPagingJumpedToFirstPage = false;
                        _tenantUsersSnapshot = recovered;
                    }
                    else
                    {
                        _tenantUsersSnapshot = TenantUsersSnapshot.Degraded(tenantId, retained, recovered.Reason);
                    }
                }).ConfigureAwait(false);

                return;
            }

            // Marshalled and re-checked inside InvokeAsync. These writes previously ran on the thread-pool
            // continuation after a single CanApply check, so a superseded member page could overwrite newer
            // rows and mutate _memberCursorHistory while the renderer was reading its Count for CanGoPrevious.
            await InvokeAsync(() =>
            {
                if (!CanApply(generation, tenantId))
                {
                    return;
                }

                // Any non-usable page must leave paging state untouched. Advancing the cursor and pushing
                // history on Unauthorized/NotFound/Invalid built a history out of failed reads, so Previous
                // then walked back through pages that never rendered.
                if (IsTerminalMemberPage(snapshot))
                {
                    _tenantUsersSnapshot = snapshot;
                    return;
                }

                if (!IsUsableMemberPage(snapshot, requestedCursor))
                {
                    _tenantUsersSnapshot = TenantUsersSnapshot.Degraded(
                        tenantId,
                        retained,
                        snapshot.Reason);
                    return;
                }

                _tenantUsersSnapshot = snapshot;

                // A gateway-side page-one recovery answers page one, not the cursor that was requested, so
                // the requested cursor must never be committed. Doing so stored an expired cursor as the
                // current page, pushed a history entry that made Previous available on a page-one view, and
                // re-sent the dead cursor on every later refresh. The gateway does not surface an
                // InvalidCursor reason in this case -- it already recovered -- so PagingRecovered is the
                // only signal, and it is also what renders the recovery notice.
                if (snapshot.PagingRecovered)
                {
                    _memberCursor = null;
                    _memberCursorHistory.Clear();
                    _memberPagingHistoryTruncated = false;
                    _memberPagingJumpedToFirstPage = false;
                    return;
                }

                _memberCursor = requestedCursor;
                if (moveForward)
                {
                    _memberCursorHistory.Push(priorCursor);

                    // Bound the history so a long paging session cannot grow it without limit. Trim's return
                    // value is the signal that the first-page sentinel was re-appended; discarding it left the
                    // member pager unable to announce the jump its two siblings announce.
                    _memberPagingHistoryTruncated |= CursorHistory.Trim(_memberCursorHistory, MaximumMemberCursorHistory);
                    _memberPagingJumpedToFirstPage = false;
                }
                else if (_memberCursorHistory.Count > 0)
                {
                    _ = _memberCursorHistory.Pop();

                    // A trimmed history re-appends the first-page sentinel under the newest entries, so one
                    // Previous click walks the operator from the middle of the sequence straight to page one.
                    _memberPagingJumpedToFirstPage = _memberPagingHistoryTruncated
                        && _memberCursor is null
                        && _memberCursorHistory.Count == 0;
                    if (_memberPagingJumpedToFirstPage)
                    {
                        _memberPagingHistoryTruncated = false;
                    }
                }
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer load owns the surface.
        }
        finally
        {
            if (generation == _loadGeneration)
            {
                _memberPageLoadInFlight = false;
            }
        }
    }

    private CancellationTokenSource ReplaceActiveCancellation()
    {
        var source = new CancellationTokenSource();
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = source;
        }

        return source;
    }

    private void CancelActiveCancellation()
    {
        lock (_cancellationLock)
        {
            RetireCancellationCore(_loadCancellation);
            _loadCancellation = null;
        }
    }

    private void RetireCancellationCore(CancellationTokenSource? source)
    {
        if (source is null)
        {
            return;
        }

        source.Cancel();
    }

    private void CompleteCancellation(CancellationTokenSource source)
    {
        lock (_cancellationLock)
        {
            if (ReferenceEquals(_loadCancellation, source))
            {
                _loadCancellation = null;
            }
        }

        source.Dispose();
    }

    /// <summary>A page whose rows and paging state may be applied.</summary>
    /// <remarks>
    /// <see cref="TenantUsersSurfaceKind.Unknown"/> is a successful read whose projection freshness could
    /// not be resolved, not a failure. Omitting it sent every such page down the degraded-retention path,
    /// which re-presented the previous page's rows and cursor while leaving Next enabled -- so the operator
    /// could never leave page one and was told the evidence was degraded on a read that succeeded. Every
    /// sibling predicate (IsRetainableTenantUsers, IsUsableGlobalAdministratorsPage, CanOpenMemberAudit,
    /// IsAppliedRequestedPage) admits it.
    /// </remarks>
    private static bool IsUsableMemberPage(TenantUsersSnapshot snapshot, string? requestedCursor)
        => (snapshot.Kind is TenantUsersSurfaceKind.Ready
            or TenantUsersSurfaceKind.Empty
            or TenantUsersSurfaceKind.Stale
            or TenantUsersSurfaceKind.Unknown)
            || (snapshot.Kind is TenantUsersSurfaceKind.Degraded
                && string.Equals(snapshot.RequestCursor, requestedCursor, StringComparison.Ordinal));

    /// <summary>A terminal response that must replace retained rows to avoid disclosure.</summary>
    private static bool IsTerminalMemberPage(TenantUsersSnapshot snapshot)
        => snapshot.Kind is TenantUsersSurfaceKind.Unauthorized
            or TenantUsersSurfaceKind.NotFound
            or TenantUsersSurfaceKind.Invalid;


    private PendingOperation BeginLoad()
    {
        long generation = Interlocked.Increment(ref _loadGeneration);
        CancellationTokenSource source = ReplaceActiveCancellation();
        _memberPageLoadInFlight = false;
        if (_tenantUsersSnapshot.IsRefreshing)
        {
            _tenantUsersSnapshot = _tenantUsersSnapshot with { IsRefreshing = false };
        }

        return new(generation, source, () => CompleteCancellation(source));
    }

    // Volatile.Read matches the two sibling pages: this guard is read from thread-pool continuations and is
    // the sole defence against a superseded completion overwriting newer member rows.
    private bool CanApply(long generation, string tenantId)
        => !_disposed
            && generation == Volatile.Read(ref _loadGeneration)
            && string.Equals(TenantId, tenantId, StringComparison.Ordinal);

