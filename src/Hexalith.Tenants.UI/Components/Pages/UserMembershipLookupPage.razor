@page "/tenants/users"
@using Hexalith.Tenants.UI.Components.Users
@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantQueryGateway QueryGateway
@inject NavigationManager Navigation

<PageTitle>@Localizer["Tenants.UserLookup.Title"]</PageTitle>

<main class="user-lookup-page" data-testid="tenants-user-lookup">
    <header class="user-lookup-page__header">
        <p class="user-lookup-page__eyebrow">@Localizer["Tenants.Workspace.Eyebrow"]</p>
        <h1>@Localizer["Tenants.UserLookup.Title"]</h1>
        <p>@Localizer["Tenants.UserLookup.Description"]</p>
    </header>

    <FluentAccordion Class="user-lookup-page__sections"
                     ExpandMode="AccordionExpandMode.Multi"
                     Block="true">
        <FluentAccordionItem Header="@Localizer["Tenants.UserLookup.FormLabel"]"
                             Expanded="true">
            <form class="user-lookup-page__form"
                  aria-label="@Localizer["Tenants.UserLookup.FormLabel"]"
                  @onsubmit="SubmitAsync"
                  @onsubmit:preventDefault="true">
                <div class="user-lookup-page__field">
                    <FluentTextInput @ref="_inputElement"
                                     Required="true"
                                     Label="@Localizer["Tenants.UserLookup.InputLabel"]"
                                     Value="@_inputUserId"
                                     data-testid="tenants-user-lookup-input"
                                     aria-describedby="tenants-user-lookup-help"
                                     ValueChanged="OnInputChanged" />
                </div>
                <p id="tenants-user-lookup-help">@Localizer["Tenants.UserLookup.InputHelp"]</p>
                <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" data-testid="tenants-user-lookup-submit">
                    @Localizer["Tenants.UserLookup.Submit"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-user-lookup-clear" OnClick="ClearAsync">
                    @Localizer["Tenants.UserLookup.Clear"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-user-lookup-refresh" Disabled="@(!CanRefresh)" OnClick="RefreshAsync">
                    @Localizer["Tenants.UserLookup.Refresh"]
                </FluentButton>
                <a href="/tenants" data-testid="tenants-user-lookup-back">@Localizer["Tenants.UserLookup.Back"]</a>
            </form>
        </FluentAccordionItem>

        <FluentAccordionItem Header="@StatusHeading"
                             Expanded="true">
            <section class="user-lookup-page__status"
                     aria-live="@StatusLive"
                     role="@StatusRole">
                <h2 id="tenants-user-lookup-status-heading"
                    tabindex="-1"
                    @ref="_statusElement"
                    data-testid="tenants-user-lookup-status">
                    @StatusHeading
                </h2>
                <p>@StatusMessage</p>
                @if (!string.IsNullOrEmpty(_targetUserId))
                {
                    <p data-testid="tenants-user-lookup-target">
                        @Localizer["Tenants.UserLookup.TargetContext", _targetUserId]
                    </p>
                }
            </section>
        </FluentAccordionItem>

        @if (_snapshot is not null)
        {
            <FluentAccordionItem Header="@ResultsHeading"
                                 Expanded="true">
                @if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Loading)
                {
                    <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Loading"
                                    ResourcePrefix="Tenants.UserLookup"
                                    SelectorPrefix="tenants-user" />
                }
                else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Empty)
                {
                    <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Empty"
                                    ResourcePrefix="Tenants.UserLookup"
                                    SelectorPrefix="tenants-user" />
                }
                else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Invalid)
                {
                    <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Invalid"
                                    ResourcePrefix="Tenants.UserLookup"
                                    SelectorPrefix="tenants-user" />
                }
                else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Unauthorized)
                {
                    <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Unauthorized"
                                    ResourcePrefix="Tenants.UserLookup"
                                    SelectorPrefix="tenants-user" />
                }
                else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Unavailable)
                {
                    <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Unavailable"
                                    ResourcePrefix="Tenants.UserLookup"
                                    SelectorPrefix="tenants-user" />
                }
                else
                {
                    @if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Stale)
                    {
                        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Stale"
                                        ResourcePrefix="Tenants.UserLookup"
                                        SelectorPrefix="tenants-user"
                                        OnRefresh="RefreshAsync" />
                    }
                    else if (_snapshot.Kind is UserTenantMembershipSurfaceKind.Degraded)
                    {
                        <MyTenantsState Kind="UserTenantMembershipSurfaceKind.Degraded"
                                        ResourcePrefix="Tenants.UserLookup"
                                        SelectorPrefix="tenants-user"
                                        OnRefresh="RefreshAsync" />
                    }

                    <section class="user-lookup-page__results"
                             aria-labelledby="tenants-user-lookup-status-heading"
                             data-testid="tenants-user-lookup-results">
                        <div class="user-lookup-page__sort">
                            <FluentSelect TOption="string" TValue="string"
                                          Label="@Localizer["Tenants.UserLookup.SortLabel"]"
                                          Value="@_sortColumn"
                                          ValueChanged="OnSortChanged"
                                          data-testid="tenants-user-lookup-sort">
                                <FluentOption TValue="string" Value="@("tenant")">@Localizer["Tenants.UserLookup.Sort.Tenant"]</FluentOption>
                                <FluentOption TValue="string" Value="@("name")">@Localizer["Tenants.UserLookup.Sort.Name"]</FluentOption>
                                <FluentOption TValue="string" Value="@("role")">@Localizer["Tenants.UserLookup.Sort.Role"]</FluentOption>
                                <FluentOption TValue="string" Value="@("status")">@Localizer["Tenants.UserLookup.Sort.Status"]</FluentOption>
                            </FluentSelect>
                        </div>

                        <MyTenantsDataGrid Rows="@VisibleRows"
                                           ResourcePrefix="Tenants.UserLookup"
                                           SelectorPrefix="tenants-user"
                                           TargetUserId="@_targetUserId"
                                           SourceKind="user-lookup"
                                           ReturnUrl="@UserLookupReturnUrl" />

                        <nav class="user-lookup-page__pager" aria-label="@Localizer["Tenants.UserLookup.PaginationLabel"]">
                            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-user-lookup-previous" Disabled="@(_cursorHistory.Count == 0)" OnClick="PreviousPageAsync">
                                @Localizer["Tenants.UserLookup.Previous"]
                            </FluentButton>
                            <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-user-lookup-next" Disabled="@(!_snapshot.HasMore)" OnClick="NextPageAsync">
                                @Localizer["Tenants.UserLookup.Next"]
                            </FluentButton>
                        </nav>
                    </section>
                }
            </FluentAccordionItem>
        }
    </FluentAccordion>
</main>

@code {
    private const int PageSize = 20;
    private UserTenantMembershipSnapshot? _snapshot;
    private readonly Stack<string?> _cursorHistory = new();
    private string? _currentCursor;
    private string _inputUserId = string.Empty;
    private string? _targetUserId;
    private string _sortColumn = "tenant";
    private FluentTextInput _inputElement = default!;
    private ElementReference _statusElement;
    private bool _focusStatusPending;
    private bool _focusInputPending;
    private string _announcement = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "userId")]
    public string? QueryUserId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? QuerySort { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "cursor")]
    public string? QueryCursor { get; set; }

    private bool CanRefresh
        => !string.IsNullOrEmpty(_targetUserId) && _snapshot is not null;

    private IReadOnlyList<UserTenantMembershipRow> VisibleRows
        => _snapshot?.Rows.OrderBy(row => _sortColumn switch
        {
            "name" => row.Name,
            "role" => row.Role.ToString(),
            "status" => row.Status.ToString(),
            _ => row.TenantId,
        }, StringComparer.Ordinal).ToArray() ?? [];

    private string StatusHeading
        => _snapshot?.Kind switch
        {
            UserTenantMembershipSurfaceKind.Ready => Localizer["Tenants.UserLookup.State.Ready.Title"],
            UserTenantMembershipSurfaceKind.Empty => Localizer["Tenants.UserLookup.State.Empty.Title"],
            UserTenantMembershipSurfaceKind.Loading => Localizer["Tenants.UserLookup.State.Loading.Title"],
            UserTenantMembershipSurfaceKind.Invalid => Localizer["Tenants.UserLookup.State.Invalid.Title"],
            UserTenantMembershipSurfaceKind.Stale => Localizer["Tenants.UserLookup.State.Stale.Title"],
            UserTenantMembershipSurfaceKind.Degraded => Localizer["Tenants.UserLookup.State.Degraded.Title"],
            UserTenantMembershipSurfaceKind.Unauthorized => Localizer["Tenants.UserLookup.State.Unauthorized.Title"],
            UserTenantMembershipSurfaceKind.Unavailable => Localizer["Tenants.UserLookup.State.Unavailable.Title"],
            _ => Localizer["Tenants.UserLookup.Initial.Title"],
        };

    private string StatusMessage
        => string.IsNullOrWhiteSpace(_announcement)
            ? Localizer["Tenants.UserLookup.Initial.Message"]
            : _announcement;

    private string StatusRole
        => _snapshot?.Kind is UserTenantMembershipSurfaceKind.Invalid
            or UserTenantMembershipSurfaceKind.Unauthorized
            or UserTenantMembershipSurfaceKind.Unavailable
            or UserTenantMembershipSurfaceKind.Degraded
                ? "alert"
                : "status";

    private string StatusLive
        => StatusRole == "alert" ? "assertive" : "polite";

    private string ResultsHeading
        => _snapshot?.Kind switch
        {
            UserTenantMembershipSurfaceKind.Loading => Localizer["Tenants.UserLookup.State.Loading.Title"],
            UserTenantMembershipSurfaceKind.Empty => Localizer["Tenants.UserLookup.State.Empty.Title"],
            UserTenantMembershipSurfaceKind.Invalid => Localizer["Tenants.UserLookup.State.Invalid.Title"],
            UserTenantMembershipSurfaceKind.Stale => Localizer["Tenants.UserLookup.State.Stale.Title"],
            UserTenantMembershipSurfaceKind.Degraded => Localizer["Tenants.UserLookup.State.Degraded.Title"],
            UserTenantMembershipSurfaceKind.Unauthorized => Localizer["Tenants.UserLookup.State.Unauthorized.Title"],
            UserTenantMembershipSurfaceKind.Unavailable => Localizer["Tenants.UserLookup.State.Unavailable.Title"],
            _ => Localizer["Tenants.UserLookup.State.Ready.Title"],
        };

    private string UserLookupReturnUrl
    {
        get
        {
            string userId = Uri.EscapeDataString(_targetUserId ?? _inputUserId);
            string sort = Uri.EscapeDataString(_sortColumn);
            string cursor = string.IsNullOrWhiteSpace(_currentCursor) ? string.Empty : $"&cursor={Uri.EscapeDataString(_currentCursor)}";
            return $"/tenants/users?userId={userId}&sort={sort}{cursor}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(QueryUserId))
        {
            _inputUserId = QueryUserId;
            _sortColumn = string.IsNullOrWhiteSpace(QuerySort) ? _sortColumn : QuerySort;
            _currentCursor = QueryCursor;
            await RunLookupAsync(QueryUserId, reuseETag: false).ConfigureAwait(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStatusPending)
        {
            _focusStatusPending = false;
            await _statusElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusInputPending)
        {
            _focusInputPending = false;
            await _inputElement.Element.FocusAsync().ConfigureAwait(false);
        }
    }

    private void OnInputChanged(string? value)
        => _inputUserId = value ?? string.Empty;

    private async Task SubmitAsync()
    {
        _currentCursor = null;
        _cursorHistory.Clear();
        await RunLookupAsync(_inputUserId, reuseETag: false).ConfigureAwait(false);
    }

    private async Task RefreshAsync()
    {
        if (!string.IsNullOrEmpty(_targetUserId))
        {
            await RunLookupAsync(_targetUserId, reuseETag: true).ConfigureAwait(false);
        }
    }

    private async Task ClearAsync()
    {
        _inputUserId = string.Empty;
        _targetUserId = null;
        _snapshot = null;
        _currentCursor = null;
        _cursorHistory.Clear();
        _announcement = Localizer["Tenants.UserLookup.Announcement.Cleared"];
        _focusInputPending = true;

        await Task.CompletedTask.ConfigureAwait(false);
    }

    private async Task NextPageAsync()
    {
        if (_snapshot is null)
        {
            return;
        }

        _cursorHistory.Push(_currentCursor);
        _currentCursor = _snapshot.NextCursor;
        await RunLookupAsync(_targetUserId, reuseETag: false).ConfigureAwait(false);
    }

    private async Task PreviousPageAsync()
    {
        if (_cursorHistory.Count > 0)
        {
            _currentCursor = _cursorHistory.Pop();
            await RunLookupAsync(_targetUserId, reuseETag: false).ConfigureAwait(false);
        }
    }

    private void OnSortChanged(string? value)
    {
        _sortColumn = value ?? "tenant";
        _announcement = Localizer["Tenants.UserLookup.Announcement.Sorted"];
    }

    private async Task RunLookupAsync(string? targetUserId, bool reuseETag)
    {
        if (!IsValidUserId(targetUserId))
        {
            _targetUserId = targetUserId;
            _snapshot = UserTenantMembershipSnapshot.Invalid(
                string.IsNullOrWhiteSpace(targetUserId)
                    ? UserTenantMembershipReason.MissingTargetUser
                    : UserTenantMembershipReason.InvalidTargetUser,
                targetUserId);
            _announcement = Localizer["Tenants.UserLookup.Announcement.Invalid"];
            _focusStatusPending = true;
            return;
        }

        string validTargetUserId = targetUserId!;
        UserTenantMembershipSnapshot? previous = _snapshot;
        _targetUserId = validTargetUserId;
        _snapshot = UserTenantMembershipSnapshot.Loading() with
        {
            TargetUserId = validTargetUserId,
        };
        _announcement = Localizer["Tenants.UserLookup.Announcement.Loading", validTargetUserId];

        UserTenantMembershipRequest request = new(
            TargetUserId: validTargetUserId,
            Cursor: _currentCursor,
            PageSize: PageSize,
            ETag: reuseETag ? previous?.ETag : null);

        _snapshot = await QueryGateway
            .GetUserTenantsAsync(request, previous, CancellationToken.None)
            .ConfigureAwait(false);
        _announcement = AnnouncementFor(_snapshot, validTargetUserId);
        _focusStatusPending = true;
        Navigation.NavigateTo(UserLookupReturnUrl, replace: true);
    }

    private string AnnouncementFor(UserTenantMembershipSnapshot snapshot, string targetUserId)
        => snapshot.Kind switch
        {
            UserTenantMembershipSurfaceKind.Ready => Localizer["Tenants.UserLookup.Announcement.Ready", snapshot.Rows.Count, targetUserId],
            UserTenantMembershipSurfaceKind.Empty => Localizer["Tenants.UserLookup.Announcement.Empty", targetUserId],
            UserTenantMembershipSurfaceKind.Stale => Localizer["Tenants.UserLookup.Announcement.Stale", targetUserId],
            UserTenantMembershipSurfaceKind.Degraded => Localizer["Tenants.UserLookup.Announcement.Degraded", targetUserId],
            UserTenantMembershipSurfaceKind.Unauthorized => Localizer["Tenants.UserLookup.Announcement.Unauthorized", targetUserId],
            UserTenantMembershipSurfaceKind.Unavailable => Localizer["Tenants.UserLookup.Announcement.Unavailable", targetUserId],
            UserTenantMembershipSurfaceKind.Invalid => Localizer["Tenants.UserLookup.Announcement.Invalid"],
            _ => Localizer["Tenants.UserLookup.Announcement.Loading", targetUserId],
        };

    private static bool IsValidUserId(string? userId)
        => !string.IsNullOrWhiteSpace(userId)
            && userId.Length <= 256
            && !userId.Any(char.IsControl);
}
