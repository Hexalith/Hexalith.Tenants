@page "/tenants/my"
@implements IDisposable
@using Hexalith.Tenants.UI.Components.Users
@using Microsoft.JSInterop
@inject IStringLocalizer<TenantsResources> Localizer
@inject IJSRuntime JS

<FcPageLayout Mode="FcPageLayoutMode.FullWidth">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="20px">
        <FcPageHeader PageTitle="@Localizer["Tenants.MyTenants.Title"]"
                      Heading="@Localizer["Tenants.MyTenants.Title"]"
                      HeadingId="tenants-my-heading"
                      HeadingTabIndex="-1"
                      Eyebrow="@Localizer["Tenants.Workspace.Eyebrow"]"
                      Description="@Localizer["Tenants.MyTenants.Description"]"
                      TestId="tenants-my-page-header" />
        @if (_missingOrigin)
        {
            <p role="status" data-testid="tenants-audit-return-notice">@Localizer["Tenants.Audit.Return.MissingOrigin"]</p>
        }
        @if (_stalledOrigin)
        {
            <p role="status" data-testid="tenants-audit-stalled-return">@Localizer["Tenants.Audit.Return.Stalled"]</p>
        }
        @if (_partialReturn)
        {
            <p role="status" data-testid="tenants-audit-partial-return">@Localizer["Tenants.Audit.Return.Partial"]</p>
        }

        <AuditReadAuthorityBoundary @ref="_auditAuthority" Context="auditAuthority">
            <span hidden data-audit-focus-page-terminal="@auditAuthority.IsResolved"
                  data-audit-focus-heading="tenants-my-heading"
                  data-audit-focus-active-origin="tenants-my-page"></span>
            <MyTenantsPanel ShowBackLink="true"
                            BackHref="/tenants?tab=tenants&amp;scope=mine"
                            InitialCursor="@QueryCursor"
                            AuditReadAvailable="@auditAuthority.IsAvailable"
                            AuditReadDenied="@auditAuthority.IsDenied"
                            AuditReadResolved="@auditAuthority.IsResolved"
                            OnAuditRefresh="@RefreshAuditAuthorityAsync" />
        </AuditReadAuthorityBoundary>
    </FluentStack>
</FcPageLayout>

@code {
    private AuditReadAuthorityBoundary? _auditAuthority;
    private string? _pendingFocus;
    private string? _handledFocus;
    private string? _pendingDetailFocus;
    private string? _handledDetailFocus;
    private bool _missingOrigin;
    private bool _stalledOrigin;
    private bool _partialReturn;
    private bool _consumedFocuslessReturn;
    private bool _disposed;

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditFocus")]
    public string? AuditFocus { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "auditPartialReturn")]
    public bool AuditPartialReturn { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "anchor")]
    public string? QueryAnchor { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "cursor")]
    public string? QueryCursor { get; set; }

    protected override void OnParametersSet()
    {
        if (AuditFocus is null || !TenantAuditNavigationSafety.IsSafeFocus(AuditFocus))
        {
            _pendingFocus = null;
            _handledFocus = null;
            _missingOrigin = false;
            _stalledOrigin = false;
            _partialReturn = AuditPartialReturn;
            if (!AuditPartialReturn)
            {
                _consumedFocuslessReturn = false;
            }
        }
        else if (AuditFocus is { } focus && TenantAuditNavigationSafety.IsSafeFocus(focus)
            && !string.Equals(_handledFocus, focus, StringComparison.Ordinal))
        {
            _pendingFocus = focus;
            _handledFocus = focus;
            _missingOrigin = false;
            _stalledOrigin = false;
            _partialReturn = AuditPartialReturn;
        }

        if (QueryAnchor is { } anchor && anchor.StartsWith("tenants-my-detail-", StringComparison.Ordinal)
            && TenantAuditNavigationSafety.IsSafeFocus(anchor)
            && !string.Equals(_handledDetailFocus, anchor, StringComparison.Ordinal))
        {
            _pendingDetailFocus = anchor;
            _handledDetailFocus = anchor;
        }
        else if (QueryAnchor is null)
        {
            _pendingDetailFocus = null;
            _handledDetailFocus = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingDetailFocus is { } detailFocus)
        {
            _pendingDetailFocus = null;
            try
            {
                await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
                string? outcome = await module.InvokeAsync<string>("restoreDetailFocus", detailFocus, "tenants-my-page", "tenants-my-heading");
                if (outcome != "cancelled" && string.Equals(QueryAnchor, detailFocus, StringComparison.Ordinal))
                {
                    await module.InvokeVoidAsync("consumeReturnMarkers", detailFocus, null, true);
                    QueryAnchor = null;
                }
                if (outcome is "missing" or "stalled" && string.Equals(_handledDetailFocus, detailFocus, StringComparison.Ordinal))
                {
                    await InvokeAsync(() => { _missingOrigin = outcome == "missing"; _stalledOrigin = outcome == "stalled"; StateHasChanged(); });
                }
            }
            catch (JSDisconnectedException)
            {
                // The circuit ended before return focus could be restored.
            }
            catch (Exception exception) when (exception is JSException or TaskCanceledException)
            {
                if (!_disposed && string.Equals(QueryAnchor, detailFocus, StringComparison.Ordinal))
                {
                    await InvokeAsync(() => { _missingOrigin = true; _stalledOrigin = false; StateHasChanged(); });
                }
            }
        }

        if (_pendingFocus is not { } focus)
        {
            if (_partialReturn && AuditFocus is null && !_consumedFocuslessReturn)
            {
                _consumedFocuslessReturn = true;
                try
                {
                    await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
                    await module.InvokeVoidAsync("consumeReturnMarkers");
                    AuditPartialReturn = false;
                }
                catch (JSDisconnectedException)
                {
                    // The circuit ended before the URL marker could be consumed.
                }
                catch (Exception exception) when (exception is JSException or TaskCanceledException)
                {
                    // Keep the visible partial-return notice when browser cleanup is unavailable.
                }
            }
            return;
        }

        _pendingFocus = null;
        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/tenantsFocus.js");
            string? outcome = await module.InvokeAsync<string>("restoreAuditFocus", focus, "tenants-my-page", "tenants-my-heading");
            if (outcome != "cancelled" && string.Equals(AuditFocus, focus, StringComparison.Ordinal))
            {
                await module.InvokeVoidAsync("consumeReturnMarkers", focus);
                AuditFocus = null;
                AuditPartialReturn = false;
            }
            if (outcome is "missing" or "stalled" && string.Equals(_handledFocus, focus, StringComparison.Ordinal))
            {
                _missingOrigin = outcome == "missing";
                _stalledOrigin = outcome == "stalled";
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit ended before focus restoration.
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            if (!_disposed && string.Equals(AuditFocus, focus, StringComparison.Ordinal))
            {
                await InvokeAsync(() => { _missingOrigin = true; _stalledOrigin = false; StateHasChanged(); });
            }
        }
    }

    private Task RefreshAuditAuthorityAsync()
        => _auditAuthority?.RefreshAsync() ?? Task.CompletedTask;

    public void Dispose() => _disposed = true;
}
