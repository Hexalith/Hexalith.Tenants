@inject IStringLocalizer<TenantsResources> Localizer
@inject ITenantsBffComposition BffComposition

<nav class="operations-shell-nav"
     aria-label="@Localizer["Tenants.Navigation.AriaLabel"]"
     data-testid="tenants-primary-nav">
    <a class="operations-shell-nav__item"
       href="/tenants"
       data-testid="tenants-nav-tenants">@Localizer["Tenants.Navigation.Tenants"]</a>
    @if (CanShowGlobalAdministrators)
    {
        <a class="operations-shell-nav__item"
           href="/global-administrators"
           data-testid="tenants-global-admins-nav">@Localizer["Tenants.Navigation.GlobalAdministrators"]</a>
    }
    <span class="operations-shell-nav__item operations-shell-nav__item--unavailable"
          role="link"
          aria-disabled="true"
          tabindex="0"
          data-testid="tenants-nav-audit">
        <span>@Localizer["Tenants.Navigation.Audit"]</span>
        <span class="operations-shell-nav__state" aria-hidden="true">!</span>
        <span class="operations-shell-nav__reason">@Localizer["Tenants.Navigation.AuditUnavailable"]</span>
    </span>
</nav>

@code {
    private bool CanShowGlobalAdministrators
        => BffComposition.GlobalAdministratorsAuthorizationReflection is TenantLifecycleAuthorizationReflectionState.Authorized;
}
