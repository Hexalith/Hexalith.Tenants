@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State.TenantCommands
@inject IStringLocalizer<TenantsResources> Localizer

<section class="tenant-lifecycle"
         aria-labelledby="tenants-lifecycle-heading"
         data-testid="tenants-lifecycle-actions">
    <header class="tenant-lifecycle__header">
        <div>
            <h2 id="tenants-lifecycle-heading">@Localizer["Tenants.Lifecycle.Title"]</h2>
            <p>@Localizer["Tenants.Lifecycle.Description", TenantId]</p>
        </div>
        <dl class="tenant-lifecycle__facts" aria-label="@Localizer["Tenants.Lifecycle.FactsLabel"]">
            <div data-testid="tenants-lifecycle-state">
                <dt>@Localizer["Tenants.Lifecycle.StateLabel"]</dt>
                <dd>@Localizer[$"Tenants.Lifecycle.Status.{CurrentStatus}"]</dd>
            </div>
            <div data-testid="tenants-lifecycle-current-status">
                <dt>@Localizer["Tenants.Lifecycle.CurrentStatusLabel"]</dt>
                <dd>@Localizer[$"Tenants.Lifecycle.Status.{CurrentStatus}"]</dd>
            </div>
            <div data-testid="tenants-lifecycle-freshness">
                <dt>@Localizer["Tenants.Lifecycle.FreshnessLabel"]</dt>
                <dd><TruthStateBadge Freshness="@Freshness" ResourcePrefix="Tenants.Lifecycle" TestId="tenants-lifecycle-freshness-badge" /></dd>
            </div>
            <div data-testid="tenants-lifecycle-projection-lifecycle">
                <dt>@Localizer["Tenants.ProjectionLifecycle.Label"]</dt>
                <dd><ProjectionLifecycleBadge Lifecycle="@Lifecycle" TestId="tenants-lifecycle-projection-lifecycle-badge" /></dd>
            </div>
            <div data-testid="tenants-lifecycle-governance-gate">
                <dt>@Localizer["Tenants.Lifecycle.GovernanceGateLabel"]</dt>
                <dd>@Localizer[$"Tenants.Lifecycle.Governance.{GovernanceReadiness}"]</dd>
            </div>
        </dl>
    </header>

    <div class="tenant-lifecycle__announcer"
         aria-live="@LiveRegion"
         aria-atomic="true"
         data-testid="tenants-lifecycle-live-region">
        @Localizer[PrimaryAvailability.SafeMessageKey, TenantId, Localizer[$"Tenants.Lifecycle.Operation.{PrimaryAvailability.Operation}"], PrimaryAvailability.ExpectedDomainOutcomeKey ?? string.Empty]
    </div>

    <div class="tenant-lifecycle__actions" role="list">
        @foreach (TenantLifecycleAvailability availability in Availabilities)
        {
            string actionId = availability.Operation is TenantLifecycleOperation.EnableTenant
                ? "tenants-lifecycle-enable"
                : "tenants-lifecycle-disable";
            string reasonId = $"{actionId}-reason";

            <div class="tenant-lifecycle__action" role="listitem">
                @if (availability.Operation is TenantLifecycleOperation.EnableTenant)
                {
                    <span class="tenant-lifecycle__button-focus" tabindex="-1" @ref="_enableElement">
                        <FluentButton Id="@actionId"
                                      Appearance="ButtonAppearance.Primary"
                                      Class="tenant-lifecycle__button"
                                      data-testid="@actionId"
                                      Disabled="@IsActionDisabled(availability)"
                                      aria-disabled="@IsActionDisabled(availability).ToString().ToLowerInvariant()"
                                      aria-describedby="@reasonId"
                                      OnClick="() => OpenFlowAsync(availability)">
                            @Localizer[$"Tenants.Lifecycle.Operation.{availability.Operation}"]
                        </FluentButton>
                    </span>
                }
                else
                {
                    <span class="tenant-lifecycle__button-focus" tabindex="-1" @ref="_disableElement">
                        <FluentButton Id="@actionId"
                                      Appearance="ButtonAppearance.Primary"
                                      Class="tenant-lifecycle__button"
                                      data-testid="@actionId"
                                      Disabled="@IsActionDisabled(availability)"
                                      aria-disabled="@IsActionDisabled(availability).ToString().ToLowerInvariant()"
                                      aria-describedby="@reasonId"
                                      OnClick="() => OpenFlowAsync(availability)">
                            @Localizer[$"Tenants.Lifecycle.Operation.{availability.Operation}"]
                        </FluentButton>
                    </span>
                }
                <p id="@reasonId"
                   class="tenant-lifecycle__reason"
                   tabindex="0"
                   data-testid="tenants-lifecycle-unavailable-reason"
                   data-reason-category="@ReasonCategory(ReasonCategoryFor(availability))">
                    <span>@Localizer[$"Tenants.Lifecycle.UnavailableReason.{ReasonCategoryFor(availability)}"]</span>
                    <span>@ReasonText(availability)</span>
                </p>
            </div>
        }
    </div>

    @if (_activeAvailability is not null && Detail is not null)
    {
        <TenantLifecycleCommandFlow Detail="@Detail"
                                    Availability="@_activeAvailability"
                                    IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                    OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                    OnCloseRequested="@CloseFlowAsync"
                                    OnCommandActivityChanged="@OnCommandActivityChanged"
                                    ProjectionEvidenceProvider="@ProjectionEvidenceProvider" />
    }
</section>

@code {
    private TenantLifecycleAvailability? _activeAvailability;
    private ElementReference _enableElement;
    private ElementReference _disableElement;
    private TenantLifecycleOperation? _returnFocusOperation;
    private string? _activeFlowTenantId;

    [Parameter]
    public string TenantId { get; set; } = string.Empty;

    [Parameter]
    public TenantDetail? Detail { get; set; }

    [Parameter]
    public TenantStatus CurrentStatus { get; set; } = TenantStatus.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public bool IsCommandSurfaceConnected { get; set; }

    [Parameter]
    public TenantLifecycleAuthorizationReflectionState AuthorizationReflection { get; set; } = TenantLifecycleAuthorizationReflectionState.Indeterminate;

    [Parameter]
    public TenantLifecycleGovernanceReadiness GovernanceReadiness { get; set; } = TenantLifecycleGovernanceReadiness.Unresolved;

    [Parameter]
    public bool IsNarrowSafetyContext { get; set; }

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<TenantLifecycleCommandRequest, Task<TenantDetail?>>? ProjectionEvidenceProvider { get; set; }

    private TenantLifecycleAvailabilityInput Input
        => new(
            TenantId,
            CurrentStatus,
            Freshness,
            SurfaceKind,
            IsCommandSurfaceConnected,
            GovernanceReadiness,
            AuthorizationReflection,
            IsNarrowSafetyContext,
            Lifecycle);

    private IReadOnlyList<TenantLifecycleAvailability> Availabilities
        =>
        [
            Input.Evaluate(TenantLifecycleOperation.EnableTenant),
            Input.Evaluate(TenantLifecycleOperation.DisableTenant),
        ];

    private TenantLifecycleAvailability PrimaryAvailability
        => Availabilities.FirstOrDefault(static availability => availability.IsUnavailable)
            ?? Availabilities[0];

    private string LiveRegion
        => Availabilities.Any(static availability => availability.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive)
            || !IsCommandSurfaceAvailable
            ? "assertive"
            : "polite";

    private bool IsActionDisabled(TenantLifecycleAvailability availability)
        => availability.IsUnavailable || !IsCommandSurfaceAvailable;

    private TenantLifecycleUnavailableReasonCategory ReasonCategoryFor(TenantLifecycleAvailability availability)
        => !IsCommandSurfaceAvailable && !availability.IsUnavailable
            ? TenantLifecycleUnavailableReasonCategory.MissingLifecycleSupport
            : availability.UnavailableReasonCategory;

    private string ReasonText(TenantLifecycleAvailability availability)
        => !IsCommandSurfaceAvailable && !availability.IsUnavailable
            ? Localizer["Tenants.Lifecycle.Unavailable.InFlightOrCommandSurface"].Value
            : Localizer[
                availability.SafeMessageKey,
                TenantId,
                Localizer[$"Tenants.Lifecycle.Operation.{availability.Operation}"],
                availability.ExpectedDomainOutcomeKey ?? string.Empty].Value;

    private static string ReasonCategory(TenantLifecycleUnavailableReasonCategory category)
        => category.ToString();

    protected override void OnParametersSet()
    {
        if (_activeAvailability is null)
        {
            return;
        }

        // An open confirm must not retarget a different tenant when the parent remounts parameters.
        if (!string.Equals(_activeFlowTenantId, TenantId, StringComparison.Ordinal)
            || Detail is null
            || !string.Equals(Detail.TenantId, TenantId, StringComparison.Ordinal))
        {
            _activeAvailability = null;
            _activeFlowTenantId = null;
            return;
        }

        _activeAvailability = Input.Evaluate(_activeAvailability.Operation);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_returnFocusOperation is null)
        {
            return;
        }

        TenantLifecycleOperation operation = _returnFocusOperation.Value;
        _returnFocusOperation = null;
        if (operation is TenantLifecycleOperation.EnableTenant)
        {
            await _enableElement.FocusAsync().ConfigureAwait(false);
            return;
        }

        await _disableElement.FocusAsync().ConfigureAwait(false);
    }

    private async Task OpenFlowAsync(TenantLifecycleAvailability availability)
    {
        if (IsActionDisabled(availability))
        {
            return;
        }

        _activeAvailability = availability;
        _activeFlowTenantId = TenantId;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private async Task CloseFlowAsync()
    {
        _returnFocusOperation = _activeAvailability?.Operation;
        _activeAvailability = null;
        _activeFlowTenantId = null;
        await Task.CompletedTask.ConfigureAwait(false);
    }
}
