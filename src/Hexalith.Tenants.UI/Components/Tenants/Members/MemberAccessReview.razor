@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.Tenants.UI.State.TenantList
@using Hexalith.Tenants.UI.State.TenantUsers
@inject IStringLocalizer<TenantsResources> Localizer

<section class="tenant-members"
         aria-labelledby="tenants-member-heading"
         data-testid="tenants-member-section">
    <header class="tenant-members__header">
        <div>
            <h2 id="tenants-member-heading">@Localizer["Tenants.Members.Title"]</h2>
            <p>@Localizer["Tenants.Members.Description"]</p>
            <p class="tenant-members__scope">@Localizer["Tenants.Members.ScopeNotice"]</p>
        </div>
        <div class="tenant-members__truth" data-testid="tenants-member-truth-state">
            <TruthStateBadge Freshness="@Members.Freshness"
                             Lifecycle="@Members.Lifecycle"
                             TestId="tenants-member-truth-badge"
                             ResourcePrefix="Tenants.Members" />
            @if (Members.IsRefreshing)
            {
                <p data-testid="tenants-member-refreshing">@Localizer["Tenants.Members.Freshness.Refreshing"]</p>
            }
            else if (Members.Kind is not TenantUsersSurfaceKind.Ready and not TenantUsersSurfaceKind.Empty)
            {
                <p>@StateMessage</p>
            }
        </div>
    </header>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true"
                 Class="tenant-members__reason-catalog"
                 role="list"
                 aria-label="@Localizer["Tenants.Members.ReasonCatalogLabel"]">
        @foreach (UnavailableReason reason in AllReasons)
        {
            <span class="tenant-members__reason tenant-members__reason--catalog"
                  role="listitem"
                  data-testid="@ReasonTestId(reason)">
                <span aria-hidden="true">@ReasonIcon(reason)</span>
                <span>@ReasonLabel(reason)</span>
            </span>
        }
    </FluentStack>

    <AddTenantMemberFlow Detail="@Detail"
                         SurfaceKind="@EffectiveSurfaceKind"
                         Freshness="@EffectiveFreshness"
                         IsAuthorized="@IsAddMemberAuthorized"
                         IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                         OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                         OnCommandActivityChanged="@OnCommandActivityChanged"
                         ProjectionEvidenceProvider="@ProjectionEvidenceProvider" />

    @if (Rows.Count == 0)
    {
        <section class="tenant-members__state"
                 data-testid="@EmptyStateTestId"
                 role="status">
            <h3>@EmptyStateTitle</h3>
            <p>@EmptyStateMessage</p>
        </section>
    }
    else
    {
        <div class="tenant-members__table-wrap" data-testid="tenants-member-table">
            <p class="tenant-members__table-caption">@Localizer["Tenants.Members.Table.Caption"]</p>
            <FluentDataGrid Items="@Rows.AsQueryable()"
                            Class="tenant-members__data-grid"
                            ResizableColumns="true"
                            ReorderableColumns="false"
                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                            ItemKey="@(row => row.Member.UserId)">
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.UserId"]"
                                ColumnId="member-user-id"
                                Width="260px"
                                Pin="DataGridColumnPin.Start">
                    <div class="tenant-members__user"
                         tabindex="0"
                         data-testid="tenants-member-row">
                        <div class="tenant-members__user-row" data-testid="tenants-member-user-id">
                            <code aria-label="@Localizer["Tenants.Members.UserIdAccessible", context.Member.UserId]">@context.Member.UserId</code>
                            <SupportSafeCopyButton Value="@context.Member.UserId"
                                                   ValueKind="SupportSafeCopyValueKind.UserId"
                                                   IsApproved="true"
                                                   AccessibleName="@Localizer["Tenants.Copy.Label.UserId", context.Member.UserId]"
                                                   TestId="tenants-member-copy-reference" />
                        </div>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Role"]"
                                ColumnId="member-role"
                                Width="180px">
                    <span class="tenant-members__badge tenant-members__badge--role"
                          aria-label="@Localizer["Tenants.Members.RoleAccessible", RoleLabel(context.Member.Role)]">
                        <span aria-hidden="true">@RoleIcon(context.Member.Role)</span>
                        <span>@RoleLabel(context.Member.Role)</span>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.OwnerContext"]"
                                ColumnId="member-owner-context"
                                Width="180px">
                    <span data-testid="tenants-member-owner-context">@OwnerContext</span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Status"]"
                                ColumnId="member-status"
                                Width="160px">
                    <span class="tenant-members__badge tenant-members__badge--status tenant-members__badge--@StatusCss"
                          aria-label="@Localizer["Tenants.Members.StatusAccessible", StatusLabel]">
                        <span aria-hidden="true">@StatusIcon</span>
                        <span>@StatusLabel</span>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Freshness"]"
                                ColumnId="member-freshness"
                                Width="170px">
                    <TruthStateBadge Freshness="@Members.Freshness"
                                     Lifecycle="@Members.Lifecycle"
                                     TestId="tenants-member-row-freshness"
                                     ResourcePrefix="Tenants.Members" />
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Audit"]"
                                ColumnId="member-audit"
                                Width="180px">
                    <AuditEvidenceEntryPoint TenantId="@Detail.TenantId"
                                             TargetUserId="@context.Member.UserId"
                                             SourceKind="member-row"
                                             SourceTestId="tenants-member-audit-entrypoint"
                                             Label="@Localizer["Tenants.Audit.EntryPoint.Label"]"
                                             AccessibleName="@Localizer["Tenants.Members.AuditAccessibleLabel", context.Member.UserId, Detail.TenantId]"
                                             ReturnUrl="@MemberReturnUrl"
                                             ReturnFocus="@($"tenants-member-{context.Member.UserId}")"
                                             IsAvailable="@CanOpenMemberAudit" />
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Actions"]"
                                ColumnId="member-actions"
                                Width="360px">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="tenant-members__actions">
                        @foreach (ActionSlot slot in context.ActionSlots)
                        {
                            @if (slot.Action is MemberAction.ChangeRole && slot.Reasons.Count == 0)
                            {
                                <span class="tenant-members__action-focus" tabindex="-1" @ref="_changeRoleLaunchElements[context.Member.UserId]">
                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                  Class="tenant-members__action-button"
                                                  data-testid="tenants-change-role-open"
                                                  aria-controls="tenants-change-role-flow-region"
                                                  aria-describedby="@context.ReasonElementId"
                                                  OnClick="() => OpenChangeRole(context.Member.UserId)">
                                        @ActionLabel(slot.Action)
                                    </FluentButton>
                                </span>
                            }
                            else if (slot.Action is MemberAction.RemoveMember && slot.Reasons.Count == 0)
                            {
                                <span class="tenant-members__action-focus" tabindex="-1" @ref="_removeMemberLaunchElements[context.Member.UserId]">
                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                  Class="tenant-members__action-button tenant-members__action-button--destructive"
                                                  data-testid="tenants-remove-member-open"
                                                  aria-controls="tenants-remove-member-flow-region"
                                                  aria-describedby="@context.ReasonElementId"
                                                  OnClick="() => OpenRemoveMember(context.Member.UserId)">
                                        @ActionLabel(slot.Action)
                                    </FluentButton>
                                </span>
                            }
                            else
                            {
                                <div class="tenant-members__action-slot"
                                     data-testid="tenants-member-action-slot"
                                     aria-describedby="@context.ReasonElementId"
                                     aria-label="@Localizer["Tenants.Members.ActionSlotAccessible", ActionLabel(slot.Action), context.Member.UserId, ReasonSummary(slot.Reasons)]">
                                    <span class="tenant-members__action-name">@ActionLabel(slot.Action)</span>
                                    <span class="tenant-members__action-state">@Localizer["Tenants.Members.Action.Unavailable"]</span>
                                </div>
                            }
                        }
                        <ul id="@context.ReasonElementId"
                            class="tenant-members__reasons"
                            data-testid="tenants-member-reason-list"
                            tabindex="0"
                            aria-label="@Localizer["Tenants.Members.ReasonListLabel", context.Member.UserId]">
                            @foreach (UnavailableReason reason in context.Reasons)
                            {
                                <li class="tenant-members__reason"
                                    data-testid="tenants-member-unavailable-reason">
                                    <span aria-hidden="true">@ReasonIcon(reason)</span>
                                    <span>@ReasonLabel(reason)</span>
                                </li>
                            }
                        </ul>
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>
        </div>

        @if (ActiveChangeRoleMember is not null)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem" id="tenants-change-role-flow-region" Class="tenant-members__change-role-region">
                <ChangeTenantMemberRoleFlow Detail="@Detail"
                                            Member="@ActiveChangeRoleMember"
                                            SurfaceKind="@EffectiveSurfaceKind"
                                            Freshness="@EffectiveFreshness"
                                            IsAuthorized="@IsChangeRoleAuthorized"
                                            IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                            OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                            OnCloseRequested="@CloseChangeRoleAsync"
                                            OnCommandActivityChanged="@OnCommandActivityChanged"
                                            ProjectionEvidenceProvider="@ChangeRoleProjectionEvidenceProvider" />
            </FluentStack>
        }

        @if (ActiveRemoveMember is not null)
        {
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem" id="tenants-remove-member-flow-region" Class="tenant-members__remove-member-region">
                <RemoveTenantMemberFlow Detail="@Detail"
                                        Member="@ActiveRemoveMember"
                                        SurfaceKind="@EffectiveSurfaceKind"
                                        Freshness="@EffectiveFreshness"
                                        IsAuthorized="@IsRemoveMemberAuthorized"
                                        IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                        TargetGlobalAdministratorFriction="@TargetGlobalAdministratorFriction"
                                        OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                        OnCloseRequested="@CloseRemoveMemberAsync"
                                        OnCommandActivityChanged="@OnCommandActivityChanged"
                                        ProjectionEvidenceProvider="@RemoveMemberProjectionEvidenceProvider" />
            </FluentStack>
        }

        @if (CanGoPrevious || Members.HasMore)
        {
            <nav class="tenant-members__paging"
                 data-testid="tenants-member-paging"
                 aria-label="@Localizer["Tenants.Members.Paging.Label"]">
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Disabled="@(!CanGoPrevious || Members.IsRefreshing)"
                              data-testid="tenants-member-previous"
                              OnClick="RequestPreviousPageAsync">
                    @Localizer["Tenants.Members.Previous"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Disabled="@(!Members.HasMore || Members.IsRefreshing)"
                              data-testid="tenants-member-next"
                              OnClick="RequestNextPageAsync">
                    @Localizer["Tenants.Members.Next"]
                </FluentButton>
            </nav>
        }
    }
</section>

@code {
    private static readonly UnavailableReason[] AllReasons =
    [
        UnavailableReason.MissingPermission,
        UnavailableReason.StaleData,
        UnavailableReason.MissingLifecycleSupport,
        UnavailableReason.MissingConsequencePreview,
        UnavailableReason.MissingAuditProof,
        UnavailableReason.HighImpactFlowNotReady,
    ];

    private string? _activeChangeRoleUserId;
    private string? _activeRemoveMemberUserId;

    // One launch button is rendered per actionable member row, so a single shared reference would
    // be overwritten by the last row in the loop and return focus to the wrong member on close.
    // Key the captured focus-wrapper references by the literal user id so focus returns to the launching control.
    private readonly Dictionary<string, ElementReference> _changeRoleLaunchElements = new(StringComparer.Ordinal);
    private readonly Dictionary<string, ElementReference> _removeMemberLaunchElements = new(StringComparer.Ordinal);
    private string? _focusChangeRoleLaunchUserId;
    private string? _focusRemoveMemberLaunchUserId;

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    [Parameter]
    public string? ProjectionVersion { get; set; }

    [Parameter]
    public TenantUsersSnapshot Members { get; set; } = TenantUsersSnapshot.Unavailable();

    [Parameter]
    public bool CanGoPrevious { get; set; }

    [Parameter]
    public EventCallback OnNextPageRequested { get; set; }

    [Parameter]
    public EventCallback OnPreviousPageRequested { get; set; }

    [Parameter]
    public bool IsAddMemberAuthorized { get; set; } = true;

    [Parameter]
    public bool IsChangeRoleAuthorized { get; set; } = true;

    [Parameter]
    public bool IsRemoveMemberAuthorized { get; set; } = true;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public bool TargetGlobalAdministratorFriction { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<AddUserToTenant, Task<TenantDetail?>>? ProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<ChangeUserRole, Task<TenantDetail?>>? ChangeRoleProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<RemoveUserFromTenant, Task<TenantDetail?>>? RemoveMemberProjectionEvidenceProvider { get; set; }

    private IReadOnlyList<MemberRow> Rows
        => Members.Rows
            .Select((member, index) => ToRow(member, index))
            .ToArray();

    private TenantMember? ActiveChangeRoleMember
        => Members.Rows.FirstOrDefault(member => string.Equals(member.UserId, _activeChangeRoleUserId, StringComparison.Ordinal));

    private TenantMember? ActiveRemoveMember
        => Members.Rows.FirstOrDefault(member => string.Equals(member.UserId, _activeRemoveMemberUserId, StringComparison.Ordinal));

    private int OwnerCount
        => Detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private string OwnerContext
        => !ActionsAreEvidenceBacked
            ? Localizer["Tenants.Members.OwnerContext.Unavailable"]
            : OwnerCount switch
        {
            0 => Localizer["Tenants.Members.OwnerContext.NoOwners"],
            1 => Localizer["Tenants.Members.OwnerContext.LastOwner", OwnerCount],
            _ => Localizer["Tenants.Members.OwnerContext.MultipleOwners", OwnerCount],
        };

    private string StatusLabel
        => Localizer[$"Tenants.Members.Status.{Detail.Status}"];

    private string StatusCss
        => Detail.Status.ToString().ToLowerInvariant();

    private string StatusIcon
        => Detail.Status switch
        {
            TenantStatus.Active => "OK",
            TenantStatus.Disabled => "!",
            _ => "?",
        };

    private UnavailableReason PrimaryUnavailableReason
        => ResolveFailClosedReasons(TenantRole.Unknown).FirstOrDefault(UnavailableReason.StaleData);

    private string StateMessage
        => Members.Kind switch
        {
            TenantUsersSurfaceKind.Loading => Localizer["Tenants.Members.State.Loading"],
            TenantUsersSurfaceKind.Stale => Localizer["Tenants.Members.State.Stale"],
            TenantUsersSurfaceKind.Degraded => Localizer["Tenants.Members.State.Degraded"],
            TenantUsersSurfaceKind.Unknown => Localizer["Tenants.Members.State.Unknown"],
            TenantUsersSurfaceKind.Unauthorized => Localizer["Tenants.Members.State.Unauthorized"],
            TenantUsersSurfaceKind.NotFound => Localizer["Tenants.Members.State.NotFound"],
            _ => Localizer["Tenants.Members.State.Unavailable"],
        };

    private bool CanOpenMemberAudit
        => Members.Kind is TenantUsersSurfaceKind.Ready
            or TenantUsersSurfaceKind.Stale
            or TenantUsersSurfaceKind.Degraded
            or TenantUsersSurfaceKind.Unknown;

    private bool ActionsAreEvidenceBacked
        => SurfaceKind is TenantDetailSurfaceKind.Ready
            && Freshness is ReadModelFreshnessState.Current
            && Lifecycle is ProjectionLifecycleState.Current
            && Members.Kind is TenantUsersSurfaceKind.Ready or TenantUsersSurfaceKind.Empty
            && Members.Freshness is ReadModelFreshnessState.Current
            && Members.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(ProjectionVersion)
            && string.Equals(ProjectionVersion, Members.ProjectionVersion, StringComparison.Ordinal);

    private TenantDetailSurfaceKind EffectiveSurfaceKind
        => ActionsAreEvidenceBacked ? SurfaceKind : TenantDetailSurfaceKind.Degraded;

    private ReadModelFreshnessState EffectiveFreshness
        => ActionsAreEvidenceBacked ? Freshness : ReadModelFreshnessState.Unknown;

    private string EmptyStateTestId
        => Members.Kind is TenantUsersSurfaceKind.Empty ? "tenants-member-empty" : "tenants-member-state";

    private string EmptyStateTitle
        => Members.Kind is TenantUsersSurfaceKind.Empty
            ? Localizer["Tenants.Members.Empty.Title"]
            : Localizer["Tenants.Members.State.Title"];

    private string EmptyStateMessage
        => Members.Kind is TenantUsersSurfaceKind.Empty
            ? Localizer["Tenants.Members.Empty.Message", ReasonLabel(PrimaryUnavailableReason)]
            : StateMessage;

    private string MemberReturnUrl
        => $"/tenants/{Uri.EscapeDataString(Detail.TenantId)}";

    private MemberRow ToRow(TenantMember member, int index)
    {
        IReadOnlyList<ActionSlot> slots = BuildActionSlots(member.Role);
        return new(member, $"tenants-member-reasons-{index}", slots, slots.SelectMany(static slot => slot.Reasons).Distinct().ToArray());
    }

    private IReadOnlyList<ActionSlot> BuildActionSlots(TenantRole role)
    {
        IReadOnlyList<UnavailableReason> failClosedReasons = ResolveFailClosedReasons(role);
        if (failClosedReasons.Count > 0)
        {
            return
            [
                new(MemberAction.AddMember, failClosedReasons),
                new(MemberAction.ChangeRole, failClosedReasons),
                new(MemberAction.RemoveMember, failClosedReasons),
            ];
        }

        return
        [
            new(MemberAction.AddMember, [UnavailableReason.MissingPermission, UnavailableReason.HighImpactFlowNotReady]),
            new(MemberAction.ChangeRole, []),
            new(MemberAction.RemoveMember, []),
        ];
    }

    private IReadOnlyList<UnavailableReason> ResolveFailClosedReasons(TenantRole role)
    {
        if (SurfaceKind is TenantDetailSurfaceKind.Unauthorized)
        {
            return [UnavailableReason.MissingPermission];
        }

        if (!ActionsAreEvidenceBacked)
        {
            return [UnavailableReason.StaleData];
        }

        if (SurfaceKind is TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown or TenantDetailSurfaceKind.Degraded)
        {
            return [UnavailableReason.StaleData];
        }

        if (Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown)
        {
            return [UnavailableReason.MissingLifecycleSupport];
        }

        if (SurfaceKind is TenantDetailSurfaceKind.Stale || Freshness is not ReadModelFreshnessState.Current)
        {
            return [UnavailableReason.StaleData];
        }

        if (role is TenantRole.Unknown)
        {
            return [UnavailableReason.MissingPermission];
        }

        return [];
    }

    private Task RequestNextPageAsync()
        => Members.HasMore && !Members.IsRefreshing
            ? OnNextPageRequested.InvokeAsync()
            : Task.CompletedTask;

    private Task RequestPreviousPageAsync()
        => CanGoPrevious && !Members.IsRefreshing
            ? OnPreviousPageRequested.InvokeAsync()
            : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusChangeRoleLaunchUserId is not null
            && _changeRoleLaunchElements.TryGetValue(_focusChangeRoleLaunchUserId, out ElementReference launchElement))
        {
            _focusChangeRoleLaunchUserId = null;
            await launchElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRemoveMemberLaunchUserId is not null
            && _removeMemberLaunchElements.TryGetValue(_focusRemoveMemberLaunchUserId, out ElementReference removeLaunchElement))
        {
            _focusRemoveMemberLaunchUserId = null;
            await removeLaunchElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private void OpenChangeRole(string userId)
    {
        _activeRemoveMemberUserId = null;
        _activeChangeRoleUserId = userId;
    }

    private void OpenRemoveMember(string userId)
    {
        _activeChangeRoleUserId = null;
        _activeRemoveMemberUserId = userId;
    }

    private async Task CloseChangeRoleAsync()
    {
        // Capture the launching member before clearing it so focus returns to that exact row's
        // "Change role" control once the flow region is removed and the table re-renders.
        _focusChangeRoleLaunchUserId = _activeChangeRoleUserId;
        _activeChangeRoleUserId = null;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private async Task CloseRemoveMemberAsync()
    {
        _focusRemoveMemberLaunchUserId = _activeRemoveMemberUserId;
        _activeRemoveMemberUserId = null;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private string ActionLabel(MemberAction action)
        => Localizer[$"Tenants.Members.Action.{action}"];

    private string RoleLabel(TenantRole role)
        => Localizer[$"Tenants.Members.Role.{role}"];

    private static string RoleIcon(TenantRole role)
        => role switch
        {
            TenantRole.TenantOwner => "O",
            TenantRole.TenantContributor => "C",
            TenantRole.TenantReader => "R",
            _ => "?",
        };

    private string ReasonLabel(UnavailableReason reason)
        => Localizer[$"Tenants.Members.UnavailableReason.{reason}"];

    private string ReasonSummary(IReadOnlyList<UnavailableReason> reasons)
        => string.Join(", ", reasons.Select(ReasonLabel));

    private static string ReasonTestId(UnavailableReason reason)
        => $"tenants-member-reason-{ReasonSlug(reason)}";

    private static string ReasonSlug(UnavailableReason reason)
        => reason switch
        {
            UnavailableReason.MissingPermission => "missing-permission",
            UnavailableReason.StaleData => "stale-data",
            UnavailableReason.MissingLifecycleSupport => "missing-lifecycle-support",
            UnavailableReason.MissingConsequencePreview => "missing-consequence-preview",
            UnavailableReason.MissingAuditProof => "missing-audit-proof",
            UnavailableReason.HighImpactFlowNotReady => "high-impact-flow-not-ready",
            _ => "unknown",
        };

    private static string ReasonIcon(UnavailableReason reason)
        => reason switch
        {
            UnavailableReason.MissingPermission => "!",
            UnavailableReason.StaleData => "!",
            UnavailableReason.MissingLifecycleSupport => "!",
            UnavailableReason.MissingConsequencePreview => "?",
            UnavailableReason.MissingAuditProof => "?",
            UnavailableReason.HighImpactFlowNotReady => "!",
            _ => "?",
        };

    private sealed record MemberRow(
        TenantMember Member,
        string ReasonElementId,
        IReadOnlyList<ActionSlot> ActionSlots,
        IReadOnlyList<UnavailableReason> Reasons);

    private sealed record ActionSlot(MemberAction Action, IReadOnlyList<UnavailableReason> Reasons);

    private enum MemberAction
    {
        AddMember,
        ChangeRole,
        RemoveMember,
    }

    private enum UnavailableReason
    {
        MissingPermission,
        StaleData,
        MissingLifecycleSupport,
        MissingConsequencePreview,
        MissingAuditProof,
        HighImpactFlowNotReady,
    }
}
