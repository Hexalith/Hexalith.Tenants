@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.Services.Gateways
@using Hexalith.Tenants.UI.State.GlobalAdministrators
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.Tenants.UI.State.TenantList
@using Hexalith.Tenants.UI.State.TenantUsers
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services
@implements IAsyncDisposable

<section class="tenant-members"
         aria-labelledby="tenants-member-heading"
         data-testid="tenants-member-section">
    <header class="tenant-members__header">
        <div>
            <h2 id="tenants-member-heading">@Localizer["Tenants.Members.Title"]</h2>
            <p>@Localizer["Tenants.Members.Description"]</p>
            <p class="tenant-members__scope">@Localizer["Tenants.Members.ScopeNotice"]</p>
        </div>
        <div class="tenant-members__truth" data-testid="tenants-member-truth-state">
            <ProjectionLifecycleStatus Lifecycle="@Members.Lifecycle"
                                       TestId="tenants-member-projection-lifecycle-status"
                                       BadgeTestId="tenants-member-projection-lifecycle-badge" />
            <TruthStateBadge Freshness="@Members.Freshness"
                             TestId="tenants-member-truth-badge"
                             ResourcePrefix="Tenants.Members" />
            @if (Members.IsRefreshing)
            {
                <p data-testid="tenants-member-refreshing">@Localizer["Tenants.Members.Freshness.Refreshing"]</p>
            }
            else if (Members.Kind is not TenantUsersSurfaceKind.Ready and not TenantUsersSurfaceKind.Empty)
            {
                <p>@StateMessage</p>
            }
        </div>
    </header>

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true"
                 Class="tenant-members__reason-catalog"
                 role="list"
                 aria-label="@Localizer["Tenants.Members.ReasonCatalogLabel"]">
        @foreach (UnavailableReason reason in AllReasons)
        {
            <span class="tenant-members__reason tenant-members__reason--catalog"
                  role="listitem"
                  data-testid="@ReasonTestId(reason)">
                <span aria-hidden="true">@ReasonIcon(reason)</span>
                <span>@ReasonLabel(reason)</span>
            </span>
        }
    </FluentStack>

    @* All membership flows acquire the same exclusive aggregate lease. The add flow renders unconditionally;
       the conditional change/remove flows additionally rely on this landmark's teardown release below. *@
    <AddTenantMemberFlow @ref="_addMemberFlow"
                         Detail="@Detail"
                         SurfaceKind="@EffectiveSurfaceKind"
                         Freshness="@EffectiveFreshness"
                         IsAuthorized="@IsAddMemberAuthorized"
                         IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                         ProjectionVersion="@ProjectionVersion"
                         ProjectionVersionProvider="@ProjectionVersionProvider"
                         CommandSurfaceUnavailableReason="@CommandSurfaceUnavailableReason"
                         OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                         CommandActivityLease="@HandleAddCommandActivityLeaseAsync"
                         ProjectionEvidenceProvider="@ProjectionEvidenceProvider" />

    @if (Members.PagingRecovered)
    {
        <p role="status" aria-live="polite" data-testid="tenants-member-page-recovered">
            @Localizer["Tenants.Members.Recovery.PageRecovered"]
        </p>
    }

    @if (PagingJumpedToFirstPage)
    {
        <p role="status" aria-live="polite" data-testid="tenants-member-history-truncated">
            @Localizer["Tenants.Members.Recovery.HistoryTruncated"]
        </p>
    }

    @if (Rows.Count == 0)
    {
        <section class="tenant-members__state"
                 data-testid="@EmptyStateTestId"
                 role="status">
            <h3>@EmptyStateTitle</h3>
            <p>@EmptyStateMessage</p>
        </section>
    }
    else
    {
        <div class="tenant-members__table-wrap" data-testid="tenants-member-table">
            <p class="tenant-members__table-caption">@Localizer["Tenants.Members.Table.Caption"]</p>
            <FluentDataGrid Items="@Rows.AsQueryable()"
                            Class="tenant-members__data-grid"
                            ResizableColumns="true"
                            ReorderableColumns="false"
                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                            ItemKey="@(row => row.Member.UserId)">
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.UserId"]"
                                ColumnId="member-user-id"
                                Width="260px"
                                Pin="DataGridColumnPin.Start">
                    <div class="tenant-members__user"
                         tabindex="0"
                         data-testid="tenants-member-row">
                        <div class="tenant-members__user-row" data-testid="tenants-member-user-id">
                            <code aria-label="@Localizer["Tenants.Members.UserIdAccessible", context.Member.UserId]">@context.Member.UserId</code>
                            <SupportSafeCopyButton Value="@context.Member.UserId"
                                                   ValueKind="SupportSafeCopyValueKind.UserId"
                                                   IsApproved="true"
                                                   AccessibleName="@Localizer["Tenants.Copy.Label.UserId", context.Member.UserId]"
                                                   TestId="tenants-member-copy-reference" />
                        </div>
                    </div>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Role"]"
                                ColumnId="member-role"
                                Width="180px">
                    <span class="tenant-members__badge tenant-members__badge--role"
                          aria-label="@Localizer["Tenants.Members.RoleAccessible", RoleLabel(context.Member.Role)]">
                        <span aria-hidden="true">@RoleIcon(context.Member.Role)</span>
                        <span>@RoleLabel(context.Member.Role)</span>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.OwnerContext"]"
                                ColumnId="member-owner-context"
                                Width="180px">
                    <span data-testid="tenants-member-owner-context">@OwnerContext</span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Status"]"
                                ColumnId="member-status"
                                Width="160px">
                    <span class="tenant-members__badge tenant-members__badge--status tenant-members__badge--@StatusCss"
                          aria-label="@Localizer["Tenants.Members.StatusAccessible", StatusLabel]">
                        <span aria-hidden="true">@StatusIcon</span>
                        <span>@StatusLabel</span>
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Freshness"]"
                                ColumnId="member-freshness"
                                Width="170px">
                    <TruthStateBadge Freshness="@Members.Freshness"
                                     TestId="tenants-member-row-freshness"
                                     ResourcePrefix="Tenants.Members" />
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.ProjectionLifecycle.Label"]"
                                ColumnId="member-projection-lifecycle"
                                Width="180px">
                    <ProjectionLifecycleBadge Lifecycle="@Members.Lifecycle"
                                              TestId="tenants-member-row-projection-lifecycle" />
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Audit"]"
                                ColumnId="member-audit"
                                Width="180px">
                    <AuditEvidenceEntryPoint TenantId="@Detail.TenantId"
                                             TargetUserId="@context.Member.UserId"
                                             SourceKind="member-row"
                                             SourceTestId="tenants-member-audit-entrypoint"
                                             Label="@Localizer["Tenants.Audit.EntryPoint.Label"]"
                                             AccessibleName="@Localizer["Tenants.Members.AuditAccessibleLabel", context.Member.UserId, Detail.TenantId]"
                                             ReturnUrl="@MemberReturnUrl"
                                             ReturnFocus="@($"tenants-member-{context.Member.UserId}")"
                                             IsAvailable="@CanOpenMemberAudit" />
                </TemplateColumn>
                <TemplateColumn Title="@Localizer["Tenants.Members.Column.Actions"]"
                                ColumnId="member-actions"
                                Width="360px">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="tenant-members__actions">
                        @foreach (ActionSlot slot in context.ActionSlots)
                        {
                            @if (slot.Action is MemberAction.ChangeRole && slot.Reasons.Count == 0)
                            {
                                <span class="tenant-members__action-focus" tabindex="-1" @ref="_changeRoleLaunchElements[context.Member.UserId]">
                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                  Class="tenant-members__action-button"
                                                  data-testid="tenants-change-role-open"
                                                  aria-controls="tenants-change-role-flow-region"
                                                  aria-describedby="@context.ReasonElementId"
                                                  OnClick="() => OpenChangeRole(context.Member)">
                                        @ActionLabel(slot.Action)
                                    </FluentButton>
                                </span>
                            }
                            else if (slot.Action is MemberAction.RemoveMember && slot.Reasons.Count == 0)
                            {
                                <span class="tenant-members__action-focus" tabindex="-1" @ref="_removeMemberLaunchElements[context.Member.UserId]">
                                    <FluentButton Appearance="ButtonAppearance.Outline"
                                                  Class="tenant-members__action-button tenant-members__action-button--destructive"
                                                  data-testid="tenants-remove-member-open"
                                                  aria-controls="tenants-remove-member-flow-region"
                                                  aria-describedby="@context.ReasonElementId"
                                                  OnClick="() => OpenRemoveMember(context.Member)">
                                        @ActionLabel(slot.Action)
                                    </FluentButton>
                                </span>
                            }
                            else
                            {
                                <div class="tenant-members__action-slot"
                                     data-testid="tenants-member-action-slot"
                                     aria-describedby="@context.ReasonElementId"
                                     aria-label="@Localizer["Tenants.Members.ActionSlotAccessible", ActionLabel(slot.Action), context.Member.UserId, ReasonSummary(slot.Reasons)]">
                                    <span class="tenant-members__action-name">@ActionLabel(slot.Action)</span>
                                    <span class="tenant-members__action-state">@Localizer["Tenants.Members.Action.Unavailable"]</span>
                                </div>
                            }
                        }
                        <ul id="@context.ReasonElementId"
                            class="tenant-members__reasons"
                            data-testid="tenants-member-reason-list"
                            tabindex="0"
                            aria-label="@Localizer["Tenants.Members.ReasonListLabel", context.Member.UserId]">
                            @foreach (UnavailableReason reason in context.Reasons)
                            {
                                <li class="tenant-members__reason"
                                    data-testid="tenants-member-unavailable-reason">
                                    <span aria-hidden="true">@ReasonIcon(reason)</span>
                                    <span>@ReasonLabel(reason)</span>
                                </li>
                            }
                        </ul>
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>
        </div>

    }

    @* Rendered outside the empty/non-empty branches on purpose, for the same reason as the pager below:
       a confirmation re-query that removes the target row -- which for a removal is the success signal --
       previously emptied Rows, took the branch above, and unmounted the flow mid-command, discarding its
       lifecycle state, receipt and pending projection confirmation while leaving the pager permanently
       disabled. The flow now renders from its captured intent until the operator closes it. *@
    @if (ActiveChangeRoleMember is not null)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem" id="tenants-change-role-flow-region" Class="tenant-members__change-role-region">
            <ChangeTenantMemberRoleFlow @ref="_changeRoleFlow"
                                        Detail="@Detail"
                                        Member="@ActiveChangeRoleMember"
                                        SurfaceKind="@EffectiveSurfaceKind"
                                        Freshness="@EffectiveFreshness"
                                        IsAuthorized="@IsChangeRoleAuthorized"
                                        IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                        ProjectionVersion="@ProjectionVersion"
                                        ProjectionVersionProvider="@ProjectionVersionProvider"
                                        CommandSurfaceUnavailableReason="@CommandSurfaceUnavailableReason"
                                        OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                        OnCloseRequested="@CloseChangeRoleAsync"
                                        CommandActivityLease="@HandleChangeRoleCommandActivityLeaseAsync"
                                        ProjectionEvidenceProvider="@ChangeRoleProjectionEvidenceProvider" />
        </FluentStack>
    }

    @if (ActiveRemoveMember is not null)
    {
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem" id="tenants-remove-member-flow-region" Class="tenant-members__remove-member-region">
            <RemoveTenantMemberFlow @ref="_removeMemberFlow"
                                    Detail="@Detail"
                                    Member="@ActiveRemoveMember"
                                    SurfaceKind="@EffectiveSurfaceKind"
                                    Freshness="@EffectiveFreshness"
                                    IsAuthorized="@IsRemoveMemberAuthorized"
                                    IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                    ProjectionVersion="@ProjectionVersion"
                                    ProjectionVersionProvider="@ProjectionVersionProvider"
                                    CommandSurfaceUnavailableReason="@CommandSurfaceUnavailableReason"
                                    AuditProofCapabilityAvailable="@AuditProofCapabilityAvailable"
                                    TargetGlobalAdministratorFriction="@ResolveTargetGlobalAdministratorFriction(ActiveRemoveMember)"
                                    TargetPlatformStandingResolved="@TargetPlatformStandingResolved"
                                    OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                    OnCloseRequested="@CloseRemoveMemberAsync"
                                    CommandActivityLease="@HandleRemoveMemberCommandActivityLeaseAsync"
                                    ProjectionEvidenceProvider="@RemoveMemberProjectionEvidenceProvider" />
        </FluentStack>
    }

    @* Rendered outside the empty/non-empty branches on purpose. Paging forward into a page emptied by
       concurrent removals previously hid the whole pager, leaving no Previous control and no way back
       except a full reload -- which resets the member cursor anyway. *@
    @if (CanGoPrevious || Members.HasMore)
    {
        <nav class="tenant-members__paging"
             data-testid="tenants-member-paging"
             aria-label="@Localizer["Tenants.Members.Paging.Label"]">
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Disabled="@(!CanGoPrevious || Members.IsRefreshing || HasOpenMemberCommandFlow)"
                          data-testid="tenants-member-previous"
                          OnClick="RequestPreviousPageAsync">
                @Localizer["Tenants.Members.Previous"]
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          Disabled="@(!Members.HasMore || Members.IsRefreshing || HasOpenMemberCommandFlow)"
                          data-testid="tenants-member-next"
                          OnClick="RequestNextPageAsync">
                @Localizer["Tenants.Members.Next"]
            </FluentButton>
        </nav>
    }
</section>

@code {
    private static readonly UnavailableReason[] AllReasons =
    [
        UnavailableReason.MissingPermission,
        UnavailableReason.StaleData,
        UnavailableReason.MissingLifecycleSupport,
        UnavailableReason.MissingConsequencePreview,
        UnavailableReason.MissingAuditProof,
        UnavailableReason.HighImpactFlowNotReady,
        UnavailableReason.AggregateLocked,
    ];

    private string? _activeChangeRoleUserId;
    private string? _activeRemoveMemberUserId;

    // Tracks the exact child that owns the aggregate lease. A single Boolean lets teardown of an unrelated
    // conditional flow lower the add flow's lease, so ownership must survive independently of render branches.
    private MemberCommandLeaseOwner? _childCommandLeaseOwner;

    // The member record captured when the flow was launched. Resolving the open flow's target against
    // Members.Rows on every render made a successful removal destroy its own evidence: the confirmation
    // re-query removes the row, the @if guard tears the flow down mid-command, and its lifecycle state,
    // receipt and pending projection confirmation go with it -- while the active user id survives, leaving
    // HasOpenMemberCommandFlow stuck true and both pager buttons disabled with no rendered flow to close.
    // The row leaving the page IS the confirmation, so the flow renders from this captured intent and the
    // live row is used only to pick up in-place changes (a role edit) while the member is still visible.
    private TenantMember? _activeChangeRoleCapture;
    private TenantMember? _activeRemoveMemberCapture;
    private string? _renderedTenantId;
    private string? _renderedMemberCursor;
    private AddTenantMemberFlow? _addMemberFlow;
    private ChangeTenantMemberRoleFlow? _changeRoleFlow;
    private RemoveTenantMemberFlow? _removeMemberFlow;

    // One launch button is rendered per actionable member row, so a single shared reference would
    // be overwritten by the last row in the loop and return focus to the wrong member on close.
    // Key the captured focus-wrapper references by the literal user id so focus returns to the launching control.
    private readonly Dictionary<string, ElementReference> _changeRoleLaunchElements = new(StringComparer.Ordinal);
    private readonly Dictionary<string, ElementReference> _removeMemberLaunchElements = new(StringComparer.Ordinal);
    private string? _focusChangeRoleLaunchUserId;
    private string? _focusRemoveMemberLaunchUserId;

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    [Parameter]
    public string? ProjectionVersion { get; set; }

    [Parameter]
    public Func<string?>? ProjectionVersionProvider { get; set; }

    [Parameter]
    public TenantUsersSnapshot Members { get; set; } = TenantUsersSnapshot.Unavailable();

    [Parameter]
    public bool CanGoPrevious { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the last Previous step walked the operator to the first page
    /// because the bounded cursor history had been trimmed, rather than moving back one page.
    /// </summary>
    [Parameter]
    public bool PagingJumpedToFirstPage { get; set; }

    [Parameter]
    public EventCallback OnNextPageRequested { get; set; }

    [Parameter]
    public EventCallback OnPreviousPageRequested { get; set; }

    [Parameter]
    public bool IsAddMemberAuthorized { get; set; } = true;

    [Parameter]
    public bool IsChangeRoleAuthorized { get; set; } = true;

    [Parameter]
    public bool IsRemoveMemberAuthorized { get; set; } = true;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public string? CommandSurfaceUnavailableReason { get; set; }

    /// <summary>
    /// Optional authorized global-administrator projection used for target platform-standing friction.
    /// Incomplete, stale, or unavailable evidence never invents standing.
    /// </summary>
    [Parameter]
    public GlobalAdministratorsSnapshot? GlobalAdministrators { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the composing parent has an authoritative audit read surface.
    /// </summary>
    [Parameter]
    public bool AuditProofCapabilityAvailable { get; set; } = true;

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<bool, Task<bool>>? CommandActivityLease { get; set; }

    [Parameter]
    public Func<AddUserToTenant, Task<TenantDetail?>>? ProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<ChangeUserRole, Task<TenantDetail?>>? ChangeRoleProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<RemoveUserFromTenant, Task<TenantDetail?>>? RemoveMemberProjectionEvidenceProvider { get; set; }

    private IReadOnlyList<MemberRow> Rows
        => Members.Rows
            .Select((member, index) => ToRow(member, index))
            .ToArray();

    // Prefer the live row so an in-place role change is picked up while the member is still visible, and
    // fall back to the captured record once the row leaves the page -- which for a removal is the
    // confirmation itself, not a reason to tear the flow down. See _activeRemoveMemberCapture.
    private TenantMember? ActiveChangeRoleMember
        => _activeChangeRoleUserId is null
            ? null
            : Members.Rows.FirstOrDefault(member => string.Equals(member.UserId, _activeChangeRoleUserId, StringComparison.Ordinal))
                ?? _activeChangeRoleCapture;

    private TenantMember? ActiveRemoveMember
        => _activeRemoveMemberUserId is null
            ? null
            : Members.Rows.FirstOrDefault(member => string.Equals(member.UserId, _activeRemoveMemberUserId, StringComparison.Ordinal))
                ?? _activeRemoveMemberCapture;

    private bool TargetPlatformStandingResolved
        => GlobalAdministrators is
        {
            IsCompleteEvidence: true,
            Freshness: ReadModelFreshnessState.Current,
            Lifecycle: ProjectionLifecycleState.Current,
        };

    private int OwnerCount
        => Detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private string OwnerContext
        => !ActionsAreEvidenceBacked
            ? Localizer["Tenants.Members.OwnerContext.Unavailable"]
            : OwnerCount switch
        {
            0 => Localizer["Tenants.Members.OwnerContext.NoOwners"],
            1 => Localizer["Tenants.Members.OwnerContext.LastOwner", OwnerCount],
            _ => Localizer["Tenants.Members.OwnerContext.MultipleOwners", OwnerCount],
        };

    private string StatusLabel
        => Localizer[$"Tenants.Members.Status.{Detail.Status}"];

    private string StatusCss
        => Detail.Status.ToString().ToLowerInvariant();

    private string StatusIcon
        => Detail.Status switch
        {
            TenantStatus.Active => "OK",
            TenantStatus.Disabled => "!",
            _ => "?",
        };

    private UnavailableReason PrimaryUnavailableReason
        => ResolveFailClosedReasons(TenantRole.Unknown).FirstOrDefault(UnavailableReason.StaleData);

    private string StateMessage
        => Members.Kind switch
        {
            TenantUsersSurfaceKind.Loading => Localizer["Tenants.Members.State.Loading"],
            TenantUsersSurfaceKind.Stale => Localizer["Tenants.Members.State.Stale"],
            TenantUsersSurfaceKind.Degraded => Localizer["Tenants.Members.State.Degraded"],
            TenantUsersSurfaceKind.Unknown => Localizer["Tenants.Members.State.Unknown"],
            TenantUsersSurfaceKind.Unauthorized => Localizer["Tenants.Members.State.Unauthorized"],
            TenantUsersSurfaceKind.NotFound => Localizer["Tenants.Members.State.NotFound"],
            TenantUsersSurfaceKind.Invalid => Localizer["Tenants.Members.State.Invalid"],
            TenantUsersSurfaceKind.Error => Localizer["Tenants.Members.State.Error"],
            _ => Localizer["Tenants.Members.State.Unavailable"],
        };

    private bool CanOpenMemberAudit
        => Members.Kind is TenantUsersSurfaceKind.Ready
            or TenantUsersSurfaceKind.Stale
            or TenantUsersSurfaceKind.Degraded
            or TenantUsersSurfaceKind.Unknown;

    private bool ActionsAreEvidenceBacked
        => SurfaceKind is TenantDetailSurfaceKind.Ready
            && Freshness is ReadModelFreshnessState.Current
            && Lifecycle is ProjectionLifecycleState.Current
            && Members.Kind is TenantUsersSurfaceKind.Ready or TenantUsersSurfaceKind.Empty
            && Members.Freshness is ReadModelFreshnessState.Current
            && Members.Lifecycle is ProjectionLifecycleState.Current
            && !string.IsNullOrWhiteSpace(ProjectionVersion)
            && string.Equals(ProjectionVersion, Members.ProjectionVersion, StringComparison.Ordinal);

    private TenantDetailSurfaceKind EffectiveSurfaceKind
        => ActionsAreEvidenceBacked ? SurfaceKind : TenantDetailSurfaceKind.Degraded;

    private ReadModelFreshnessState EffectiveFreshness
        => ActionsAreEvidenceBacked ? Freshness : ReadModelFreshnessState.Unknown;

    // AC6 requires empty, unauthorized, not-found, error, degraded, stale and unknown to stay distinct. A
    // single "tenants-member-state" id and a single "Member read unavailable" title collapsed all of them
    // into one indistinguishable surface -- including Loading -- and left selector-based tests unable to
    // tell an authorization-safe absence from a failed read.
    // An authorized read that returned no rows is an authorization-safe absence whatever its freshness.
    // TenantUsersSnapshot.Empty maps Stale/Unknown freshness onto the Stale/Unknown kind -- the kind IS the
    // freshness channel, matching Ready -- so keying the empty surface on Kind alone reported a successful
    // authorized-empty page as "Member read unavailable". IsAuthorizationScopedEmpty is set only by that
    // factory (every failure path goes through EmptyState, which sets it false), so it is the precise
    // signal for the absence channel; freshness stays visible through the truth badge and the qualifier
    // below.
    private bool IsAuthorizationSafeAbsence
        => Members.IsAuthorizationScopedEmpty && Members.Rows.Count == 0;

    private string EmptyStateTestId
        => IsAuthorizationSafeAbsence
            ? "tenants-member-empty"
            : Members.Kind switch
            {
                TenantUsersSurfaceKind.Empty => "tenants-member-empty",
                TenantUsersSurfaceKind.Loading => "tenants-member-loading",
                TenantUsersSurfaceKind.Unauthorized => "tenants-member-unauthorized",
                TenantUsersSurfaceKind.NotFound => "tenants-member-not-found",
                TenantUsersSurfaceKind.Invalid => "tenants-member-invalid",
                TenantUsersSurfaceKind.Unavailable => "tenants-member-unavailable",
                TenantUsersSurfaceKind.Error => "tenants-member-error",
                TenantUsersSurfaceKind.Degraded => "tenants-member-degraded",
                TenantUsersSurfaceKind.Stale => "tenants-member-stale",
                TenantUsersSurfaceKind.Unknown => "tenants-member-unknown",
                _ => "tenants-member-state",
            };

    private string EmptyStateTitle
        => IsAuthorizationSafeAbsence
            ? Localizer["Tenants.Members.Empty.Title"]
            : Members.Kind switch
            {
                TenantUsersSurfaceKind.Empty => Localizer["Tenants.Members.Empty.Title"],
                TenantUsersSurfaceKind.Loading => Localizer["Tenants.Members.State.Loading.Title"],
                TenantUsersSurfaceKind.Unauthorized => Localizer["Tenants.Members.State.Unauthorized.Title"],
                TenantUsersSurfaceKind.NotFound => Localizer["Tenants.Members.State.NotFound.Title"],
                TenantUsersSurfaceKind.Invalid => Localizer["Tenants.Members.State.Invalid.Title"],
                TenantUsersSurfaceKind.Unknown => Localizer["Tenants.Members.State.Unknown.Title"],
                _ => Localizer["Tenants.Members.State.Title"],
            };

    // A stale or unknown-freshness authorized-empty page keeps the absence wording and states the freshness
    // qualifier, so neither channel is lost to the other. Each variant is a whole localized sentence with a
    // placeholder: the previous form glued two independently translated sentences with an ASCII space, which
    // no translator can reorder, re-punctuate, or make agree, against the project's whole-string rule.
    private string EmptyStateMessage
        => IsAuthorizationSafeAbsence
            ? Members.Kind switch
            {
                TenantUsersSurfaceKind.Stale
                    => Localizer["Tenants.Members.Empty.Message.Stale", ReasonLabel(PrimaryUnavailableReason)],
                TenantUsersSurfaceKind.Unknown
                    => Localizer["Tenants.Members.Empty.Message.Unknown", ReasonLabel(PrimaryUnavailableReason)],
                _ => Localizer["Tenants.Members.Empty.Message", ReasonLabel(PrimaryUnavailableReason)],
            }
            : Members.Kind is TenantUsersSurfaceKind.Empty
                ? Localizer["Tenants.Members.Empty.Message", ReasonLabel(PrimaryUnavailableReason)]
                : StateMessage;

    private string MemberReturnUrl
        => $"/tenants/{Uri.EscapeDataString(Detail.TenantId)}";

    private MemberRow ToRow(TenantMember member, int index)
    {
        IReadOnlyList<ActionSlot> slots = BuildActionSlots(member.Role);
        return new(member, $"tenants-member-reasons-{index}", slots, slots.SelectMany(static slot => slot.Reasons).Distinct().ToArray());
    }

    private IReadOnlyList<ActionSlot> BuildActionSlots(TenantRole role)
    {
        IReadOnlyList<UnavailableReason> failClosedReasons = ResolveFailClosedReasons(role);
        if (failClosedReasons.Count > 0)
        {
            return
            [
                new(MemberAction.AddMember, failClosedReasons),
                new(MemberAction.ChangeRole, failClosedReasons),
                new(MemberAction.RemoveMember, failClosedReasons),
            ];
        }

        IReadOnlyList<UnavailableReason> removeReasons = AuditProofCapabilityAvailable
            ? []
            : [UnavailableReason.MissingAuditProof];

        return
        [
            new(MemberAction.AddMember, [UnavailableReason.MissingPermission, UnavailableReason.HighImpactFlowNotReady]),
            new(MemberAction.ChangeRole, []),
            new(MemberAction.RemoveMember, removeReasons),
        ];
    }

    private IReadOnlyList<UnavailableReason> ResolveFailClosedReasons(TenantRole role)
    {
        if (SurfaceKind is TenantDetailSurfaceKind.Unauthorized)
        {
            return [UnavailableReason.MissingPermission];
        }

        if (!ActionsAreEvidenceBacked)
        {
            return [UnavailableReason.StaleData];
        }

        if (SurfaceKind is TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown or TenantDetailSurfaceKind.Degraded)
        {
            return [UnavailableReason.StaleData];
        }

        if (Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown)
        {
            return [UnavailableReason.MissingLifecycleSupport];
        }

        if (SurfaceKind is TenantDetailSurfaceKind.Stale || Freshness is not ReadModelFreshnessState.Current)
        {
            return [UnavailableReason.StaleData];
        }

        if (role is TenantRole.Unknown)
        {
            return [UnavailableReason.MissingPermission];
        }

        // Contention is reported only once the prerequisites that would block the action anyway have been
        // cleared. Reporting it first masked missing permission, stale evidence and disabled lifecycle
        // behind "another command is already in progress" for as long as any command held the aggregate.
        if (!string.IsNullOrWhiteSpace(CommandSurfaceUnavailableReason))
        {
            return [UnavailableReason.AggregateLocked];
        }

        return [];
    }

    // Paging while a member command flow is open unmounts that flow: ActiveChangeRoleMember and
    // ActiveRemoveMember resolve against Members.Rows, and the target is absent from the next page, so the
    // @if guard tears the component down mid-command and its lifecycle state, receipt and projection
    // confirmation go with it. The active user id also survives paging, so returning silently re-opened a
    // flow the operator never re-initiated.
    private bool HasOpenMemberCommandFlow
        => _activeChangeRoleUserId is not null || _activeRemoveMemberUserId is not null;

    // internal, not private: these guards exist for the click dispatched BEFORE the Disabled re-render
    // lands, so asserting the rendered `disabled` attribute cannot observe them -- every guard here could be
    // deleted with the suite still green. The test project has InternalsVisibleTo and invokes them directly.
    internal Task RequestNextPageAsync()
        => Members.HasMore && !Members.IsRefreshing && !HasOpenMemberCommandFlow
            ? OnNextPageRequested.InvokeAsync()
            : Task.CompletedTask;

    internal Task RequestPreviousPageAsync()
        => CanGoPrevious && !Members.IsRefreshing && !HasOpenMemberCommandFlow
            ? OnPreviousPageRequested.InvokeAsync()
            : Task.CompletedTask;

    // A denial read withdraws the caller's right to see this membership at all, so a captured flow target can
    // no longer be rendered: continuing to show the member's identifier and role after an Unauthorized or
    // NotFound would leak exactly what the authorization-safe absence rule forbids. The teardown is therefore
    // correct here and is NOT gated on an open flow -- what it must not do is strand the lease, which
    // ReleaseChildCommandActivityAsync below now prevents.
    //
    // Unavailable and Error are deliberately absent. They are operational failures, not denials: the caller's
    // rights are unchanged and a command that was really submitted still owns a receipt to render. Folding
    // them in here let one API blip destroy an in-flight member removal's Confirmed/Rejected/UnableToVerify
    // state, safe message and audit entry point. Degraded/Stale/Unknown were already excluded for the same
    // reason. This list is kept identical to TenantDetailPage.IsTerminalMemberPage -- two predicates for one
    // concept is how they drifted apart.
    private bool HasTerminalMemberRead
        => Members.Kind is TenantUsersSurfaceKind.Unauthorized
            or TenantUsersSurfaceKind.NotFound
            or TenantUsersSurfaceKind.Invalid;

    protected override async Task OnParametersSetAsync()
    {
        // Clear any open flow target when the rendered page changes. Without this the active user id
        // outlives the page it belonged to, so returning to that page re-opens a change-role or remove flow
        // the operator never re-initiated.
        //
        // A terminal member read clears it too. Those snapshots come from EmptyState, which leaves
        // RequestCursor null, so on page one the cursor comparison below sees no change and the reset never
        // fired: the rows blanked to the denial or outage state while the flow region kept rendering the
        // captured member's identifier and role from _activeRemoveMemberCapture, and HasOpenMemberCommandFlow
        // held both pager buttons disabled behind a flow the operator had no way to close.
        if (HasTerminalMemberRead
            || !string.Equals(_renderedTenantId, Detail.TenantId, StringComparison.Ordinal)
            || !string.Equals(_renderedMemberCursor, Members.RequestCursor, StringComparison.Ordinal))
        {
            _renderedTenantId = Detail.TenantId;
            _renderedMemberCursor = Members.RequestCursor;
            bool hadOpenFlow = HasOpenMemberCommandFlow;
            _activeChangeRoleUserId = null;
            _activeRemoveMemberUserId = null;
            _activeChangeRoleCapture = null;
            _activeRemoveMemberCapture = null;
            _focusChangeRoleLaunchUserId = null;
            _focusRemoveMemberLaunchUserId = null;

            // The flow that owned the lease is gone with the branch that rendered it, and no member flow
            // implements disposal, so nothing downstream will ever send activity false. Without this release
            // TenantDetailPage._commandInFlight stayed raised for the life of the circuit and every command
            // surface on the page -- lifecycle, metadata, configuration, membership -- was disabled behind a
            // command no longer on screen.
            if (hadOpenFlow
                && _childCommandLeaseOwner is MemberCommandLeaseOwner.ChangeRole
                    or MemberCommandLeaseOwner.RemoveMember)
            {
                await ReleaseChildCommandActivityAsync().ConfigureAwait(false);
            }
        }
    }

    // The member flows used to pass OnCommandActivityChanged straight through, so this landmark never learned
    // it owned an in-flight command and could not release the lease when it tore a flow down.
    private Task<bool> HandleAddCommandActivityLeaseAsync(bool isActive)
        => HandleCommandActivityLeaseAsync(MemberCommandLeaseOwner.Add, isActive);

    private Task<bool> HandleChangeRoleCommandActivityLeaseAsync(bool isActive)
        => HandleCommandActivityLeaseAsync(MemberCommandLeaseOwner.ChangeRole, isActive);

    private Task<bool> HandleRemoveMemberCommandActivityLeaseAsync(bool isActive)
        => HandleCommandActivityLeaseAsync(MemberCommandLeaseOwner.RemoveMember, isActive);

    private async Task<bool> HandleCommandActivityLeaseAsync(MemberCommandLeaseOwner owner, bool isActive)
    {
        if (isActive && _childCommandLeaseOwner is not null)
        {
            return false;
        }

        if (!isActive && _childCommandLeaseOwner != owner)
        {
            return true;
        }

        bool accepted = CommandActivityLease is not null
            ? await CommandActivityLease(isActive).ConfigureAwait(false)
            : true;
        if (isActive && !accepted)
        {
            return false;
        }

        _childCommandLeaseOwner = isActive ? owner : null;
        if (CommandActivityLease is null)
        {
            await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
        }

        return true;
    }

    /// <summary>
    /// Forwards a SignalR / read-refresh nudge into any in-flight membership flow without confirming
    /// from the notification alone. Flows re-query authoritative status; locks release only via status path.
    /// </summary>
    internal async Task ApplySignalRNudgeAsync()
    {
        if (_addMemberFlow is not null
            && TenantCommandFlowGuard.RetainsCommandActivity(_addMemberFlow.Snapshot.State))
        {
            await _addMemberFlow.HandleAuthoritativeRefreshNudgeAsync().ConfigureAwait(false);
        }

        if (_changeRoleFlow is not null
            && TenantCommandFlowGuard.RetainsCommandActivity(_changeRoleFlow.Snapshot.State))
        {
            await _changeRoleFlow.HandleAuthoritativeRefreshNudgeAsync().ConfigureAwait(false);
        }

        if (_removeMemberFlow is not null
            && TenantCommandFlowGuard.RetainsCommandActivity(_removeMemberFlow.Snapshot.State))
        {
            await _removeMemberFlow.HandleAuthoritativeRefreshNudgeAsync().ConfigureAwait(false);
        }
    }

    private async Task ReleaseChildCommandActivityAsync()
    {
        if (_childCommandLeaseOwner is null)
        {
            return;
        }

        _childCommandLeaseOwner = null;
        if (CommandActivityLease is not null)
        {
            _ = await CommandActivityLease(false).ConfigureAwait(false);
        }
        else
        {
            await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(false)).ConfigureAwait(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusChangeRoleLaunchUserId is not null
            && _changeRoleLaunchElements.TryGetValue(_focusChangeRoleLaunchUserId, out ElementReference launchElement))
        {
            _focusChangeRoleLaunchUserId = null;
            await launchElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRemoveMemberLaunchUserId is not null
            && _removeMemberLaunchElements.TryGetValue(_focusRemoveMemberLaunchUserId, out ElementReference removeLaunchElement))
        {
            _focusRemoveMemberLaunchUserId = null;
            await removeLaunchElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private void OpenChangeRole(TenantMember member)
    {
        _activeRemoveMemberUserId = null;
        _activeRemoveMemberCapture = null;
        _activeChangeRoleUserId = member.UserId;
        _activeChangeRoleCapture = member;
    }

    private void OpenRemoveMember(TenantMember member)
    {
        _activeChangeRoleUserId = null;
        _activeChangeRoleCapture = null;
        _activeRemoveMemberUserId = member.UserId;
        _activeRemoveMemberCapture = member;
    }

    private bool ResolveTargetGlobalAdministratorFriction(TenantMember? member)
        => member is not null
        && GlobalAdministrators?.Rows.Any(row =>
            string.Equals(row.UserId, member.UserId, StringComparison.Ordinal)
            && row.Freshness is ReadModelFreshnessState.Current
            && row.Lifecycle is ProjectionLifecycleState.Current) == true;

    private async Task CloseChangeRoleAsync()
    {
        // Capture the launching member before clearing it so focus returns to that exact row's
        // "Change role" control once the flow region is removed and the table re-renders.
        _focusChangeRoleLaunchUserId = _activeChangeRoleUserId;
        _activeChangeRoleUserId = null;
        _activeChangeRoleCapture = null;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private async Task CloseRemoveMemberAsync()
    {
        _focusRemoveMemberLaunchUserId = _activeRemoveMemberUserId;
        _activeRemoveMemberUserId = null;
        _activeRemoveMemberCapture = null;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private string ActionLabel(MemberAction action)
        => Localizer[$"Tenants.Members.Action.{action}"];

    private string RoleLabel(TenantRole role)
        => Localizer[$"Tenants.Members.Role.{role}"];

    private static string RoleIcon(TenantRole role)
        => role switch
        {
            TenantRole.TenantOwner => "O",
            TenantRole.TenantContributor => "C",
            TenantRole.TenantReader => "R",
            _ => "?",
        };

    private string ReasonLabel(UnavailableReason reason)
        => reason is UnavailableReason.AggregateLocked && !string.IsNullOrWhiteSpace(CommandSurfaceUnavailableReason)
            ? CommandSurfaceUnavailableReason
            : Localizer[$"Tenants.Members.UnavailableReason.{reason}"];

    private string ReasonSummary(IReadOnlyList<UnavailableReason> reasons)
        => string.Join(", ", reasons.Select(ReasonLabel));

    private static string ReasonTestId(UnavailableReason reason)
        => $"tenants-member-reason-{ReasonSlug(reason)}";

    private static string ReasonSlug(UnavailableReason reason)
        => reason switch
        {
            UnavailableReason.MissingPermission => "missing-permission",
            UnavailableReason.StaleData => "stale-data",
            UnavailableReason.MissingLifecycleSupport => "missing-lifecycle-support",
            UnavailableReason.MissingConsequencePreview => "missing-consequence-preview",
            UnavailableReason.MissingAuditProof => "missing-audit-proof",
            UnavailableReason.HighImpactFlowNotReady => "high-impact-flow-not-ready",
            UnavailableReason.AggregateLocked => "aggregate-locked",
            _ => "unknown",
        };

    private static string ReasonIcon(UnavailableReason reason)
        => reason switch
        {
            UnavailableReason.MissingPermission => "!",
            UnavailableReason.StaleData => "!",
            UnavailableReason.MissingLifecycleSupport => "!",
            UnavailableReason.MissingConsequencePreview => "?",
            UnavailableReason.MissingAuditProof => "?",
            UnavailableReason.HighImpactFlowNotReady => "!",
            UnavailableReason.AggregateLocked => "!",
            _ => "?",
        };

    private sealed record MemberRow(
        TenantMember Member,
        string ReasonElementId,
        IReadOnlyList<ActionSlot> ActionSlots,
        IReadOnlyList<UnavailableReason> Reasons);

    private sealed record ActionSlot(MemberAction Action, IReadOnlyList<UnavailableReason> Reasons);

    private enum MemberAction
    {
        AddMember,
        ChangeRole,
        RemoveMember,
    }

    private enum UnavailableReason
    {
        MissingPermission,
        StaleData,
        MissingLifecycleSupport,
        MissingConsequencePreview,
        MissingAuditProof,
        HighImpactFlowNotReady,
        AggregateLocked,
    }

    private enum MemberCommandLeaseOwner
    {
        Add,
        ChangeRole,
        RemoveMember,
    }

    public async ValueTask DisposeAsync()
    {
        await ReleaseChildCommandActivityAsync().ConfigureAwait(false);
    }
}
