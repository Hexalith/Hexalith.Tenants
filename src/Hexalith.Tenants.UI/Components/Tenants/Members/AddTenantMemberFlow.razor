@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.Tenants.UI.State.TenantList
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services

<section class="tenants-add-member-flow"
         data-testid="tenants-add-member-flow"
         aria-labelledby="tenants-add-member-heading">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.65rem" Class="tenants-add-member-flow__heading">
        <h3 id="tenants-add-member-heading">@Localizer["Tenants.AddMember.Title"]</h3>
        <p>@Localizer["Tenants.AddMember.Description", Detail.TenantId, OwnerCount]</p>
    </FluentStack>

    @if (!string.IsNullOrWhiteSpace(UnavailableReason))
    {
        <p class="tenants-add-member-flow__unavailable"
           data-testid="tenants-add-member-unavailable-reason"
           role="alert">
            @UnavailableReason
        </p>
    }

    <EditForm Model="@_formModel"
              FormName="tenants-add-member-flow"
              class="tenants-add-member-flow__form"
              OnSubmit="SubmitAsync">
        <div class="tenants-add-member-flow__field">
            <FluentTextInput Id="tenants-add-member-user-id"
                             @ref="_userIdElement"
                             name="member-user-id"
                             Label="@Localizer["Tenants.AddMember.UserId.Label"]"
                             Value="@_userId"
                             ValueChanged="OnUserIdInput"
                             data-testid="tenants-add-member-user-id"
                             aria-describedby="@UserIdDescribedBy" />
            <span id="tenants-add-member-user-id-help">@Localizer["Tenants.AddMember.UserId.Help"]</span>
        </div>

        <div class="tenants-add-member-flow__field" @ref="_roleElement" tabindex="-1">
            <FluentSelect TOption="string" TValue="string"
                          Id="tenants-add-member-role"
                          name="member-role"
                          Label="@Localizer["Tenants.AddMember.Role.Label"]"
                          Placeholder="@Localizer["Tenants.AddMember.Role.Placeholder"]"
                          Value="@_roleValue"
                          ValueChanged="OnRoleChanged"
                          data-testid="tenants-add-member-role"
                          aria-describedby="@RoleDescribedBy">
                @foreach (TenantRole role in AssignableRoles)
                {
                    <FluentOption TValue="string" Value="@role.ToString()">@RoleLabel(role)</FluentOption>
                }
            </FluentSelect>
        </div>

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <p id="tenants-add-member-validation"
               class="tenants-add-member-flow__validation"
               data-testid="tenants-add-member-validation"
               role="alert">
                @_validationMessage
            </p>
        }

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom" Class="tenants-add-member-flow__actions">
            <FluentButton Type="ButtonType.Submit"
                          Appearance="ButtonAppearance.Primary"
                          data-testid="tenants-add-member-submit"
                          Disabled="@IsSubmitDisabled">
                @Localizer["Tenants.AddMember.Submit"]
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          data-testid="tenants-add-member-refresh"
                          Disabled="@(!CanRefresh)"
                          OnClick="RefreshStatusAsync">
                @Localizer["Tenants.AddMember.Refresh"]
            </FluentButton>
            @if (CanContinueReadOnly)
            {
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-add-member-continue-read-only"
                              OnClick="ContinueReadOnlyAsync">
                    @Localizer["Tenants.AddMember.Action.ContinueReadOnly"]
                </FluentButton>
            }
        </FluentStack>
    </EditForm>

    <section class="tenants-add-member-flow__lifecycle"
             @ref="_lifecycleElement"
             tabindex="-1"
             id="tenants-add-member-lifecycle" data-testid="tenants-add-member-lifecycle"
             aria-labelledby="tenants-add-member-state-label">
        <h4 id="tenants-add-member-state-label">@Localizer["Tenants.AddMember.Lifecycle.Title"]</h4>
        <p class="@StateClass" data-testid="tenants-add-member-state">
            <span aria-hidden="true">@StateSymbol</span>
            <span>@StateText</span>
        </p>
        <div data-testid="tenants-add-member-audit">
            @if (ShouldRenderAuditEntryPoint)
            {
                <AuditAvailabilityState AuditState="@_snapshot.AuditState"
                                        Source="add-member"
                                        OwnerRefreshIncludesAuditAuthority="true"
                                        OnRefresh="@(CanRequeryAudit ? EventCallback.Factory.Create(this, RefreshStatusAsync) : default(EventCallback))"
                                        OnContinueReadOnly="ContinueReadOnlyAsync"
                                        InspectAuditAction="@CommandAuditEntryPoint" />
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(DisplaySafeMessage))
        {
            <p data-testid="tenants-add-member-safe-message">@DisplaySafeMessage</p>
        }
        <p class="tenants-add-member-flow__live"
           data-testid="tenants-add-member-live-region"
           aria-live="@LiveRegionMode"
           aria-atomic="true">
            @StateText
        </p>
    </section>
</section>

@code {
    [CascadingParameter(Name = "AuditReadAvailable")]
    public bool AuditReadAvailable { get; set; }

    [CascadingParameter(Name = "AuditReadPending")]
    public bool AuditReadPending { get; set; }

    [CascadingParameter(Name = "AuditReadDenied")]
    public bool AuditReadDenied { get; set; }

    [CascadingParameter(Name = "AuditReadUnavailableReason")]
    public string? AuditReadUnavailableReason { get; set; }

    [CascadingParameter(Name = "DetailAuditReturnUrl")]
    public string? DetailAuditReturnUrl { get; set; }

    private static readonly TenantRole[] AssignableRoles =
    [
        TenantRole.TenantOwner,
        TenantRole.TenantContributor,
        TenantRole.TenantReader,
    ];

    private readonly object _formModel = new();
    private TenantAddMemberCommandSnapshot _snapshot = TenantAddMemberCommandSnapshot.Idle();
    private string? _userId;
    private string _roleValue = string.Empty;
    private string? _validationMessage;
    private bool _isSubmitting;
    private bool _hasRaisedCommandActivity;
    private FluentTextInput _userIdElement = default!;
    private ElementReference _roleElement;
    private ElementReference _lifecycleElement;
    private bool _focusUserIdPending;
    private bool _focusRolePending;
    private bool _focusLifecyclePending;
    private TaskCompletionSource? _refreshCompletion;
    private int _refreshPending;
    private readonly AsyncLocal<bool> _isProjectionRefreshCallback = new();

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public bool IsAuthorized { get; set; } = true;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public string? CommandSurfaceUnavailableReason { get; set; }

    [Parameter]
    public string? ProjectionVersion { get; set; }

    /// <summary>
    /// Optional live projection-version reader used after parent refresh. Prefer this over the
    /// <see cref="ProjectionVersion"/> parameter, which can lag until the next render.
    /// </summary>
    [Parameter]
    public Func<string?>? ProjectionVersionProvider { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<bool, Task<bool>>? CommandActivityLease { get; set; }

    [Parameter]
    public Func<AddUserToTenant, Task<TenantDetail?>>? ProjectionEvidenceProvider { get; set; }

    internal TenantAddMemberCommandSnapshot Snapshot => _snapshot;

    private int OwnerCount
        => Detail.Members.Count(static member => member.Role == TenantRole.TenantOwner);

    private string? UnavailableReason
        => !IsAuthorized || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
            ? Localizer["Tenants.AddMember.Unavailable.Authorization"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Stale
                or TenantDetailSurfaceKind.Unavailable
                or TenantDetailSurfaceKind.Unknown
                or TenantDetailSurfaceKind.Degraded
                || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.AddMember.Unavailable.Freshness"].Value
                : Detail.Status is TenantStatus.Disabled or TenantStatus.Unknown
                    ? Localizer["Tenants.AddMember.Unavailable.TenantLifecycle"].Value
                    : (!IsCommandSurfaceAvailable && !IsOwnedCommandInFlight) || CommandGateway is null
                        ? CommandSurfaceUnavailableReason ?? Localizer["Tenants.AddMember.Unavailable.CommandSurface"].Value
                        : _isSubmitting
                            ? Localizer["Tenants.AddMember.Unavailable.InFlight"].Value
                            : null;

    private bool IsSubmitDisabled
        => IsOwnedCommandInFlight
        || !string.IsNullOrWhiteSpace(UnavailableReason);

    private bool IsOwnedCommandInFlight
        => TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State, _isSubmitting);

    private bool CanRefresh
        => !string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
        && _snapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded;

    private bool CanContinueReadOnly
        => _snapshot.State is TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded;

    private string? DisplaySafeMessage
        => !string.IsNullOrWhiteSpace(_snapshot.SafeMessageKey)
            ? Localizer[_snapshot.SafeMessageKey].Value
            : _snapshot.SafeMessage;

    private ITenantCommandGateway? CommandGateway
        => Services.GetService<ITenantCommandGateway>();

    private string StateClass
        => $"tenants-add-member-flow__state tenants-add-member-flow__state--{_snapshot.State.ToString().ToLowerInvariant()}";

    private string StateSymbol
        => _snapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            _ => ">",
        };

    private string StateText
        => Localizer[$"Tenants.AddMember.State.{_snapshot.State}"];

    // The entry point names the audit state with the shared availability label, never a flow-local duplicate.
    private string AuditStateLabel
        => TenantAuditAvailability.StateLabelKeyFor(_snapshot.AuditState) is { } key ? Localizer[key] : string.Empty;

    // Refresh is offered only while the attempt can actually be re-queried; a no-op control would only
    // exhaust the retry bound behind a misleading limit note.
    private bool CanRequeryAudit
        => !string.IsNullOrWhiteSpace(_snapshot.MessageId) && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId);

    // No fragment at all when audit read is denied, so the shared control renders no empty Inspect-audit shell.
    private RenderFragment? CommandAuditEntryPoint
        => AuditReadDenied ? null : CommandAuditEntryPointTemplate;

    private RenderFragment CommandAuditEntryPointTemplate
        => @<AuditEvidenceEntryPoint TenantId="@Detail.TenantId"
                                     TargetUserId="@_userId"
                                     SourceKind="command-result"
                                     SourceTestId="tenants-command-audit-entrypoint"
                                     Label="@Localizer["Tenants.Audit.Availability.Action.InspectAudit"]"
                                     AccessibleName="@Localizer["Tenants.Audit.EntryPoint.Accessible.Command", AuditStateLabel, Detail.TenantId]"
                                     ReturnUrl="@CommandAuditReturnUrl"
                                     ReturnFocus="tenants-add-member-lifecycle"
                                     AuthorityPending="@AuditReadPending"
                                     UnavailableReason="@AuditReadUnavailableReason"
                                     IsAvailable="@AuditReadAvailable" />;

    private bool ShouldRenderAuditEntryPoint
        => _snapshot.AuditState is not TenantCommandAuditState.NotStarted;

    private string? CommandAuditReturnUrl => DetailAuditReturnUrl;

    private string LiveRegionMode
        => _snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string UserIdDescribedBy
        => string.IsNullOrWhiteSpace(_validationMessage)
            ? "tenants-add-member-user-id-help"
            : "tenants-add-member-user-id-help tenants-add-member-validation";

    private string? RoleDescribedBy
        => string.IsNullOrWhiteSpace(_validationMessage) ? null : "tenants-add-member-validation";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusUserIdPending)
        {
            _focusUserIdPending = false;
            await _userIdElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusRolePending)
        {
            _focusRolePending = false;
            await _roleElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusLifecyclePending)
        {
            _focusLifecyclePending = false;
            await _lifecycleElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private void SetSnapshot(TenantAddMemberCommandSnapshot snapshot)
    {
        _snapshot = snapshot;
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive)
        {
            _focusLifecyclePending = true;
        }
    }

    private async Task<bool> SetCommandActivityRaisedAsync(bool isActive)
    {
        if (_hasRaisedCommandActivity == isActive)
        {
            return true;
        }

        if (CommandActivityLease is not null)
        {
            bool accepted = await CommandActivityLease(isActive).ConfigureAwait(false);
            if (isActive && !accepted)
            {
                return false;
            }
        }

        _hasRaisedCommandActivity = isActive;
        if (CommandActivityLease is null)
        {
            await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
        }

        return true;
    }

    private async Task UpdateCommandActivityForSnapshotAsync()
        => _ = await SetCommandActivityRaisedAsync(TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State, _isSubmitting)).ConfigureAwait(false);

    internal void ApplySignalRNudge()
        => _snapshot = _snapshot.SignalRNudge();

    /// <summary>
    /// SignalR / read-refresh path: nudge lifecycle, then re-query authoritative status/evidence.
    /// Does not confirm from the notification alone.
    /// </summary>
    internal async Task HandleAuthoritativeRefreshNudgeAsync()
    {
        ApplySignalRNudge();
        if (_isProjectionRefreshCallback.Value
            || (_isSubmitting && _snapshot.State is TenantCommandLifecycleState.RequestSent))
        {
            return;
        }

        await RefreshCommandStatusAsync(requestProjectionRefresh: false, waitForRunningRefresh: false).ConfigureAwait(false);
    }

    internal void ApplyProjectionEvidence(TenantDetail? detail)
        => _snapshot = _snapshot.ConfirmProjection(detail, ResolveCurrentProjectionVersion());

    private string? ResolveCurrentProjectionVersion()
        => ProjectionVersionProvider?.Invoke() ?? ProjectionVersion;

    private string RoleLabel(TenantRole role)
        => Localizer[$"Tenants.AddMember.Role.{role}"];

    private void OnUserIdInput(string? value)
        => _userId = value;

    private void OnRoleChanged(string? value)
        => _roleValue = value ?? string.Empty;

    private async Task SubmitAsync()
    {
        _validationMessage = null;

        if (!_isSubmitting && IsOwnedCommandInFlight)
        {
            // Same logical attempt still in flight: re-query status with stored tracking; never mint a second dispatch.
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            SetSnapshot(TenantAddMemberCommandSnapshot.Blocked(
                Localizer["Tenants.AddMember.Unavailable.InFlight"].Value,
                TenantCommandFocusTarget.Refresh));
            return;
        }

        if (_snapshot.State is TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded)
        {
            if (!string.IsNullOrWhiteSpace(_snapshot.MessageId)
                && !string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            // Tracking is gone, so this attempt can neither be re-queried nor safely re-dispatched. Say so:
            // returning silently left the enabled submit button doing nothing at all -- no state change, no
            // message, no announcement -- which reads as a broken control rather than a safety stop.
            SetSnapshot(_snapshot with
            {
                SafeMessage = null,
                SafeMessageKey = "Tenants.Members.Submit.TrackingLost",
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            });
            return;
        }

        if (!string.IsNullOrWhiteSpace(UnavailableReason))
        {
            SetSnapshot(TenantAddMemberCommandSnapshot.Blocked(UnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        if (string.IsNullOrWhiteSpace(_userId))
        {
            _validationMessage = Localizer["Tenants.AddMember.Validation.UserIdRequired"];
            _focusUserIdPending = true;
            return;
        }

        if (!TryParseAssignableRole(_roleValue, out TenantRole role))
        {
            _validationMessage = Localizer["Tenants.AddMember.Validation.RoleRequired"];
            _focusRolePending = true;
            return;
        }

        var request = new AddUserToTenant(Detail.TenantId, _userId, role);
        string? retryMessageId = _snapshot.State is TenantCommandLifecycleState.Failed
            && string.IsNullOrWhiteSpace(_snapshot.CorrelationId)
            && !string.IsNullOrWhiteSpace(_snapshot.MessageId)
            && Equals(_snapshot.Intent, request)
                ? _snapshot.MessageId
                : null;
        bool baselinePostconditionMet = Detail.Members.Any(member =>
            string.Equals(member.UserId, request.UserId, StringComparison.Ordinal)
            && member.Role == request.Role);
        _snapshot = TenantAddMemberCommandSnapshot.Idle()
            .RequestSent(request, ResolveCurrentProjectionVersion(), baselinePostconditionMet) with
        {
            MessageId = retryMessageId,
            CorrelationId = null,
        };

        _isSubmitting = true;
        if (!await SetCommandActivityRaisedAsync(true).ConfigureAwait(false))
        {
            _isSubmitting = false;
            SetSnapshot(TenantAddMemberCommandSnapshot.Blocked(
                CommandSurfaceUnavailableReason ?? Localizer["Tenants.AddMember.Unavailable.InFlight"].Value,
                TenantCommandFocusTarget.Submit) with
            {
                // A retry reuses an identity that may already have reached the server, so its status is unknown.
                AuditState = retryMessageId is null
                    ? TenantCommandAuditStates.NotStarted
                    : TenantCommandAuditStates.Unverifiable,
            });
            return;
        }

        try
        {
            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                SetSnapshot(TenantAddMemberCommandSnapshot.Blocked(
                    Localizer["Tenants.AddMember.Unavailable.CommandSurface"].Value,
                    TenantCommandFocusTarget.Submit) with
                {
                    // A retry reuses an identity that may already have reached the server, so its status is unknown.
                    AuditState = retryMessageId is null
                        ? TenantCommandAuditStates.NotStarted
                        : TenantCommandAuditStates.Unverifiable,
                });
                return;
            }

            TenantCommandSubmissionResult result = await gateway
                .AddUserToTenantAsync(request, retryMessageId, CancellationToken.None)
                .ConfigureAwait(false);

            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                SetSnapshot(_snapshot.Accepted(result));
                await RefreshStatusAsync().ConfigureAwait(false);
            }
            else
            {
                SetSnapshot(_snapshot with
                {
                    State = result.State,
                    MessageId = result.MessageId ?? _snapshot.MessageId,
                    CorrelationId = result.CorrelationId ?? _snapshot.CorrelationId,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = null,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditStates.FromSubmission(result),
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
            }
        }
        finally
        {
            _isSubmitting = false;
            await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
        }
    }

    private Task RefreshStatusAsync()
        => RefreshCommandStatusAsync(requestProjectionRefresh: true);

    private async Task RefreshCommandStatusAsync(bool requestProjectionRefresh, bool waitForRunningRefresh = true)
    {
        // The running refresh doubles as the in-flight gate, so a merged request can wait for exactly the
        // refresh (and replay) that will serve it. The replay request is written before the gate is tried: an
        // owner finishing between a failed gate and a later write would release this caller without running it.
        // An owner clears it before its first lookup.
        Volatile.Write(ref _refreshPending, 1);
        TaskCompletionSource completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
        if (Interlocked.CompareExchange(ref _refreshCompletion, completion, null) is { } running)
        {
            // A request merged into the refresh already running is served by that refresh's replay. Waiting for
            // it keeps the caller (for example the shared audit control's bounded Refresh) from observing an
            // unchanged state before the replay has run. A SignalR nudge does not wait.
            if (waitForRunningRefresh)
            {
                await running.Task.ConfigureAwait(false);
            }

            return;
        }

        try
        {
            try
            {
                bool refreshProjection = requestProjectionRefresh;
                do
                {
                    Volatile.Write(ref _refreshPending, 0);
                    await RefreshCommandStatusCoreAsync(refreshProjection).ConfigureAwait(false);
                    refreshProjection = false;
                }
                while (Interlocked.Exchange(ref _refreshPending, 0) != 0);
            }
            finally
            {
                Volatile.Write(ref _refreshCompletion, null);
            }

            if (Interlocked.Exchange(ref _refreshPending, 0) != 0)
            {
                await RefreshCommandStatusAsync(requestProjectionRefresh: false).ConfigureAwait(false);
            }
        }
        finally
        {
            completion.TrySetResult();
        }
    }

    private async Task RefreshCommandStatusCoreAsync(bool requestProjectionRefresh)
    {
        if (string.IsNullOrWhiteSpace(_snapshot.MessageId) || string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
        {
            if (TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State)
                || _snapshot.State is TenantCommandLifecycleState.UnableToVerify
                    or TenantCommandLifecycleState.Degraded)
            {
                SetSnapshot(_snapshot with
                {
                    State = TenantCommandLifecycleState.UnableToVerify,
                    SafeMessage = Localizer["Tenants.AddMember.Unavailable.CommandSurface"].Value,
                    SafeMessageKey = null,
                    AuditState = TenantCommandAuditStates.Unverifiable,
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            }

            return;
        }

        ITenantCommandGateway? gateway = CommandGateway;
        if (gateway is null)
        {
            SetSnapshot(_snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(Localizer["Tenants.AddMember.Unavailable.CommandSurface"].Value)));
            await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
            return;
        }

        TenantCommandStatusResult status = await gateway
            .GetStatusAsync(new TenantCommandTrackingHandle(_snapshot.MessageId, _snapshot.CorrelationId), CancellationToken.None)
            .ConfigureAwait(false);
        SetSnapshot(_snapshot.ApplyStatus(status));

        if (requestProjectionRefresh)
        {
            _isProjectionRefreshCallback.Value = true;
            try
            {
                await InvokeAsync(() => OnProjectionRefreshRequested.InvokeAsync()).ConfigureAwait(false);
            }
            finally
            {
                _isProjectionRefreshCallback.Value = false;
            }
        }

        if (_snapshot.Intent is not null && ProjectionEvidenceProvider is not null)
        {
            TenantDetail? evidence = await ProjectionEvidenceProvider(_snapshot.Intent).ConfigureAwait(false);
            SetSnapshot(_snapshot.ConfirmProjection(evidence, ResolveCurrentProjectionVersion()));
        }

        await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
    }

    private async Task ContinueReadOnlyAsync()
    {
        SetSnapshot(TenantAddMemberCommandSnapshot.Idle());

        // The polite Idle snapshot unmounts the shared control and the button that had focus, so focus moves to
        // the lifecycle section instead of falling back to the document body.
        _focusLifecyclePending = true;
        _ = await SetCommandActivityRaisedAsync(false).ConfigureAwait(false);
    }

    private static bool TryParseAssignableRole(string value, out TenantRole role)
    {
        if (Enum.TryParse(value, ignoreCase: false, out role)
            && AssignableRoles.Contains(role))
        {
            return true;
        }

        role = TenantRole.Unknown;
        return false;
    }
}
