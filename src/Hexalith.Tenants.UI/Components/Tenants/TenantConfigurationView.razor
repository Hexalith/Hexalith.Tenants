@using Hexalith.Tenants.UI.State.TenantDetail
@inject IStringLocalizer<TenantsResources> Localizer

<section class="tenant-config"
         aria-labelledby="tenants-config-read-heading"
         data-testid="tenants-config-read-section">
    <header class="tenant-config__header">
        <div>
            <h2 id="tenants-config-read-heading">@Localizer["Tenants.Configuration.Title"]</h2>
            <p>@Localizer["Tenants.Configuration.Description"]</p>
            <p class="tenant-config__scope">@Localizer["Tenants.Configuration.ScopeNotice"]</p>
        </div>
        <div class="tenant-config__truth" data-testid="tenants-config-read-truth-state">
            <ProjectionLifecycleStatus Lifecycle="@Lifecycle"
                                       TestId="tenants-config-read-projection-lifecycle-status"
                                       BadgeTestId="tenants-config-read-projection-lifecycle-badge" />
            <TruthStateBadge Freshness="@EffectiveFreshness"
                             TestId="tenants-config-read-truth-badge"
                             ResourcePrefix="Tenants.Configuration" />
        </div>
    </header>

    @* The state section is the single owner of the truth sentence and the only live region for it. It was
       previously rendered only when the region could not be inspected, so stale, degraded, unknown and
       non-current-lifecycle reads announced their result count and never announced their state, while the
       unavailable sentence was duplicated between here and the header. *@
    @if (HasNonCurrentState)
    {
        @* role and aria-live have to agree. role="status" carries an implicit aria-live="polite", so
           pairing it with assertive is contradictory and screen readers resolve it inconsistently — the
           detail page fixed exactly this by switching role with the escalation, and this landmark widened
           the contradiction instead of inheriting the fix. *@
        <section class="tenant-config__state"
                 data-testid="tenants-config-read-state"
                 data-state="@StateKind"
                 role="@StateRole"
                 aria-live="@LivePoliteness">
            <h3>@StateTitle</h3>
            <p>@StateMessage</p>
        </section>
    }

    @if (CanInspect)
    {
        @if (Rows.Count > 0)
        {
            <div class="tenant-config__controls"
                 role="search"
                 aria-label="@Localizer["Tenants.Configuration.Filter.Label"]">
                <FluentTextInput Id="tenants-config-read-filter"
                                 Class="tenant-config__filter"
                                 Label="@Localizer["Tenants.Configuration.Filter.Label"]"
                                 data-testid="tenants-config-read-filter"
                                 Value="@_filter"
                                 ValueChanged="OnFilterChanged"
                                 Placeholder="@Localizer["Tenants.Configuration.Filter.Placeholder"]"
                                 aria-describedby="tenants-config-read-filter-help" />
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Class="tenant-config__clear"
                              data-testid="tenants-config-read-clear-filter"
                              OnClick="ClearFilter">
                    @Localizer["Tenants.Configuration.ClearFilter"]
                </FluentButton>
                <p id="tenants-config-read-filter-help">@Localizer["Tenants.Configuration.Filter.Help"]</p>
            </div>
        }

        @* Routine result counts are always polite: assertive belongs to the truth state above, not to a
           row tally. The empty panels below are described by this region and therefore carry no role of
           their own — two live regions fired simultaneously for a single state change. That description
           has to be a real association: the region carried no id and nothing referenced it, so the claim
           held only in this comment. It now has one, and both empty panels point at it. *@
        <p id="tenants-config-read-announcer"
           class="tenant-config__announcer"
           role="status"
           aria-live="polite"
           aria-atomic="true"
           data-testid="tenants-config-read-announcer">
            @Announcement
        </p>

        @if (Rows.Count == 0)
        {
            <section class="tenant-config__state"
                     aria-describedby="tenants-config-read-announcer"
                     data-testid="tenants-config-read-empty">
                <h3>@Localizer["Tenants.Configuration.State.Empty.Title"]</h3>
                <p>@Localizer["Tenants.Configuration.State.Empty"]</p>
            </section>
        }
        else if (FilteredRows.Count == 0)
        {
            <section class="tenant-config__state"
                     aria-describedby="tenants-config-read-announcer"
                     data-testid="tenants-config-read-filtered-empty">
                <h3>@Localizer["Tenants.Configuration.State.FilteredEmpty.Title"]</h3>
                <p>@Localizer["Tenants.Configuration.State.FilteredEmpty"]</p>
            </section>
        }
        else
        {
            <div class="tenant-config__table-wrap"
                 data-testid="tenants-config-read-table"
                 role="region"
                 tabindex="0"
                 aria-label="@Localizer["Tenants.Configuration.Table.AccessibleLabel"]">
                <p class="tenant-config__table-caption">@Localizer["Tenants.Configuration.Table.Caption"]</p>
                <FluentAccordion Class="tenant-config__groups"
                                 ExpandMode="AccordionExpandMode.Multi"
                                 Block="true">
                    @foreach (IGrouping<string, TenantConfigurationSafeRow> group in FilteredRows.GroupBy(static row => row.Namespace))
                    {
                        @* Keyed by namespace: without it Blazor reuses accordion items positionally and the
                           component's DOM-held collapsed state follows position instead of namespace. *@
                        <FluentAccordionItem @key="group.Key"
                                             Header="@Localizer["Tenants.Configuration.GroupLabel", group.Key]"
                                             Expanded="true">
                            <div class="tenant-config__group" data-testid="tenants-config-read-group">
                                <FluentDataGrid Items="@group.AsQueryable()"
                                                ItemKey="@(row => row.Key)"
                                                Class="tenant-config__data-grid"
                                                ResizableColumns="true"
                                                ReorderableColumns="false"
                                                GenerateHeader="DataGridGeneratedHeaderType.Sticky">
                                    <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Namespace"]"
                                                    ColumnId="configuration-namespace"
                                                    Width="180px">
                                        <code data-testid="tenants-config-read-namespace">@context.Namespace</code>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Key"]"
                                                    ColumnId="configuration-key"
                                                    Width="280px">
                                        @* aria-label is prohibited on role=code, so AT dropped it and the
                                           literal was announced from text content anyway. *@
                                        <code data-testid="tenants-config-read-key">@context.Key</code>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Value"]"
                                                    ColumnId="configuration-value"
                                                    Width="320px">
                                        <code class="tenant-config__value"
                                              data-testid="tenants-config-read-value">@context.Value</code>
                                    </TemplateColumn>
                                </FluentDataGrid>
                            </div>
                        </FluentAccordionItem>
                    }
                </FluentAccordion>
            </div>
        }
    }
</section>

@code {
    private string _filter = string.Empty;

    [Parameter]
    public TenantConfigurationSafeModel Model { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    private IReadOnlyList<TenantConfigurationSafeRow> Rows
        => Model?.Rows ?? [];

    private IReadOnlyList<TenantConfigurationSafeRow> FilteredRows
        => string.IsNullOrWhiteSpace(_filter)
            ? Rows
            : Rows

                // Ordinal, like every other comparison in this feature. Culture-sensitive matching
                // applies ICU collation, so an NFD filter matched an NFC key the policy treats as
                // different, a zero-width space matched every row, and EN/FR produced different
                // results over identical literals.
                .Where(row => row.Namespace.Contains(_filter, StringComparison.OrdinalIgnoreCase)
                    || row.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase))
                .ToArray();

    private bool CanInspect
        => Model?.IsAvailable == true
        && SurfaceKind is TenantDetailSurfaceKind.Ready or TenantDetailSurfaceKind.Stale or TenantDetailSurfaceKind.Degraded;

    private bool IsDegraded
        => Model?.IsDegraded == true || SurfaceKind is TenantDetailSurfaceKind.Degraded;

    // Lifecycle is part of the truth model, not decoration. It was rendered as a badge but excluded from
    // every state predicate, so Lifecycle=Unavailable with Freshness=Current produced an "Unavailable"
    // badge beside a "Current" badge and no sentence at all. Both command flows already refuse to act
    // unless the lifecycle is Current; the read landmark was the only surface ignoring it.
    private bool HasNonCurrentLifecycle
        => Lifecycle is not ProjectionLifecycleState.Current;

    private bool HasNonCurrentState
        => !CanInspect
        || IsDegraded
        || HasNonCurrentLifecycle
        || EffectiveFreshness is not ReadModelFreshnessState.Current;

    private ReadModelFreshnessState EffectiveFreshness
        => IsDegraded ? ReadModelFreshnessState.Unknown : Freshness;

    // Degraded and Unknown share a truth badge because a degraded read must not claim Current. They stay
    // distinguishable through the state section's title, message and this text-independent discriminator.
    private string StateKind
        => StateResourcePrefix["Tenants.Configuration.State.".Length..];

    private string Announcement
        => Localizer[
            "Tenants.Configuration.Announcement.Results",
            FilteredRows.Count,
            FilteredRows.Select(static row => row.Namespace).Distinct(StringComparer.Ordinal).Count()];

    private string StateTitle
        => Localizer[StateResourcePrefix + ".Title"];

    private string StateMessage
        => Localizer[StateResourcePrefix];

    // Loading is tested before availability: a loading snapshot legitimately carries an unavailable
    // model, so ordering availability first made the loading state unreachable and reported a
    // still-arriving read as unavailable. Loading is reachable for a consumer that renders this landmark
    // outside FcAggregateDetailPage's ReadyContent; the tenant detail page cannot produce it.
    // Aging is classified with Stale rather than falling through to Ready, which previously rendered
    // "evidence is current" beside a warning Aging badge. It is anticipatory and deliberately retained:
    // ResolveFreshness returns only Current/Stale/Unknown today and Aging is dormant on the wire, so no
    // producer can reach this arm — but Aging is a member of the shared platform enum, and the arm exists so
    // that wiring it later cannot silently reintroduce "current" copy over an aged read. Kept, not covered.
    private string StateResourcePrefix
        => SurfaceKind is TenantDetailSurfaceKind.Loading
            ? "Tenants.Configuration.State.Loading"
            : Model?.IsAvailable != true || SurfaceKind is TenantDetailSurfaceKind.Unavailable
                ? "Tenants.Configuration.State.Unavailable"
                : IsDegraded
                    ? "Tenants.Configuration.State.Degraded"
                    : SurfaceKind is TenantDetailSurfaceKind.Stale
                        || Freshness is ReadModelFreshnessState.Stale or ReadModelFreshnessState.Aging
                        ? "Tenants.Configuration.State.Stale"
                        : Freshness is ReadModelFreshnessState.Unknown || SurfaceKind is TenantDetailSurfaceKind.Unknown
                            ? "Tenants.Configuration.State.Unknown"

                            // Last, so it reports only what freshness does not already say: a lifecycle that
                            // is not Current while the read itself looks fine. This is the case that used to
                            // fall through to Ready — "evidence is current" beside an Unavailable badge.
                            //
                            // The copy is deliberately lifecycle-neutral. This arm covers Unknown, Stale,
                            // Rebuilding, Degraded, Unavailable and LocalOnly, and the reachable shape is
                            // Freshness=Current with Lifecycle=Unknown — no lifecycle header on the wire.
                            // The title therefore says "not current", not "rebuilding": asserting a rebuild
                            // that is not happening conflates two truth states this landmark exists to keep
                            // apart, and Unknown means the UI has no lifecycle evidence at all.
                            : HasNonCurrentLifecycle
                                ? "Tenants.Configuration.State.ProjectionLifecycle"
                                : "Tenants.Configuration.State.Ready";

    private string StateRole
        => string.Equals(LivePoliteness, "assertive", StringComparison.Ordinal) ? "alert" : "status";

    private string LivePoliteness
        => IsDegraded
            || !CanInspect
            || Lifecycle is ProjectionLifecycleState.Unavailable
            || SurfaceKind is TenantDetailSurfaceKind.Unknown
                ? "assertive"
                : "polite";

    private void OnFilterChanged(string? value)
        => _filter = value ?? string.Empty;

    private void ClearFilter()
        => _filter = string.Empty;
}
