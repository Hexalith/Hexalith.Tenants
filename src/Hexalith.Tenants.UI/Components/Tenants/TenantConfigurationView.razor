@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.Components.Tenants.Configuration
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Hexalith.Tenants.UI.State.TenantList
@inject IStringLocalizer<TenantsResources> Localizer

<section class="tenant-config"
         aria-labelledby="tenants-config-heading"
         data-testid="tenants-config-section">
    <header class="tenant-config__header">
        <div>
            <h2 id="tenants-config-heading">@Localizer["Tenants.Configuration.Title"]</h2>
            <p>@Localizer["Tenants.Configuration.Description"]</p>
            <p class="tenant-config__scope">@Localizer["Tenants.Configuration.ScopeNotice"]</p>
        </div>
        <div class="tenant-config__truth" data-testid="tenants-config-truth-state">
            <TruthStateBadge Freshness="@Freshness"
                             TestId="tenants-config-truth-badge"
                             ResourcePrefix="Tenants.Configuration" />
            @if (SurfaceKind is TenantDetailSurfaceKind.Stale or TenantDetailSurfaceKind.Degraded)
            {
                <p>@StateMessage</p>
            }
        </div>
    </header>

    @if (IsCommandPreviewBlocked)
    {
        <p class="tenant-config__state"
           data-testid="tenants-config-command-unavailable">
            @Localizer["Tenants.Configuration.CommandUnavailable"]
        </p>
    }

    <SetTenantConfigurationFlow Detail="@Detail"
                                SurfaceKind="@SurfaceKind"
                                Freshness="@Freshness"
                                IsAuthorized="@IsAuthorized"
                                IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                OnCommandActivityChanged="@OnCommandActivityChanged"
                                ProjectionEvidenceProvider="@ProjectionEvidenceProvider" />

    @if (!string.IsNullOrWhiteSpace(_removeKey))
    {
        <RemoveTenantConfigurationFlow Detail="@Detail"
                                       TargetKey="@_removeKey"
                                       SurfaceKind="@SurfaceKind"
                                       Freshness="@Freshness"
                                       IsAuthorized="@IsAuthorized"
                                       IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                       OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                       OnCommandActivityChanged="@OnCommandActivityChanged"
                                       OnCloseRequested="@CloseRemoveFlowAsync"
                                       ProjectionEvidenceProvider="@RemoveProjectionEvidenceProvider" />
    }

    <div class="tenant-config__controls" role="search" aria-label="@Localizer["Tenants.Configuration.Filter.Label"]">
        <FluentTextInput Id="tenants-config-filter"
                         Class="tenant-config__filter"
                         Label="@Localizer["Tenants.Configuration.Filter.Label"]"
                         data-testid="tenants-config-filter"
                         Value="@_filter"
                         ValueChanged="OnFilterChanged"
                         Placeholder="@Localizer["Tenants.Configuration.Filter.Placeholder"]"
                         aria-describedby="tenants-config-filter-help" />
        <FluentButton Appearance="ButtonAppearance.Outline"
                      Class="tenant-config__clear"
                      data-testid="tenants-config-clear-filter"
                      OnClick="ClearFilter">
            @Localizer["Tenants.Configuration.ClearFilter"]
        </FluentButton>
        <p id="tenants-config-filter-help">@Localizer["Tenants.Configuration.Filter.Help"]</p>
    </div>

    <p class="tenant-config__announcer"
       role="status"
       aria-live="@LivePoliteness"
       data-testid="tenants-config-announcer">
        @Announcement
    </p>

    @if (Rows.Count == 0)
    {
        <section class="tenant-config__state"
                 data-testid="tenants-config-empty"
                 role="status">
            <h3>@Localizer["Tenants.Configuration.State.Empty.Title"]</h3>
            <p>@Localizer["Tenants.Configuration.State.Empty"]</p>
        </section>
    }
    else if (FilteredRows.Count == 0)
    {
        <section class="tenant-config__state"
                 data-testid="tenants-config-filtered-empty"
                 role="status">
            <h3>@Localizer["Tenants.Configuration.State.FilteredEmpty.Title"]</h3>
            <p>@Localizer["Tenants.Configuration.State.FilteredEmpty"]</p>
        </section>
    }
    else
    {
        <div class="tenant-config__table-wrap" data-testid="tenants-config-table">
            <p class="tenant-config__table-caption">@Localizer["Tenants.Configuration.Table.Caption"]</p>
            <FluentAccordion Class="tenant-config__groups"
                             ExpandMode="AccordionExpandMode.Multi"
                             Block="true">
                @foreach (IGrouping<string, ConfigurationRow> group in FilteredRows.GroupBy(static row => row.NamespaceLabel))
                {
                    <FluentAccordionItem Header="@Localizer["Tenants.Configuration.GroupLabel", group.Key]"
                                         Expanded="true">
                        <div class="tenant-config__group" data-testid="tenants-config-group">
                            <FluentDataGrid Items="@group.AsQueryable()"
                                            Class="tenant-config__data-grid"
                                            ResizableColumns="true"
                                            ReorderableColumns="false"
                                            GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                                            ItemKey="@(row => row.Key)">
                                <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Namespace"]"
                                                ColumnId="configuration-namespace"
                                                Width="180px">
                                    <span>@context.NamespaceLabel</span>
                                </TemplateColumn>
                                <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Key"]"
                                                ColumnId="configuration-key"
                                                Width="260px">
                                    <div class="tenant-config__literal-row"
                                         tabindex="0"
                                         data-testid="tenants-config-row">
                                        <code data-testid="tenants-config-key"
                                              aria-label="@Localizer["Tenants.Configuration.KeyAccessible", context.Key]">@context.Key</code>
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Value"]"
                                                ColumnId="configuration-value"
                                                Width="260px">
                                    @if (context.IsSafe)
                                    {
                                        <code class="tenant-config__value"
                                              aria-label="@Localizer["Tenants.Configuration.ValueAccessible", context.DisplayValue]">@context.DisplayValue</code>
                                    }
                                    else
                                    {
                                        <span class="tenant-config__value tenant-config__value--unavailable"
                                              aria-label="@Localizer["Tenants.Configuration.Value.Unavailable"]">@Localizer["Tenants.Configuration.Value.Unavailable"]</span>
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Safety"]"
                                                ColumnId="configuration-safety"
                                                Width="160px">
                                    <span data-testid="tenants-config-value-state">@context.SafetyLabel</span>
                                </TemplateColumn>
                                <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Freshness"]"
                                                ColumnId="configuration-freshness"
                                                Width="170px">
                                    <TruthStateBadge Freshness="@Freshness" TestId="tenants-config-row-freshness" ResourcePrefix="Tenants.Configuration" />
                                </TemplateColumn>
                                <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Actions"]"
                                                ColumnId="configuration-actions"
                                                Width="260px">
                                    <span class="tenant-config__remove-focus" tabindex="-1" @ref="_removeLaunchElements[context.Key]">
                                        <FluentButton Appearance="ButtonAppearance.Outline"
                                                      Class="tenant-config__remove"
                                                      data-testid="tenants-config-remove-open"
                                                      aria-describedby="@RemoveActionDescriptionId(context.Key)"
                                                      Disabled="@(!string.IsNullOrWhiteSpace(RemoveUnavailableReason))"
                                                      OnClick="() => OpenRemoveFlow(context.Key)">
                                            @Localizer["Tenants.Configuration.Remove.Open"]
                                        </FluentButton>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(RemoveUnavailableReason))
                                    {
                                        <p id="@RemoveActionDescriptionId(context.Key)"
                                           class="tenant-config__remove-reason"
                                           data-testid="tenants-config-remove-unavailable-reason">
                                            @RemoveUnavailableReason
                                        </p>
                                    }
                                </TemplateColumn>
                            </FluentDataGrid>
                        </div>
                    </FluentAccordionItem>
                }
            </FluentAccordion>
        </div>
    }
</section>

@code {
    private string _filter = string.Empty;
    private string? _removeKey;
    private readonly Dictionary<string, ElementReference> _removeLaunchElements = new(StringComparer.Ordinal);
    private string? _focusRemoveLaunchKey;

    [Parameter]
    public TenantDetail Detail { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public bool IsAuthorized { get; set; } = true;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<SetTenantConfiguration, Task<TenantDetail?>>? ProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<RemoveTenantConfiguration, Task<TenantDetail?>>? RemoveProjectionEvidenceProvider { get; set; }

    private IReadOnlyList<ConfigurationRow> Rows
        => Detail.Configuration
            .OrderBy(static item => NamespaceKey(item.Key), StringComparer.Ordinal)
            .ThenBy(static item => item.Key, StringComparer.Ordinal)
            .Select(ToRow)
            .ToArray();

    private IReadOnlyList<ConfigurationRow> FilteredRows
        => string.IsNullOrWhiteSpace(_filter)
            ? Rows
            : Rows
                .Where(row => row.NamespaceLabel.Contains(_filter, StringComparison.CurrentCultureIgnoreCase)
                    || row.Key.Contains(_filter, StringComparison.CurrentCultureIgnoreCase))
                .ToArray();

    private string Announcement
        => Localizer[
            "Tenants.Configuration.Announcement.Results",
            FilteredRows.Count,
            FilteredRows.Select(static row => row.NamespaceLabel).Distinct(StringComparer.Ordinal).Count()];

    private bool IsCommandPreviewBlocked
        => SurfaceKind is TenantDetailSurfaceKind.Stale or TenantDetailSurfaceKind.Degraded or TenantDetailSurfaceKind.Unknown
            || Freshness is ReadModelFreshnessState.Stale or ReadModelFreshnessState.Unknown;

    private string? RemoveUnavailableReason
        => !IsAuthorized || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
            ? Localizer["Tenants.Configuration.Remove.Unavailable.Authorization"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown or TenantDetailSurfaceKind.Degraded
                ? Localizer["Tenants.Configuration.Remove.Unavailable.ProjectionState"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Stale || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.Configuration.Remove.Unavailable.Freshness"].Value
                : !IsCommandSurfaceAvailable
                    ? Localizer["Tenants.Configuration.Remove.Unavailable.CommandSurface"].Value
                    : string.IsNullOrWhiteSpace(Detail.TenantId)
                        ? Localizer["Tenants.Configuration.Remove.Unavailable.Identity"].Value
                        : null;

    private string LivePoliteness
        => SurfaceKind is TenantDetailSurfaceKind.Degraded or TenantDetailSurfaceKind.Unknown ? "assertive" : "polite";

    private string StateMessage
        => SurfaceKind switch
        {
            TenantDetailSurfaceKind.Stale => Localizer["Tenants.Configuration.State.Stale"],
            TenantDetailSurfaceKind.Degraded => Localizer["Tenants.Configuration.State.Degraded"],
            _ => string.Empty,
        };

    private void OnFilterChanged(string? value)
        => _filter = value ?? string.Empty;

    private void ClearFilter()
        => _filter = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRemoveLaunchKey is not null
            && _removeLaunchElements.TryGetValue(_focusRemoveLaunchKey, out ElementReference launchElement))
        {
            _focusRemoveLaunchKey = null;
            await launchElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private void OpenRemoveFlow(string key)
        => _removeKey = key;

    private async Task CloseRemoveFlowAsync()
    {
        _focusRemoveLaunchKey = _removeKey;
        _removeKey = null;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private static string RemoveActionDescriptionId(string key)
        => $"tenants-config-remove-reason-{Math.Abs(StringComparer.Ordinal.GetHashCode(key))}";

    private ConfigurationRow ToRow(KeyValuePair<string, string> item)
    {
        bool isSafe = LegacyConfigurationDisplaySanitizer.IsDisplayable(item.Key, item.Value);
        string displayValue = isSafe ? item.Value : Localizer["Tenants.Configuration.Value.Unavailable"];
        return new(
            NamespaceLabel(item.Key),
            item.Key,
            displayValue,
            isSafe,
            isSafe ? Localizer["Tenants.Configuration.Value.Safe"] : Localizer["Tenants.Configuration.Value.Sensitive"]);
    }

    private string NamespaceLabel(string key)
    {
        string namespaceKey = NamespaceKey(key);
        return string.IsNullOrEmpty(namespaceKey)
            ? Localizer["Tenants.Configuration.UnscopedNamespace"]
            : namespaceKey;
    }

    private static string NamespaceKey(string key)
    {
        int separator = key.IndexOf('.', StringComparison.Ordinal);
        return separator > 0 ? key[..separator] : string.Empty;
    }

    private sealed record ConfigurationRow(
        string NamespaceLabel,
        string Key,
        string DisplayValue,
        bool IsSafe,
        string SafetyLabel);
}
