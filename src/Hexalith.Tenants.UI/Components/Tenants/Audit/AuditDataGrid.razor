@using Hexalith.Tenants.Contracts.Enums
@using System.Globalization
@inject IStringLocalizer<TenantsResources> Localizer

<div class="audit-data-grid" data-testid="tenants-audit-grid">
    <FluentDataGrid Items="@Rows.AsQueryable()"
                    ResizableColumns="true"
                    ReorderableColumns="false"
                    GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                    ItemKey="@(row => row.EventReference)">
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Timestamp"]"
                        ColumnId="audit-timestamp"
                        Class="tenants-audit-critical tenants-audit-critical--timestamp"
                        Width="190px"
                        Pin="DataGridColumnPin.Start">
            <span data-testid="tenants-audit-row-timestamp">@TimestampLabel(context.Timestamp)</span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Actor"]"
                        ColumnId="audit-actor"
                        Class="tenants-audit-critical tenants-audit-critical--actor"
                        Width="190px"
                        Pin="DataGridColumnPin.Start">
            <span class="audit-data-grid__wrap" data-testid="tenants-audit-row-actor">@context.ActorId</span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Outcome"]"
                        ColumnId="audit-outcome"
                        Class="tenants-audit-critical tenants-audit-critical--outcome"
                        Width="190px"
                        Pin="DataGridColumnPin.Start">
            <span class="audit-data-grid__state">@context.Outcome</span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Target"]" ColumnId="audit-target" Width="180px">
            <span class="audit-data-grid__wrap" data-testid="tenants-audit-row-target">@context.Target</span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Scope"]" ColumnId="audit-scope" Width="160px">
            <span class="audit-data-grid__wrap" data-testid="tenants-audit-row-scope">@context.Scope</span>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Category"]"
                        ColumnId="audit-category"
                        Class="tenants-audit-critical tenants-audit-critical--category"
                        Width="160px">
            <FluentBadge Appearance="BadgeAppearance.Tint"
                         Color="@CategoryBadgeColor(context.Category)"
                         IconStart="@CategoryIcon(context.Category)"
                         Class="@($"audit-data-grid__category audit-data-grid__category--{CategoryCss(context.Category)}")">
                @Localizer[$"Tenants.Audit.Category.{context.Category}"]
            </FluentBadge>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Freshness"]"
                        ColumnId="audit-freshness"
                        Class="tenants-audit-critical tenants-audit-critical--freshness"
                        Width="160px">
            <TruthStateBadge Freshness="@context.Freshness"
                             TestId="tenants-audit-row-freshness"
                             ResourcePrefix="Tenants.Audit" />
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.ProjectionLifecycle.Label"]"
                        ColumnId="audit-projection-lifecycle"
                        Width="180px">
            <ProjectionLifecycleBadge Lifecycle="@context.Lifecycle"
                                      TestId="tenants-audit-row-projection-lifecycle" />
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Reference"]"
                        ColumnId="audit-reference"
                        Class="tenants-audit-critical tenants-audit-critical--reference"
                        Width="260px">
            @{
                string? supportSafeReference = SupportSafeReferenceLabel(context);
            }
            <div class="audit-data-grid__reference" data-testid="tenants-audit-row-reference">
                <span class="audit-data-grid__wrap">@(supportSafeReference ?? Localizer["Tenants.Audit.Reference.Unavailable"].Value)</span>
                @if (supportSafeReference is not null)
                {
                    <SupportSafeCopyButton Value="@supportSafeReference"
                                           ValueKind="SupportSafeCopyValueKind.ApprovedReference"
                                           IsApproved="true"
                                           AccessibleName="@Localizer["Tenants.Audit.Copy.EventReference", supportSafeReference]"
                                           TestId="tenants-audit-copy-reference" />
                }
            </div>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Receipt"]"
                        ColumnId="audit-receipt"
                        Width="150px">
            <FluentButton Appearance="ButtonAppearance.Primary"
                          Class="audit-data-grid__receipt-open"
                          data-testid="tenants-audit-receipt-open"
                          OnClick="() => OpenReceiptAsync(context)">
                @Localizer["Tenants.Audit.Receipt.Open"]
            </FluentButton>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.Audit.Column.Correction"]"
                        ColumnId="audit-correction"
                        Width="190px">
            @{
                string? supportSafeReference = SupportSafeReferenceLabel(context);
                TenantCorrectionStartIntent? correctionIntent = supportSafeReference is null
                    ? null
                    : CorrectionIntentFor(context);
            }
            @if (correctionIntent?.IsAvailable is true)
            {
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Class="audit-data-grid__correction-start"
                              data-testid="tenants-correction-start"
                              data-correction-focus-reference="@context.EventReference"
                              aria-label="@CorrectionAccessibleName(correctionIntent)"
                              OnClick="() => StartCorrectionAsync(correctionIntent)">
                    @CorrectionActionLabel(correctionIntent)
                </FluentButton>
            }
            else if (ShouldRenderUnavailableReason(correctionIntent))
            {
                @if (RequiresRoleSelection(correctionIntent!))
                {
                    <FluentSelect TOption="string" TValue="string"
                                  Class="audit-data-grid__correction-role"
                                  Value="@string.Empty"
                                  ValueChanged="value => SelectCorrectionRoleAsync(context, value)"
                                  data-testid="tenants-correction-role"
                                  data-correction-focus-reference="@context.EventReference"
                                  aria-label="@Localizer["Tenants.Correction.RoleChoice.Label"]">
                        <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.Correction.RoleChoice.Placeholder"]</FluentOption>
                        @foreach (TenantRole role in AssignableRoles)
                        {
                            <FluentOption TValue="string" Value="@role.ToString()">@Localizer[$"Tenants.Correction.Role.{role}"]</FluentOption>
                        }
                    </FluentSelect>
                }
                <span class="audit-data-grid__correction-reason"
                      data-testid="tenants-correction-unavailable-reason">
                    @CorrectionUnavailableReason(correctionIntent!)
                </span>
            }
        </TemplateColumn>
    </FluentDataGrid>
    @foreach (TenantAuditRow row in Rows)
    {
        <span class="audit-data-grid__row-marker"
              data-testid="tenants-audit-row"
              tabindex="-1"
              data-audit-reference="@SupportSafeRowMarker(row)"></span>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<TenantAuditRow> Rows { get; set; } = [];

    [Parameter]
    public EventCallback<TenantAuditRow> OnOpenReceipt { get; set; }

    [Parameter]
    public Func<TenantAuditRow, TenantCorrectionStartIntent>? CorrectionIntentProvider { get; set; }

    [Parameter]
    public EventCallback<TenantCorrectionStartIntent> OnStartCorrection { get; set; }

    [Parameter]
    public EventCallback<TenantCorrectionRoleSelection> OnRoleSelected { get; set; }

    private static readonly TenantRole[] AssignableRoles =
    [
        TenantRole.TenantOwner,
        TenantRole.TenantContributor,
        TenantRole.TenantReader,
    ];

    // Gate the bare event reference first: a composed "{reference} - {context}" literal can satisfy the
    // policy while the reference itself is missing or unsafe, which would render and copy a
    // reference-less literal and leave the row without its data-audit-reference anchor.
    private static string? SupportSafeReferenceLabel(TenantAuditRow row)
    {
        string? reference = TenantAuditSupportSafety.SafeApprovedReference(row.EventReference);
        return reference is null || string.IsNullOrWhiteSpace(row.ReferenceContext)
            ? reference
            : TenantAuditSupportSafety.SafeApprovedReference($"{reference} - {row.ReferenceContext}");
    }

    private static string? SupportSafeRowMarker(TenantAuditRow row)
        => SupportSafeReferenceLabel(row) is null
            ? null
            : TenantAuditSupportSafety.SafeApprovedReference(row.EventReference);

    // Render in UTC: Blazor InteractiveServer runs server-side, so ToLocalTime() would bind the
    // displayed timestamp to the server's timezone (non-deterministic across deployments) and
    // disagree with the absolute date-range filter and the app-wide UTC convention (TenantDetailPage "u").
    private static string TimestampLabel(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss 'UTC'", CultureInfo.CurrentCulture);

    private static string CategoryCss(AuditEventCategory category)
        => category.ToString().ToLowerInvariant();

    private static BadgeColor CategoryBadgeColor(AuditEventCategory category)
        => category switch
        {
            AuditEventCategory.Access => BadgeColor.Informative,
            AuditEventCategory.Administrative => BadgeColor.Brand,
            _ => BadgeColor.Subtle,
        };

    private static Icon CategoryIcon(AuditEventCategory category)
        => category switch
        {
            AuditEventCategory.Access => FcFluentIcons.Key16(),
            AuditEventCategory.Administrative => FcFluentIcons.Settings20(),
            _ => FcFluentIcons.QuestionCircle16(),
        };

    private async Task OpenReceiptAsync(TenantAuditRow row)
        => await InvokeAsync(() => OnOpenReceipt.InvokeAsync(row)).ConfigureAwait(false);

    private TenantCorrectionStartIntent? CorrectionIntentFor(TenantAuditRow row)
        => CorrectionIntentProvider?.Invoke(row);

    private static bool ShouldRenderUnavailableReason(TenantCorrectionStartIntent? intent)
        => intent?.UnavailableReasons.Count > 0
            && !intent.UnavailableReasons.Contains(TenantCorrectionUnavailableReason.UnsupportedOutcome);

    private static bool RequiresRoleSelection(TenantCorrectionStartIntent intent)
        => intent.UnavailableReasons.Contains(TenantCorrectionUnavailableReason.ExplicitRoleRequired);

    private string CorrectionActionLabel(TenantCorrectionStartIntent intent)
        => intent.IsRestoreAccessAction
            ? Localizer["Tenants.Correction.Action.RestoreAccess"]
            : Localizer["Tenants.Correction.Action.Start"];

    private string CorrectionAccessibleName(TenantCorrectionStartIntent intent)
        => intent.IsRestoreAccessAction
            ? Localizer["Tenants.Correction.Action.RestoreAccessAccessible", intent.OriginalAuditReference]
            : Localizer["Tenants.Correction.Action.StartAccessible", intent.OriginalAuditReference];

    private string CorrectionUnavailableReason(TenantCorrectionStartIntent intent)
        => string.Join(
            " ",
            intent.UnavailableReasons.Select(reason => Localizer[$"Tenants.Correction.Unavailable.{reason}"].Value));

    private async Task StartCorrectionAsync(TenantCorrectionStartIntent intent)
        => await InvokeAsync(() => OnStartCorrection.InvokeAsync(intent)).ConfigureAwait(false);

    private async Task SelectCorrectionRoleAsync(TenantAuditRow row, string? value)
    {
        if (Enum.TryParse(value, ignoreCase: false, out TenantRole role)
            && AssignableRoles.Contains(role))
        {
            await InvokeAsync(() => OnRoleSelected.InvokeAsync(new(row.EventReference, role))).ConfigureAwait(false);
        }
    }
}
