@using Hexalith.Tenants.UI.State.TenantCommands
@inject IStringLocalizer<TenantsResources> Localizer

@if (Availability.ShouldRender)
{
    <section class="tenants-audit-availability tenants-audit-availability--@StateCss"
             data-testid="tenants-audit-availability"
             data-state="@StateCss"
             aria-label="@AccessibleLabel"
             aria-live="@LiveRegion"
             aria-atomic="true">
        <p class="tenants-audit-availability__state" data-testid="@StateTestId">
            <span class="tenants-audit-availability__icon" aria-hidden="true">@StateGlyph</span>
            <span>@StateText</span>
        </p>
        @if (!string.IsNullOrWhiteSpace(ReasonText))
        {
            <p class="tenants-audit-availability__reason">@ReasonText</p>
        }
        @if (RenderableRecoveryVerbs.Count > 0)
        {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true" Class="tenants-audit-availability__actions" aria-label="@Localizer["Tenants.Audit.Availability.ActionsLabel"]">
            @foreach (TenantAuditRecoveryVerb verb in RenderableRecoveryVerbs)
            {
                @if (verb is TenantAuditRecoveryVerb.InspectAudit && InspectAuditAction is not null)
                {
                    <span class="tenants-audit-availability__action-shell">
                        @InspectAuditAction
                    </span>
                }
                else
                {
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Class="tenants-audit-availability__action"
                                  data-recovery-verb="@VerbCss(verb)"
                                  OnClick="() => InvokeRecoveryAsync(verb)">
                        @Localizer[$"Tenants.Audit.Availability.Action.{verb}"]
                    </FluentButton>
                }
            }
        </FluentStack>
        }
    </section>
}

@code {
    [Parameter]
    public TenantCommandAuditState AuditState { get; set; } = TenantCommandAuditState.NotStarted;

    [Parameter]
    public string StateTestId { get; set; } = "tenants-audit-availability-state";

    [Parameter]
    public RenderFragment? InspectAuditAction { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback OnInspectAudit { get; set; }

    [Parameter]
    public EventCallback OnContinueReadOnly { get; set; }

    [Parameter]
    public EventCallback OnEscalate { get; set; }

    private TenantAuditAvailability Availability
        => TenantAuditAvailability.FromCommandAuditState(AuditState);

    private string StateCss
        => Availability.State?.ToString().ToLowerInvariant() ?? "not-started";

    private string LiveRegion
        => Availability.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string StateText
        => Availability.State is null
            ? string.Empty
            : Localizer[$"Tenants.Audit.Availability.State.{Availability.State}"];

    private string AccessibleLabel
        => Availability.State is null
            ? string.Empty
            : Localizer[$"Tenants.Audit.Availability.Accessible.{Availability.State}{RecoveryCopySuffix}"];

    private string ReasonText
        => Availability.State is TenantAuditAvailabilityState.Unavailable or TenantAuditAvailabilityState.MissingSupport
            ? Localizer[$"Tenants.Audit.Availability.Reason.{Availability.State}{RecoveryCopySuffix}"]
            : string.Empty;

    private IReadOnlyList<TenantAuditRecoveryVerb> RenderableRecoveryVerbs
        => [.. Availability.RecoveryVerbs.Where(CanRenderRecovery)];

    // Derived from what will actually render, not from OnEscalate alone. The old rule only compensated for a
    // missing escalate delegate, so a surface that also lacked OnContinueReadOnly still announced "continue
    // read-only" with no such control -- and MissingSupport, whose verbs are ContinueReadOnly + Escalate,
    // announced a recovery while rendering no buttons at all.
    private string RecoveryCopySuffix
    {
        get
        {
            // Only the two recovery-bearing states carry copy variants; Pending/Delayed/Available keep their
            // base key. This also matches the old behaviour, which was scoped to these states implicitly
            // because Escalate appears in no other verb set.
            if (Availability.State is not (TenantAuditAvailabilityState.Unavailable
                or TenantAuditAvailabilityState.MissingSupport))
            {
                return string.Empty;
            }

            IReadOnlyList<TenantAuditRecoveryVerb> renderable = RenderableRecoveryVerbs;
            if (renderable.Count == 0)
            {
                return ".NoRecovery";
            }

            bool readOnlyOffered = Availability.RecoveryVerbs.Contains(TenantAuditRecoveryVerb.ContinueReadOnly);
            if (readOnlyOffered && !renderable.Contains(TenantAuditRecoveryVerb.ContinueReadOnly))
            {
                return ".RefreshOnly";
            }

            return Availability.RecoveryVerbs.Contains(TenantAuditRecoveryVerb.Escalate) && !OnEscalate.HasDelegate
                ? ".NoEscalation"
                : string.Empty;
        }
    }

    private string StateGlyph
        => Availability.State switch
        {
            TenantAuditAvailabilityState.Pending => "...",
            TenantAuditAvailabilityState.Delayed => "!",
            TenantAuditAvailabilityState.Unavailable => "?",
            TenantAuditAvailabilityState.Available => "\u2713",
            TenantAuditAvailabilityState.MissingSupport => "?",
            _ => string.Empty,
        };

    private static string VerbCss(TenantAuditRecoveryVerb verb)
        => verb.ToString().ToLowerInvariant();

    private bool CanRenderRecovery(TenantAuditRecoveryVerb verb)
        => verb switch
        {
            // Wait has no handler (InvokeRecoveryAsync breaks on it), so rendering it as a FluentButton gave
            // the operator a live, enabled control that did nothing. Waiting is conveyed by the state copy.
            TenantAuditRecoveryVerb.Wait => false,
            TenantAuditRecoveryVerb.Refresh => OnRefresh.HasDelegate,
            TenantAuditRecoveryVerb.InspectAudit => InspectAuditAction is not null || OnInspectAudit.HasDelegate,
            TenantAuditRecoveryVerb.ContinueReadOnly => OnContinueReadOnly.HasDelegate,
            TenantAuditRecoveryVerb.Escalate => OnEscalate.HasDelegate,
            _ => false,
        };

    private async Task InvokeRecoveryAsync(TenantAuditRecoveryVerb verb)
    {
        switch (verb)
        {
            case TenantAuditRecoveryVerb.Wait:
                break;
            case TenantAuditRecoveryVerb.Refresh:
                await InvokeAsync(() => OnRefresh.InvokeAsync()).ConfigureAwait(false);
                break;
            case TenantAuditRecoveryVerb.InspectAudit:
                await InvokeAsync(() => OnInspectAudit.InvokeAsync()).ConfigureAwait(false);
                break;
            case TenantAuditRecoveryVerb.ContinueReadOnly:
                await InvokeAsync(() => OnContinueReadOnly.InvokeAsync()).ConfigureAwait(false);
                break;
            case TenantAuditRecoveryVerb.Escalate:
                await InvokeAsync(() => OnEscalate.InvokeAsync()).ConfigureAwait(false);
                break;
            default:
                break;
        }
    }
}
