@using Hexalith.Tenants.UI.State.TenantCommands
@using Microsoft.JSInterop
@implements IDisposable
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services

@if (Availability.ShouldRender)
{
    <section class="tenants-audit-availability tenants-audit-availability--@StateCss"
             data-testid="tenants-audit-availability"
             data-state="@StateCss"
             data-audit-source="@Source"
             aria-label="@StateLabel">
        @* The live region holds only the state and its explanation. Recovery controls, the retry-limit note,
           and focus changes stay outside it, so re-rendering an identical state never re-announces. *@
        <FluentStack Orientation="Orientation.Vertical"
                     VerticalGap="0.5rem"
                     Class="tenants-audit-availability__announcement"
                     data-testid="tenants-audit-availability-announcement"
                     aria-live="@LiveRegion"
                     aria-atomic="true">
            <p class="tenants-audit-availability__state"
               data-testid="@StateTestId"
               tabindex="-1"
               aria-describedby="@(IsRetryLimitReached ? _retryLimitId : null)"
               @ref="_stateLineElement">
                <FluentBadge Appearance="BadgeAppearance.Tint"
                             Color="@StateBadgeColor"
                             IconStart="@StateIcon"
                             Class="@($"tenants-audit-availability__badge tenants-audit-availability__badge--{StateCss}")"
                             aria-label="@StateLabel"
                             data-testid="tenants-audit-availability-badge">
                    @StateLabel
                </FluentBadge>
            </p>
            @if (!string.IsNullOrWhiteSpace(ExplanationText))
            {
                <p class="tenants-audit-availability__reason" data-testid="tenants-audit-availability-explanation">@ExplanationText</p>
            }
        </FluentStack>
        @if (IsRetryLimitReached)
        {
            <p id="@_retryLimitId"
               class="tenants-audit-availability__limit"
               data-testid="tenants-audit-availability-retry-limit">
                @Localizer["Tenants.Audit.Availability.RetryLimit"]
            </p>
        }
        @{
            IReadOnlyList<TenantAuditRecoveryVerb> recoveryVerbs = RenderableRecoveryVerbs;
        }
        @if (recoveryVerbs.Count > 0)
        {
            <FluentStack Orientation="Orientation.Horizontal"
                         HorizontalGap="0.5rem"
                         Wrap="true"
                         Class="tenants-audit-availability__actions"
                         data-testid="tenants-audit-availability-actions"
                         role="group"
                         aria-label="@Localizer["Tenants.Audit.Availability.ActionsLabel"]">
                @foreach (TenantAuditRecoveryVerb verb in recoveryVerbs)
                {
                    @if (verb is TenantAuditRecoveryVerb.InspectAudit && InspectAuditAction is not null)
                    {
                        <span class="tenants-audit-availability__action-shell"
                              data-recovery-verb="@VerbCss(verb)"
                              data-testid="@RecoveryTestId(verb)">
                            @InspectAuditAction
                        </span>
                    }
                    else if (verb is TenantAuditRecoveryVerb.Escalate)
                    {
                        <FluentAnchorButton Href="@EscalationHref"
                                            Appearance="ButtonAppearance.Outline"
                                            Class="tenants-audit-availability__action"
                                            data-recovery-verb="@VerbCss(verb)"
                                            data-testid="@RecoveryTestId(verb)">
                            @Localizer["Tenants.Audit.Recovery.Action.Escalate"]
                        </FluentAnchorButton>
                    }
                    else
                    {
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      Class="tenants-audit-availability__action"
                                      data-recovery-verb="@VerbCss(verb)"
                                      data-testid="@RecoveryTestId(verb)"
                                      OnClick="() => InvokeRecoveryAsync(verb)">
                            @Localizer[verb is TenantAuditRecoveryVerb.Refresh && RefreshLabelResourceKey is not null
                                ? RefreshLabelResourceKey
                                : $"Tenants.Audit.Availability.Action.{verb}"]
                        </FluentButton>
                    }
                }
            </FluentStack>
        }
    </section>
}

@code {
    /// <summary>The default recovery test-id prefix; every rendered recovery carries <c>{prefix}-{verb}</c>.</summary>
    public const string DefaultRecoveryTestIdPrefix = "tenants-audit-availability-recovery";

    private readonly string _retryLimitId = $"tenants-audit-availability-limit-{Guid.NewGuid():N}";
    private ElementReference _stateLineElement;
    private TenantAuditAvailability _availability = TenantAuditAvailability.FromCommandAuditState(TenantCommandAuditState.NotStarted);
    private string? _escalationHref;
    private TenantAuditAvailabilityState? _countedState;
    private int _unchangedRefreshCount;
    private bool _focusStateLinePending;
    private bool _refreshInFlight;
    private bool _disposed;

    [Parameter]
    public TenantCommandAuditState AuditState { get; set; } = TenantCommandAuditState.NotStarted;

    /// <summary>Gets or sets the stable, culture-independent host surface rendered as <c>data-audit-source</c>.</summary>
    [Parameter]
    public string? Source { get; set; }

    [Parameter]
    public string StateTestId { get; set; } = "tenants-audit-availability-state";

    [Parameter]
    public string RecoveryTestIdPrefix { get; set; } = DefaultRecoveryTestIdPrefix;

    [Parameter]
    public string? RefreshLabelResourceKey { get; set; }

    /// <summary>Gets or sets whether the state describes a failed audit read rather than a command's audit record.</summary>
    [Parameter]
    public bool IsReceiptAuditRead { get; set; }

    /// <summary>
    /// Gets or sets whether the host surface already offers escalation for the same failure, so this control
    /// does not render a second escalation link.
    /// </summary>
    [Parameter]
    public bool SuppressEscalation { get; set; }

    [Parameter]
    public RenderFragment? InspectAuditAction { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public bool OwnerRefreshIncludesAuditAuthority { get; set; }

    [CascadingParameter(Name = "AuditAuthorityRefresh")]
    public Func<Task>? AuditAuthorityRefresh { get; set; }

    [CascadingParameter(Name = "AuditAuthorityRefreshVersion")]
    public Func<long>? AuditAuthorityRefreshVersion { get; set; }

    [Parameter]
    public EventCallback OnInspectAudit { get; set; }

    [Parameter]
    public EventCallback OnContinueReadOnly { get; set; }

    // Derived once per parameter set: every render reads the state, verbs, and labels several times.
    private TenantAuditAvailability Availability
        => _availability;

    private string StateCss
        => Availability.State?.ToString().ToLowerInvariant() ?? "not-started";

    private string LiveRegion
        => Availability.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string StateLabel
        => Availability.StateLabelKey is { } key ? Localizer[key] : string.Empty;

    // Explanations describe the state only; they never name a recovery verb, because the rendered controls
    // (and only the rendered controls) carry the recovery.
    private string ExplanationText
        => Availability.State is TenantAuditAvailabilityState.Unavailable && IsReceiptAuditRead
            ? Localizer["Tenants.Audit.Receipt.Availability.Unavailable.Reason"]
            : Availability.ExplanationKey is { } key ? Localizer[key] : string.Empty;

    private BadgeColor StateBadgeColor
        => Availability.State switch
        {
            TenantAuditAvailabilityState.Available => BadgeColor.Success,
            TenantAuditAvailabilityState.Pending => BadgeColor.Informative,
            TenantAuditAvailabilityState.Delayed => BadgeColor.Warning,
            TenantAuditAvailabilityState.Unavailable => BadgeColor.Severe,
            _ => BadgeColor.Subtle,
        };

    // Each state has its own glyph, so meaning survives forced colors where the badge fill is dropped.
    private Icon StateIcon
        => Availability.State switch
        {
            TenantAuditAvailabilityState.Available => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.DocumentCheckmark(),
            TenantAuditAvailabilityState.Pending => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ClipboardClock(),
            TenantAuditAvailabilityState.Delayed => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ClockWarning(),
            TenantAuditAvailabilityState.Unavailable => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.DocumentProhibited(),
            _ => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.ClockToolbox(),
        };

    private bool IsRetryLimitReached
        => _unchangedRefreshCount >= TenantAuditAvailability.MaximumUnchangedRetries;

    private string? EscalationHref
        => _escalationHref;

    private IReadOnlyList<TenantAuditRecoveryVerb> RenderableRecoveryVerbs
        => [.. Availability.RecoveryVerbs.Where(CanRenderRecovery)];

    protected override void OnParametersSet()
    {
        _availability = TenantAuditAvailability.FromCommandAuditState(AuditState);

        // Escalation goes only to the configured local destination; an absent, external, or otherwise unsafe
        // configuration renders no escalation control at all. It is resolved once per parameter set, not on
        // every Escalate check of a render.
        _escalationHref = SuppressEscalation
            ? null
            : TenantAuditNavigationSafety.SafeRecoveryHref(
                (Services.GetService(typeof(ITenantsBffComposition)) as ITenantsBffComposition)?.AuditEscalationRecoveryHref);

        // A state change is new evidence: the unchanged-retry count starts over.
        TenantAuditAvailabilityState? state = Availability.State;
        if (state != _countedState)
        {
            _countedState = state;
            _unchangedRefreshCount = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusStateLinePending && Availability.ShouldRender)
        {
            _focusStateLinePending = false;
            try
            {
                await _stateLineElement.FocusAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
            catch (ObjectDisposedException) when (_disposed)
            {
            }
            catch (TaskCanceledException)
            {
            }
            catch (InvalidOperationException) when (_disposed)
            {
            }
        }
    }

    public void Dispose()
        => _disposed = true;

    private string RecoveryTestId(TenantAuditRecoveryVerb verb)
        => $"{RecoveryTestIdPrefix}-{VerbCss(verb)}";

    private static string VerbCss(TenantAuditRecoveryVerb verb)
        => verb.ToString().ToLowerInvariant();

    private bool CanRenderRecovery(TenantAuditRecoveryVerb verb)
        => verb switch
        {
            // Waiting is conveyed by the state explanation; a Wait button would be a live control that does nothing.
            TenantAuditRecoveryVerb.Wait => false,
            TenantAuditRecoveryVerb.Refresh => OnRefresh.HasDelegate && !IsRetryLimitReached,
            TenantAuditRecoveryVerb.InspectAudit => InspectAuditAction is not null || OnInspectAudit.HasDelegate,
            TenantAuditRecoveryVerb.ContinueReadOnly => OnContinueReadOnly.HasDelegate,
            TenantAuditRecoveryVerb.Escalate => EscalationHref is not null,
            _ => false,
        };

    private async Task InvokeRecoveryAsync(TenantAuditRecoveryVerb verb)
    {
        switch (verb)
        {
            case TenantAuditRecoveryVerb.Refresh:
                await RefreshAsync().ConfigureAwait(false);
                break;
            case TenantAuditRecoveryVerb.InspectAudit:
                await InvokeAsync(() => OnInspectAudit.InvokeAsync()).ConfigureAwait(false);
                break;
            case TenantAuditRecoveryVerb.ContinueReadOnly:
                await InvokeAsync(() => OnContinueReadOnly.InvokeAsync()).ConfigureAwait(false);
                break;
            default:
                break;
        }
    }

    private async Task RefreshAsync()
    {
        // A click while the host refresh is still running is the same recovery, not another retry: it is
        // ignored rather than counted, and the focused button stays in place.
        if (_refreshInFlight)
        {
            return;
        }

        _refreshInFlight = true;
        TenantAuditAvailabilityState? stateBeforeRefresh = Availability.State;
        bool refreshCompleted = false;
        try
        {
            long? probeVersion = AuditAuthorityRefreshVersion?.Invoke();
            await InvokeAsync(() => OnRefresh.InvokeAsync()).ConfigureAwait(false);
            if (AuditAuthorityRefresh is not null
                && (!OwnerRefreshIncludesAuditAuthority || probeVersion is null
                    || AuditAuthorityRefreshVersion?.Invoke() == probeVersion))
            {
                await InvokeAsync(AuditAuthorityRefresh).ConfigureAwait(false);
            }

            refreshCompleted = true;
        }
        catch (ObjectDisposedException) when (_disposed)
        {
            // The renderer was torn down between the owner refresh and the authority refresh dispatch.
        }
        catch (TaskCanceledException) when (_disposed)
        {
            // Renderer shutdown cancelled a queued refresh callback.
        }
        catch (InvalidOperationException) when (_disposed)
        {
            // The renderer rejected a callback after the component left its interactive lifetime.
        }
        finally
        {
            await FinalizeRefreshAsync(stateBeforeRefresh, refreshCompleted).ConfigureAwait(false);
        }
    }

    private async Task FinalizeRefreshAsync(
        TenantAuditAvailabilityState? stateBeforeRefresh,
        bool refreshCompleted)
    {
        try
        {
            // The gate, retry count, focus decision, and render request are one renderer-dispatcher transaction.
            // A second click can never start after the gate opens but before the completed retry is counted.
            await InvokeAsync(() =>
            {
                _refreshInFlight = false;
                if (_disposed || !refreshCompleted)
                {
                    return;
                }

                // The host re-renders this control with the refreshed state before the callback completes; a
                // different state already reset the count in OnParametersSet.
                if (Availability.State == stateBeforeRefresh && _countedState == stateBeforeRefresh)
                {
                    _unchangedRefreshCount++;
                }

                // Whenever the refresh leaves the control rendered without a Refresh control -- the retry bound,
                // or a new state with no Refresh recovery -- focus lands on the state line (whose description
                // carries the limit note when the bound was reached) instead of on the vanished button.
                if (Availability.ShouldRender && !RenderableRecoveryVerbs.Contains(TenantAuditRecoveryVerb.Refresh))
                {
                    _focusStateLinePending = true;
                }

                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (ObjectDisposedException) when (_disposed)
        {
            // The renderer was torn down after the host refresh completed; no visible state remains to update.
        }
        catch (TaskCanceledException) when (_disposed)
        {
            // Renderer shutdown cancelled the queued completion.
        }
        catch (InvalidOperationException) when (_disposed)
        {
            // The renderer is no longer interactive, so retry bookkeeping is no longer observable.
        }
    }
}
