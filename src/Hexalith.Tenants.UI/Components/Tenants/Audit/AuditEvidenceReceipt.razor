@using System.Globalization
@using System.Text.RegularExpressions
@using Hexalith.Tenants.UI.State.TenantCommands
@inject IStringLocalizer<TenantsResources> Localizer

@if (Receipt is not null)
{
    string? receiptSummary = SafeReceiptSummary(Receipt);
    <section class="audit-evidence-receipt audit-evidence-receipt--@StateCss"
             role="region"
             aria-labelledby="tenants-audit-receipt-heading"
             data-testid="tenants-audit-receipt">
        <header class="audit-evidence-receipt__header">
            <div>
                <h3 id="tenants-audit-receipt-heading" tabindex="-1">@Localizer["Tenants.Audit.Receipt.Title"]</h3>
                @if (ReceiptAuditState is null)
                {
                    <p class="audit-evidence-receipt__state"
                       role="@(LiveRegion == "assertive" ? "alert" : "status")"
                       aria-live="@LiveRegion"
                       data-testid="tenants-audit-receipt-state">
                        <span class="audit-evidence-receipt__state-icon" aria-hidden="true">@StateGlyph</span>
                        @Localizer[$"Tenants.Audit.Receipt.State.{Receipt.State}"]
                    </p>
                }
                @if (Receipt.IsRequestedReferenceMissing)
                {
                    <p data-testid="tenants-audit-receipt-missing" role="status">@Localizer["Tenants.Audit.Receipt.MissingCheckedPage"]</p>
                }
            </div>
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          data-testid="tenants-audit-receipt-close"
                          OnClick="() => OnClose.InvokeAsync()">@Localizer["Tenants.Audit.Receipt.Close"]</FluentButton>
            @if (receiptSummary is not null)
            {
                <SupportSafeCopyButton Value="@receiptSummary"
                                       ValueKind="SupportSafeCopyValueKind.ApprovedReference"
                                       IsApproved="true"
                                       AccessibleName="@Localizer["Tenants.Audit.Receipt.Copy"]"
                                       TestId="tenants-audit-receipt-copy" />
            }
            else if (Receipt.State is TenantAuditReceiptState.Ready)
            {
                <p class="audit-evidence-receipt__copy-blocked" role="alert" aria-live="assertive" data-testid="tenants-audit-receipt-copy-blocked">
                    @Localizer["Tenants.Audit.Receipt.CopyBlocked"]
                </p>
            }
        </header>

        <dl class="audit-evidence-receipt__fields">
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-actor">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Actor"]</dt>
                <dd>@FieldValue(TenantAuditSupportSafety.SafeIdentifier(Receipt.Actor, SupportSafeCopyValueKind.UserId))</dd>
            </div>
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-target">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Target"]</dt>
                <dd>@FieldValue(SafeTargetForDisplay(Receipt.Target))</dd>
            </div>
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-scope">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Scope"]</dt>
                <dd>@FieldValue(TenantAuditSupportSafety.SafeIdentifier(Receipt.Scope, SupportSafeCopyValueKind.TenantId))</dd>
            </div>
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-outcome">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Outcome"]</dt>
                <dd>@FieldValue(LocalizedOutcome(Receipt.Outcome))</dd>
            </div>
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-timestamp">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Timestamp"]</dt>
                <dd>@FieldValue(Receipt.Timestamp is { Offset: var offset } && offset == TimeSpan.Zero ? Receipt.TimestampLabel : null)</dd>
            </div>
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-projection">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.ProjectionMarker"]</dt>
                <dd>@FieldValue(LocalizedProjection(Receipt.ProjectionMarker))</dd>
            </div>
            <div class="audit-evidence-receipt__field" data-testid="tenants-audit-receipt-audit-reference">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Reference"]</dt>
                <dd data-testid="tenants-audit-receipt-reference">@SafeReferenceFallback(Receipt.AuditReference)</dd>
            </div>
            @if (TenantAuditSupportSafety.SafeApprovedReference(Receipt.CommandReference) is { } safeCommandReference)
            {
                <div class="audit-evidence-receipt__field">
                    <dt>@Localizer["Tenants.Audit.Receipt.Field.CommandReference"]</dt>
                    <dd>@safeCommandReference</dd>
                </div>
            }
        </dl>

        @if (ReceiptAuditState is not null)
        {
            <AuditAvailabilityState AuditState="@ReceiptAuditState.Value"
                                    Source="audit-receipt"
                                    StateTestId="tenants-audit-receipt-state"
                                    RecoveryTestIdPrefix="tenants-audit-receipt-recovery"
                                    RefreshLabelResourceKey="Tenants.Audit.Receipt.Action.RefreshAudit"
                                    IsReceiptAuditRead="true"
                                    SuppressEscalation="@HostEscalatesFailedRead"
                                    OnRefresh="OnRetry"
                                    OnInspectAudit="OnInspectAudit"
                                    OnContinueReadOnly="OnClose" />
        }
        else
        {
            @if (ShouldRenderCorrection)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem" Class="audit-evidence-receipt__correction">
                    @if (CorrectionIntent!.IsAvailable)
                    {
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      Class="audit-evidence-receipt__action audit-evidence-receipt__correction-start"
                                      data-testid="tenants-correction-start"
                                      data-correction-focus-reference="@CorrectionIntent.OriginalAuditReference"
                                      aria-label="@CorrectionAccessibleName"
                                      OnClick="StartCorrectionAsync">
                            @CorrectionActionLabel
                        </FluentButton>
                    }
                    else
                    {
                        <p class="audit-evidence-receipt__correction-reason"
                           data-testid="tenants-correction-unavailable-reason">
                            @CorrectionUnavailableReason
                        </p>
                    }
                </FluentStack>
            }
            @if (ActionResourceKeys.Count > 0)
            {
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true" Class="audit-evidence-receipt__actions" role="group" aria-label="@Localizer["Tenants.Audit.Receipt.ActionsLabel"]">
                    @foreach (string action in ActionResourceKeys)
                    {
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      Class="audit-evidence-receipt__action"
                                      data-testid="@RecoveryTestId(action)"
                                      OnClick="() => InvokeActionAsync(action)">
                            @Localizer[action]
                        </FluentButton>
                    }
                </FluentStack>
            }
        }
    </section>
}

@code {
    [Parameter]
    public TenantAuditReceipt? Receipt { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public bool UseResetRecovery { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnInspectAudit { get; set; }

    /// <summary>
    /// Gets or sets whether the host page already renders escalation for the failed audit read, so the
    /// receipt's availability control does not offer a duplicate escalation link.
    /// </summary>
    [Parameter]
    public bool HostEscalatesFailedRead { get; set; }

    [Parameter]
    public TenantCorrectionStartIntent? CorrectionIntent { get; set; }

    [Parameter]
    public EventCallback<TenantCorrectionStartIntent> OnStartCorrection { get; set; }

    // Mirror AuditDataGrid: only surface correction UI on a ready receipt, and never show a
    // correction reason for outcomes that are not correctable at all (e.g. UserAddedToTenant),
    // so opening any receipt does not render a confusing "not supported for correction" message.
    private bool ShouldRenderCorrection
        => CorrectionIntent is not null
            && Receipt?.State is TenantAuditReceiptState.Ready
            && (CorrectionIntent.IsAvailable || HasRenderableUnavailableReason);

    private string? SafeReceiptSummary(TenantAuditReceipt receipt)
    {
        if (receipt.State is not TenantAuditReceiptState.Ready)
        {
            return null;
        }

        string? outcome = LocalizedOutcome(receipt.Outcome);
        string? projection = LocalizedProjection(receipt.ProjectionMarker);
        string[] values = [receipt.Actor, receipt.Target, receipt.Scope, outcome ?? string.Empty,
            receipt.TimestampLabel, projection ?? string.Empty, receipt.AuditReference];
        if (values.Any(static value => string.IsNullOrWhiteSpace(value)
            || value.Length > 256 || TenantAuditSupportSafety.ContainsFieldBoundary(value)
            || value.Contains('{', StringComparison.Ordinal) || value.Contains('}', StringComparison.Ordinal))
            || !TenantAuditSupportSafety.IsSafe(receipt.Actor, SupportSafeCopyValueKind.UserId)
            || !(TenantAuditSupportSafety.IsSafe(receipt.Target, SupportSafeCopyValueKind.UserId)
                || TenantAuditSupportSafety.IsSafe(receipt.Target, SupportSafeCopyValueKind.ConfigurationKey)
                || TenantAuditSupportSafety.IsSafe(receipt.Target, SupportSafeCopyValueKind.TenantId))
            || !TenantAuditSupportSafety.IsSafe(receipt.Scope, SupportSafeCopyValueKind.TenantId)
            || TenantAuditSupportSafety.SafeApprovedReference(receipt.AuditReference) is null
            || receipt.Timestamp is null || receipt.Timestamp.Value == default
            || receipt.Timestamp.Value.Offset != TimeSpan.Zero
            || receipt.ProjectionMarker is not Hexalith.EventStore.Client.Projections.ReadModelFreshnessState.Current)
        {
            return null;
        }

        string templateKey = "Tenants.Audit.Receipt.Summary";
        var templateResource = Localizer[templateKey];
        string template = templateResource.Value;
        if (templateResource.ResourceNotFound || template == templateKey || template.Length > 512
            || TenantAuditSupportSafety.ContainsFieldBoundary(template.Replace(" | ", string.Empty, StringComparison.Ordinal))
            || !TenantAuditSupportSafety.IsSafe(template.Replace(" | ", " ", StringComparison.Ordinal), SupportSafeCopyValueKind.ApprovedReference))
        {
            return null;
        }

        string[] names = ["actor", "target", "scope", "outcome", "timestamp", "projection", "auditReference"];
        string[] labelKeys = ["Actor", "Target", "Scope", "Outcome", "Timestamp", "ProjectionMarker", "Reference"];
        string[] segments = template.Split(" | ", StringSplitOptions.None);
        MatchCollection matches = Regex.Matches(template, @"\{([a-zA-Z]+)\}");
        if (segments.Length != names.Length
            || Enumerable.Range(0, names.Length).Any(index =>
            {
                string labelKey = $"Tenants.Audit.Receipt.Field.{labelKeys[index]}";
                var label = Localizer[labelKey];
                return label.ResourceNotFound || label.Value == labelKey
                    || string.IsNullOrWhiteSpace(label.Value)
                    || !segments[index].Contains(label.Value, StringComparison.Ordinal)
                    || !segments[index].Contains("{" + names[index] + "}", StringComparison.Ordinal);
            })
            || matches.Count != names.Length || names.Any(name => matches.Count(match =>
            string.Equals(match.Groups[1].Value, name, StringComparison.Ordinal)) != 1)
            || Regex.Replace(template, @"\{[a-zA-Z]+\}", string.Empty).Contains('{', StringComparison.Ordinal)
            || Regex.Replace(template, @"\{[a-zA-Z]+\}", string.Empty).Contains('}', StringComparison.Ordinal))
        {
            return null;
        }

        string[] completedSegments = new string[segments.Length];
        for (int index = 0; index < names.Length; index++)
        {
            string placeholder = "{" + names[index] + "}";
            string label = Localizer[$"Tenants.Audit.Receipt.Field.{labelKeys[index]}"].Value;

            // The validated field label is trusted copy, but its letters would join the value's letters in the
            // normalized fragment match ("Target: agnes" -> "targetagnes" -> "etag"). Strip it from the template
            // segment before substituting, so only template text glued to the placeholder is re-checked.
            string placeholderBoundary = segments[index]
                .Replace(label, string.Empty, StringComparison.Ordinal)
                .Replace(placeholder, values[index], StringComparison.Ordinal);
            if (!IsSafeCompletedSummarySegment(index, placeholderBoundary))
            {
                return null;
            }

            completedSegments[index] = segments[index].Replace(placeholder, values[index], StringComparison.Ordinal);
        }

        string summary = string.Join(" | ", completedSegments);
        return summary.Length <= 2048 ? summary : null;
    }

    private static bool IsSafeCompletedSummarySegment(int index, string segment)
        => index switch
        {
            0 => TenantAuditSupportSafety.IsSafe(segment, SupportSafeCopyValueKind.UserId),
            1 => TenantAuditSupportSafety.IsSafe(segment, SupportSafeCopyValueKind.UserId)
                || TenantAuditSupportSafety.IsSafe(segment, SupportSafeCopyValueKind.ConfigurationKey)
                || TenantAuditSupportSafety.IsSafe(segment, SupportSafeCopyValueKind.TenantId),
            2 => TenantAuditSupportSafety.IsSafe(segment, SupportSafeCopyValueKind.TenantId),
            _ => TenantAuditSupportSafety.IsSafe(segment, SupportSafeCopyValueKind.ApprovedReference),
        };

    private string? LocalizedOutcome(string outcome)
    {
        if (!TenantAuditReceipt.IsKnownOutcome(outcome,
            outcome is "TenantCreated" or "TenantUpdated" or "TenantDisabled" or "TenantEnabled"
                or "TenantConfigurationSet" or "TenantConfigurationRemoved"
                ? Hexalith.Tenants.Contracts.Enums.AuditEventCategory.Administrative
                : Hexalith.Tenants.Contracts.Enums.AuditEventCategory.Access))
        {
            return null;
        }

        string key = $"Tenants.Audit.Receipt.Outcome.{outcome}";
        var resource = Localizer[key];
        return resource.ResourceNotFound || resource.Value == key
            || !TenantAuditSupportSafety.IsSafe(resource.Value, SupportSafeCopyValueKind.ApprovedReference)
            ? null : resource.Value;
    }

    private string? LocalizedProjection(Hexalith.EventStore.Client.Projections.ReadModelFreshnessState marker)
    {
        string key = $"Tenants.Audit.Freshness.{marker}";
        var resource = Localizer[key];
        return resource.ResourceNotFound || resource.Value == key
            || !TenantAuditSupportSafety.IsSafe(resource.Value, SupportSafeCopyValueKind.ApprovedReference)
            ? null : resource.Value;
    }

    private static string SafeReferenceFallback(string? auditReference)
        => FieldValue(TenantAuditSupportSafety.SafeApprovedReference(auditReference));

    private static string SafeTargetForDisplay(string? target)
        => TenantAuditSupportSafety.IsSafe(target, SupportSafeCopyValueKind.UserId)
            || TenantAuditSupportSafety.IsSafe(target, SupportSafeCopyValueKind.ConfigurationKey)
            || TenantAuditSupportSafety.IsSafe(target, SupportSafeCopyValueKind.TenantId)
                ? target! : string.Empty;

    // Receipt-local recoveries use the canonical verb spellings the shared availability control renders under the
    // same prefix, so one recovery keeps one selector whichever receipt state renders it.
    private static string RecoveryTestId(string action)
        => action switch
        {
            "Tenants.Audit.Receipt.Action.InspectAudit" => "tenants-audit-receipt-recovery-inspectaudit",
            "Tenants.Audit.Receipt.Action.ContinueReadOnly" => "tenants-audit-receipt-recovery-continuereadonly",
            "Tenants.Audit.Receipt.Action.Reset" => "tenants-audit-receipt-recovery-reset",
            _ => "tenants-audit-receipt-recovery-refresh",
        };

    private bool HasRenderableUnavailableReason
        => CorrectionIntent is not null
            && CorrectionIntent.UnavailableReasons.Count > 0
            && !CorrectionIntent.UnavailableReasons.Contains(TenantCorrectionUnavailableReason.UnsupportedOutcome);

    private string CorrectionActionLabel
        => CorrectionIntent?.IsRestoreAccessAction is true
            ? Localizer["Tenants.Correction.Action.RestoreAccess"]
            : Localizer["Tenants.Correction.Action.Start"];

    private string CorrectionAccessibleName
        => CorrectionIntent?.IsRestoreAccessAction is true
            ? Localizer["Tenants.Correction.Action.RestoreAccessAccessible", CorrectionIntent.OriginalAuditReference]
            : Localizer["Tenants.Correction.Action.StartAccessible", CorrectionIntent?.OriginalAuditReference ?? string.Empty];

    private string CorrectionUnavailableReason
        => CorrectionIntent is null
            ? string.Empty
            : string.Join(
                " ",
                CorrectionIntent.UnavailableReasons.Select(reason => Localizer[$"Tenants.Correction.Unavailable.{reason}"].Value));

    private string StateCss
        => Receipt?.State.ToString().ToLowerInvariant() ?? "unavailable";

    private string LiveRegion
        => ReceiptAuditAvailability?.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Polite
            || Receipt?.State is TenantAuditReceiptState.Ready or TenantAuditReceiptState.Loading
            ? "polite"
            : "assertive";

    private string StateGlyph
        => Receipt?.State switch
        {
            TenantAuditReceiptState.Ready => "OK",
            TenantAuditReceiptState.Loading => "...",
            TenantAuditReceiptState.Pending => "...",
            TenantAuditReceiptState.Delayed => "!",
            TenantAuditReceiptState.Stale => "!",
            TenantAuditReceiptState.Degraded => "!",
            TenantAuditReceiptState.Partial => "!",
            _ => "?",
        };

    private IReadOnlyList<string> ActionResourceKeys
        => Receipt?.State is TenantAuditReceiptState.Loading
            ? []
            : UseResetRecovery && OnReset.HasDelegate
            ? ["Tenants.Audit.Receipt.Action.Reset"]
            : Receipt?.State switch
        {
            // A Ready receipt must never fall through to the trailing Refresh arm. Offering "retry status
            // lookup" on evidence the receipt has just reported as ready contradicts the state itself; when
            // no inspect delegate is wired there is simply nothing to offer, and Close still dismisses.
            TenantAuditReceiptState.Ready
                => AvailableReceiptActions(
                    (OnInspectAudit.HasDelegate, "Tenants.Audit.Receipt.Action.InspectAudit"),
                    (OnClose.HasDelegate, "Tenants.Audit.Receipt.Action.ContinueReadOnly")),
            TenantAuditReceiptState.InvalidReference
                => AvailableReceiptActions(
                    (OnInspectAudit.HasDelegate, "Tenants.Audit.Receipt.Action.InspectAudit"),
                    (OnRetry.HasDelegate, "Tenants.Audit.Receipt.Action.Refresh")),
            TenantAuditReceiptState.Unauthorized when OnClose.HasDelegate
                => ["Tenants.Audit.Receipt.Action.ContinueReadOnly"],
            TenantAuditReceiptState.Error or TenantAuditReceiptState.InvalidCursor
                when OnRetry.HasDelegate
                => ["Tenants.Audit.Receipt.Action.Refresh"],
            TenantAuditReceiptState.Stale or TenantAuditReceiptState.Degraded or TenantAuditReceiptState.Partial
                when OnRetry.HasDelegate
                => ["Tenants.Audit.Receipt.Action.Refresh"],
            _ when OnRetry.HasDelegate => ["Tenants.Audit.Receipt.Action.Refresh"],
            _ => [],
        };

    private TenantCommandAuditState? ReceiptAuditState
        => Receipt?.State switch
        {
            TenantAuditReceiptState.Pending => TenantCommandAuditState.AuditPending,
            TenantAuditReceiptState.Delayed => TenantCommandAuditState.AuditDelayed,
            TenantAuditReceiptState.Unavailable => TenantCommandAuditState.AuditUnavailable,
            TenantAuditReceiptState.MissingSupport => TenantCommandAuditState.MissingSupport,
            _ => null,
        };

    private TenantAuditAvailability? ReceiptAuditAvailability
        => ReceiptAuditState is null ? null : TenantAuditAvailability.FromCommandAuditState(ReceiptAuditState.Value);

    private static string FieldValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task InvokeActionAsync(string actionResourceKey)
    {
        if (actionResourceKey is "Tenants.Audit.Receipt.Action.Reset")
        {
            await InvokeAsync(() => OnReset.InvokeAsync()).ConfigureAwait(false);
            return;
        }
        if (actionResourceKey is "Tenants.Audit.Receipt.Action.InspectAudit")
        {
            await InvokeAsync(() => OnInspectAudit.InvokeAsync()).ConfigureAwait(false);
            return;
        }

        if (actionResourceKey is "Tenants.Audit.Receipt.Action.ContinueReadOnly")
        {
            await InvokeAsync(() => OnClose.InvokeAsync()).ConfigureAwait(false);
            return;
        }

        await InvokeAsync(() => OnRetry.InvokeAsync()).ConfigureAwait(false);
    }

    private static IReadOnlyList<string> AvailableReceiptActions(
        params (bool Available, string ResourceKey)[] candidates)
        => candidates
            .Where(static candidate => candidate.Available)
            .Select(static candidate => candidate.ResourceKey)
            .ToArray();

    private async Task StartCorrectionAsync()
    {
        if (CorrectionIntent is not null)
        {
            await InvokeAsync(() => OnStartCorrection.InvokeAsync(CorrectionIntent)).ConfigureAwait(false);
        }
    }
}
