@using System.Globalization
@using Hexalith.Tenants.UI.State.TenantCommands
@inject IStringLocalizer<TenantsResources> Localizer

@if (Receipt is not null)
{
    <section class="audit-evidence-receipt audit-evidence-receipt--@StateCss"
             role="region"
             aria-labelledby="tenants-audit-receipt-heading"
             aria-live="@LiveRegion"
             data-testid="tenants-audit-receipt">
        <header class="audit-evidence-receipt__header">
            <div>
                <h3 id="tenants-audit-receipt-heading">@Localizer["Tenants.Audit.Receipt.Title"]</h3>
                @if (ReceiptAuditState is null)
                {
                    <p class="audit-evidence-receipt__state"
                       data-testid="tenants-audit-receipt-state">
                        <span class="audit-evidence-receipt__state-icon" aria-hidden="true">@StateGlyph</span>
                        @Localizer[$"Tenants.Audit.Receipt.State.{Receipt.State}"]
                    </p>
                }
            </div>
            <SupportSafeCopyButton Value="@Receipt.CopyableReferenceText"
                                   ValueKind="SupportSafeCopyValueKind.ApprovedReference"
                                   AccessibleName="@Localizer["Tenants.Audit.Receipt.Copy"]"
                                   TestId="tenants-audit-receipt-copy" />
        </header>

        <dl class="audit-evidence-receipt__fields">
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Actor"]</dt>
                <dd>@FieldValue(Receipt.Actor)</dd>
            </div>
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Target"]</dt>
                <dd>@FieldValue(Receipt.Target)</dd>
            </div>
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Scope"]</dt>
                <dd>@FieldValue(Receipt.Scope)</dd>
            </div>
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Outcome"]</dt>
                <dd>@FieldValue(Receipt.Outcome)</dd>
            </div>
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Timestamp"]</dt>
                <dd>@FieldValue(Receipt.TimestampLabel)</dd>
            </div>
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.ProjectionMarker"]</dt>
                <dd>@Localizer[$"Tenants.Audit.Freshness.{Receipt.ProjectionMarker}"]</dd>
            </div>
            <div class="audit-evidence-receipt__field">
                <dt>@Localizer["Tenants.Audit.Receipt.Field.Reference"]</dt>
                <dd data-testid="tenants-audit-receipt-reference">@FieldValue(Receipt.AuditReference)</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Receipt.CommandReference))
            {
                <div class="audit-evidence-receipt__field">
                    <dt>@Localizer["Tenants.Audit.Receipt.Field.CommandReference"]</dt>
                    <dd>@Receipt.CommandReference</dd>
                </div>
            }
        </dl>

        @if (ReceiptAuditState is not null)
        {
            <AuditAvailabilityState AuditState="@ReceiptAuditState.Value"
                                    StateTestId="tenants-audit-receipt-state"
                                    OnRefresh="OnRetry"
                                    OnInspectAudit="OnClose"
                                    OnContinueReadOnly="OnClose"
                                    OnEscalate="OnRetry" />
        }
        else
        {
            @if (ShouldRenderCorrection)
            {
                <div class="audit-evidence-receipt__correction">
                    @if (CorrectionIntent!.IsAvailable)
                    {
                        <button type="button"
                                class="audit-evidence-receipt__action audit-evidence-receipt__correction-start"
                                data-testid="tenants-correction-start"
                                aria-label="@CorrectionAccessibleName"
                                @onclick="StartCorrectionAsync">
                            @CorrectionActionLabel
                        </button>
                    }
                    else
                    {
                        <p class="audit-evidence-receipt__correction-reason"
                           data-testid="tenants-correction-unavailable-reason">
                            @CorrectionUnavailableReason
                        </p>
                    }
                </div>
            }
            <div class="audit-evidence-receipt__actions" aria-label="@Localizer["Tenants.Audit.Receipt.ActionsLabel"]">
                @foreach (string action in ActionResourceKeys)
                {
                    <button type="button"
                            class="audit-evidence-receipt__action"
                            @onclick="() => InvokeActionAsync(action)">
                        @Localizer[action]
                    </button>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter]
    public TenantAuditReceipt? Receipt { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public TenantCorrectionStartIntent? CorrectionIntent { get; set; }

    [Parameter]
    public EventCallback<TenantCorrectionStartIntent> OnStartCorrection { get; set; }

    // Mirror AuditDataGrid: only surface correction UI on a ready receipt, and never show a
    // correction reason for outcomes that are not correctable at all (e.g. UserAddedToTenant),
    // so opening any receipt does not render a confusing "not supported for correction" message.
    private bool ShouldRenderCorrection
        => CorrectionIntent is not null
            && Receipt?.State is TenantAuditReceiptState.Ready
            && (CorrectionIntent.IsAvailable || HasRenderableUnavailableReason);

    private bool HasRenderableUnavailableReason
        => CorrectionIntent is not null
            && CorrectionIntent.UnavailableReasons.Count > 0
            && !CorrectionIntent.UnavailableReasons.Contains(TenantCorrectionUnavailableReason.UnsupportedOutcome);

    private string CorrectionActionLabel
        => CorrectionIntent?.IsRestoreAccessAction is true
            ? Localizer["Tenants.Correction.Action.RestoreAccess"]
            : Localizer["Tenants.Correction.Action.Start"];

    private string CorrectionAccessibleName
        => CorrectionIntent?.IsRestoreAccessAction is true
            ? Localizer["Tenants.Correction.Action.RestoreAccessAccessible", CorrectionIntent.OriginalAuditReference]
            : Localizer["Tenants.Correction.Action.StartAccessible", CorrectionIntent?.OriginalAuditReference ?? string.Empty];

    private string CorrectionUnavailableReason
        => CorrectionIntent is null
            ? string.Empty
            : string.Join(
                " ",
                CorrectionIntent.UnavailableReasons.Select(reason => Localizer[$"Tenants.Correction.Unavailable.{reason}"].Value));

    private string StateCss
        => Receipt?.State.ToString().ToLowerInvariant() ?? "unavailable";

    private string LiveRegion
        => ReceiptAuditAvailability?.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Polite
            || Receipt?.State is TenantAuditReceiptState.Ready
            ? "polite"
            : "assertive";

    private string StateGlyph
        => Receipt?.State switch
        {
            TenantAuditReceiptState.Ready => "OK",
            TenantAuditReceiptState.Pending => "...",
            TenantAuditReceiptState.Delayed => "!",
            TenantAuditReceiptState.Stale => "!",
            TenantAuditReceiptState.Degraded => "!",
            TenantAuditReceiptState.Partial => "!",
            _ => "?",
        };

    private IReadOnlyList<string> ActionResourceKeys
        => Receipt?.State switch
        {
            TenantAuditReceiptState.Ready => ["Tenants.Audit.Receipt.Action.InspectAudit"],
            TenantAuditReceiptState.InvalidReference => ["Tenants.Audit.Receipt.Action.InspectAudit", "Tenants.Audit.Receipt.Action.Refresh"],
            TenantAuditReceiptState.Unauthorized => ["Tenants.Audit.Receipt.Action.ContinueReadOnly"],
            TenantAuditReceiptState.Stale or TenantAuditReceiptState.Degraded or TenantAuditReceiptState.Partial => ["Tenants.Audit.Receipt.Action.Refresh"],
            _ => ["Tenants.Audit.Receipt.Action.Refresh"],
        };

    private TenantCommandAuditState? ReceiptAuditState
        => Receipt?.State switch
        {
            TenantAuditReceiptState.Pending => TenantCommandAuditState.AuditPending,
            TenantAuditReceiptState.Delayed => TenantCommandAuditState.AuditDelayed,
            TenantAuditReceiptState.Unavailable => TenantCommandAuditState.AuditUnavailable,
            TenantAuditReceiptState.MissingSupport => TenantCommandAuditState.MissingSupport,
            _ => null,
        };

    private TenantAuditAvailability? ReceiptAuditAvailability
        => ReceiptAuditState is null ? null : TenantAuditAvailability.FromCommandAuditState(ReceiptAuditState.Value);

    private static string FieldValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private async Task InvokeActionAsync(string actionResourceKey)
    {
        if (actionResourceKey is "Tenants.Audit.Receipt.Action.ContinueReadOnly" or "Tenants.Audit.Receipt.Action.InspectAudit")
        {
            await OnClose.InvokeAsync().ConfigureAwait(false);
            return;
        }

        await OnRetry.InvokeAsync().ConfigureAwait(false);
    }

    private async Task StartCorrectionAsync()
    {
        if (CorrectionIntent is not null)
        {
            await OnStartCorrection.InvokeAsync(CorrectionIntent).ConfigureAwait(false);
        }
    }
}
