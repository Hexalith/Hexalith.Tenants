@using System.Text
@using Hexalith.Tenants.UI.Services.Gateways
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services

@if (CanOpen)
{
    <FluentAnchorButton Class="tenants-audit-entrypoint"
                        Href="@Href"
                        Appearance="ButtonAppearance.Outline"
                        data-testid="tenants-audit-entrypoint"
                        data-audit-source="@SourceKind"
                        aria-label="@AccessibleName">
        <span data-testid="@SourceTestId">@Label</span>
        @if (!string.IsNullOrWhiteSpace(AvailabilityText))
        {
            <span class="tenants-audit-entrypoint__state">@AvailabilityText</span>
        }
    </FluentAnchorButton>
}
else
{
    <FluentButton Class="tenants-audit-entrypoint tenants-audit-entrypoint--unavailable"
                  Appearance="ButtonAppearance.Outline"
                  Disabled="true"
                  data-testid="tenants-audit-entrypoint"
                  data-audit-source="@SourceKind"
                  aria-label="@AccessibleName"
                  aria-describedby="@_reasonId">
        <span data-testid="@SourceTestId">@Label</span>
        @if (!string.IsNullOrWhiteSpace(AvailabilityText))
        {
            <span class="tenants-audit-entrypoint__state">@AvailabilityText</span>
        }
    </FluentButton>
    <span id="@_reasonId" class="tenants-audit-entrypoint__reason" role="note" tabindex="0">@UnavailableText</span>
    @if ((OnRefresh.HasDelegate || AuditAuthorityRefresh is not null) && HasSafeContext)
    {
        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="RefreshAsync" data-testid="tenants-audit-entrypoint-refresh">
            @Localizer["Tenants.Audit.Refresh"]
        </FluentButton>
    }
}

@code {
    private readonly string _reasonId = $"tenants-audit-reason-{Guid.NewGuid():N}";

    [Parameter]
    public string? TenantId { get; set; }

    [Parameter]
    public string? TargetUserId { get; set; }

    [Parameter]
    public string? SupportSafeCommandReference { get; set; }

    [Parameter]
    public string? ReturnUrl { get; set; }

    [Parameter]
    public string? ReturnFocus { get; set; }

    [Parameter]
    public bool PartialReturn { get; set; }

    [Parameter]
    public string SourceKind { get; set; } = "tenant";

    [Parameter]
    public string SourceTestId { get; set; } = "tenants-list-audit-entrypoint";

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string AccessibleName { get; set; } = string.Empty;

    [Parameter]
    public bool IsAvailable { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [CascadingParameter(Name = "AuditAuthorityRefresh")]
    public Func<Task>? AuditAuthorityRefresh { get; set; }

    [Parameter]
    public string? UnavailableReason { get; set; }

    [Parameter]
    public string? AvailabilityText { get; set; }

    private bool HasTenantScope
        => TenantAuditNavigationSafety.IsSafeTenantId(TenantId);

    private bool IsReadConnected
        => Services.GetService(typeof(ITenantsBffComposition)) is ITenantsBffComposition composition
            && composition.IsReadSurfaceConnected;

    private bool HasSafeContext
    {
        get
        {
            string? safeReturn = TenantAuditNavigationSafety.SafeReturnUrlForTenant(ReturnUrl, TenantId, out _);
            return HasTenantScope
                && TenantAuditNavigationSafety.IsSafeSource(SourceKind)
                && (TargetUserId is null || TenantAuditNavigationSafety.IsSafeIdentifier(TargetUserId))
                && (SupportSafeCommandReference is null || TenantAuditNavigationSafety.IsSafeHint(SupportSafeCommandReference))
                && safeReturn is not null
                && (ReturnFocus is null ||
                    (TenantAuditNavigationSafety.IsFocusForReturnUrl(safeReturn, ReturnFocus)
                    && (TenantAuditNavigationSafety.ReturnQueryValue(safeReturn, "anchor") is not { } anchor
                        || string.Equals(anchor, ReturnFocus, StringComparison.Ordinal))
                    && (TenantAuditNavigationSafety.ReturnQueryValue(safeReturn, "auditFocus") is not { } existingFocus
                        || string.Equals(existingFocus, ReturnFocus, StringComparison.Ordinal))));
        }
    }

    private bool CanOpen
        => IsAvailable && IsReadConnected && HasSafeContext;

    private string Href
        => BuildHref();

    private string UnavailableText
        => string.IsNullOrWhiteSpace(TenantId)
            ? Localizer["Tenants.Audit.EntryPoint.Unavailable.ScopeRequired"]
            : !HasSafeContext
                ? Localizer["Tenants.Audit.EntryPoint.Unavailable.InvalidContext"]
                : !IsReadConnected
                    ? Localizer["Tenants.Audit.EntryPoint.Unavailable.Disconnected"]
                : string.IsNullOrWhiteSpace(UnavailableReason)
                ? Localizer["Tenants.Audit.EntryPoint.Unavailable.StaleScope"]
                : UnavailableReason;

    private string BuildHref()
    {
        if (!HasSafeContext)
        {
            return string.Empty;
        }

        StringBuilder builder = new($"/tenants/{Uri.EscapeDataString(TenantId!)}/audit");
        AppendQuery(builder, "targetUserId", TargetUserId);
        AppendQuery(builder, "supportSafeCommandReference", SupportSafeCommandReference);
        AppendQuery(builder, "source", SourceKind);
        string? safeReturnUrl = TenantAuditNavigationSafety.SafeReturnUrlForTenant(ReturnUrl, TenantId, out bool partialReturn);
        AppendQuery(builder, "returnUrl", safeReturnUrl);
        AppendQuery(builder, "returnFocus", ReturnFocus);
        if (partialReturn || PartialReturn)
        {
            AppendQuery(builder, "auditPartialReturn", "true");
        }
        return builder.ToString();
    }

    private async Task RefreshAsync()
    {
        if (OnRefresh.HasDelegate)
        {
            await OnRefresh.InvokeAsync().ConfigureAwait(false);
        }
        else if (AuditAuthorityRefresh is not null)
        {
            await AuditAuthorityRefresh().ConfigureAwait(false);
        }
    }

    private static void AppendQuery(StringBuilder builder, string key, string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Any(char.IsControl))
        {
            return;
        }

        builder.Append(builder.ToString().Contains('?', StringComparison.Ordinal) ? '&' : '?');
        builder.Append(Uri.EscapeDataString(key));
        builder.Append('=');
        builder.Append(Uri.EscapeDataString(value));
    }

}
