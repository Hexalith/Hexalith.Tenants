@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.EventStore.Client.Projections
@using Hexalith.EventStore.Contracts.Queries
@using Hexalith.Tenants.UI.Services.Gateways
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.JSInterop
@implements IDisposable
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services

@if (_snapshot is not null)
{
    <section class="correction-start-panel correction-start-panel--@_snapshot.LifecycleState.ToString().ToLowerInvariant()"
             role="region"
             @onkeydown="OnPanelKeyDownAsync"
             aria-labelledby="tenants-correction-title"
             data-testid="tenants-correction-panel">
        <div data-testid="tenants-correction-preview">
            <header class="correction-start-panel__header">
                <div>
                    <h3 id="tenants-correction-title" tabindex="-1">@Localizer["Tenants.Correction.Title"]</h3>
                    <p class="correction-start-panel__live"
                       data-testid="tenants-correction-live-region"
                       aria-live="@LiveRegionMode"
                       aria-atomic="true">
                        @StateText
                    </p>
                </div>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              Class="correction-start-panel__close"
                              data-testid="tenants-correction-close"
                              OnClick="CloseAsync">
                    @Localizer["Tenants.Correction.Close"]
                </FluentButton>
            </header>

            @if (!string.IsNullOrWhiteSpace(UnavailableReason))
            {
                <p class="correction-start-panel__reason"
                   @ref="_reasonElement"
                   id="tenants-correction-unavailable"
                   data-testid="tenants-correction-unavailable-reason"
                   tabindex="-1"
                   role="alert">
                    @if (ShowCompetingAttemptNotice || IsAggregateBusy)
                    {
                        <span data-testid="tenants-correction-aggregate-busy">@UnavailableReason</span>
                    }
                    else
                    {
                        @UnavailableReason
                    }
                </p>
            }

            <dl class="correction-start-panel__fields">
                <div>
                    <dt>@Localizer["Tenants.Correction.Field.OriginalEvidence"]</dt>
                    <dd data-testid="tenants-correction-original-evidence">@FieldValue(_snapshot.OriginalAuditReference)</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Preview.OriginalTime"]</dt>
                    <dd data-testid="tenants-correction-original-time">@OriginalTimestampLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Field.CurrentSnapshot"]</dt>
                    <dd data-testid="tenants-correction-current-snapshot">@ProjectionSnapshotLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Preview.Freshness"]</dt>
                    <dd data-testid="tenants-correction-freshness">@FreshnessLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Preview.Provenance"]</dt>
                    <dd data-testid="tenants-correction-provenance">@ProvenanceLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Field.Domain"]</dt>
                    <dd data-testid="tenants-correction-domain">@CommandDomainLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Field.Command"]</dt>
                    <dd data-testid="tenants-correction-command">@CommandTypeLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Preview.CurrentRole"]</dt>
                    <dd data-testid="tenants-correction-current-role">@CurrentRoleLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Preview.Readiness"]</dt>
                    <dd id="tenants-correction-readiness" data-testid="tenants-correction-readiness">@ReadinessLabel</dd>
                </div>
                <div>
                    <dt>@Localizer["Tenants.Correction.Preview.IntendedRole"]</dt>
                    <dd>
                        <FluentSelect TOption="string" TValue="string"
                                      Class="correction-start-panel__role-label"
                                      Label="@Localizer["Tenants.Correction.RoleChoice.Label"]"
                                      Value="@_roleValue"
                                      ValueChanged="OnRoleChanged"
                                      data-testid="tenants-correction-role"
                                      aria-describedby="tenants-correction-readiness"
                                      Disabled="@RoleSelectionDisabled">
                            <FluentOption TValue="string" Value="@string.Empty">@Localizer["Tenants.Correction.RoleChoice.Placeholder"]</FluentOption>
                            @foreach (TenantRole role in AssignableRoles)
                            {
                                <FluentOption TValue="string" Value="@role.ToString()">@RoleLabel(role)</FluentOption>
                            }
                        </FluentSelect>
                    </dd>
                </div>
            </dl>

            <FluentAccordion ExpandMode="AccordionExpandMode.Multi" Block="true">
              <FluentAccordionItem Header="@Localizer["Tenants.Correction.Field.PreviewData"].Value" Expanded="true">
            <section class="correction-start-panel__preview" aria-label="@Localizer["Tenants.Correction.Field.PreviewData"]">
                <dl data-testid="tenants-correction-preview-data">
                    <div>
                        <dt>@Localizer["Tenants.Correction.Preview.Consequences"]</dt>
                        <dd data-testid="tenants-correction-consequences">@string.Join(" ", _snapshot.KnownConsequences.Select(ConsequenceLabel))</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.Correction.Preview.OwnerImpact"]</dt>
                        <dd data-testid="tenants-correction-owner-impact">@OwnerImpactLabel</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.Correction.Preview.Unknowns"]</dt>
                        <dd data-testid="tenants-correction-unknowns">@string.Join(" ", _snapshot.KnownUnknowns.Select(UnknownLabel))</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.Correction.Preview.AuditExpectation"]</dt>
                        <dd data-testid="tenants-correction-audit-expectation">@Localizer["Tenants.Correction.Preview.AuditExpectation.Text"]</dd>
                    </div>
                    <div>
                        <dt>@Localizer["Tenants.Correction.Preview.RecoveryPath"]</dt>
                        <dd data-testid="tenants-correction-recovery-path">@Localizer["Tenants.Correction.Preview.RecoveryPath.Text"]</dd>
                    </div>
                    @foreach (KeyValuePair<string, string> input in _snapshot.Intent.RequiredPreviewInputs.Where(static input => input.Key is not "originalTimestamp"))
                    {
                        <div>
                            <dt>@Localizer[$"Tenants.Correction.PreviewInput.{input.Key}"]</dt>
                            <dd>@PreviewValue(input.Key, input.Value)</dd>
                        </div>
                    }
                </dl>
            </section>
              </FluentAccordionItem>
              <FluentAccordionItem Header="@Localizer["Tenants.Correction.Lifecycle.Title"].Value" Expanded="true">
            <section class="correction-start-panel__lifecycle"
                     @ref="_lifecycleElement"
                     tabindex="-1"
                     data-testid="tenants-correction-lifecycle"
                     aria-label="@Localizer["Tenants.Correction.Lifecycle.Title"]">
                <p class="correction-start-panel__state correction-start-panel__state--@_snapshot.LifecycleState.ToString().ToLowerInvariant()"
                   data-testid="tenants-correction-state">
                    <span aria-hidden="true">@StateSymbol</span>
                    <span>@StateText</span>
                </p>
                @if (!string.IsNullOrWhiteSpace(SafeMessageText))
                {
                    <p data-testid="tenants-correction-safe-message">@SafeMessageText</p>
                }
                @if (_snapshot.AuditState is not TenantCommandAuditState.NotStarted)
                {
                    <p data-testid="tenants-correction-audit-state">
                        @Localizer[$"Tenants.Correction.Audit.{_snapshot.AuditState}"]
                    </p>
                }
            </section>
              </FluentAccordionItem>
            </FluentAccordion>

            <div class="correction-start-panel__actions">
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Class="correction-start-panel__confirm"
                              data-testid="tenants-correction-confirm"
                              Disabled="@IsConfirmDisabled"
                              OnClick="SubmitAsync">
                    @Localizer["Tenants.Correction.Confirm.Submit"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-correction-refresh"
                              Disabled="@(!CanRefresh)"
                              OnClick="@(() => RefreshStatusAsync())">
                    @Localizer["Tenants.Correction.Confirm.Refresh"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-correction-cancel"
                              OnClick="CloseAsync">
                    @Localizer["Tenants.Correction.Confirm.Cancel"]
                </FluentButton>
            </div>
        </div>
    </section>
}

@code {
    private static readonly TenantRole[] AssignableRoles =
    [
        TenantRole.TenantOwner,
        TenantRole.TenantContributor,
        TenantRole.TenantReader,
    ];

    private TenantCorrectionPreviewSnapshot? _snapshot;
    private string _roleValue = string.Empty;
    private bool _isSubmitting;
    private int _statusReadInFlight;
    private bool _hasSubmitted;
    private string? _intentReference;
    private ElementReference _lifecycleElement;
    private ElementReference _reasonElement;
    private bool _focusLifecyclePending;
    private bool _focusReasonPending;
    private TenantCorrectionAttemptTracker _attemptTracker = new();
    private TenantAggregateCommandAdmissionGate _admissionGate = new();
    private TenantHighImpactViewportObservation? _viewportObservation;
    private readonly object _confirmSync = new();
    private long _confirmGeneration;
    private bool _disposed;

    [Parameter]
    public TenantCorrectionStartIntent? Intent { get; set; }

    [Parameter]
    public TenantDetail? CurrentProjection { get; set; }

    /// <summary>Gets or sets fresh redacted handoff facts that take precedence over cached detail.</summary>
    [Parameter]
    public TenantCorrectionProjection? StartProjection { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Gets a fresh authorized, versioned capture from one direct tenant read.</summary>
    [Parameter]
    public Func<Task<TenantCorrectionProjection>>? CurrentCaptureProvider { get; set; }

    /// <summary>Shows why a different row redirects to the retained attempt.</summary>
    [Parameter]
    public bool ShowCompetingAttemptNotice { get; set; }

    internal TenantCorrectionPreviewSnapshot? Snapshot => _snapshot;

    internal bool HasSubmitted => _hasSubmitted;

    private ITenantCommandGateway? CommandGateway
        => Services.GetService<ITenantCommandGateway>();

    private ITenantQueryGateway? QueryGateway
        => Services.GetService<ITenantQueryGateway>();

    // Resolve a localized key first so client-derived conflict/blocking copy stays support-safe and
    // localized (EN/FR); fall back to the gateway-provided SafeMessage, which is already user-facing text.
    private string? SafeMessageText
        => _snapshot is null
            ? null
            : _snapshot.SafeMessageKey is { } key
                ? Localizer[key].Value
                : _snapshot.SafeMessage;

    private string? UnavailableReason
        => _snapshot is null
            ? null
            : ShowCompetingAttemptNotice
                ? Localizer["Tenants.Correction.Unavailable.AggregateBusy"].Value
                : SafeMessageText ?? (IsViewportBlocked
                ? Localizer["Tenants.Correction.Unavailable.NarrowViewportUnavailable"].Value
                    : IsAggregateBusy
                    ? Localizer["Tenants.Correction.Unavailable.AggregateBusy"].Value
                    : IsCommandSupportBlocked
                        ? Localizer["Tenants.Correction.Unavailable.CommandSupportUnavailable"].Value
                        : !TenantLifecycleProjectionVersion.IsOrdered(_snapshot.BaselineProjectionVersion)
                            && _snapshot.Intent.IsAvailable
                            ? Localizer["Tenants.Correction.Unavailable.ProjectionVersionUnavailable"].Value
                            : _snapshot.Intent.IsAvailable && _snapshot.Intent.CurrentProjection?.OwnerCount is not >= 0
                                ? Localizer["Tenants.Correction.Unavailable.OwnerCountUnavailable"].Value
                            : string.Join(
                " ",
                DisplayedUnavailableReasons(_snapshot.Intent)
                    .Select(reason => Localizer[$"Tenants.Correction.Unavailable.{reason}"].Value)));

    // A hidden read keeps CurrentProjectionUnavailable for the projection marker, but the operator
    // sees one access recovery instead of the projection, lifecycle and membership guesses.
    private static IReadOnlyList<TenantCorrectionUnavailableReason> DisplayedUnavailableReasons(
        TenantCorrectionStartIntent intent)
        => TenantCorrectionStartIntent.IsHiddenRead(intent.CurrentProjection)
            && intent.UnavailableReasons.Contains(TenantCorrectionUnavailableReason.AuthorizationIndeterminate)
                ? TenantCorrectionStartIntent.WithoutHiddenReadGuesses(intent.UnavailableReasons)
                : intent.UnavailableReasons;

    private bool IsConfirmDisabled
        => _hasSubmitted || _isSubmitting || _snapshot?.CanSubmit is not true
            || IsCommandSupportBlocked || IsAggregateBusy || IsViewportBlocked;

    private bool IsCommandSupportBlocked
        => !_hasSubmitted && _snapshot?.CanSubmit is true
            && CommandGateway?.SupportsCommandStatusLookup is not true;

    private bool IsViewportBlocked
        => !_hasSubmitted && _viewportObservation is not null
            && (_viewportObservation.HasMeasurement is false
                || _viewportObservation.State is not TenantHighImpactViewportState.Safe);

    private bool IsAggregateBusy
        => !_hasSubmitted && _snapshot?.CanSubmit is true
            && _admissionGate.IsLocked(TenantCommandAggregateLock.ForTenant(_snapshot.TenantId));

    private bool RoleSelectionDisabled
        => _hasSubmitted || _isSubmitting || _snapshot?.LifecycleState is TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.Confirmed;

    private bool CanRefresh
        => !_isSubmitting && Volatile.Read(ref _statusReadInFlight) == 0 && _snapshot?.MessageId is not null
        && (_snapshot.CorrelationId is not null || !_attemptTracker.IsExpired(_snapshot.TenantId))
        && (_snapshot.LifecycleState is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.RequestSent
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded);

    private string StateText
        => _snapshot is null ? string.Empty : Localizer[$"Tenants.Correction.State.{_snapshot.LifecycleState}"];

    private string StateSymbol
        => _snapshot?.LifecycleState switch
        {
            TenantCommandLifecycleState.Confirmed or TenantCommandLifecycleState.AlreadyApplied => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            _ => ">",
        };

    private string LiveRegionMode
        => _snapshot?.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private TenantCorrectionProjection? CurrentProjectionForDisplay
        => _snapshot?.LastConfirmedCorrectionProjection ?? _snapshot?.Intent.CurrentProjection;

    private string ProjectionSnapshotLabel
        => CurrentProjectionForDisplay is { IsCurrent: true, IsAuthorized: true } capture
            && string.Equals(capture.TenantId, _snapshot?.TenantId, StringComparison.Ordinal)
            && string.Equals(capture.TargetUserId, _snapshot?.TargetUserId, StringComparison.Ordinal)
            ? Localizer["Tenants.Correction.Preview.CurrentProjectionReady", _snapshot?.TenantId ?? string.Empty]
            : Localizer["Tenants.Correction.Preview.CurrentProjectionUnavailable"];

    private string FreshnessLabel
        => Localizer[$"Tenants.Audit.Freshness.{CurrentProjectionForDisplay?.Freshness switch {
            ReadModelFreshnessState.Current => "Current",
            ReadModelFreshnessState.Aging => "Aging",
            ReadModelFreshnessState.Stale => "Stale",
            _ => "Unknown",
        }}"];

    private string ProvenanceLabel
        => CurrentProjectionForDisplay?.Provenance is QueryResponseProvenance.ProjectionBacked
            ? Localizer["Tenants.Correction.Preview.Provenance.ProjectionBacked"]
            : Localizer["Tenants.Correction.Preview.Provenance.Unverified"];

    private string CommandDomainLabel
        => _snapshot?.Intent.IntendedCommandDomain is null
            ? FieldValue(null)
            : Localizer[$"Tenants.Correction.Domain.{_snapshot.Intent.IntendedCommandDomain}"];

    private string CommandTypeLabel
        => _snapshot?.Intent.IntendedCommandType is null
            ? FieldValue(null)
            : Localizer[$"Tenants.Correction.Command.{_snapshot.Intent.IntendedCommandType}"];

    private string OriginalTimestampLabel
        => _snapshot?.OriginalTimestampUtc is { } timestamp
            ? timestamp.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)
            : FieldValue(null);

    private string ReadinessLabel
        => _hasSubmitted
            ? Localizer["Tenants.Correction.Preview.Readiness.Submitted"]
            : _snapshot?.CanSubmit is true && !IsAggregateBusy && !IsCommandSupportBlocked && !IsViewportBlocked
            ? Localizer["Tenants.Correction.Preview.Readiness.Ready"]
            : Localizer["Tenants.Correction.Preview.Readiness.Blocked"];

    private string CurrentRoleLabel
        => HasCurrentFactCapture && CurrentProjectionForDisplay!.CurrentRole is null
            ? Localizer["Tenants.Correction.Start.TargetAbsent"]
            : HasCurrentFactCapture ? RoleLabel(CurrentProjectionForDisplay!.CurrentRole ?? TenantRole.Unknown)
                : FieldValue(null);

    private bool HasCurrentFactCapture
        => CurrentProjectionForDisplay is { IsCurrent: true, IsAuthorized: true } capture
            && string.Equals(capture.TenantId, _snapshot?.TenantId, StringComparison.Ordinal)
            && string.Equals(capture.TargetUserId, _snapshot?.TargetUserId, StringComparison.Ordinal);

    private string OwnerImpactLabel
    {
        get
        {
            if (!HasCurrentFactCapture || _snapshot?.Intent.IntendedCommandType is null
                || _snapshot.IntendedRole is TenantRole.Unknown
                || CurrentProjectionForDisplay?.OwnerCount is not { } count)
            {
                return FieldValue(null);
            }

            string category = CurrentProjectionForDisplay.IsMembershipEmpty
                && _snapshot.IntendedRole is TenantRole.TenantOwner ? "Bootstrap"
                : CurrentProjectionForDisplay.CurrentRole is TenantRole.TenantOwner
                    && _snapshot.IntendedRole is not TenantRole.TenantOwner && count == 1 ? "LastOwner"
                : CurrentProjectionForDisplay.CurrentRole is TenantRole.TenantOwner
                    || _snapshot.IntendedRole is TenantRole.TenantOwner ? "Changes" : "None";
            return Localizer[$"Tenants.Correction.Preview.OwnerImpact.{category}", count];
        }
    }

    protected override void OnInitialized()
    {
        _attemptTracker = Services.GetService<TenantCorrectionAttemptTracker>() ?? _attemptTracker;
        _attemptTracker.StateChanged += OnAttemptChanged;
        _admissionGate = Services.GetService<TenantAggregateCommandAdmissionGate>() ?? _admissionGate;
        _admissionGate.StateChanged += OnAdmissionChanged;
        _viewportObservation = Services.GetService<TenantHighImpactViewportObservation>();
        if (_viewportObservation is not null) _viewportObservation.StateChanged += OnAdmissionChanged;
    }

    private void OnAdmissionChanged(object? sender, EventArgs args)
        => _ = InvokeAsync(StateHasChanged);

    private void OnAttemptChanged(object? sender, EventArgs args)
    {
        if (_disposed) return;
        _ = InvokeAsync(() => {
            if (_disposed) return;
            if (_snapshot is not null && _attemptTracker.Find(_snapshot.TenantId) is { } attempt
                && string.Equals(attempt.MessageId, _snapshot.MessageId, StringComparison.Ordinal))
            {
                SetSnapshot(attempt.Snapshot);
            }
            StateHasChanged();
        });
    }

    /// <inheritdoc />
    public void Dispose()
    {
        lock (_confirmSync)
        {
            Volatile.Write(ref _disposed, true);
            Interlocked.Increment(ref _confirmGeneration);
        }
        _admissionGate.StateChanged -= OnAdmissionChanged;
        _attemptTracker.StateChanged -= OnAttemptChanged;
        if (_viewportObservation is not null) _viewportObservation.StateChanged -= OnAdmissionChanged;
    }

    protected override void OnParametersSet()
    {
        if (Intent is null)
        {
            _snapshot = null;
            _intentReference = null;
            return;
        }

        TenantCorrectionAttempt? retained = _attemptTracker.Find(Intent.TenantScope);
        if (retained?.Matches(Intent) is true)
        {
            _snapshot = retained.Snapshot;
            _intentReference = Intent.OriginalAuditReference;
            _roleValue = retained.Snapshot.IntendedRole.ToString();
            _hasSubmitted = true;
            return;
        }

        // Rebuild the preview only when a different audit-evidence intent is supplied (or on first
        // set). An unchanged intent must never reset an existing snapshot on an unrelated parent
        // re-render (for example a projection refresh while this panel remains open): doing so
        // would discard a terminal Rejected/Failed/Degraded/UnableToVerify/AlreadyApplied
        // correction and silently re-arm submission (AC4). Role re-selection re-evaluates the preview
        // directly through OnRoleChanged, so it does not depend on this method.
        bool intentChanged = !string.Equals(_intentReference, Intent.OriginalAuditReference, StringComparison.Ordinal);
        if (_snapshot is not null && !intentChanged)
        {
            // Live-update the pre-submit preview against a projection the parent refreshed while the panel
            // stayed open (preserving the user's role selection in _roleValue). ONLY pre-submit preview
            // states are re-derived; submitted/terminal states are preserved so submission is never
            // re-armed (AC4, preserves the P1 guard).
            if ((StartProjection is not null || CurrentProjection is not null) && ShouldLiveUpdatePreview(_snapshot)
                && (StartProjection is null || _snapshot.Intent.CurrentProjection is null
                    || TenantLifecycleProjectionVersion.CompareSequences(
                        StartProjection.ProjectionVersion, _snapshot.Intent.CurrentProjection.ProjectionVersion)
                        is not TenantLifecycleSequenceRelation.IncomingOlder))
            {
                SetSnapshotFromIntent();
            }

            return;
        }

        _intentReference = Intent.OriginalAuditReference;
        _roleValue = Intent.IntendedRole?.ToString() ?? string.Empty;
        SetSnapshotFromIntent();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusReasonPending)
        {
            _focusReasonPending = false;
            try { await _reasonElement.FocusAsync().ConfigureAwait(false); }
            catch (JSDisconnectedException) { }
        }
        if (_focusLifecyclePending)
        {
            _focusLifecyclePending = false;
            try
            {
                await _lifecycleElement.FocusAsync().ConfigureAwait(false);
            }
            catch (JSDisconnectedException)
            {
                // Circuit dropped between the terminal SetSnapshot and this render; focus is no longer observable.
            }
        }
    }

    private void SetSnapshotFromIntent(TenantCorrectionProjection? currentCapture = null)
    {
        if (Intent is null)
        {
            return;
        }

        TenantCorrectionStartIntent resolvedIntent = ResolvedIntent(currentCapture);
        _snapshot = TenantCorrectionPreviewSnapshot.FromIntent(resolvedIntent, StartProjection is null ? CurrentProjection : null);
        if (resolvedIntent.UnavailableReasons.Count == 1
            && resolvedIntent.UnavailableReasons[0] is TenantCorrectionUnavailableReason.AlreadyApplied)
        {
            _snapshot = _snapshot with
            {
                LifecycleState = TenantCommandLifecycleState.AlreadyApplied,
                FocusTarget = TenantCommandFocusTarget.Lifecycle,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Polite,
                SafeMessageKey = "Tenants.Correction.Unavailable.AlreadyApplied",
            };
        }
    }

    private static bool ShouldLiveUpdatePreview(TenantCorrectionPreviewSnapshot snapshot)
        => !snapshot.HasCommandTracking
        && (snapshot.LifecycleState is TenantCommandLifecycleState.Previewed
            or TenantCommandLifecycleState.AlreadyApplied
            || (snapshot.LifecycleState is TenantCommandLifecycleState.UnableToVerify
                && (IsProjectionDrivenBlock(snapshot.SafeMessageKey)
                    || snapshot.SafeMessageKey is null && snapshot.Intent.UnavailableReasons.Count > 0)));

    private static bool IsProjectionDrivenBlock(string? safeMessageKey)
        => safeMessageKey is "Tenants.Correction.Unavailable.CurrentProjectionUnavailable"
            or "Tenants.Correction.Unavailable.CurrentStateIndeterminate"
            or "Tenants.Correction.Unavailable.CurrentRoleConflict";

    private void SetSnapshot(TenantCorrectionPreviewSnapshot snapshot, bool focusTerminalState = false)
    {
        _snapshot = snapshot;
        if (focusTerminalState
            && _snapshot.LifecycleState is TenantCommandLifecycleState.Confirmed
                or TenantCommandLifecycleState.Failed
                or TenantCommandLifecycleState.Rejected
                or TenantCommandLifecycleState.Degraded
                or TenantCommandLifecycleState.UnableToVerify
                or TenantCommandLifecycleState.AlreadyApplied)
        {
            _focusLifecyclePending = true;
        }
    }

    private TenantCorrectionStartIntent ResolvedIntent(TenantCorrectionProjection? currentCapture = null)
    {
        if (Intent is null)
        {
            return Intent!;
        }

        if (!TryParseAssignableRole(_roleValue, out TenantRole role))
        {
            Dictionary<string, string> blockedInputs = new(Intent.RequiredPreviewInputs, StringComparer.Ordinal);
            blockedInputs.Remove("intendedRole");
            return Intent with {
                IntendedRole = null,
                IntendedCommandType = null,
                RequiredPreviewInputs = blockedInputs,
                UnavailableReasons = Intent.UnavailableReasons
                    .Append(TenantCorrectionUnavailableReason.ExplicitRoleRequired).Distinct().ToArray(),
            };
        }

        Dictionary<string, string> inputs = new(Intent.RequiredPreviewInputs, StringComparer.Ordinal)
        {
            ["intendedRole"] = role.ToString(),
        };
        List<TenantCorrectionUnavailableReason> reasons = Intent.UnavailableReasons
            .Where(reason => reason is not TenantCorrectionUnavailableReason.ExplicitRoleRequired)
            .ToList();

        TenantCorrectionProjection? projectionCapture = currentCapture ?? StartProjection;
        if (projectionCapture is not null)
        {
            // Preserve the same redacted read used for start/handoff; cached detail cannot replace it.
            reasons.RemoveAll(reason => reason is TenantCorrectionUnavailableReason.AlreadyApplied
                or TenantCorrectionUnavailableReason.EmptyMembershipRequiresOwner
                or TenantCorrectionUnavailableReason.CurrentStateIndeterminate);
            bool matchingProjection = string.Equals(projectionCapture.TenantId, Intent.TenantScope, StringComparison.Ordinal)
                && string.Equals(projectionCapture.TargetUserId, Intent.TargetUserId, StringComparison.Ordinal);
            if (!projectionCapture.IsCurrent || !projectionCapture.IsAuthorized || !matchingProjection)
            {
                reasons.Add(TenantCorrectionUnavailableReason.CurrentProjectionUnavailable);
            }
            if (TenantCorrectionStartIntent.IsHiddenRead(projectionCapture))
            {
                reasons.Add(TenantCorrectionUnavailableReason.AuthorizationIndeterminate);
            }
            if (!matchingProjection) reasons.Add(TenantCorrectionUnavailableReason.ScopeConflict);
            if (!projectionCapture.IsCurrent || !projectionCapture.IsAuthorized || !matchingProjection)
            {
                inputs.Remove("currentRole");
                inputs.Remove("emptyMembership");
                inputs["currentProjectionSnapshot"] = string.Empty;
                return Intent with
                {
                    IntendedRole = role,
                    IntendedCommandType = null,
                    CurrentProjectionSnapshotReference = string.Empty,
                    CurrentProjection = projectionCapture,
                    RequiredPreviewInputs = inputs,
                    UnavailableReasons = reasons.Distinct().ToArray(),
                };
            }
            if (projectionCapture.TenantStatus is TenantStatus.Disabled)
            {
                reasons.Add(TenantCorrectionUnavailableReason.TenantDisabled);
            }
            else if (projectionCapture.TenantStatus is not TenantStatus.Active)
            {
                reasons.Add(TenantCorrectionUnavailableReason.TenantLifecycleUnknown);
            }
            if (projectionCapture.CurrentRole is TenantRole.Unknown)
            {
                reasons.Add(TenantCorrectionUnavailableReason.CurrentStateIndeterminate);
            }
            if (Intent.OutcomeType is "UserRoleChanged" && projectionCapture.CurrentRole is null)
            {
                reasons.Add(TenantCorrectionUnavailableReason.CurrentStateIndeterminate);
            }
            if (projectionCapture.CurrentRole is { } currentRole)
            {
                inputs["currentRole"] = currentRole.ToString();
                if (currentRole == role) reasons.Add(TenantCorrectionUnavailableReason.AlreadyApplied);
            }
            else
            {
                inputs.Remove("currentRole");
            }
            if (projectionCapture.IsMembershipEmpty && (role is not TenantRole.TenantOwner || !projectionCapture.IsGlobalAdministrator))
            {
                reasons.Add(TenantCorrectionUnavailableReason.EmptyMembershipRequiresOwner);
            }
            return Intent with
            {
                IntendedRole = role,
                IntendedCommandType = Intent.OutcomeType is "UserRoleChanged" && projectionCapture.CurrentRole is null ? null
                    : projectionCapture.CurrentRole == role ? null
                    : projectionCapture.CurrentRole is null ? TenantCorrectionCommandType.AddUserToTenant
                        : TenantCorrectionCommandType.ChangeUserRole,
                CurrentProjection = projectionCapture,
                RequiredPreviewInputs = inputs,
                UnavailableReasons = reasons.Distinct().ToArray(),
            };
        }

        if (CurrentProjection is not null)
        {
            TenantMember? member = CurrentProjection.Members.FirstOrDefault(member =>
                string.Equals(member.UserId, Intent.TargetUserId, StringComparison.Ordinal));
            if (member is not null)
            {
                inputs["currentRole"] = member.Role.ToString();
                if (Intent.IntendedCommandType is TenantCorrectionCommandType.AddUserToTenant)
                {
                    if (member.Role == role)
                    {
                        reasons.Add(TenantCorrectionUnavailableReason.AlreadyApplied);
                    }
                    else
                    {
                        reasons.Add(TenantCorrectionUnavailableReason.CurrentRoleConflict);
                    }
                }
            }
        }

        return Intent with
        {
            IntendedRole = role,
            RequiredPreviewInputs = inputs,
            UnavailableReasons = reasons.Distinct().ToArray(),
        };
    }

    private async Task SubmitAsync()
    {
        if (_snapshot is null || IsConfirmDisabled)
        {
            return;
        }

        long confirmGeneration = Volatile.Read(ref _confirmGeneration);
        _isSubmitting = true;
        try
        {
            // The preview's authority and role are only a handoff. Confirm uses a new direct read.
            TenantCorrectionProjection? capture;
            try { capture = await RefreshCaptureAsync().ConfigureAwait(false); }
            catch (Exception)
            {
                await InvokeAsync(() => SetCaptureUnavailable(confirmGeneration)).ConfigureAwait(false);
                return;
            }
            await InvokeAsync(() => AdmitAndDispatchAsync(capture, confirmGeneration)).ConfigureAwait(false);
        }
        finally
        {
            await InvokeAsync(() => { _isSubmitting = false; StateHasChanged(); }).ConfigureAwait(false);
        }
    }

    private void SetCaptureUnavailable(long confirmGeneration)
    {
        if (_disposed || confirmGeneration != _confirmGeneration || _snapshot is null) return;
        SetSnapshot(_snapshot with {
            LifecycleState = TenantCommandLifecycleState.Previewed,
            SafeMessage = null,
            SafeMessageKey = "Tenants.Correction.Unavailable.ConfirmReadFailed",
            FocusTarget = TenantCommandFocusTarget.Submit,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        });
        _focusReasonPending = true;
    }

    private async Task AdmitAndDispatchAsync(TenantCorrectionProjection? capture, long confirmGeneration)
    {
        if (_disposed || confirmGeneration != _confirmGeneration || _snapshot is null) return;
        if (capture is null) { SetCaptureUnavailable(confirmGeneration); return; }

        TenantCorrectionPreviewSnapshot preview = _snapshot;
        if (TenantLifecycleProjectionVersion.CompareSequences(
            capture.ProjectionVersion, preview.BaselineProjectionVersion)
            is TenantLifecycleSequenceRelation.IncomingOlder)
        {
            SetSnapshot(preview with {
                SafeMessage = null,
                SafeMessageKey = "Tenants.Correction.Unavailable.ProjectionRegressed",
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            });
            _focusReasonPending = true;
            return;
        }
        SetSnapshotFromIntent(capture);
        if (_snapshot?.CanSubmit is not true)
        {
            if (_snapshot is not null) SetSnapshot(_snapshot, focusTerminalState: true);
            return;
        }

        TenantCorrectionProjection? prior = preview.Intent.CurrentProjection;
        if (_snapshot.Intent.IntendedCommandType != preview.Intent.IntendedCommandType
            || prior?.CurrentRole != capture.CurrentRole
            || prior?.IsMembershipEmpty != capture.IsMembershipEmpty
            || prior?.OwnerCount != capture.OwnerCount)
        {
            SetSnapshot(_snapshot with {
                SafeMessageKey = "Tenants.Correction.Preview.ChangedAtConfirm",
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                FocusTarget = TenantCommandFocusTarget.Role,
            });
            _focusReasonPending = true;
            return;
        }

        // The renderer dispatches this section serially with parameter and viewport updates.
        if (IsViewportBlocked) return;
        TenantCorrectionAttempt? attempt;
        lock (_confirmSync)
        {
            if (_disposed || confirmGeneration != _confirmGeneration || IsViewportBlocked) return;
            if (!_attemptTracker.TryBegin(_snapshot, _admissionGate, out attempt) || attempt is null) return;
            _hasSubmitted = true;
            SetSnapshot(attempt.Snapshot);
        }

        await DispatchAttemptAsync(attempt).ConfigureAwait(false);
    }

    private async Task DispatchAttemptAsync(TenantCorrectionAttempt attempt)
    {
        ITenantCommandGateway? gateway = CommandGateway;
        if (gateway is null)
        {
            SetSnapshot(attempt.Snapshot with {
                LifecycleState = TenantCommandLifecycleState.UnableToVerify,
                SafeMessageKey = "Tenants.Correction.Unavailable.CommandSupportUnavailable",
                AuditState = TenantCommandAuditState.MissingSupport,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            }, focusTerminalState: true);
            _attemptTracker.TryUpdate(attempt.TenantId, attempt.MessageId, _snapshot!);
            _attemptTracker.EndDelivery(attempt.TenantId, attempt.MessageId);
            return;
        }

        TenantCorrectionPreviewSnapshot request = attempt.Snapshot;
        TenantCommandSubmissionResult result;
        try
        {
            result = request.Intent.IntendedCommandType switch
            {
                TenantCorrectionCommandType.AddUserToTenant => await gateway.AddUserToTenantAsync(
                    new(request.TenantId, request.TargetUserId, request.IntendedRole), attempt.MessageId,
                    CancellationToken.None).ConfigureAwait(false),
                TenantCorrectionCommandType.ChangeUserRole => await gateway.ChangeUserRoleAsync(
                    new(request.TenantId, request.TargetUserId, request.IntendedRole), attempt.MessageId,
                    CancellationToken.None).ConfigureAwait(false),
                _ => TenantCommandSubmissionResult.FailedWithKey("Tenants.Correction.Unavailable.CommandSupportUnavailable"),
            };
        }
        catch (Exception)
        {
            result = TenantCommandSubmissionResult.Ambiguous(attempt.MessageId,
                "Tenants.Correction.State.UnableToVerify");
        }

        TenantCorrectionPreviewSnapshot next = result.MessageId is not null
            && !string.Equals(result.MessageId, attempt.MessageId, StringComparison.Ordinal)
            ? request with {
                LifecycleState = TenantCommandLifecycleState.UnableToVerify,
                SafeMessageKey = "Tenants.Correction.State.UnableToVerify",
                AuditState = TenantCommandAuditState.MissingSupport,
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
            }
            : result.State is TenantCommandLifecycleState.Failed
                && result.IsAmbiguousFailure
                && string.Equals(result.MessageId, attempt.MessageId, StringComparison.Ordinal)
                ? request with {
                    LifecycleState = TenantCommandLifecycleState.UnableToVerify,
                    SafeMessage = null,
                    SafeMessageKey = "Tenants.Correction.State.UnableToVerify",
                    AuditState = TenantCommandAuditState.MissingSupport,
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                }
            : result.State is TenantCommandLifecycleState.Accepted
                && string.Equals(result.MessageId, attempt.MessageId, StringComparison.Ordinal)
                && !string.IsNullOrWhiteSpace(result.CorrelationId)
                ? request.Accepted(result)
                : request.ApplySubmissionFailure(result) with {
                    MessageId = attempt.MessageId,
                    SafeMessage = null,
                    SafeMessageKey = result.SafeMessageKey ?? FailureMessageKey(result.State),
                };
        _attemptTracker.EndDelivery(attempt.TenantId, attempt.MessageId);
        SetRetainedSnapshot(attempt, next, focusTerminalState: true);
        if (next.LifecycleState is TenantCommandLifecycleState.Accepted)
        {
            await RefreshStatusAsync(afterDispatch: true).ConfigureAwait(false);
        }
    }

    private async Task RefreshStatusAsync(bool afterDispatch = false)
    {
        if (!afterDispatch && !CanRefresh) return;
        if (_snapshot?.MessageId is not { } messageId
            || _attemptTracker.Find(_snapshot.TenantId) is not { } attempt
            || !string.Equals(attempt.MessageId, messageId, StringComparison.Ordinal))
        {
            return;
        }

        // Another panel may have advanced this attempt while this panel was remounted.
        SetSnapshot(attempt.Snapshot);

        if (string.IsNullOrWhiteSpace(_snapshot.CorrelationId))
        {
            if (_isSubmitting || !_attemptTracker.TryStartRetry(attempt.TenantId, messageId)) return;
            _isSubmitting = true;
            try { await DispatchAttemptAsync(attempt).ConfigureAwait(false); }
            finally { _isSubmitting = false; }
            return;
        }

        ITenantCommandGateway? gateway = CommandGateway;
        if (gateway is null)
        {
            SetRetainedSnapshot(attempt, _snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(
                Localizer["Tenants.Correction.Unavailable.CommandSupportUnavailable"])));
            return;
        }

        if (Interlocked.CompareExchange(ref _statusReadInFlight, 1, 0) != 0) return;
        try
        {
        TenantCommandStatusResult status;
        try
        {
            status = await gateway.GetStatusAsync(
                new(messageId, _snapshot.CorrelationId, _snapshot.TenantId), CancellationToken.None)
                .ConfigureAwait(false);
        }
        catch (Exception)
        {
            status = TenantCommandStatusResult.RetryableFailure(
                Localizer["Tenants.Correction.State.UnableToVerify"]);
        }
        if (status.IsPending || status.IsRetryableFailure)
        {
            SetRetainedSnapshot(attempt, _snapshot with { SafeMessage = null,
                SafeMessageKey = status.IsPending ? "Tenants.Correction.Status.Pending" : "Tenants.Correction.Status.Retryable",
                FocusTarget = TenantCommandFocusTarget.Refresh });
            return;
        }
        if (!status.HasVerifiedCommandIdentity)
        {
            SetRetainedSnapshot(attempt, _snapshot with { LifecycleState = TenantCommandLifecycleState.UnableToVerify,
                SafeMessageKey = "Tenants.Correction.State.UnableToVerify",
                FocusTarget = TenantCommandFocusTarget.Refresh,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive }, focusTerminalState: true);
            return;
        }

        TenantCorrectionPreviewSnapshot next = _snapshot.ApplyStatus(status);
        if (next.SafeMessageKey is null && FailureMessageKey(next.LifecycleState) is { } failureKey)
        {
            next = next with { SafeMessage = null, SafeMessageKey = status.SafeMessageKey ?? failureKey };
        }
        if (next.LifecycleState is TenantCommandLifecycleState.ProjectionPending
            && status.EventCount is > 0)
        {
            try
            {
                TenantCorrectionProjection? capture = await RefreshCaptureAsync().ConfigureAwait(false);
                next = next.ConfirmProjection(capture);
            }
            catch (Exception)
            {
                next = next with {
                    LifecycleState = TenantCommandLifecycleState.UnableToVerify,
                    SafeMessage = null,
                    SafeMessageKey = "Tenants.Correction.Unavailable.CurrentProjectionUnavailable",
                    AuditState = TenantCommandAuditState.MissingSupport,
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                };
            }
        }
        next = next.WithCorrectiveProof(null);
        SetRetainedSnapshot(attempt, next, focusTerminalState: true);
        }
        finally { Volatile.Write(ref _statusReadInFlight, 0); }
    }

    private static string? FailureMessageKey(TenantCommandLifecycleState state)
        => state switch {
            TenantCommandLifecycleState.Rejected => "Tenants.Correction.Failure.Rejected",
            TenantCommandLifecycleState.Failed => "Tenants.Correction.Failure.Failed",
            TenantCommandLifecycleState.Degraded => "Tenants.Correction.Failure.Degraded",
            TenantCommandLifecycleState.UnableToVerify => "Tenants.Correction.Failure.UnableToVerify",
            _ => null,
        };

    private void SetRetainedSnapshot(TenantCorrectionAttempt attempt,
        TenantCorrectionPreviewSnapshot candidate, bool focusTerminalState = false)
    {
        _attemptTracker.TryUpdate(attempt.TenantId, attempt.MessageId, candidate);
        SetSnapshot(_attemptTracker.Find(attempt.TenantId)?.Snapshot ?? candidate, focusTerminalState);
    }

    private async Task<TenantCorrectionProjection?> RefreshCaptureAsync()
    {
        if (_snapshot is null) return null;
        if (CurrentCaptureProvider is not null)
        {
            return await CurrentCaptureProvider().ConfigureAwait(false);
        }
        return QueryGateway is null ? null : await QueryGateway.GetTenantCorrectionProjectionAsync(
            _snapshot.TenantId, _snapshot.TargetUserId, CancellationToken.None).ConfigureAwait(false);
    }

    private async Task CloseAsync()
    {
        // Invalidate a Confirm that is awaiting its direct read before the parent unmounts us.
        lock (_confirmSync) Interlocked.Increment(ref _confirmGeneration);
        await InvokeAsync(() => OnClose.InvokeAsync()).ConfigureAwait(false);
    }

    private Task OnPanelKeyDownAsync(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
        => args.Key is "Escape" ? CloseAsync() : Task.CompletedTask;

    private void OnRoleChanged(string? value)
    {
        if (RoleSelectionDisabled)
        {
            return;
        }
        _roleValue = value ?? string.Empty;
        SetSnapshotFromIntent();
    }

    private string RoleLabel(TenantRole role)
        => role is TenantRole.Unknown ? FieldValue(null) : Localizer[$"Tenants.Correction.Role.{role}"];

    private string PreviewValue(string key, string value)
        => key is "currentProjectionSnapshot" && value is "tenant-projection-current"
            ? Localizer["Tenants.Correction.Start.Projection"]
            : key is "emptyMembership" ? Localizer["Tenants.Correction.Start.EmptyRecovery"]
            : key is "intendedRole" or "currentRole"
            ? Enum.TryParse(value, out TenantRole role) ? RoleLabel(role) : FieldValue(null)
            : FieldValue(value);

    private string ConsequenceLabel(string value)
        => Localizer[$"Tenants.Correction.Preview.Consequence.{ConsequenceKey(value)}"];

    private string UnknownLabel(string value)
        => Localizer[$"Tenants.Correction.Preview.Unknown.{ConsequenceKey(value)}"];

    private static string ConsequenceKey(string value)
        => value.Contains("membership", StringComparison.OrdinalIgnoreCase)
            ? "Membership"
            : value.Contains("role-change", StringComparison.OrdinalIgnoreCase)
                ? "RoleChange"
                : value.Contains("SignalR", StringComparison.Ordinal)
                    ? "SignalR"
                    : value.Contains("Historical role", StringComparison.Ordinal)
                        ? "HistoricalRole"
                        : "Unsupported";

    private static string FieldValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static bool TryParseAssignableRole(string value, out TenantRole role)
    {
        if (Enum.TryParse(value, ignoreCase: false, out role)
            && AssignableRoles.Contains(role))
        {
            return true;
        }

        role = TenantRole.Unknown;
        return false;
    }
}
