@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services

<section class="tenants-create-flow" data-testid="tenants-create-flow"
         aria-labelledby="@(ShowHeading ? "tenants-create-heading" : null)"
         aria-label="@(ShowHeading ? null : Localizer["Tenants.Create.Title"].Value)">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="tenants-create-flow__heading">
        @if (ShowHeading)
        {
            <h2 id="tenants-create-heading">@Localizer["Tenants.Create.Title"]</h2>
        }
        <p>@Localizer["Tenants.Create.Description"]</p>
    </FluentStack>

    @if (!string.IsNullOrWhiteSpace(UnavailableReason))
    {
        <p class="tenants-create-flow__unavailable"
           data-testid="tenants-create-unavailable-reason"
           role="alert">
            @UnavailableReason
        </p>
    }

    <EditForm Model="@_formModel"
              FormName="tenants-create-flow"
              class="tenants-create-flow__form"
              OnSubmit="SubmitAsync">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="tenants-create-flow__field">
            <FluentTextInput Id="tenants-create-tenant-id"
                             @ref="_tenantIdElement"
                             Name="tenant-id"
                             Label="@Localizer["Tenants.Create.TenantId.Label"]"
                             Value="@_tenantId"
                             ValueChanged="OnTenantIdInput"
                             data-testid="tenants-create-tenant-id"
                             aria-describedby="@TenantIdDescribedBy" />
            <span id="tenants-create-tenant-id-help" class="tenants-create-flow__hint">@Localizer["Tenants.Create.TenantId.Help"]</span>
        </FluentStack>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="tenants-create-flow__field">
            <FluentTextInput Id="tenants-create-name"
                             @ref="_nameElement"
                             Name="tenant-name"
                             Label="@Localizer["Tenants.Create.Name.Label"]"
                             Value="@_name"
                             ValueChanged="OnNameInput"
                             data-testid="tenants-create-name"
                             aria-describedby="@ValidationDescribedBy" />
        </FluentStack>

        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="tenants-create-flow__field tenants-create-flow__field--wide">
            <FluentTextArea Id="tenants-create-description"
                            Name="tenant-description"
                            Label="@Localizer["Tenants.Create.Description.Label"]"
                            Value="@_description"
                            ValueChanged="OnDescriptionInput"
                            data-testid="tenants-create-description" />
        </FluentStack>

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <p id="tenants-create-validation"
               class="tenants-create-flow__validation"
               data-testid="tenants-create-validation"
               role="alert">
                @_validationMessage
            </p>
        }

        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.75rem" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom" Class="tenants-create-flow__actions">
            <FluentButton Type="ButtonType.Submit"
                          Appearance="ButtonAppearance.Primary"
                          data-testid="tenants-create-submit"
                          Disabled="@IsSubmitDisabled">
                @Localizer["Tenants.Create.Submit"]
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Outline"
                          data-testid="tenants-create-refresh"
                          Disabled="@(!CanRefresh)"
                          OnClick="RefreshStatusAsync">
                @Localizer["Tenants.Create.Refresh"]
            </FluentButton>
        </FluentStack>
    </EditForm>

    <section class="tenants-create-flow__lifecycle"
             @ref="_lifecycleElement"
             tabindex="-1"
             data-testid="tenants-create-lifecycle"
             aria-labelledby="tenants-create-state-label">
        <h3 id="tenants-create-state-label">@Localizer["Tenants.Create.Lifecycle.Title"]</h3>
        <p class="@StateClass" data-testid="tenants-create-state">
            <span aria-hidden="true">@StateSymbol</span>
            <span>@StateText</span>
        </p>
        <div data-testid="tenants-create-audit">
            @if (ShouldRenderAuditEntryPoint)
            {
                <AuditAvailabilityState AuditState="@_snapshot.AuditState"
                                        OnRefresh="RefreshStatusAsync">
                    <InspectAuditAction>
                        <AuditEvidenceEntryPoint TenantId="@_tenantId"
                                                 SourceKind="command-result"
                                                 SourceTestId="tenants-command-audit-entrypoint"
                                                 Label="@Localizer["Tenants.Audit.EntryPoint.Label"]"
                                                 AccessibleName="@Localizer["Tenants.Audit.EntryPoint.Accessible.Command", AuditText, _tenantId ?? string.Empty]"
                                                 ReturnUrl="/tenants"
                                                 ReturnFocus="tenants-create-lifecycle"
                                                 AvailabilityText="@AuditText"
                                                 UnavailableReason="@Localizer["Tenants.Audit.EntryPoint.CommandReason"]" />
                    </InspectAuditAction>
                </AuditAvailabilityState>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(SafeMessageText))
        {
            <p data-testid="tenants-create-safe-message">@SafeMessageText</p>
        }
        <p class="tenants-create-flow__live"
           data-testid="tenants-create-live-region"
           aria-live="@LiveRegionMode"
           aria-atomic="true">
            @StateText
        </p>
    </section>
</section>

@code {
    private readonly object _formModel = new();
    private TenantCreateCommandSnapshot _snapshot = TenantCreateCommandSnapshot.Idle();
    private string? _tenantId;
    private string? _name;
    private string? _description;
    private string? _validationMessage;
    private bool _isSubmitting;
    private FluentTextInput _tenantIdElement = default!;
    private FluentTextInput _nameElement = default!;
    private ElementReference _lifecycleElement;
    private bool _focusTenantIdPending;
    private bool _focusNamePending;
    private bool _focusLifecyclePending;

    [Parameter]
    public bool ShowHeading { get; set; } = true;

    [Parameter]
    public bool IsAuthorized { get; set; } = true;

    [Parameter]
    public bool IsFresh { get; set; } = true;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public string? BaselineProjectionVersion { get; set; }

    [Parameter]
    public bool BaselineTenantAbsent { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public Func<string, Task<(TenantSummary? Summary, string? ProjectionVersion)>>? ProjectionEvidenceProvider { get; set; }

    internal TenantCreateCommandSnapshot Snapshot => _snapshot;

    private string? UnavailableReason
        => !IsAuthorized
            ? Localizer["Tenants.Create.Unavailable.Authorization"].Value
            : !IsFresh
                ? Localizer["Tenants.Create.Unavailable.Freshness"].Value
                : !IsCommandSurfaceAvailable || CommandGateway is null
                    ? Localizer["Tenants.Create.Unavailable.CommandSurface"].Value
                    : _isSubmitting
                        ? Localizer["Tenants.Create.Unavailable.InFlight"].Value
                        : null;

    private bool IsSubmitDisabled => !string.IsNullOrWhiteSpace(UnavailableReason);

    private bool CanRefresh
        => _snapshot.CorrelationId is not null
        && _snapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded;

    private ITenantCommandGateway? CommandGateway
        => Services.GetService<ITenantCommandGateway>();

    private string StateClass
        => $"tenants-create-flow__state tenants-create-flow__state--{_snapshot.State.ToString().ToLowerInvariant()}";

    private string StateSymbol
        => _snapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed => "✓",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            _ => "•",
        };

    private string StateText
        => Localizer[$"Tenants.Create.State.{_snapshot.State}"];

    private string AuditText
        => Localizer[$"Tenants.Create.Audit.{_snapshot.AuditState}"];

    private string? SafeMessageText
        => !string.IsNullOrWhiteSpace(_snapshot.SafeMessage)
            ? _snapshot.SafeMessage
            : !string.IsNullOrWhiteSpace(_snapshot.SafeMessageKey)
                ? Localizer[_snapshot.SafeMessageKey].Value
                : null;

    private bool ShouldRenderAuditEntryPoint
        => _snapshot.AuditState is not TenantCommandAuditState.NotStarted;

    private string LiveRegionMode
        => _snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string TenantIdDescribedBy
        => string.IsNullOrWhiteSpace(_validationMessage)
            ? "tenants-create-tenant-id-help"
            : "tenants-create-tenant-id-help tenants-create-validation";

    private string? ValidationDescribedBy
        => string.IsNullOrWhiteSpace(_validationMessage) ? null : "tenants-create-validation";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTenantIdPending)
        {
            _focusTenantIdPending = false;
            await _tenantIdElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusNamePending)
        {
            _focusNamePending = false;
            await _nameElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusLifecyclePending)
        {
            _focusLifecyclePending = false;
            await _lifecycleElement.FocusAsync().ConfigureAwait(false);
        }
    }

    // Honours the lifecycle FocusTarget for fail-closed/non-success transitions: when the command
    // surface becomes blocked, rejected, failed, degraded, or unable-to-verify, the submit button
    // may disable, so focus is moved to the lifecycle region to keep it recoverable (AC6). Routine
    // polite progress (request sent, accepted, projection pending, confirmed) never steals focus.
    private void SetSnapshot(TenantCreateCommandSnapshot snapshot)
    {
        _snapshot = snapshot;
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive)
        {
            _focusLifecyclePending = true;
        }
    }

    internal void ApplySignalRNudge()
        => _snapshot = _snapshot.SignalRNudge();

    internal void ApplyProjectionEvidence(TenantSummary? summary, string? projectionVersion)
        => _snapshot = _snapshot.ConfirmProjection(summary, null, projectionVersion);

    private void OnTenantIdInput(string? value)
        => _tenantId = value;

    private void OnNameInput(string? value)
        => _name = value;

    private void OnDescriptionInput(string? value)
        => _description = value;

    private async Task SubmitAsync()
    {
        _validationMessage = null;

        if (!string.IsNullOrWhiteSpace(UnavailableReason))
        {
            SetSnapshot(TenantCreateCommandSnapshot.Blocked(UnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        if (string.IsNullOrWhiteSpace(_tenantId))
        {
            _validationMessage = Localizer["Tenants.Create.Validation.TenantIdRequired"];
            _focusTenantIdPending = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_name))
        {
            _validationMessage = Localizer["Tenants.Create.Validation.NameRequired"];
            _focusNamePending = true;
            return;
        }

        var request = new CreateTenant(_tenantId, _name, _description);
        if (_snapshot.MessageId is not null || _snapshot.CorrelationId is not null)
        {
            if (_snapshot.Intent == request && _snapshot.MessageId is not null && _snapshot.CorrelationId is not null)
            {
                await RefreshStatusAsync().ConfigureAwait(false);
                return;
            }

            SetSnapshot(TenantCreateCommandSnapshot.Blocked(
                Localizer["Tenants.Create.Unavailable.Tracking"].Value,
                TenantCommandFocusTarget.Refresh));
            return;
        }

        _isSubmitting = true;

        try
        {
            bool? baselineTenantAbsent = await CaptureBaselineTenantAbsenceAsync(request.TenantId).ConfigureAwait(false);
            if (baselineTenantAbsent is null)
            {
                SetSnapshot(TenantCreateCommandSnapshot.Blocked(
                    Localizer["Tenants.Create.Unavailable.Freshness"].Value,
                    TenantCommandFocusTarget.Refresh));
                return;
            }

            _snapshot = _snapshot.RequestSent(
                request,
                BaselineProjectionVersion,
                baselineTenantAbsent.Value);
            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                SetSnapshot(TenantCreateCommandSnapshot.Blocked(
                    Localizer["Tenants.Create.Unavailable.CommandSurface"].Value,
                    TenantCommandFocusTarget.Submit));
                return;
            }

            TenantCommandSubmissionResult result = await gateway
                .CreateTenantAsync(request, messageId: null, cancellationToken: CancellationToken.None)
                .ConfigureAwait(false);

            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                SetSnapshot(_snapshot.Accepted(result));
                await RefreshStatusAsync().ConfigureAwait(false);
            }
            else
            {
                SetSnapshot(_snapshot with
                {
                    State = result.State,
                    SafeMessage = result.SafeMessage,
                    SafeMessageKey = null,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditState.AuditUnavailable,
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task RefreshStatusAsync()
    {
        if (_snapshot.MessageId is null || _snapshot.CorrelationId is null)
        {
            return;
        }

        ITenantCommandGateway? gateway = CommandGateway;
        if (gateway is null)
        {
            SetSnapshot(_snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(Localizer["Tenants.Create.Unavailable.CommandSurface"].Value)));
            return;
        }

        TenantCommandStatusResult status = await gateway
            .GetStatusAsync(new TenantCommandTrackingHandle(_snapshot.MessageId, _snapshot.CorrelationId), CancellationToken.None)
            .ConfigureAwait(false);
        SetSnapshot(_snapshot.ApplyStatus(status));

        // Marshal the EventCallback back onto the renderer's Dispatcher: the preceding
        // ConfigureAwait(false) awaits leave us on a thread-pool thread, and invoking the
        // callback there triggers the parent's StateHasChanged off-Dispatcher, which throws
        // "The current thread is not associated with the Dispatcher" and tears down the circuit.
        await InvokeAsync(() => OnProjectionRefreshRequested.InvokeAsync()).ConfigureAwait(false);
        if (_snapshot.Intent is not null)
        {
            try
            {
                (TenantSummary? Summary, string? ProjectionVersion) listResult = ProjectionEvidenceProvider is null
                    ? (null, null)
                    : await ProjectionEvidenceProvider(_snapshot.Intent.TenantId).ConfigureAwait(false);
                TenantDetailSnapshot? detailEvidence = null;
                if (Services.GetService<ITenantQueryGateway>() is ITenantQueryGateway queryGateway)
                {
                    detailEvidence = await queryGateway
                        .GetTenantAsync(
                            new TenantDetailRequest(_snapshot.Intent.TenantId),
                            previous: null,
                            cancellationToken: CancellationToken.None)
                        .ConfigureAwait(false);
                }

                SetSnapshot(_snapshot.ConfirmProjection(listResult.Summary, detailEvidence, listResult.ProjectionVersion));
            }
            catch (Exception)
            {
                SetSnapshot(UnableToVerifyProjection());
            }
        }
    }

    private async Task<bool?> CaptureBaselineTenantAbsenceAsync(string tenantId)
    {
        if (BaselineTenantAbsent)
        {
            return true;
        }

        if (Services.GetService<ITenantQueryGateway>() is not ITenantQueryGateway queryGateway)
        {
            return false;
        }

        try
        {
            TenantDetailSnapshot detail = await queryGateway
                .GetTenantAsync(
                    new TenantDetailRequest(tenantId),
                    previous: null,
                    cancellationToken: CancellationToken.None)
                .ConfigureAwait(false);
            return detail.Kind is TenantDetailSurfaceKind.NotFound;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private TenantCreateCommandSnapshot UnableToVerifyProjection()
        => _snapshot with
        {
            State = TenantCommandLifecycleState.UnableToVerify,
            SafeMessage = null,
            SafeMessageKey = "Tenants.Create.Confirm.UnableToVerify.MissingProvenance",
            AuditState = TenantCommandAuditState.AuditUnavailable,
            FocusTarget = TenantCommandFocusTarget.Refresh,
            LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
        };
}
