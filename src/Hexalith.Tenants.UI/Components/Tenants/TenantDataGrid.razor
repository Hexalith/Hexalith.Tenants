@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.UI.State.TenantList
@inject IStringLocalizer<TenantsResources> Localizer

<div class="tenant-data-grid" data-testid="tenants-list-grid">
    <FluentDataGrid Items="@Rows.AsQueryable()"
                    @key="GridSortStateKey"
                    ResizableColumns="true"
                    ReorderableColumns="false"
                    MultiLine="true"
                    GenerateHeader="DataGridGeneratedHeaderType.Sticky"
                    ItemKey="@(row => row.TenantId)"
                    OnSortChanged="@SortChanged">
        <TemplateColumn Title="@Localizer["Tenants.List.CurrentPageSort.Tenant"]"
                        ColumnId="tenant-id"
                        Class="tenants-critical tenants-critical--identity"
                        Width="var(--tenants-grid-identity-width)"
                        Sortable="true"
                        SortBy="@TenantSort"
                        IsDefaultSortColumn="@(!PreserveRowOrder && IsTenantNameSort)"
                        InitialSortDirection="@InitialSortDirection"
                        Pin="DataGridColumnPin.Start">
            <HeaderCellTitleTemplate>
                <FluentText As="TextTag.Span" data-testid="tenants-list-sort-tenant">@Localizer["Tenants.List.CurrentPageSort.Tenant"]</FluentText>
            </HeaderCellTitleTemplate>
            <ChildContent>
                <div class="tenant-data-grid__identity"
                     id="@TenantDomIdentity.ElementId("tenant-row-", context.TenantId)"
                     data-testid="tenants-list-tenant-id">
                    <div class="tenant-data-grid__identity-line">
                        @if (TenantAuditNavigationSafety.IsSafeTenantId(context.TenantId))
                        {
                            <a class="tenant-data-grid__detail-link"
                               href="@DetailHref(context)"
                               title="@context.TenantId"
                               data-testid="tenants-list-detail-link"
                               aria-label="@Localizer["Tenants.List.DetailLinkLabel", context.TenantId]">
                                <strong>@context.TenantId</strong>
                            </a>
                        }
                        else
                        {
                            <strong>@context.TenantId</strong>
                        }
                        <SupportSafeCopyButton Value="@context.TenantId"
                                               ValueKind="SupportSafeCopyValueKind.TenantId"
                                               IsApproved="true"
                                               AccessibleName="@Localizer["Tenants.Copy.Label.TenantId", context.TenantId]"
                                               TestId="tenants-list-copy-reference" />
                    </div>
                    <span>@context.Name</span>
                    @if (!AuditReadDenied)
                    {
                        <FluentStack Class="tenant-data-grid__mobile-audit" Width="100%">
                            @AuditEntryPoint(context, compact: true)
                        </FluentStack>
                    }
                </div>
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.List.CurrentPageSort.Status"]"
                        ColumnId="tenant-status"
                        Class="tenants-critical tenants-critical--status"
                        Width="var(--tenants-grid-status-width)"
                        Sortable="true"
                        SortBy="@StatusSort"
                        IsDefaultSortColumn="@(!PreserveRowOrder && IsStatusSort)"
                        InitialSortDirection="@InitialSortDirection"
                        Pin="DataGridColumnPin.Start">
            <HeaderCellTitleTemplate>
                <FluentText As="TextTag.Span" data-testid="tenants-list-sort-status">@Localizer["Tenants.List.CurrentPageSort.Status"]</FluentText>
            </HeaderCellTitleTemplate>
            <ChildContent>
                <FluentText As="TextTag.Span" role="img" aria-label="@StatusLabel(context.Status)" data-status-badge="true">
                    <FluentBadge aria-hidden="true" Appearance="@(StatusBadgeColor(context.Status) is BadgeColor.Danger or BadgeColor.Severe ? BadgeAppearance.Filled : BadgeAppearance.Tint)"
                                 Shape="BadgeShape.Rounded"
                                 Color="@StatusBadgeColor(context.Status)"
                                 IconStart="@StatusIcon(context.Status)"
                                 IconLabel="@StatusLabel(context.Status)"
                                 role="img"
                                 Class="@($"tenant-data-grid__status tenant-data-grid__status--{StatusCss(context.Status)}")"
                                 aria-label="@StatusLabel(context.Status)"
                                 data-testid="tenants-list-status">
                        @StatusLabel(context.Status)
                    </FluentBadge>
                </FluentText>
            </ChildContent>
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.List.Column.Freshness"]"
                        ColumnId="tenant-freshness"
                        Class="tenants-critical tenants-critical--freshness"
                        Width="var(--tenants-grid-freshness-width)"
                        Pin="DataGridColumnPin.Start">
            <TruthStateBadge Freshness="@context.Freshness" />
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.ProjectionLifecycle.Label"]"
                        ColumnId="tenant-projection-lifecycle"
                        Width="180px">
            <ProjectionLifecycleBadge Lifecycle="@context.Lifecycle" />
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.List.Column.Members"]" ColumnId="tenant-members" Width="115px">
            @CountLabel(context.MemberCount)
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.List.Column.Owners"]" ColumnId="tenant-owners" Width="115px">
            @CountLabel(context.OwnerCount)
        </TemplateColumn>
        <TemplateColumn Title="@Localizer["Tenants.List.Column.Pending"]"
                        ColumnId="tenant-pending"
                        Class="tenants-critical tenants-critical--pending"
                        Width="175px">
            <FluentText As="TextTag.Span" role="img" aria-label="@PendingLabel(context.PendingState)" data-status-badge="true">
                <FluentBadge aria-hidden="true" Appearance="@(PendingBadgeColor(context.PendingState) is BadgeColor.Danger or BadgeColor.Severe ? BadgeAppearance.Filled : BadgeAppearance.Tint)"
                             Shape="BadgeShape.Rounded"
                             Color="@PendingBadgeColor(context.PendingState)"
                             IconStart="@PendingIcon(context.PendingState)"
                             IconLabel="@PendingLabel(context.PendingState)"
                             role="img"
                             Class="tenant-data-grid__pending"
                             aria-label="@PendingLabel(context.PendingState)"
                             data-testid="tenants-list-pending">
                    @PendingLabel(context.PendingState)
                </FluentBadge>
            </FluentText>
        </TemplateColumn>
        @if (!AuditReadDenied)
        {
        <TemplateColumn Title="@Localizer["Tenants.List.Column.Audit"]" ColumnId="tenant-audit" Width="175px">
            <FluentStack Class="tenant-data-grid__desktop-audit">
                @AuditEntryPoint(context, compact: false)
            </FluentStack>
        </TemplateColumn>
        }
    </FluentDataGrid>
</div>

@code {
    // The grid owns column-header sorting (replacing the former sort comboboxes). The Tenant column
    // sorts by display name (with tenant id as a stable tiebreak); Status sorts by status. The default
    // unsorted order remains the server/tenant-id order supplied by the host page.
    private static readonly GridSort<TenantListRow> _sortByTenant =
        GridSort<TenantListRow>.ByAscending(row => row.Name).ThenAscending(row => row.TenantId);

    private static readonly GridSort<TenantListRow> _sortByStatus =
        GridSort<TenantListRow>.ByAscending(row => row.Status);

    [Parameter]
    public IReadOnlyList<TenantListRow> Rows { get; set; } = [];

    [Parameter]
    public Func<TenantListRow, string> DetailHref { get; set; } = static row => $"/tenants/{Uri.EscapeDataString(row.TenantId)}";

    [Parameter]
    public Func<TenantListRow, string> AuditHref { get; set; } = static row => $"/tenants/{Uri.EscapeDataString(row.TenantId)}/audit?source=tenant-list";

    [Parameter]
    public bool AuditReadAvailable { get; set; }

    [Parameter]
    public bool AuditReadDenied { get; set; }

    [Parameter]
    public bool AuditReadPending { get; set; }

    [Parameter]
    public string? AuditUnavailableReason { get; set; }

    [Parameter]
    public EventCallback OnAuditRefresh { get; set; }

    [Parameter]
    public string SortColumn { get; set; } = TenantListSortColumns.TenantId;

    [Parameter]
    public bool SortDescending { get; set; }

    [Parameter]
    public bool PreserveRowOrder { get; set; }

    [Parameter]
    public EventCallback<DataGridSortEventArgs<TenantListRow>> SortChanged { get; set; }

    private bool IsTenantNameSort
        => string.Equals(SortColumn, TenantListSortColumns.Name, StringComparison.Ordinal);

    private bool IsStatusSort
        => string.Equals(SortColumn, TenantListSortColumns.Status, StringComparison.Ordinal);

    private DataGridSortDirection InitialSortDirection
        => SortDescending ? DataGridSortDirection.Descending : DataGridSortDirection.Ascending;

    private GridSort<TenantListRow>? TenantSort
        => PreserveRowOrder ? null : _sortByTenant;

    private GridSort<TenantListRow>? StatusSort
        => PreserveRowOrder ? null : _sortByStatus;

    private string GridSortStateKey
        => $"{SortColumn}:{SortDescending}:{PreserveRowOrder}";

    private RenderFragment AuditEntryPoint(TenantListRow row, bool compact)
        => @<AuditEvidenceEntryPoint TenantId="@row.TenantId"
                                     SourceKind="tenant-list"
                                     SourceTestId="@(compact ? "tenants-list-mobile-audit-entrypoint" : "tenants-list-audit-entrypoint")"
                                     Label="@Localizer[compact ? "Tenants.List.Column.Audit" : "Tenants.Audit.EntryPoint.Label"]"
                                     AccessibleName="@Localizer["Tenants.List.AuditAccessibleLabel", row.TenantId]"
                                     ReturnUrl="@ListReturnUrl(row)"
                                     ReturnFocus="@TenantDomIdentity.ElementId("tenant-row-", row.TenantId)"
                                     PartialReturn="@(TenantAuditNavigationSafety.IsSafeTenantId(row.TenantId) && AuditHref(row).Contains("auditPartialReturn=true", StringComparison.Ordinal))"
                                     IsAvailable="@(AuditReadAvailable && row.Freshness is ReadModelFreshnessState.Current && row.Lifecycle is ProjectionLifecycleState.Current)"
                                     AuthorityPending="@AuditReadPending"
                                     UnavailableReason="@AuditUnavailableReason"
                                     OnRefresh="@OnAuditRefresh" />;

    private string? ListReturnUrl(TenantListRow row)
    {
        if (!TenantAuditNavigationSafety.IsSafeTenantId(row.TenantId))
        {
            return null;
        }

        string href = AuditHref(row);
        int returnUrlIndex = href.IndexOf("returnUrl=", StringComparison.Ordinal);
        if (returnUrlIndex < 0)
        {
            return null;
        }

        string encodedReturnUrl = href[(returnUrlIndex + "returnUrl=".Length)..];
        int nextParameterIndex = encodedReturnUrl.IndexOf('&', StringComparison.Ordinal);
        if (nextParameterIndex >= 0)
        {
            encodedReturnUrl = encodedReturnUrl[..nextParameterIndex];
        }

        return Uri.UnescapeDataString(encodedReturnUrl);
    }

    private string CountLabel(TenantCountValue count)
        => count.IsKnown
            ? count.Value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)
            : Localizer["Tenants.List.Count.Unknown"];

    private string PendingLabel(TenantPendingState state)
        => state == TenantPendingState.None
            ? Localizer["Tenants.List.Pending.None"]
            : Localizer["Tenants.List.Pending.Unknown"];

    private string StatusLabel(TenantStatus status)
        => Localizer[$"Tenants.List.Status.{status}"];

    private static string StatusCss(TenantStatus status)
        => status.ToString().ToLowerInvariant();

    private static BadgeColor StatusBadgeColor(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => BadgeColor.Success,
            TenantStatus.Disabled => BadgeColor.Severe,
            _ => BadgeColor.Important,
        };

    private static Icon StatusIcon(TenantStatus status)
        => status switch
        {
            TenantStatus.Active => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Checkmark(),
            TenantStatus.Disabled => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.Power(),
            _ => new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.QuestionCircle(),
        };

    private static BadgeColor PendingBadgeColor(TenantPendingState state)
        => state == TenantPendingState.None ? BadgeColor.Subtle : BadgeColor.Important;

    private static Icon PendingIcon(TenantPendingState state)
        => state == TenantPendingState.None
            ? new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.SubtractCircle()
            : new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size20.QuestionCircle();
}
