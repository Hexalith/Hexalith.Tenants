@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.Contracts.Queries
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Microsoft.Extensions.DependencyInjection
@inject IStringLocalizer<TenantsResources> Localizer
@inject IServiceProvider Services

<section class="tenants-config-set"
         data-testid="tenants-config-set-flow"
         aria-labelledby="tenants-config-set-heading"
         @onkeydown="HandleKeyDownAsync">
    <header class="tenants-config-set__header">
        <div>
            <h3 id="tenants-config-set-heading">@Localizer["Tenants.Configuration.Set.Title"]</h3>
            <p>@Localizer["Tenants.Configuration.Set.Description", Context.TenantId]</p>
        </div>
        @if (CanOpen)
        {
            <span class="tenants-config-set__open-focus" tabindex="-1" @ref="_openElement">
                <FluentButton Appearance="ButtonAppearance.Primary"
                              data-testid="tenants-config-set-open"
                              aria-controls="tenants-config-set-editor"
                              OnClick="OpenEditorAsync">
                    @Localizer["Tenants.Configuration.Set.Open"]
                </FluentButton>
            </span>
        }
    </header>

    <p class="tenants-config-set__narrow"
       data-testid="tenants-config-set-narrow-unavailable">
        @Localizer["Tenants.Configuration.Set.Unavailable.Narrow"]
    </p>

    @if (!string.IsNullOrWhiteSpace(UnavailableReason))
    {
        <p class="tenants-config-set__unavailable"
           id="tenants-config-set-unavailable"
           data-testid="tenants-config-set-unavailable-reason"
           role="alert">
            @UnavailableReason
        </p>
    }

    @if (_isOpen)
    {
        <EditForm Model="@_formModel"
                  FormName="tenants-config-set-editor"
                  id="tenants-config-set-editor"
                  class="tenants-config-set__form"
                  OnSubmit="SubmitAsync">
            <div class="tenants-config-set__field">
                <FluentTextInput Id="tenants-config-set-key"
                                 @ref="_keyElement"
                                 name="configuration-key"
                                 Label="@Localizer["Tenants.Configuration.Set.Key.Label"]"
                                 Value="@_key"
                                 ValueChanged="OnKeyInput"
                                 data-testid="tenants-config-set-key"
                                 aria-describedby="@KeyDescribedBy" />
                <span id="tenants-config-set-key-help">@Localizer["Tenants.Configuration.Set.Key.Help"]</span>
            </div>

            <div class="tenants-config-set__field">
                <FluentTextArea Id="tenants-config-set-value"
                                @ref="_valueElement"
                                name="configuration-value"
                                Label="@Localizer["Tenants.Configuration.Set.Value.Label"]"
                                Value="@_value"
                                ValueChanged="OnValueInput"
                                data-testid="tenants-config-set-value"
                                aria-describedby="@ValueDescribedBy" />
                <span id="tenants-config-set-value-help">@Localizer["Tenants.Configuration.Set.Value.Help"]</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_validationMessage))
            {
                <p id="tenants-config-set-validation"
                   class="tenants-config-set__validation"
                   data-testid="tenants-config-set-validation"
                   role="alert">
                    @_validationMessage
                </p>
            }

            @if (IsPreviewComplete)
            {
                <section class="tenants-config-set__preview"
                         data-testid="tenants-config-set-preview"
                         aria-labelledby="tenants-config-set-preview-heading">
                    <h4 id="tenants-config-set-preview-heading">@Localizer["Tenants.Configuration.Set.Preview.Title"]</h4>
                    <dl>
                        @foreach ((string Label, string Value, string TestId) item in PreviewItems)
                        {
                            <div data-testid="tenants-config-set-preview-item">
                                <dt>@item.Label</dt>
                                <dd data-testid="@item.TestId">@item.Value</dd>
                            </div>
                        }
                    </dl>
                </section>
            }
            else
            {
                <p class="tenants-config-set__preview-blocked"
                   id="tenants-config-set-preview-blocked"
                   data-testid="tenants-config-set-preview-blocked"
                   role="status">
                    @PreviewUnavailableReason
                </p>
            }

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Wrap="true" Class="tenants-config-set__actions">
                <FluentButton Type="ButtonType.Submit"
                              Appearance="ButtonAppearance.Primary"
                              data-testid="tenants-config-set-submit"
                              Disabled="@IsSubmitDisabled">
                    @Localizer["Tenants.Configuration.Set.Submit"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-config-set-refresh"
                              Disabled="@(!CanRefresh)"
                              OnClick="RefreshStatusAsync">
                    @Localizer["Tenants.Configuration.Set.Refresh"]
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Outline"
                              data-testid="tenants-config-set-cancel"
                              OnClick="CloseEditorAsync">
                    @Localizer["Tenants.Configuration.Set.Cancel"]
                </FluentButton>
            </FluentStack>
        </EditForm>
    }

    <section class="tenants-config-set__lifecycle"
             @ref="_lifecycleElement"
             tabindex="-1"
             data-testid="tenants-config-set-lifecycle"
             aria-labelledby="tenants-config-set-state-label">
        <h4 id="tenants-config-set-state-label">@Localizer["Tenants.Configuration.Set.Lifecycle.Title"]</h4>
        <p class="@StateClass" data-testid="tenants-config-set-state">
            <span aria-hidden="true">@StateSymbol</span>
            <span>@StateText</span>
        </p>
        <div data-testid="tenants-config-set-audit">
            @if (ShouldRenderAuditEntryPoint)
            {
                <AuditAvailabilityState AuditState="@_snapshot.AuditState"
                                        OnRefresh="RefreshStatusAsync">
                    <InspectAuditAction>
                        <AuditEvidenceEntryPoint TenantId="@Context.TenantId"
                                                 SourceKind="command-result"
                                                 SourceTestId="tenants-command-audit-entrypoint"
                                                 Label="@Localizer["Tenants.Audit.EntryPoint.Label"]"
                                                 AccessibleName="@Localizer["Tenants.Audit.EntryPoint.Accessible.Command", AuditText, Context.TenantId]"
                                                 ReturnUrl="@CommandAuditReturnUrl"
                                                 ReturnFocus="tenants-config-set-lifecycle"
                                                 AvailabilityText="@AuditText"
                                                 UnavailableReason="@Localizer["Tenants.Audit.EntryPoint.CommandReason"]" />
                    </InspectAuditAction>
                </AuditAvailabilityState>
            }
        </div>
        <p data-testid="tenants-config-set-recovery">@RecoveryText</p>
        @if (!string.IsNullOrWhiteSpace(_snapshot.SafeMessage))
        {
            <p data-testid="tenants-config-set-safe-message">@_snapshot.SafeMessage</p>
        }
        <p class="tenants-config-set__live"
           data-testid="tenants-config-set-live-region"
           aria-live="@LiveRegionMode"
           aria-atomic="true">
            @StateText
        </p>
    </section>
</section>

@code {
    private const int MaxConfigurationKeyLength = 256;
    private const int MaxConfigurationValueLength = 1024;

    private readonly object _formModel = new();
    private TenantSetConfigurationCommandSnapshot _snapshot = TenantSetConfigurationCommandSnapshot.Idle();
    private string? _key;
    private string? _value;
    private string? _validationMessage;
    private bool _isOpen;
    private bool _isSubmitting;
    private bool _hasRaisedCommandActivity;
    private ElementReference _openElement;
    private FluentTextInput _keyElement = default!;
    private FluentTextArea _valueElement = default!;
    private ElementReference _lifecycleElement;
    private bool _focusOpenPending;
    private bool _focusKeyPending;
    private bool _focusValuePending;
    private bool _focusLifecyclePending;

    [Parameter]
    public TenantConfigurationManagementContext Context { get; set; } = default!;

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    [Parameter]
    public bool IsAuthorized { get; set; } = true;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    [Parameter]
    public Func<SetTenantConfiguration, Task<TenantConfigurationProjectionProof>>? ProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<Task<TenantConfigurationManagementContext>>? ReauthorizeProvider { get; set; }

    internal TenantSetConfigurationCommandSnapshot Snapshot => _snapshot;

    private IReadOnlySet<string> AuthorizedNamespaces
        => Context.AuthorizedPrefixes
            .Where(static value => !string.Equals(value, "*", StringComparison.Ordinal))
            .ToHashSet(StringComparer.Ordinal);

    private string? UnavailableReason
        => !IsAuthorized || SurfaceKind is TenantDetailSurfaceKind.Unauthorized
            ? Localizer["Tenants.Configuration.Set.Unavailable.Authorization"].Value
            : Context?.IsAvailable != true
                ? Localizer["Tenants.Configuration.Set.Unavailable.Scope"].Value
            : Lifecycle is not ProjectionLifecycleState.Current
                ? Localizer["Tenants.Configuration.Set.Unavailable.ProjectionLifecycle"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown or TenantDetailSurfaceKind.Degraded
                ? Localizer["Tenants.Configuration.Set.Unavailable.ProjectionState"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Stale || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.Configuration.Set.Unavailable.Freshness"].Value
                : Context.TenantStatus is TenantStatus.Disabled or TenantStatus.Unknown
                    ? Localizer["Tenants.Configuration.Set.Unavailable.TenantLifecycle"].Value
                    : (!IsCommandSurfaceAvailable && !IsOwnedCommandInFlight) || CommandGateway is null
                        ? Localizer["Tenants.Configuration.Set.Unavailable.CommandSurface"].Value
                        : _isSubmitting
                            ? Localizer["Tenants.Configuration.Set.Unavailable.InFlight"].Value
                            : string.IsNullOrWhiteSpace(Context.TenantId)
                                ? Localizer["Tenants.Configuration.Set.Unavailable.Identity"].Value
                                : !Context.IsGlobalAdministrator && AuthorizedNamespaces.Count == 0
                                    ? Localizer["Tenants.Configuration.Set.Unavailable.Scope"].Value
                                    : null;

    private bool CanOpen
        => !_isOpen && string.IsNullOrWhiteSpace(UnavailableReason);

    private bool IsOwnedCommandInFlight
        => TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State, _isSubmitting);

    private bool IsSubmitDisabled
        => IsOwnedCommandInFlight
        || !IsPreviewComplete
        || !string.IsNullOrWhiteSpace(UnavailableReason);

    private bool CanRefresh
        => _snapshot.Intent is not null
        && _snapshot.State is TenantCommandLifecycleState.Accepted
            or TenantCommandLifecycleState.ProjectionPending
            or TenantCommandLifecycleState.Rejected
            or TenantCommandLifecycleState.UnableToVerify
            or TenantCommandLifecycleState.Degraded;

    private bool IsPreviewComplete
        => string.IsNullOrWhiteSpace(UnavailableReason)
        && TryBuildRequest(out _, out _, showValidation: false);

    private ITenantCommandGateway? CommandGateway
        => Services.GetService<ITenantCommandGateway>();

    private IReadOnlyList<(string Label, string Value, string TestId)> PreviewItems
    {
        get
        {
            if (!TryBuildRequest(out SetTenantConfiguration? request, out string? authorizedNamespace, showValidation: false)
                || request is null
                || authorizedNamespace is null)
            {
                return [];
            }

            TenantConfigurationSafeRow? current = Context.FindRemovableRow(request.Key);
            string currentState = current?.Value
                ?? Localizer["Tenants.Configuration.Set.Preview.CurrentState.Unavailable"];
            return
            [
                (Localizer["Tenants.Configuration.Set.Preview.Tenant"], Context.TenantId, "tenants-config-set-tenant-id"),
                (Localizer["Tenants.Configuration.Set.Preview.Namespace"], authorizedNamespace, "tenants-config-set-preview-namespace"),
                (Localizer["Tenants.Configuration.Set.Preview.Key"], request.Key, "tenants-config-set-preview-key"),
                (Localizer["Tenants.Configuration.Set.Preview.CurrentState"], currentState, "tenants-config-set-preview-current-state"),
                (Localizer["Tenants.Configuration.Set.Preview.IntendedEffect"], Localizer["Tenants.Configuration.Set.Preview.IntendedEffect.Value"], "tenants-config-set-preview-effect"),
                (Localizer["Tenants.Configuration.Set.Preview.Freshness"], Localizer[$"Tenants.Configuration.Set.Freshness.{Freshness}"], "tenants-config-set-preview-freshness"),
                (Localizer["Tenants.Configuration.Set.Preview.Authorization"], Localizer["Tenants.Configuration.Set.Preview.Authorization.Value"], "tenants-config-set-preview-authorization"),
                (Localizer["Tenants.Configuration.Set.Preview.KnownConsequences"], Localizer["Tenants.Configuration.Set.Preview.KnownConsequences.Value"], "tenants-config-set-preview-consequences"),
                (Localizer["Tenants.Configuration.Set.Preview.KnownUnknowns"], Localizer["Tenants.Configuration.Set.Preview.KnownUnknowns.Value"], "tenants-config-set-preview-unknowns"),
                (Localizer["Tenants.Configuration.Set.Preview.AuditExpectation"], Localizer["Tenants.Configuration.Set.Preview.AuditExpectation.Value"], "tenants-config-set-preview-audit"),
                (Localizer["Tenants.Configuration.Set.Preview.RecoveryPath"], Localizer["Tenants.Configuration.Set.Preview.RecoveryPath.Value"], "tenants-config-set-preview-recovery"),
            ];
        }
    }

    private string PreviewUnavailableReason
    {
        get
        {
            _ = TryBuildRequest(out _, out _, showValidation: false);
            return !string.IsNullOrWhiteSpace(UnavailableReason)
                ? UnavailableReason
                : _validationMessage ?? Localizer["Tenants.Configuration.Set.Preview.Blocked.Required"];
        }
    }

    private string StateClass
        => $"tenants-config-set__state tenants-config-set__state--{_snapshot.State.ToString().ToLowerInvariant()}";

    private string StateSymbol
        => _snapshot.State switch
        {
            TenantCommandLifecycleState.Confirmed or TenantCommandLifecycleState.AlreadyApplied => "OK",
            TenantCommandLifecycleState.Rejected or TenantCommandLifecycleState.Failed or TenantCommandLifecycleState.DuplicatePrevented => "!",
            TenantCommandLifecycleState.Degraded or TenantCommandLifecycleState.UnableToVerify => "?",
            _ => ">",
        };

    private string StateText
        => Localizer[$"Tenants.Configuration.Set.State.{_snapshot.State}"];

    private string AuditText
        => Localizer[$"Tenants.Configuration.Set.Audit.{_snapshot.AuditState}"];

    private bool ShouldRenderAuditEntryPoint
        => _snapshot.AuditState is not TenantCommandAuditState.NotStarted;

    private string CommandAuditReturnUrl
        => $"/tenants/{Uri.EscapeDataString(Context.TenantId)}";

    private string RecoveryText
        => Localizer[$"Tenants.Configuration.Set.Recovery.{_snapshot.State}"];

    private string LiveRegionMode
        => _snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive ? "assertive" : "polite";

    private string KeyDescribedBy
        => DescribedBy("tenants-config-set-key-help");

    private string ValueDescribedBy
        => DescribedBy("tenants-config-set-value-help");

    protected override void OnParametersSet()
    {
        if (_snapshot.State is TenantCommandLifecycleState.Idle)
        {
            _snapshot = TenantSetConfigurationCommandSnapshot.Idle();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusOpenPending)
        {
            _focusOpenPending = false;
            await _openElement.FocusAsync().ConfigureAwait(false);
        }

        if (_focusKeyPending)
        {
            _focusKeyPending = false;
            await _keyElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusValuePending)
        {
            _focusValuePending = false;
            await _valueElement.Element.FocusAsync().ConfigureAwait(false);
        }

        if (_focusLifecyclePending)
        {
            _focusLifecyclePending = false;
            await _lifecycleElement.FocusAsync().ConfigureAwait(false);
        }
    }

    private void SetSnapshot(TenantSetConfigurationCommandSnapshot snapshot)
    {
        _snapshot = snapshot;
        if (_snapshot.LiveRegionPoliteness is TenantCommandLiveRegionPoliteness.Assertive
            || _snapshot.FocusTarget is TenantCommandFocusTarget.Lifecycle)
        {
            _focusLifecyclePending = true;
        }
    }

    private async Task SetCommandActivityRaisedAsync(bool isActive)
    {
        if (_hasRaisedCommandActivity == isActive)
        {
            return;
        }

        _hasRaisedCommandActivity = isActive;
        await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
    }

    private async Task UpdateCommandActivityForSnapshotAsync()
        => await SetCommandActivityRaisedAsync(TenantCommandFlowGuard.RetainsCommandActivity(_snapshot.State, _isSubmitting)).ConfigureAwait(false);

    internal void ApplySignalRNudge()
        => _snapshot = _snapshot.SignalRNudge();

    internal void ApplyProjectionEvidence(TenantConfigurationProjectionProof? proof)
        => _snapshot = _snapshot.ConfirmProjection(proof);

    private async Task OpenEditorAsync()
    {
        _validationMessage = null;
        _key = null;
        _value = null;
        _isOpen = true;
        _focusKeyPending = true;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private async Task CloseEditorAsync()
    {
        _isOpen = false;
        _validationMessage = null;
        _focusOpenPending = true;
        await InvokeAsync(() => OnCloseRequested.InvokeAsync()).ConfigureAwait(false);
    }

    private void OnKeyInput(string? value)
    {
        _key = value;
        ClearValidationAndPreview();
    }

    private void OnValueInput(string? value)
    {
        _value = value;
        ClearValidationAndPreview();
    }

    private void ClearValidationAndPreview()
    {
        _validationMessage = null;
        if (TryBuildRequest(out SetTenantConfiguration? request, out _, showValidation: false) && request is not null)
        {
            _snapshot = _snapshot.Previewed(request);
            return;
        }

        if (_snapshot.State is TenantCommandLifecycleState.Previewed)
        {
            _snapshot = _snapshot with
            {
                State = TenantCommandLifecycleState.Idle,
                Intent = null,
                IsPreviewComplete = false,
                SafeMessage = null,
                RejectionCode = null,
                AuditState = TenantCommandAuditState.NotStarted,
                FocusTarget = TenantCommandFocusTarget.Submit,
                LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Polite,
            };
        }
    }

    private async Task SubmitAsync()
    {
        _validationMessage = null;

        if (_isSubmitting)
        {
            SetSnapshot(_snapshot.DuplicatePrevented(Localizer["Tenants.Configuration.Set.DuplicatePrevented.Message"].Value));
            return;
        }

        if (IsOwnedCommandInFlight)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(UnavailableReason))
        {
            SetSnapshot(TenantSetConfigurationCommandSnapshot.Blocked(UnavailableReason, TenantCommandFocusTarget.Submit));
            return;
        }

        if (!TryBuildRequest(out SetTenantConfiguration? request, out _, showValidation: true) || request is null)
        {
            return;
        }

        _snapshot = _snapshot.Previewed(request);

        // Re-authorization runs before the already-applied short-circuit. Deciding "already applied"
        // from the parameter Context would let a terminal success state be derived entirely from rows
        // captured before the grant was revoked.
        TenantConfigurationManagementContext currentContext;
        try
        {
            currentContext = ReauthorizeProvider is null
                ? TenantConfigurationManagementContext.Unavailable(Context.TenantId, Context.TenantStatus)
                : await ReauthorizeProvider().ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception)
        {
            currentContext = TenantConfigurationManagementContext.Unavailable(Context.TenantId, Context.TenantStatus);
        }

        if (!string.Equals(currentContext.TenantId, request.TenantId, StringComparison.Ordinal)
            || !currentContext.IsKeyAuthorized(request.Key))
        {
            SetSnapshot(TenantSetConfigurationCommandSnapshot.Blocked(
                Localizer["Tenants.Configuration.Set.Unavailable.Scope"].Value,
                TenantCommandFocusTarget.Submit));
            return;
        }

        if (currentContext.FindRemovableRow(request.Key) is { } current
            && string.Equals(current.Value, request.Value, StringComparison.Ordinal))
        {
            SetSnapshot(_snapshot.AlreadyApplied(
                request,
                Localizer["Tenants.Configuration.Set.AlreadyApplied.BeforeSubmit"].Value));
            return;
        }

        _snapshot = _snapshot.RequestSent();
        _isSubmitting = true;
        await SetCommandActivityRaisedAsync(true).ConfigureAwait(false);

        try
        {
            ITenantCommandGateway? gateway = CommandGateway;
            if (gateway is null)
            {
                SetSnapshot(TenantSetConfigurationCommandSnapshot.Blocked(
                    Localizer["Tenants.Configuration.Set.Unavailable.CommandSurface"].Value,
                    TenantCommandFocusTarget.Submit));
                return;
            }

            TenantCommandSubmissionResult result = await gateway
                .SetTenantConfigurationAsync(request, CancellationToken.None)
                .ConfigureAwait(false);

            if (result.State is TenantCommandLifecycleState.Accepted)
            {
                SetSnapshot(_snapshot.Accepted(result));
                await RefreshStatusAsync().ConfigureAwait(false);
            }
            else
            {
                SetSnapshot(_snapshot with
                {
                    State = result.State,
                    SafeMessage = result.SafeMessage,
                    RejectionCode = result.RejectionCode,
                    AuditState = TenantCommandAuditState.AuditUnavailable,
                    FocusTarget = TenantCommandFocusTarget.Refresh,
                    LiveRegionPoliteness = TenantCommandLiveRegionPoliteness.Assertive,
                });
            }
        }
        finally
        {
            _isSubmitting = false;
            await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
        }
    }

    private async Task RefreshStatusAsync()
    {
        if (_snapshot.Intent is null)
        {
            return;
        }

        ITenantCommandGateway? gateway = CommandGateway;
        if (_snapshot.MessageId is not null && _snapshot.CorrelationId is not null)
        {
            if (gateway is null)
            {
                SetSnapshot(_snapshot.ApplyStatus(TenantCommandStatusResult.Unknown(Localizer["Tenants.Configuration.Set.Unavailable.CommandSurface"].Value)));
                await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
                return;
            }

            TenantCommandStatusResult status = await gateway
                .GetStatusAsync(new TenantCommandTrackingHandle(_snapshot.MessageId, _snapshot.CorrelationId), CancellationToken.None)
                .ConfigureAwait(false);
            SetSnapshot(_snapshot.ApplyStatus(status));
        }

        await InvokeAsync(() => OnProjectionRefreshRequested.InvokeAsync()).ConfigureAwait(false);
        if (ProjectionEvidenceProvider is not null)
        {
            TenantConfigurationProjectionProof proof = await ProjectionEvidenceProvider(_snapshot.Intent).ConfigureAwait(false);
            SetSnapshot(_snapshot.ConfirmProjection(proof));
        }

        await UpdateCommandActivityForSnapshotAsync().ConfigureAwait(false);
    }

    private bool TryBuildRequest(
        out SetTenantConfiguration? request,
        out string? authorizedNamespace,
        bool showValidation)
    {
        request = null;
        authorizedNamespace = null;

        string keyValue = _key ?? string.Empty;
        if (keyValue.Length == 0)
        {
            SetValidation(showValidation, Localizer["Tenants.Configuration.Set.Validation.KeyRequired"], TenantCommandFocusTarget.Key);
            return false;
        }

        if (!Context.IsKeyAuthorized(keyValue))
        {
            SetValidation(showValidation, Localizer["Tenants.Configuration.Set.Validation.NamespaceScope"], TenantCommandFocusTarget.Key);
            return false;
        }

        if (keyValue.Length > MaxConfigurationKeyLength)
        {
            SetValidation(showValidation, Localizer["Tenants.Configuration.Set.Validation.KeyLength", MaxConfigurationKeyLength], TenantCommandFocusTarget.Key);
            return false;
        }

        string? value = _value;
        if (value is null || value.Length == 0)
        {
            SetValidation(showValidation, Localizer["Tenants.Configuration.Set.Validation.ValueRequired"], TenantCommandFocusTarget.Value);
            return false;
        }

        if (value.Length > MaxConfigurationValueLength)
        {
            SetValidation(showValidation, Localizer["Tenants.Configuration.Set.Validation.ValueLength", MaxConfigurationValueLength], TenantCommandFocusTarget.Value);
            return false;
        }

        authorizedNamespace = ResolveAuthorizedNamespace(keyValue);
        if (authorizedNamespace is null)
        {
            SetValidation(showValidation, Localizer["Tenants.Configuration.Set.Validation.NamespaceScope"], TenantCommandFocusTarget.Key);
            return false;
        }

        request = new SetTenantConfiguration(Context.TenantId, keyValue, value);
        return true;
    }

    private void SetValidation(bool showValidation, string message, TenantCommandFocusTarget focusTarget)
    {
        if (showValidation)
        {
            _validationMessage = message;
            QueueValidationFocus(focusTarget);
        }
    }

    private string DescribedBy(string helpId)
    {
        List<string> ids = [helpId];
        if (!IsPreviewComplete)
        {
            ids.Add("tenants-config-set-preview-blocked");
        }

        if (!string.IsNullOrWhiteSpace(UnavailableReason))
        {
            ids.Add("tenants-config-set-unavailable");
        }

        if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            ids.Add("tenants-config-set-validation");
        }

        return string.Join(" ", ids.Distinct(StringComparer.Ordinal));
    }

    private void QueueValidationFocus(TenantCommandFocusTarget focusTarget)
    {
        _focusKeyPending = focusTarget is TenantCommandFocusTarget.Key;
        _focusValuePending = focusTarget is TenantCommandFocusTarget.Value;
    }

    private string? ResolveAuthorizedNamespace(string key)
    {
        if (Context.IsGlobalAdministrator)
        {
            int separator = key.IndexOf('.', StringComparison.Ordinal);
            return separator > 0 ? key[..separator] : key;
        }

        return AuthorizedNamespaces
            .Where(prefix => TenantConfigurationManagementContext.IsPrefixMatch(prefix, key))
            .OrderByDescending(static prefix => prefix.Length)
            .ThenBy(static prefix => prefix, StringComparer.Ordinal)
            .FirstOrDefault();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.Ordinal) && _isOpen)
        {
            await CloseEditorAsync().ConfigureAwait(false);
        }
    }
}
