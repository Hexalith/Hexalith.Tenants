@using Hexalith.Tenants.Contracts.Enums
@using Hexalith.Tenants.UI.State.TenantCommands
@using Hexalith.Tenants.UI.State.TenantDetail
@using Microsoft.JSInterop
@inject IStringLocalizer<TenantsResources> Localizer

@* The unavailable reason is programmatically associated with the landmark it disables. It previously
   carried an id that nothing referenced, and its branch renders no control to attach it to. *@
<section class="tenant-config-management"
         aria-labelledby="tenants-config-management-heading"
         aria-describedby="@(IsManagementUnavailable ? "tenants-config-management-unavailable" : null)"
         data-testid="tenants-config-management-section">
    <header class="tenant-config-management__header">
        <h2 id="tenants-config-management-heading"
            tabindex="-1"
            @ref="_headingElement">@Localizer["Tenants.Configuration.Management.Title"]</h2>
        <p>@Localizer["Tenants.Configuration.Management.Description"]</p>
    </header>

    <section class="tenant-config-management__availability" role="list" data-testid="tenants-config-management-availability">
        <section role="listitem"
                 data-testid="tenants-config-set-availability"
                 data-action="@SetAvailability.Action">
            <h3>@Localizer["Tenants.HighImpact.Action.SetConfiguration"]</h3>
            <dl>
                <dt>@Localizer["Tenants.HighImpact.Fact.Identity"]</dt><dd data-testid="tenants-config-set-identity">@ResolvedSetEvidence.TenantId</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Status"]</dt><dd data-testid="tenants-config-set-status">@StatusText(ResolvedSetEvidence.TenantStatus)</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Freshness"]</dt><dd data-testid="tenants-config-set-freshness">@FreshnessText(ResolvedSetEvidence.Freshness)</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Action"]</dt><dd data-testid="tenants-config-set-action">@ActionText(ResolvedSetEvidence.Action)</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Reason"]</dt><dd id="tenants-config-set-reason" data-testid="tenants-config-set-reason">@Localizer[SetAvailability.SafeMessageKey]</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Recovery"]</dt><dd id="tenants-config-set-recovery" data-testid="tenants-config-set-recovery">@Localizer[SetAvailability.RecoveryKey]</dd>
            </dl>
        </section>
        <section role="listitem"
                 data-testid="tenants-config-remove-availability"
                 data-action="@RemoveAvailability.Action">
            <h3>@Localizer["Tenants.HighImpact.Action.RemoveConfiguration"]</h3>
            <dl>
                <dt>@Localizer["Tenants.HighImpact.Fact.Identity"]</dt><dd data-testid="tenants-config-remove-identity">@ResolvedRemoveEvidence.TenantId</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Status"]</dt><dd data-testid="tenants-config-remove-status">@StatusText(ResolvedRemoveEvidence.TenantStatus)</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Freshness"]</dt><dd data-testid="tenants-config-remove-freshness">@FreshnessText(ResolvedRemoveEvidence.Freshness)</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Action"]</dt><dd data-testid="tenants-config-remove-action">@ActionText(ResolvedRemoveEvidence.Action)</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Reason"]</dt><dd id="tenants-config-remove-reason" data-testid="tenants-config-remove-reason">@Localizer[RemoveAvailability.SafeMessageKey]</dd>
                <dt>@Localizer["Tenants.HighImpact.Fact.Recovery"]</dt><dd id="tenants-config-remove-recovery" data-testid="tenants-config-remove-recovery">@Localizer[RemoveAvailability.RecoveryKey]</dd>
            </dl>
        </section>
    </section>

    @if (!HasPolicyScope)
    {
        <p id="tenants-config-management-unavailable"
           data-testid="tenants-config-management-unavailable"
           role="status"
           aria-live="polite">
            @Localizer[PolicyUnavailableResourceKey]
        </p>
    }
    else if (!string.IsNullOrWhiteSpace(UnavailableReason))
    {
        <p id="tenants-config-management-unavailable"
           data-testid="tenants-config-management-unavailable"
           role="status"
           aria-live="polite">
            @UnavailableReason
        </p>
    }
    else
    {

        <SetTenantConfigurationFlow Context="@EffectiveContext"
                                    Evidence="@ResolvedSetEvidence"
                                    LauncherDescribedBy="tenants-config-set-reason tenants-config-set-recovery"
                                    SurfaceKind="@SurfaceKind"
                                    Freshness="@Freshness"
                                    Lifecycle="@Lifecycle"
                                    IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                    OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                    CommandActivityLease="@SetFlowCommandActivityLease"
                                    ProjectionEvidenceProvider="@SetProjectionEvidenceProvider"
                                    ReauthorizeProvider="@ReauthorizeProvider" />

        @if (EffectiveContext.RemovableRows.Count == 0)
        {
            <p data-testid="tenants-config-management-empty">
                @Localizer["Tenants.Configuration.Management.Empty"]
            </p>
        }
        else
        {
            <div class="tenant-config-management__targets"
                 role="region"
                 tabindex="0"
                 aria-label="@Localizer["Tenants.Configuration.Management.TargetsAccessibleLabel"]"
                 data-testid="tenants-config-management-targets">
                <FluentDataGrid Items="@EffectiveContext.RemovableRows.AsQueryable()"
                                ItemKey="@(row => row.Key)"
                                ResizableColumns="true"
                                ReorderableColumns="false"
                                GenerateHeader="DataGridGeneratedHeaderType.Sticky">
                    <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Namespace"]"
                                    ColumnId="configuration-management-namespace"
                                    Width="180px">
                        <code>@context.Namespace</code>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Key"]"
                                    ColumnId="configuration-management-key"
                                    Width="320px">
                        <code data-testid="tenants-config-management-key">@context.Key</code>
                    </TemplateColumn>
                    <TemplateColumn Title="@Localizer["Tenants.Configuration.Header.Actions"]"
                                    ColumnId="configuration-management-actions"
                                    Width="220px">
                        <span tabindex="-1" @ref="_removeLaunchElements[context.Key]">
                            <FluentButton Appearance="ButtonAppearance.Outline"
                                          data-testid="tenants-config-management-remove-open"
                                          Disabled="@(!RemoveAvailability.IsEligible)"
                                          aria-disabled="@((!RemoveAvailability.IsEligible).ToString().ToLowerInvariant())"
                                          aria-describedby="tenants-config-remove-reason tenants-config-remove-recovery"
                                          aria-label="@Localizer["Tenants.Configuration.Remove.OpenAccessible", context.Key]"
                                          OnClick="() => OpenRemoveFlow(context.Key)">
                                @Localizer["Tenants.Configuration.Remove.Open"]
                            </FluentButton>
                        </span>
                    </TemplateColumn>
                </FluentDataGrid>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_removeKey))
        {
            <RemoveTenantConfigurationFlow Context="@EffectiveContext"
                                           Evidence="@ResolvedRemoveEvidence"
                                           TargetKey="@_removeKey"
                                           SurfaceKind="@SurfaceKind"
                                           Freshness="@Freshness"
                                           Lifecycle="@Lifecycle"
                                           IsCommandSurfaceAvailable="@IsCommandSurfaceAvailable"
                                           OnProjectionRefreshRequested="@OnProjectionRefreshRequested"
                                           CommandActivityLease="@RemoveFlowCommandActivityLease"
                                           OnCloseRequested="@CloseRemoveFlowAsync"
                                           ProjectionEvidenceProvider="@RemoveProjectionEvidenceProvider"
                                           ReauthorizeProvider="@ReauthorizeProvider" />
        }
    }
</section>

@code {
    private readonly Dictionary<string, ElementReference> _removeLaunchElements = new(StringComparer.Ordinal);
    private ElementReference _headingElement;
    private string? _removeKey;
    private string? _focusRemoveLaunchKey;
    private string? _removeTenantId;
    private bool _removeCommandStarted;
    private bool _focusHeadingPending;

    // One lease per flow. A single shared field made dismissal of the remove dialog release the *set* flow's
    // lease: the row Remove buttons carry no Disabled binding, so while a Set command is settling the grid is
    // still rendered and still launchable, and CloseRemoveFlowAsync -- which writes the field directly,
    // bypassing the child latch -- then flipped UnavailableReason back to the CommandSurface string and
    // unmounted SetTenantConfigurationFlow mid-command, discarding its Confirmed/Rejected/UnableToVerify
    // state, safe message and audit entry point. The flows do not in fact guard each other on the launch
    // path, so ownership has to be explicit.
    //
    // Distinct from _removeCommandStarted, which is latched for the whole settling window so the remove flow
    // survives its row leaving the context; these track the live lease and are released as soon as the owning
    // child reports activity false.
    private bool _setCommandInFlight;
    private bool _removeCommandInFlight;

    private bool ChildCommandInFlight => _setCommandInFlight || _removeCommandInFlight;

    [Parameter]
    public TenantConfigurationManagementContext? Context { get; set; }

    [Parameter]
    public TenantDetailSurfaceKind SurfaceKind { get; set; } = TenantDetailSurfaceKind.Unknown;

    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public ProjectionLifecycleState Lifecycle { get; set; } = ProjectionLifecycleState.Unknown;

    [Parameter]
    public bool IsCommandSurfaceAvailable { get; set; } = true;

    [Parameter]
    public TenantHighImpactActionEvidence? SetEvidence { get; set; }

    [Parameter]
    public TenantHighImpactActionEvidence? RemoveEvidence { get; set; }

    [Parameter]
    public EventCallback OnProjectionRefreshRequested { get; set; }

    [Parameter]
    public EventCallback<bool> OnCommandActivityChanged { get; set; }

    /// <summary>
    /// Gets or sets the aggregate lease for the set-configuration flow. The landmark hosts two independent
    /// command flows, so each must hold its own lease: sharing one token makes the page-level lease
    /// multi-owner and lets whichever flow finishes first release an aggregate the other is still using.
    /// </summary>
    [Parameter]
    public Func<bool, Task<bool>>? SetCommandActivityLease { get; set; }

    /// <summary>
    /// Gets or sets the aggregate lease for the remove-configuration flow.
    /// </summary>
    [Parameter]
    public Func<bool, Task<bool>>? RemoveCommandActivityLease { get; set; }

    [Parameter]
    public Func<SetTenantConfiguration, Task<TenantConfigurationProjectionProof>>? SetProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<RemoveTenantConfiguration, Task<TenantConfigurationProjectionProof>>? RemoveProjectionEvidenceProvider { get; set; }

    [Parameter]
    public Func<Task<TenantConfigurationManagementContext>>? ReauthorizeProvider { get; set; }

    private bool IsManagementUnavailable
        => !HasPolicyScope || !string.IsNullOrWhiteSpace(UnavailableReason);

    private TenantConfigurationManagementContext EffectiveContext
        => Context ?? TenantConfigurationManagementContext.Unavailable(string.Empty);

    private TenantHighImpactActionEvidence ResolvedSetEvidence
        => ResolveEvidence(TenantHighImpactAction.SetConfiguration, SetEvidence);

    private TenantHighImpactActionEvidence ResolvedRemoveEvidence
        => ResolveEvidence(TenantHighImpactAction.RemoveConfiguration, RemoveEvidence);

    private TenantHighImpactActionAvailability SetAvailability
        => TenantHighImpactActionAvailabilityEvaluator.Evaluate(ResolvedSetEvidence);

    private TenantHighImpactActionAvailability RemoveAvailability
        => TenantHighImpactActionAvailabilityEvaluator.Evaluate(ResolvedRemoveEvidence);

    private TenantHighImpactActionEvidence BuildFallbackEvidence(TenantHighImpactAction action)
        => new(
            EffectiveContext.TenantId,
            action,
            TenantHighImpactEvaluationStage.PreviewEntry,
            EffectiveContext.TenantStatus,
            TenantHighImpactActionEvidence.FromReadModelFreshness(Freshness),
            Freshness is ReadModelFreshnessState.Current,
            SurfaceKind,
            Lifecycle,
            TenantHighImpactAuthorityEvidence.Indeterminate,
            TenantHighImpactNamespaceScopeEvidence.Indeterminate,
            TenantHighImpactSupportEvidence.Unknown,
            TenantHighImpactAdmissionEvidence.Unknown,
            TenantHighImpactPreviewEvidence.Missing,
            TenantHighImpactProofEvidence.NotRequired,
            TenantHighImpactViewportState.Unknown,
            IsInputComplete: false,
            TenantHighImpactTargetState.Unknown);

    private TenantHighImpactActionEvidence ResolveEvidence(
        TenantHighImpactAction expectedAction,
        TenantHighImpactActionEvidence? evidence)
        => evidence is not null
            && evidence.Action == expectedAction
            && string.Equals(evidence.TenantId, EffectiveContext.TenantId, StringComparison.Ordinal)
                ? evidence
                : BuildFallbackEvidence(expectedAction);

    private bool HasPolicyScope
        => EffectiveContext.IsAvailable
        && (EffectiveContext.IsGlobalAdministrator || EffectiveContext.AuthorizedPrefixes.Count > 0);

    // A valid policy that grants this caller nothing is not a verification failure. Reporting it as
    // one told a proven non-administrator that policy could not be verified, contradicting the
    // sibling read landmark, which correctly showed an authorization-safe empty state.
    private string PolicyUnavailableResourceKey
        => EffectiveContext.IsAvailable
            ? "Tenants.Configuration.Management.Unavailable.NoScope"
            : "Tenants.Configuration.Management.Unavailable.Policy";

    private string? UnavailableReason
        // Decision D-F: strict lifecycle gate retained, evaluated after the surface and freshness clauses.
        // See SetTenantConfigurationFlow for why the order matters.
        => SetEvidence is not null || RemoveEvidence is not null
            ? !IsCommandSurfaceAvailable && !ChildCommandInFlight
                ? Localizer["Tenants.Configuration.Management.Unavailable.CommandSurface"].Value
                : null
            : SurfaceKind is TenantDetailSurfaceKind.Unavailable or TenantDetailSurfaceKind.Unknown or TenantDetailSurfaceKind.Degraded
            ? Localizer["Tenants.Configuration.Management.Unavailable.ProjectionState"].Value
            : SurfaceKind is TenantDetailSurfaceKind.Stale || Freshness is not ReadModelFreshnessState.Current
                ? Localizer["Tenants.Configuration.Management.Unavailable.Freshness"].Value
            : Lifecycle is not ProjectionLifecycleState.Current
                ? Localizer["Tenants.Configuration.Management.Unavailable.ProjectionLifecycle"].Value
                : EffectiveContext.TenantStatus is TenantStatus.Disabled or TenantStatus.Unknown
                    ? Localizer["Tenants.Configuration.Management.Unavailable.TenantLifecycle"].Value
                    // The command surface goes unavailable *because* a child flow raised activity: the flow
                    // reports the submit, the detail page sets _commandInFlight, and IsCommandSurfaceAvailable
                    // comes straight back down here. Without the second clause this branch replaced both
                    // flows with a static paragraph at the exact moment of submit, so Confirmed, Rejected,
                    // UnableToVerify, the safe message and the audit entry point were never renderable for a
                    // configuration command. Both flows already carry this exception one level down
                    // (`!IsCommandSurfaceAvailable && !IsOwnedCommandInFlight`); the landmark that hosts them
                    // has to honour it too, or theirs never gets the chance to apply.
                    : !IsCommandSurfaceAvailable && !ChildCommandInFlight
                        ? Localizer["Tenants.Configuration.Management.Unavailable.CommandSurface"].Value
                        : null;

    // The launch controls exist only on this branch. Pruning against RemovableRows alone kept keys for rows
    // the render had already dropped (policy/lifecycle/freshness turning the whole branch off), so a queued
    // refocus targeted a detached ElementReference and threw JSException, not JSDisconnectedException.
    private bool TargetsAreRendered
        => HasPolicyScope
        && string.IsNullOrWhiteSpace(UnavailableReason)
        && EffectiveContext.RemovableRows.Count > 0;

    protected override void OnParametersSet()
    {
        // A tenant switch invalidates every open interaction, including one whose command is still settling:
        // the snapshot it would confirm against belongs to a different aggregate.
        if (!string.Equals(_removeTenantId, EffectiveContext.TenantId, StringComparison.Ordinal))
        {
            _removeTenantId = EffectiveContext.TenantId;
            _removeKey = null;
            _removeCommandStarted = false;
            _setCommandInFlight = false;
            _removeCommandInFlight = false;
            _focusRemoveLaunchKey = null;
            _focusHeadingPending = false;
            _removeLaunchElements.Clear();
        }

        // Once a remove command has been submitted the flow owns its own dismissal. Clearing the target
        // because the row left RemovableRows unmounted the flow at the exact moment the projection proved
        // the removal, so the operator never saw Confirmed, the audit entry point, or recovery text.
        if (_removeKey is not null
            && !_removeCommandStarted
            && EffectiveContext.FindRemovableRow(_removeKey) is null)
        {
            _removeKey = null;
            _focusHeadingPending = true;
        }

        if (_removeLaunchElements.Count > 0)
        {
            if (!TargetsAreRendered)
            {
                _removeLaunchElements.Clear();
            }
            else
            {
                HashSet<string> live = EffectiveContext.RemovableRows
                    .Select(static row => row.Key)
                    .ToHashSet(StringComparer.Ordinal);
                foreach (string stale in _removeLaunchElements.Keys.Where(key => !live.Contains(key)).ToArray())
                {
                    _ = _removeLaunchElements.Remove(stale);
                }
            }
        }

        // A successful removal deletes the row the focus was going to return to. Fall back to the landmark
        // heading rather than leaving focus on a detached subtree.
        if (_focusRemoveLaunchKey is not null && !_removeLaunchElements.ContainsKey(_focusRemoveLaunchKey))
        {
            _focusRemoveLaunchKey = null;
            _focusHeadingPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRemoveLaunchKey is not null
            && _removeLaunchElements.TryGetValue(_focusRemoveLaunchKey, out ElementReference launchElement))
        {
            _focusRemoveLaunchKey = null;
            _focusHeadingPending = false;
            await FocusSafelyAsync(launchElement).ConfigureAwait(false);
            return;
        }

        if (_focusHeadingPending)
        {
            _focusHeadingPending = false;
            await FocusSafelyAsync(_headingElement).ConfigureAwait(false);
        }
    }

    private static async Task FocusSafelyAsync(ElementReference element)
    {
        try
        {
            await element.FocusAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away while a refocus was queued; nothing to restore focus to.
        }
        catch (JSException)
        {
            // The target left the DOM between the render that queued the focus and this callback.
        }
    }

    // Cached so the delegate identity stays stable across renders; a fresh lambda each render reads as a
    // changed parameter to the child flow.
    private Func<bool, Task<bool>>? _setFlowCommandActivityLease;
    private Func<bool, Task<bool>>? _removeFlowCommandActivityLease;

    private Func<bool, Task<bool>> SetFlowCommandActivityLease
        => _setFlowCommandActivityLease ??= HandleSetCommandActivityLeaseAsync;

    private Func<bool, Task<bool>> RemoveFlowCommandActivityLease
        => _removeFlowCommandActivityLease ??= HandleRemoveCommandActivityLeaseAsync;

    private async Task<bool> HandleRemoveCommandActivityLeaseAsync(bool isActive)
    {
        // The flags are raised *before* the lease call, then rolled back on refusal. Ordering is load-bearing:
        // acquiring makes the detail page set _commandInFlight, which comes straight back down as
        // IsCommandSurfaceAvailable=false. If ChildCommandInFlight were still false at that moment, the
        // UnavailableReason branch would replace both flows with a static paragraph at the exact instant of
        // submit, so no terminal outcome could ever render.
        bool previousStarted = _removeCommandStarted;
        bool previousInFlight = _removeCommandInFlight;
        if (isActive)
        {
            _removeCommandStarted = true;
        }

        _removeCommandInFlight = isActive;

        if (RemoveCommandActivityLease is not null)
        {
            bool accepted = await RemoveCommandActivityLease(isActive).ConfigureAwait(false);
            if (isActive && !accepted)
            {
                _removeCommandStarted = previousStarted;
                _removeCommandInFlight = previousInFlight;
                return false;
            }
        }
        else
        {
            await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
        }

        return true;
    }

    // The set flow used to pass OnCommandActivityChanged straight through, so the landmark never learned it
    // owned an in-flight command and unavailability came back down as an unmount. It reports here now, into
    // its own lease -- see the field declarations for why the two cannot share one.
    private async Task<bool> HandleSetCommandActivityLeaseAsync(bool isActive)
    {
        // Raised before the lease call and rolled back on refusal -- see HandleRemoveCommandActivityLeaseAsync
        // for why the ordering matters.
        bool previousInFlight = _setCommandInFlight;
        _setCommandInFlight = isActive;

        if (SetCommandActivityLease is not null)
        {
            bool accepted = await SetCommandActivityLease(isActive).ConfigureAwait(false);
            if (isActive && !accepted)
            {
                _setCommandInFlight = previousInFlight;
                return false;
            }
        }
        else
        {
            await InvokeAsync(() => OnCommandActivityChanged.InvokeAsync(isActive)).ConfigureAwait(false);
        }

        return true;
    }

    private void OpenRemoveFlow(string key)
    {
        if (!RemoveAvailability.IsEligible)
        {
            return;
        }

        _removeKey = key;
        _removeCommandStarted = false;
    }

    private async Task CloseRemoveFlowAsync()
    {
        // This runs as an EventCallback from the child, which re-renders this component without running
        // SetParametersAsync -- so OnParametersSet, where the heading fallback used to be set, never fires on
        // this path. When the target row has already left the context its launch reference was pruned, so
        // TryGetValue fails in OnAfterRenderAsync and focus fell to <body> from the unmounting dialog. Arm
        // the fallback here and let OnAfterRenderAsync pick whichever target still exists.
        _focusRemoveLaunchKey = _removeKey;
        _focusHeadingPending = _removeKey is null || !_removeLaunchElements.ContainsKey(_removeKey);

        // Disarm the launch target when the heading fallback wins. Leaving a non-null key that is absent from
        // _removeLaunchElements made the next OnParametersSet re-arm _focusHeadingPending, so a SignalR nudge
        // or projection refresh seconds later yanked focus back to the h2 while the operator was typing in
        // the Set-configuration key field.
        if (_focusHeadingPending)
        {
            _focusRemoveLaunchKey = null;
        }

        _removeKey = null;
        _removeCommandStarted = false;

        // Only the remove half. This runs as an EventCallback from the remove child, which has already
        // lowered its own lease through HandleRemoveCommandActivityLeaseAsync, so this is defensive -- but it must
        // never touch _setCommandInFlight: a sibling Set command settling behind this dialog owns that lease
        // and clearing it here unmounted the Set flow mid-command.
        _removeCommandInFlight = false;
        await Task.CompletedTask.ConfigureAwait(false);
    }

    private string StatusText(TenantStatus status)
        => Localizer[$"Tenants.Lifecycle.Status.{(Enum.IsDefined(status) ? status : TenantStatus.Unknown)}"];

    private string FreshnessText(TenantHighImpactFreshnessState freshness)
        => Localizer[$"Tenants.HighImpact.Freshness.{(Enum.IsDefined(freshness) ? freshness : TenantHighImpactFreshnessState.Unknown)}"];

    private string ActionText(TenantHighImpactAction action)
        => Localizer[$"Tenants.HighImpact.Action.{(Enum.IsDefined(action) ? action : TenantHighImpactAction.SetConfiguration)}"];
}
