@using Hexalith.Tenants.UI.State.TenantList
@inject IStringLocalizer<TenantsResources> Localizer

<FluentBadge Appearance="BadgeAppearance.Tint"
             Color="@FreshnessBadgeColor"
             IconStart="@StateIcon"
             Class="@($"truth-state-badge truth-state-badge--{CssClass}")"
             role="status"
             aria-label="@Label"
             data-testid="@TestId">
    @Label
</FluentBadge>

@code {
    [Parameter]
    public TenantFreshnessState Freshness { get; set; } = TenantFreshnessState.Unknown;

    [Parameter]
    public string TestId { get; set; } = "tenants-list-truth-state";

    [Parameter]
    public string ResourcePrefix { get; set; } = "Tenants.List";

    private string Label => Localizer[$"{ResourcePrefix}.Freshness.{Freshness}"];

    private string CssClass => Freshness.ToString().ToLowerInvariant();

    private BadgeColor FreshnessBadgeColor => Freshness switch
    {
        TenantFreshnessState.Current => BadgeColor.Success,
        TenantFreshnessState.Refreshing => BadgeColor.Informative,
        TenantFreshnessState.Aging => BadgeColor.Warning,
        TenantFreshnessState.Stale => BadgeColor.Severe,
        _ => BadgeColor.Subtle,
    };

    private Icon StateIcon => Freshness switch
    {
        TenantFreshnessState.Current => FcFluentIcons.Checkmark16(),
        TenantFreshnessState.Refreshing => FcFluentIcons.ArrowSync16(),
        TenantFreshnessState.Aging => FcFluentIcons.Warning16(),
        TenantFreshnessState.Stale => FcFluentIcons.Warning16(),
        _ => FcFluentIcons.QuestionCircle16(),
    };
}
