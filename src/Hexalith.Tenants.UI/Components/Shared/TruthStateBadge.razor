@using Hexalith.Tenants.UI.State.TenantList
@inject IStringLocalizer<TenantsResources> Localizer

<FluentBadge Appearance="BadgeAppearance.Tint"
             Color="@FreshnessBadgeColor"
             IconStart="@StateIcon"
             Class="@($"truth-state-badge truth-state-badge--{CssClass}")"
             role="status"
             aria-label="@Label"
             data-testid="@TestId">
    @Label
</FluentBadge>

@code {
    [Parameter]
    public ReadModelFreshnessState Freshness { get; set; } = ReadModelFreshnessState.Unknown;

    [Parameter]
    public bool IsRefreshing { get; set; }

    [Parameter]
    public string TestId { get; set; } = "tenants-list-truth-state";

    [Parameter]
    public string ResourcePrefix { get; set; } = "Tenants.List";

    private string FreshnessKey => IsRefreshing ? "Refreshing" : Freshness.ToString();

    private string Label => Localizer[$"{ResourcePrefix}.Freshness.{FreshnessKey}"];

    private string CssClass => FreshnessKey.ToLowerInvariant();

    private BadgeColor FreshnessBadgeColor => IsRefreshing ? BadgeColor.Informative : Freshness switch
    {
        ReadModelFreshnessState.Current => BadgeColor.Success,
        ReadModelFreshnessState.Aging => BadgeColor.Warning,
        ReadModelFreshnessState.Stale => BadgeColor.Severe,
        _ => BadgeColor.Subtle,
    };

    private Icon StateIcon => IsRefreshing ? FcFluentIcons.ArrowSync16() : Freshness switch
    {
        ReadModelFreshnessState.Current => FcFluentIcons.Checkmark16(),
        ReadModelFreshnessState.Aging => FcFluentIcons.Warning16(),
        ReadModelFreshnessState.Stale => FcFluentIcons.Warning16(),
        _ => FcFluentIcons.QuestionCircle16(),
    };
}
