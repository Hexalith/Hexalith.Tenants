@using Hexalith.Tenants.UI.State.TenantList
@inject IStringLocalizer<TenantsResources> Localizer

<section class="list-surface-state list-surface-state--@CssClass"
         role="@Role"
         aria-live="@AriaLive"
         data-testid="@TestId">
    <h2>@Localizer[$"Tenants.List.State.{ResourceName}.Title"]</h2>
    <p>@Message</p>
    @if (Kind is TenantListSurfaceKind.FilteredEmpty)
    {
        <FluentButton Appearance="ButtonAppearance.Outline" data-testid="tenants-list-state-reset" OnClick="OnReset">
            @Localizer["Tenants.List.Reset"]
        </FluentButton>
    }
    @if (Kind is TenantListSurfaceKind.Stale)
    {
        <FluentButton Appearance="ButtonAppearance.Primary" data-testid="tenants-list-state-refresh" OnClick="OnRefresh">
            @Localizer["Tenants.List.Refresh"]
        </FluentButton>
    }
</section>

@code {
    [Parameter]
    public TenantListSurfaceKind Kind { get; set; }

    [Parameter]
    public TenantListReason Reason { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private string ResourceName => Kind switch
    {
        TenantListSurfaceKind.Loading => "Loading",
        TenantListSurfaceKind.Empty => "Empty",
        TenantListSurfaceKind.FilteredEmpty => "FilteredEmpty",
        TenantListSurfaceKind.Error => "Error",
        TenantListSurfaceKind.Unauthorized => "Unauthorized",
        TenantListSurfaceKind.Stale => "Stale",
        TenantListSurfaceKind.Degraded => "Degraded",
        _ => "Empty",
    };

    private string TestId => Kind switch
    {
        TenantListSurfaceKind.Loading => "tenants-list-loading",
        TenantListSurfaceKind.Empty => "tenants-list-empty",
        TenantListSurfaceKind.FilteredEmpty => "tenants-list-filtered-empty",
        TenantListSurfaceKind.Error => "tenants-list-error",
        TenantListSurfaceKind.Unauthorized => "tenants-list-unauthorized",
        TenantListSurfaceKind.Stale => "tenants-list-stale",
        TenantListSurfaceKind.Degraded => "tenants-list-degraded",
        _ => "tenants-list-empty",
    };

    private string CssClass => ResourceName.ToLowerInvariant();

    private string Role => Kind is TenantListSurfaceKind.Error or TenantListSurfaceKind.Degraded ? "alert" : "status";

    private string AriaLive => Kind is TenantListSurfaceKind.Error or TenantListSurfaceKind.Degraded ? "assertive" : "polite";

    private string Message => Reason is TenantListReason.None
        ? Localizer[$"Tenants.List.State.{ResourceName}.Message"]
        : Localizer[$"Tenants.List.Reason.{Reason}"];
}
