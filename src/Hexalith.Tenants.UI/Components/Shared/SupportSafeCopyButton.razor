@using Hexalith.Tenants.UI.Services.SupportSafety
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<TenantsResources> Localizer

@if (IsEligible)
{
    <span class="support-safe-copy"
          data-testid="@TestId"
          data-copy-kind="@ValueKind">
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@FcFluentIcons.Copy16()"
                      Class="@ButtonCss"
                      data-testid="tenants-copy-reference"
                      data-surface-testid="@TestId"
                      data-copy-kind="@ValueKind"
                      aria-label="@AccessibleName"
                      OnClick="CopyAsync">
            <span class="support-safe-copy__text">@Localizer["Tenants.Copy.Action"]</span>
        </FluentButton>
        <span class="@FeedbackCss"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              data-testid="@($"{TestId}-feedback")">
            @_feedback
        </span>
    </span>
}

@code {
    private const string ClipboardModulePath = "./js/tenantsClipboard.js";

    private IJSObjectReference? _module;
    private string _feedback = string.Empty;
    private CopyFeedbackKind _feedbackKind = CopyFeedbackKind.Ready;
    private string _observedValue = string.Empty;
    private SupportSafeCopyValueKind _observedValueKind = SupportSafeCopyValueKind.Unknown;
    private bool _observedIsApproved;
    private string _observedAccessibleName = string.Empty;
    private long _inputVersion;
    private int _activationInProgress;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    [EditorRequired]
    public SupportSafeCopyValueKind ValueKind { get; set; } = SupportSafeCopyValueKind.Unknown;

    [Parameter]
    [EditorRequired]
    public bool IsApproved { get; set; }

    [Parameter]
    [EditorRequired]
    public string AccessibleName { get; set; } = string.Empty;

    [Parameter]
    public string TestId { get; set; } = "tenants-copy-reference";

    private string ButtonCss
        => $"support-safe-copy__button support-safe-copy__button--{_feedbackKind.ToString().ToLowerInvariant()}";

    private string FeedbackCss
        => $"support-safe-copy__feedback support-safe-copy__feedback--{_feedbackKind.ToString().ToLowerInvariant()}";

    private bool IsEligible
        => !string.IsNullOrWhiteSpace(AccessibleName)
            && SupportSafeCopyClassifier.IsAllowed(Value, ValueKind, IsApproved);

    protected override void OnParametersSet()
    {
        if (string.Equals(_observedValue, Value, StringComparison.Ordinal)
            && _observedValueKind == ValueKind
            && _observedIsApproved == IsApproved
            && string.Equals(_observedAccessibleName, AccessibleName, StringComparison.Ordinal))
        {
            return;
        }

        _observedValue = IsEligible ? Value : string.Empty;
        _observedValueKind = ValueKind;
        _observedIsApproved = IsApproved;
        _observedAccessibleName = AccessibleName;
        _ = Interlocked.Increment(ref _inputVersion);
        _feedback = string.Empty;
        _feedbackKind = CopyFeedbackKind.Ready;
    }

    private async Task CopyAsync()
    {
        if (Interlocked.CompareExchange(ref _activationInProgress, 1, 0) != 0)
        {
            return;
        }

        CopyInput input = new(Value, ValueKind, IsApproved, AccessibleName, Volatile.Read(ref _inputVersion));
        try
        {
            if (!input.IsEligible)
            {
                return;
            }

            await ClearFeedbackAsync(input.Version).ConfigureAwait(false);

            IJSObjectReference module = _module
                ??= await JS.InvokeAsync<IJSObjectReference>("import", ClipboardModulePath).ConfigureAwait(false);
            bool writeStarted = false;
            await InvokeAsync(async () =>
            {
                if (!IsCurrent(input.Version) || !input.IsEligible)
                {
                    return;
                }

                writeStarted = true;
                await module.InvokeVoidAsync("writeText", input.Value).ConfigureAwait(false);
            }).ConfigureAwait(false);
            if (!writeStarted)
            {
                return;
            }

            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Copied, "Tenants.Copy.Feedback.Copied").ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Canceled, "Tenants.Copy.Feedback.Canceled").ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Disconnected, "Tenants.Copy.Feedback.Disconnected").ConfigureAwait(false);
        }
        catch (JSException exception) when (exception.Message.Contains("TENANTS_CLIPBOARD_INSECURE", StringComparison.Ordinal))
        {
            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Insecure, "Tenants.Copy.Feedback.Insecure").ConfigureAwait(false);
        }
        catch (JSException exception) when (exception.Message.Contains("TENANTS_CLIPBOARD_MISSING", StringComparison.Ordinal))
        {
            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Unavailable, "Tenants.Copy.Feedback.Unavailable").ConfigureAwait(false);
        }
        catch (JSException exception) when (exception.Message.Contains("TENANTS_CLIPBOARD_NOT_ALLOWED", StringComparison.Ordinal))
        {
            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Permission, "Tenants.Copy.Feedback.PermissionDenied").ConfigureAwait(false);
        }
        catch (JSException)
        {
            await PublishFeedbackAsync(input.Version, CopyFeedbackKind.Failed, "Tenants.Copy.Feedback.Failed").ConfigureAwait(false);
        }
        finally
        {
            Volatile.Write(ref _activationInProgress, 0);
        }
    }

    private bool IsCurrent(long version)
        => Volatile.Read(ref _inputVersion) == version;

    private async Task ClearFeedbackAsync(long version)
    {
        await InvokeAsync(() =>
        {
            if (IsCurrent(version))
            {
                _feedbackKind = CopyFeedbackKind.Ready;
                _feedback = string.Empty;
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    private async Task PublishFeedbackAsync(long version, CopyFeedbackKind kind, string resourceKey)
    {
        if (!IsCurrent(version))
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (IsCurrent(version))
            {
                _feedbackKind = CopyFeedbackKind.Ready;
                _feedback = string.Empty;
                StateHasChanged();
            }
        }).ConfigureAwait(false);
        await InvokeAsync(() =>
        {
            if (IsCurrent(version))
            {
                _feedbackKind = kind;
                _feedback = Localizer[resourceKey];
                StateHasChanged();
            }
        }).ConfigureAwait(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync().ConfigureAwait(false);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; no support-safe value is logged or surfaced here.
        }
    }

    private enum CopyFeedbackKind
    {
        Ready,
        Copied,
        Canceled,
        Unavailable,
        Insecure,
        Permission,
        Disconnected,
        Failed,
    }

    private readonly record struct CopyInput(
        string Value,
        SupportSafeCopyValueKind ValueKind,
        bool IsApproved,
        string AccessibleName,
        long Version)
    {
        public bool IsEligible
            => !string.IsNullOrWhiteSpace(AccessibleName)
                && SupportSafeCopyClassifier.IsAllowed(Value, ValueKind, IsApproved);
    }
}
