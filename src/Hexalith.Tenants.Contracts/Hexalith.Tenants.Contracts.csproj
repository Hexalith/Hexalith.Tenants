<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Debug source when available; Release uses the published EventStore Contracts package. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" Condition="'$(HexalithEventStoreFromSource)' == 'true'">
      <AdditionalProperties Condition="'$(HexalithSourceMappingMode)' != 'source'">Version=$(HexalithEventStoreVersion)</AdditionalProperties>
    </ProjectReference>
    <PackageReference Include="Hexalith.EventStore.Contracts" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
    <!-- McpCli Decoration Package: declares the gateway-ready operations; source when available, otherwise the pinned package. -->
    <ProjectReference Include="$(HexalithMcpCliRoot)\src\Hexalith.McpCli.Abstractions\Hexalith.McpCli.Abstractions.csproj" Condition="'$(HexalithMcpCliFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.McpCli.Abstractions" Condition="'$(HexalithMcpCliFromSource)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Hexalith.EventStore.Contracts.Events" />
  </ItemGroup>

</Project>
