<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>.NET Aspire hosting extensions for the Hexalith Tenants domain service — adds the Tenants server and its EventStore domain-module wiring to a consuming AppHost.</Description>
    <PackageTags>multi-tenancy;tenants;dapr;aspire;eventsourcing;dotnet</PackageTags>
    <!-- NU5104: Hexalith.EventStore.Aspire depends on CommunityToolkit.Aspire.Hosting.Dapr, which currently
         ships only as a prerelease aligned with Aspire 13.4. Keep the suppression scoped to this package. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Debug source when available; Release uses the published EventStore Aspire package. -->
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Aspire\Hexalith.EventStore.Aspire.csproj" AdditionalProperties="Version=$(HexalithEventStoreVersion)" Condition="'$(HexalithEventStoreFromSource)' == 'true'" />
    <PackageReference Include="Hexalith.EventStore.Aspire" Condition="'$(HexalithEventStoreFromSource)' != 'true'" />
  </ItemGroup>

</Project>
