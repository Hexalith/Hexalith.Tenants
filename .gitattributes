# Auto-detect text files and normalize line endings
* text=auto

# Force LF for shell scripts (must not have CRLF on Unix)
*.sh text eol=lf

# Force LF for other common text formats
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Preserve the required C# line endings for the DW-606 source paths on checkout.
src/Hexalith.Tenants.UI/Services/Gateways/TenantsRestQueryClient.cs text eol=crlf
src/Hexalith.Tenants/Bootstrap/TenantBootstrapCredentialProvider.cs text eol=crlf
