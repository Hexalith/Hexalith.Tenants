<Project>

  <!-- Carry the owning EventStore source identity through every local project edge, including
       indirect source graphs. Published package versions remain pinned in Directory.Build.props. -->
  <!-- The pinned mapper owns edge properties in mapped mode; keep legacy propagation elsewhere. -->
  <ItemGroup Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(HexalithSourceMappingMode)' != 'source'">
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!--
    Container image defaults (.NET SDK container support).
    Opt-in per project with:
      <EnableContainer>true</EnableContainer>
      <ContainerRepository>image-name</ContainerRepository>
    CI/CD may override ContainerRegistry and ContainerImageTags via env or -p:.
    Loaded as .targets (post-project) so EnableContainer set in the project is visible.
  -->
  <PropertyGroup Condition="'$(EnableContainer)' == 'true'">
    <IsPackable Condition="'$(EnableContainerPackable)' != 'true'">false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
    <ContainerFamily>alpine</ContainerFamily>
    <ContainerRegistry Condition="'$(ContainerRegistry)' == ''">registry.hexalith.com</ContainerRegistry>
    <ContainerImageTag Condition="'$(ContainerImageTags)' == '' and '$(ContainerImageTag)' == ''">staging-latest</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableContainer)' == 'true'">
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/Hexalith/Hexalith.Tenants" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="MIT" />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="Hexalith" />
  </ItemGroup>

  <Target Name="RemoveOpenApiSourceGenerator" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.AspNetCore.OpenApi'" />
    </ItemGroup>
  </Target>

  <!-- Reuse the shared SDK provenance repair from the centrally pinned Builds checkout. -->
  <PropertyGroup>
    <HexalithContainerProvenanceTargets>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/ContainerProvenance.targets</HexalithContainerProvenanceTargets>
    <HexalithContainerProvenanceTargets Condition="!Exists('$(HexalithContainerProvenanceTargets)') and Exists('$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/ContainerProvenance.targets')">$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/ContainerProvenance.targets</HexalithContainerProvenanceTargets>
    <HexalithContainerProvenanceTargets Condition="!Exists('$(HexalithContainerProvenanceTargets)') and Exists('$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/ContainerProvenance.targets')">$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/ContainerProvenance.targets</HexalithContainerProvenanceTargets>
  </PropertyGroup>
  <Import Project="$(HexalithContainerProvenanceTargets)" />

  <!-- Pack asks referenced projects for their version while Version/PackageVersion is the
       package being packed, so EventStore project references are stamped with the Tenants
       version. Put the central EventStore pin back before the nuspec is generated. -->
  <Target Name="PinProjectReferenceEventStoreVersions" BeforeTargets="GenerateNuspec" DependsOnTargets="_GetProjectReferenceVersions" Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(HexalithEventStoreVersion)' != ''">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="$([System.String]::Copy('%(_ProjectReferencesWithVersions.Identity)').Contains('Hexalith.EventStore'))">
        <ProjectVersion>$(HexalithEventStoreVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
