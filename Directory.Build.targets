<Project>
  <!-- Normalize only qualified stable binaries; metadata suffixes do not change their API. -->
  <PropertyGroup>
    <HexalithTenantsCatalogArtifactsAvailable>false</HexalithTenantsCatalogArtifactsAvailable>
    <HexalithTenantsCatalogSdkVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(HexalithEventStoreVersion)', '\A(3\.129\.[01]|3\.130\.[01])(?:\.0)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?\z', '$1'))</HexalithTenantsCatalogSdkVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HexalithEventStoreFromSource)' == 'true' or '$(HexalithTenantsCatalogSdkVersion)' == '3.129.0' or '$(HexalithTenantsCatalogSdkVersion)' == '3.129.1' or '$(HexalithTenantsCatalogSdkVersion)' == '3.130.0' or '$(HexalithTenantsCatalogSdkVersion)' == '3.130.1'">
    <HexalithTenantsCatalogArtifactsAvailable>true</HexalithTenantsCatalogArtifactsAvailable>
    <DefineConstants>$(DefineConstants);HEXALITH_DEVELOPMENT_CATALOG_SOURCE</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateCatalogSdkSelection" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="'$(HexalithEventStoreFromSource)' != 'true' and '$(HexalithEventStoreVersion)' != ''">
    <Error Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(HexalithEventStoreVersion)', '3.129.0')) and '$(HexalithTenantsCatalogArtifactsAvailable)' != 'true'"
           Text="Catalog SDK selection '$(HexalithEventStoreVersion)' is not qualified. Use stable 3.129.0, 3.129.1, 3.130.0 or 3.130.1, or the explicit legacy compatibility profile." />
  </Target>

  <Target Name="ValidatePublishedCatalogSdk">
    <Error Condition="'$(IsPackable)' == 'true' and '$(HexalithTenantsCatalogArtifactsAvailable)' != 'true'"
           Text="Published Tenants packages require the qualified EventStore 3.129.0, 3.129.1, 3.130.0 or 3.130.1 catalog SDK or an enrolled source build. The 3.128.4 compatibility profile is not publishable." />
  </Target>

  <!-- Foreign repositories can inherit this targets file while generating their own packages. -->
  <Target Name="ValidatePublishedCatalogArtifacts" BeforeTargets="GenerateNuspec" DependsOnTargets="ValidatePublishedCatalogSdk"
          Condition="'$(IsPackable)' == 'true' and ('$(MSBuildProjectName)' == 'Hexalith.Tenants.Contracts' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Server' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Client' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Testing' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Aspire')">
    <Exec Condition="'$(MSBuildProjectName)' == 'Hexalith.Tenants.Contracts' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Server' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Client' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Testing' or '$(MSBuildProjectName)' == 'Hexalith.Tenants.Aspire'"
          Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)tools/CatalogArtifactVerifier/CatalogArtifactVerifier.csproj&quot; --configuration Release --no-launch-profile -- &quot;$(TargetPath)&quot; &quot;$(MSBuildProjectName)&quot;" />
  </Target>

  <!-- Carry the owning EventStore source identity through ordinary local project edges.
       A source mapping mode, or an active producer mapping, owns dependency versions
       without per-edge overrides. Published package versions remain pinned in Directory.Build.props. -->
  <ItemGroup Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(HexalithSourceMappingMode)' != 'source' and ('$(HexalithSourceMappingHash)' == '' or '$(HexalithSourceMappingApplies)' != 'true')">
    <ProjectReference Update="@(ProjectReference)">
      <AdditionalProperties>%(ProjectReference.AdditionalProperties);HexalithEventStoreVersion=$(HexalithEventStoreVersion)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- The SDK also promotes transitive project references without copying edge metadata. -->
  <Target Name="PreserveBuildToolingCatalogSelection" AfterTargets="IncludeTransitiveProjectReferences">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' == 'Hexalith.Builds.Tooling'">
        <GlobalPropertiesToRemove>%(ProjectReference.GlobalPropertiesToRemove);HexalithEventStoreVersion</GlobalPropertiesToRemove>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!-- Global command-line properties cannot be raised by the default floor in props.
       Refuse an older package selection before restore or compilation consumes it. -->
  <PropertyGroup>
    <_TenantsNestedReferenceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)references/'))</_TenantsNestedReferenceRoot>
  </PropertyGroup>
  <Target Name="ValidateEventStorePackageFloor" BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="'$(HexalithEventStoreFromSource)' != 'true' and !$(MSBuildProjectFullPath.StartsWith('$(_TenantsNestedReferenceRoot)'))">
    <Error Condition="'$(HexalithEventStoreVersion)' == '' or $([MSBuild]::VersionLessThan('$(HexalithEventStoreVersion)', '3.128.4')) or ($([MSBuild]::VersionEquals('$(HexalithEventStoreVersion)', '3.128.4')) and $([System.Text.RegularExpressions.Regex]::IsMatch('$(HexalithEventStoreVersion)', '^[^+]*-')))"
           Text="EventStore package selection '$(HexalithEventStoreVersion)' must be at least 3.128.4 for completion recovery. Source mappings retain their exact producer identity." />
  </Target>

  <!--
    Container image defaults (.NET SDK container support).
    Opt-in per project with:
      <EnableContainer>true</EnableContainer>
      <ContainerRepository>image-name</ContainerRepository>
    CI/CD may override ContainerRegistry and ContainerImageTags via env or -p:.
    Loaded as .targets (post-project) so EnableContainer set in the project is visible.
  -->
  <PropertyGroup Condition="'$(EnableContainer)' == 'true'">
    <IsPackable Condition="'$(EnableContainerPackable)' != 'true'">false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0-alpine</ContainerBaseImage>
    <ContainerFamily>alpine</ContainerFamily>
    <ContainerRegistry Condition="'$(ContainerRegistry)' == ''">registry.hexalith.com</ContainerRegistry>
    <ContainerImageTag Condition="'$(ContainerImageTags)' == '' and '$(ContainerImageTag)' == ''">staging-latest</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableContainer)' == 'true'">
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/Hexalith/Hexalith.Tenants" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="MIT" />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="Hexalith" />
  </ItemGroup>

  <Target Name="RemoveOpenApiSourceGenerator" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.AspNetCore.OpenApi'" />
    </ItemGroup>
  </Target>

  <!-- Reuse the shared SDK provenance repair from the centrally pinned Builds checkout. -->
  <PropertyGroup>
    <HexalithContainerProvenanceTargets>$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/ContainerProvenance.targets</HexalithContainerProvenanceTargets>
    <HexalithContainerProvenanceTargets Condition="!Exists('$(HexalithContainerProvenanceTargets)') and Exists('$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/ContainerProvenance.targets')">$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/ContainerProvenance.targets</HexalithContainerProvenanceTargets>
    <HexalithContainerProvenanceTargets Condition="!Exists('$(HexalithContainerProvenanceTargets)') and Exists('$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/ContainerProvenance.targets')">$(MSBuildThisFileDirectory)../../Hexalith.Builds/Props/ContainerProvenance.targets</HexalithContainerProvenanceTargets>
  </PropertyGroup>
  <Import Project="$(HexalithContainerProvenanceTargets)" />

  <!-- Pack asks referenced projects for their version while Version/PackageVersion is the
       package being packed, so EventStore project references are stamped with the Tenants
       version. Put the central EventStore pin back before the nuspec is generated. -->
  <Target Name="PinProjectReferenceEventStoreVersions" BeforeTargets="GenerateNuspec" DependsOnTargets="_GetProjectReferenceVersions" Condition="'$(HexalithEventStoreFromSource)' == 'true' and '$(HexalithEventStoreVersion)' != ''">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="$([System.String]::Copy('%(_ProjectReferencesWithVersions.Identity)').Contains('Hexalith.EventStore'))">
        <ProjectVersion>$(HexalithEventStoreVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
